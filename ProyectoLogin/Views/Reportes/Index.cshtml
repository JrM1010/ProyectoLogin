@{
    ViewData["Title"] = "Reportes";
}

<div class="container-fluid py-4 reports-theme">
    <!-- HEADER -->
    <div class="reports-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="reports-icon-main me-3">
                <i class="bi bi-clipboard-data fs-3"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 fw-bold text-white">Centro de Reportes</h1>
                <p class="mb-0 text-muted-small">
                    Accede a los reportes clave de ventas, compras, inventario y actividad de usuarios desde un solo panel.
                </p>
            </div>
        </div>

        <a asp-controller="Home" asp-action="Index"
           class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left-circle"></i>
            Volver al Inicio
        </a>
    </div>

    <!-- TARJETA PRINCIPAL -->
    <div class="card reports-main-card shadow-sm border-0">
        <div class="card-header reports-main-header border-0 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="reports-icon-soft">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-semibold text-white">Módulos de Reportes</h5>
                    <small class="text-muted-small">
                        Elige un módulo para filtrar, analizar y descargar información detallada.
                    </small>
                </div>
            </div>
        </div>

        <div class="card-body px-4 pb-4 pt-3">
            <div class="row g-3 g-md-4">
                <!-- Reporte de Ventas -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <a asp-action="Ventas" class="text-decoration-none">
                        <div class="report-card-item ventas h-100">
                            <div class="report-card-icon ventas">
                                <i class="bi bi-receipt"></i>
                            </div>
                            <div class="report-card-content">
                                <h6 class="report-card-title">Reporte de Ventas</h6>
                                <p class="report-card-text">
                                    Analiza ventas por fecha, cliente, método de pago y utilidad generada.
                                </p>
                                <span class="report-card-link btn-chip ventas">
                                    Ver detalle <i class="bi bi-arrow-right-short"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Compras -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <a asp-action="Compras" class="text-decoration-none">
                        <div class="report-card-item compras h-100">
                            <div class="report-card-icon compras">
                                <i class="bi bi-cart4"></i>
                            </div>
                            <div class="report-card-content">
                                <h6 class="report-card-title">Reporte de Compras</h6>
                                <p class="report-card-text">
                                    Consulta compras por proveedor, fechas y totales consolidados.
                                </p>
                                <span class="report-card-link btn-chip compras">
                                    Ver detalle <i class="bi bi-arrow-right-short"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Inventario -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <a asp-action="ReporteInventario" class="text-decoration-none">
                        <div class="report-card-item inventario h-100">
                            <div class="report-card-icon inventario">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="report-card-content">
                                <h6 class="report-card-title">Reporte de Inventario</h6>
                                <p class="report-card-text">
                                    Visualiza existencias, mínimos, valor total y categorización de productos.
                                </p>
                                <span class="report-card-link btn-chip inventario">
                                    Ver detalle <i class="bi bi-arrow-right-short"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Ajustes de Inventario -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <a asp-action="ReporteAjustesInventario" class="text-decoration-none">
                        <div class="report-card-item ajustes h-100">
                            <div class="report-card-icon ajustes">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </div>
                            <div class="report-card-content">
                                <h6 class="report-card-title">Ajustes de Inventario</h6>
                                <p class="report-card-text">
                                    Revisa entradas, salidas y motivos de ajustes manuales del inventario.
                                </p>
                                <span class="report-card-link btn-chip ajustes">
                                    Ver detalle <i class="bi bi-arrow-right-short"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Actividades de Usuarios -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <a asp-action="Actividades" class="text-decoration-none">
                        <div class="report-card-item actividades h-100">
                            <div class="report-card-icon actividades">
                                <i class="bi bi-list-check"></i>
                            </div>
                            <div class="report-card-content">
                                <h6 class="report-card-title">Actividades de Usuarios</h6>
                                <p class="report-card-text">
                                    Consulta el historial de acciones realizadas en el sistema por cada usuario.
                                </p>
                                <span class="report-card-link btn-chip actividades">
                                    Ver detalle <i class="bi bi-arrow-right-short"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            /* Azul (inventario/ventas) + Menta (compras) + puente entre ambos */
            --reports-blue: #1C1973;
            --reports-blue-2: #514BF2;
            --reports-mint: #12C6A1;
            --reports-mint-accent: #5EF2C1;
            --reports-bg: #f5f6fa; /* fondo claro */
            --reports-card: #ffffff;
            --reports-text: #111827;
            --reports-muted: #6b7280;
            --reports-radius: .9rem;
            --reports-border: #e5e7eb;
            /* Colores por módulo */
            --ventas: #4F46E5; /* azul intenso */
            --compras: #12C6A1; /* menta */
            --inventario: #f59e0b; /* dorado/amber */
            --ajustes: #0ea5e9; /* celeste */
            --actividades: #e74c3c; /* rojo */
        }

        .reports-theme {
            background: var(--reports-bg);
            color: var(--reports-text);
        }

        /* Header híbrido azul ↔ menta */
        .reports-header {
            background: linear-gradient(90deg,var(--reports-blue),var(--reports-mint));
            border: 1px solid rgba(255,255,255,.12);
            border-radius: var(--reports-radius);
            padding: 1.1rem 1.4rem;
            box-shadow: 0 6px 18px rgba(15,23,42,.18);
            color: #fff;
        }

        .text-muted-small {
            color: rgba(241,245,249,.9) !important;
            font-size: .86rem;
        }

        .reports-icon-main {
            width: 52px;
            height: 52px;
            border-radius: 999px;
            background: radial-gradient(circle at 20% 0, var(--reports-blue-2), transparent), rgba(0,0,0,.22);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #dbeafe;
        }

        .reports-icon-soft {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: .9rem;
        }

        /* Card principal */
        .reports-main-card {
            background: var(--reports-card);
            border: 1px solid var(--reports-border);
            border-radius: var(--reports-radius);
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            overflow: hidden;
        }

        .reports-main-header {
            padding: 1rem 1.5rem .6rem 1.5rem;
            background: linear-gradient(90deg,var(--reports-blue),var(--reports-mint));
            color: #fff;
        }

        /* Tarjetas módulo (estilo claro, con “cinta” lateral por color) */
        .report-card-item {
            display: flex;
            gap: .9rem;
            padding: 1rem 1rem;
            border-radius: 1rem;
            background: #fff;
            border: 1px solid var(--reports-border);
            box-shadow: 0 2px 10px rgba(15,23,42,.05);
            position: relative;
            transition: .22s;
        }

            .report-card-item::after {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 6px;
                border-radius: 1rem 0 0 1rem;
            }

            .report-card-item:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 20px rgba(15,23,42,.10);
            }

        .report-card-icon {
            width: 46px;
            height: 46px;
            border-radius: .9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
            transition: .22s;
            background: #f3f4ff;
            color: var(--reports-blue-2);
        }

        .report-card-item:hover .report-card-icon {
            transform: translateY(-1px) scale(1.03);
        }

        .report-card-content {
            display: flex;
            flex-direction: column;
            gap: .15rem;
        }

        .report-card-title {
            font-size: .98rem;
            font-weight: 700;
            color: var(--reports-text);
            margin: 0;
        }

        .report-card-text {
            margin: 0;
            font-size: .83rem;
            color: var(--reports-muted);
        }

        /* Botón “Ver detalle” tipo chip y con color del módulo */
        .btn-chip {
            display: inline-flex;
            align-items: center;
            gap: .2rem;
            margin-top: .35rem;
            padding: .35rem .7rem;
            font-size: .78rem;
            border-radius: 999px;
            border: 1px solid transparent;
            transition: .2s;
            user-select: none;
        }

            .btn-chip i {
                font-size: 1rem;
            }

        /* ====== Colores por módulo ====== */
        /* Ventas (azul) */
        .report-card-item.ventas::after {
            background: var(--ventas);
        }

        .report-card-icon.ventas {
            color: #fff;
            background: rgba(79,70,229,.18);
        }

        .btn-chip.ventas {
            color: var(--ventas);
            border-color: var(--ventas);
            background: #fff;
        }

        .report-card-item.ventas:hover .btn-chip.ventas {
            background: var(--ventas);
            color: #fff;
        }

        /* Compras (menta) */
        .report-card-item.compras::after {
            background: var(--compras);
        }

        .report-card-icon.compras {
            color: #035c4f;
            background: rgba(18,198,161,.15);
        }

        .btn-chip.compras {
            color: #035c4f;
            border-color: var(--compras);
            background: #fff;
        }

        .report-card-item.compras:hover .btn-chip.compras {
            background: var(--compras);
            color: #020814;
        }

        /* Inventario (Azul) */
        .report-card-item.inventario::after {
            background: var(--ventas);
        }

        .report-card-icon.inventario {
            color: #fff;
            background: rgba(79,70,229,.18);
        }

        .btn-chip.inventario {
            color: var(--ventas);
            border-color: var(--ventas);
            background: #fff;
        }

        .report-card-item.inventario:hover .btn-chip.inventario {
            background: var(--ventas);
            color: #fff;
        }

        /* Ajustes (menta) */
        .report-card-item.ajustes::after {
            background: var(--compras);
        }

        .report-card-icon.ajustes {
            color: #035c4f;
            background: rgba(18,198,161,.15);
        }

        .btn-chip.ajustes {
            color: #035c4f;
            border-color: var(--compras);
            background: #fff;
        }

        .report-card-item.ajustes:hover .btn-chip.ajustes {
            background: var(--compras);
            color: #020814;
        }

        /* Actividades (Azul) */
        .report-card-item.actividades::after {
            background: var(--ventas);
        }

        .report-card-icon.actividades {
            color: #fff;
            background: rgba(79,70,229,.18);
        }

        .btn-chip.actividades {
            color: var(--ventas);
            border-color: var(--ventas);
            background: #fff;
        }

        .report-card-item.actividades:hover .btn-chip.actividades {
            background: var(--ventas);
            color: #fff;
        }

        /* Botón “Volver al Inicio” */
        .btn-outline-light {
            border-color: rgba(240,240,247,.65);
            color: #fff;
        }

            .btn-outline-light:hover {
                background: #fff;
                color: #0f172a;
            }

        /* Responsivo */
        @@media (max-width:576px) {
            .reports-main-card {
                padding-top: .15rem;
            }

            .report-card-item {
                padding: .9rem .9rem;
            }
        }
    </style>
}
