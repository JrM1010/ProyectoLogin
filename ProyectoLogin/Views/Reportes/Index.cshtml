@{
    ViewData["Title"] = "Reportes del Sistema";
}

<div class="container mt-5">
    <h3 class="mb-4 text-primary"><i class="bi bi-clipboard-data"></i> Reportes del Sistema</h3>

    <div class="list-group shadow-sm">
        <a asp-action="Ventas" class="list-group-item list-group-item-action">
            <i class="bi bi-receipt"></i> Reporte de Ventas
        </a>
    </div>

    <div class="list-group shadow-sm">
        <a asp-action="Compras" class="list-group-item list-group-item-action mt-3">
            <i class="bi bi-cart4"></i> Reporte de Compras
        </a>
    </div>

</div>
