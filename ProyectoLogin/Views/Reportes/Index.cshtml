@{
    ViewData["Title"] = "Reportes";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-clipboard-data"></i> @ViewData["Title"]
            </h4>
        </div>

        <div class="card-body bg-light">
            <p class="text-muted mb-4">
                Selecciona uno de los siguientes módulos de reportes para visualizar o descargar información detallada del sistema.
            </p>

            <div class="row g-4">
                <!-- Reporte de Ventas -->
                <div class="col-md-6 col-lg-4">
                    <a asp-action="Ventas" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 report-card">
                            <div class="card-body text-center py-4">
                                <div class="icon-container bg-primary bg-opacity-10 text-primary mb-3">
                                    <i class="bi bi-receipt fs-1"></i>
                                </div>
                                <h6 class="fw-bold text-primary">Reporte de Ventas</h6>
                                <p class="text-muted small mb-0">Consulta las ventas registradas por fecha y usuario.</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Compras -->
                <div class="col-md-6 col-lg-4">
                    <a asp-action="Compras" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 report-card">
                            <div class="card-body text-center py-4">
                                <div class="icon-container bg-success bg-opacity-10 text-success mb-3">
                                    <i class="bi bi-cart4 fs-1"></i>
                                </div>
                                <h6 class="fw-bold text-success">Reporte de Compras</h6>
                                <p class="text-muted small mb-0">Visualiza las compras por proveedor y período.</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Inventario -->
                <div class="col-md-6 col-lg-4">
                    <a asp-action="ReporteInventario" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 report-card">
                            <div class="card-body text-center py-4">
                                <div class="icon-container bg-warning bg-opacity-10 text-warning mb-3">
                                    <i class="bi bi-box-seam fs-1"></i>
                                </div>
                                <h6 class="fw-bold text-warning">Reporte de Inventario</h6>
                                <p class="text-muted small mb-0">Consulta el stock actual y la categoría de productos.</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Ajustes de Inventario -->
                <div class="col-md-6 col-lg-4">
                    <a asp-action="ReporteAjustesInventario" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 report-card">
                            <div class="card-body text-center py-4">
                                <div class="icon-container bg-info bg-opacity-10 text-info mb-3">
                                    <i class="bi bi-box-arrow-up-right fs-1"></i>
                                </div>
                                <h6 class="fw-bold text-info">Ajustes de Inventario</h6>
                                <p class="text-muted small mb-0">Visualiza los movimientos y ajustes del inventario.</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Reporte de Actividades -->
                <div class="col-md-6 col-lg-4">
                    <a asp-action="Actividades" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 report-card">
                            <div class="card-body text-center py-4">
                                <div class="icon-container bg-danger bg-opacity-10 text-danger mb-3">
                                    <i class="bi bi-list-check fs-1"></i>
                                </div>
                                <h6 class="fw-bold text-danger">Actividades de Usuarios</h6>
                                <p class="text-muted small mb-0">Revisa el historial de acciones realizadas por los usuarios.</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Botón inferior de retorno -->
            <div class="text-center mt-5">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg shadow-sm">
                    <i class="bi bi-arrow-left-circle"></i> Volver al Inicio 
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .report-card {
        border-radius: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
        background-color: #fff;
    }

        .report-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .icon-container {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        background-color: rgba(0, 123, 255, 0.1);
        transition: all 0.3s ease;
    }

    .report-card:hover .icon-container {
        transform: scale(1.1);
    }

    .card-header {
        border-top-left-radius: 1rem !important;
        border-top-right-radius: 1rem !important;
    }

    .card {
        border-radius: 1rem;
    }

    .btn-light {
        color: #0d6efd;
        border: none;
        font-weight: 600;
    }

        .btn-light:hover {
            background-color: #f8f9fa;
            color: #0a58ca;
        }

    .btn-outline-primary {
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: 600;
    }
</style>
