@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Reporte de Ajustes de Inventario";
    var ajustes = Model?.ToList() ?? new List<dynamic>();

    // Para el select de tipo (evitar C# en atributos de <option>)
    var tipoQuery = Context.Request.Query["tipo"].ToString();

    // Métricas rápidas
    var totalRegistros = ajustes.Count;
    var totalEntradas = ajustes.Count(a => (string)a.Tipo == "Entrada" || (string)a.Tipo == "entrada");
    var totalSalidas = ajustes.Count(a => (string)a.Tipo == "Salida" || (string)a.Tipo == "salida");
}

<div class="container-fluid clients-theme">

    <!-- HEADER (estilo compras/menta) -->
    <div class="clients-header">
        <div class="clients-header-title">
            <div class="clients-header-icon">
                <i class="bi bi-box-arrow-up-right"></i>
            </div>
            <div>
                <h2>@ViewData["Title"]</h2>
                <p>Filtra y analiza entradas/salidas con detalle de usuario y motivo</p>
            </div>
        </div>

        <div class="clients-header-actions d-flex gap-2">
            <a asp-action="Index" class="btn btn-clients-outline">
                <i class="bi bi-arrow-left"></i> Volver a Reportes
            </a>
        </div>
    </div>

    <!-- TARJETA DE FILTROS (estética compras) -->
    <div class="clients-search-card">
        <form method="get" class="row g-3 align-items-end" id="filtroForm">
            <div class="col-md-3">
                <label class="clients-search-label fw-semibold">
                    <i class="bi bi-calendar-date me-1"></i>Desde
                </label>
                <input type="date" name="desde" class="clients-search-input" value="@Context.Request.Query["desde"]" />
            </div>

            <div class="col-md-3">
                <label class="clients-search-label fw-semibold">
                    <i class="bi bi-calendar-date me-1"></i>Hasta
                </label>
                <input type="date" name="hasta" class="clients-search-input" value="@Context.Request.Query["hasta"]" />
            </div>

            <div class="col-md-3">
                <label class="clients-search-label fw-semibold">
                    <i class="bi bi-person me-1"></i>Usuario
                </label>
                <input type="text" name="nombreUsuario" class="clients-search-input" placeholder="Nombre del usuario" value="@Context.Request.Query["nombreUsuario"]" />
            </div>

            <div class="col-md-3">
                <label class="clients-search-label fw-semibold">
                    <i class="bi bi-arrow-left-right me-1"></i>Tipo de Ajuste
                </label>
                <select name="tipo" class="clients-search-input">
                    @if (string.IsNullOrEmpty(tipoQuery))
                    {
                        <option value="" selected>Todos</option>
                    }
                    else
                    {
                        <option value="">Todos</option>
                    }

                    @if (tipoQuery == "entrada")
                    {
                        <option value="entrada" selected>Entrada</option>
                    }
                    else
                    {
                        <option value="entrada">Entrada</option>
                    }

                    @if (tipoQuery == "salida")
                    {
                        <option value="salida" selected>Salida</option>
                    }
                    else
                    {
                        <option value="salida">Salida</option>
                    }
                </select>
            </div>

            <!-- BOTONES -->
            <div class="col-12">
                <div class="d-flex flex-wrap gap-2 justify-content-end" style="border-top:1px solid var(--clients-border-soft); padding-top:.8rem;">
                    <button type="submit" class="btn btn-clients-search d-inline-flex align-items-center gap-2">
                        <i class="bi bi-search"></i> Filtrar
                    </button>

                    <!-- Mantengo el anchor para no cambiar funcionalidad -->
                    <a asp-action="ReporteAjustesInventario" asp-route-pdf="true"
                       class="btn btn-clients-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                    </a>

                    <button type="button" id="btnLimpiar"
                            class="btn btn-clients-outline d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (ajustes.Any())
    {
        <!-- ESTADÍSTICAS RÁPIDAS (estilo compras/menta) -->
        <div class="row g-3 mb-3">
            <div class="col-xl-4 col-md-6">
                <div class="clients-card statcard-mint border-left-info">
                    <div>
                        <div class="stat-label">Ajustes encontrados</div>
                        <div class="stat-value">@totalRegistros</div>
                    </div>
                    <i class="bi bi-receipt stat-icon-mint"></i>
                </div>
            </div>
            <div class="col-xl-4 col-md-6">
                <div class="clients-card statcard-mint border-left-success">
                    <div>
                        <div class="stat-label">Entradas</div>
                        <div class="stat-value">@totalEntradas</div>
                    </div>
                    <i class="bi bi-arrow-down-circle stat-icon-mint"></i>
                </div>
            </div>
            <div class="col-xl-4 col-md-6">
                <div class="clients-card statcard-mint border-left-mint">
                    <div>
                        <div class="stat-label">Salidas</div>
                        <div class="stat-value">@totalSalidas</div>
                    </div>
                    <i class="bi bi-arrow-up-circle stat-icon-mint"></i>
                </div>
            </div>
        </div>

        <!-- TABLA (estética compras) -->
        <div class="clients-card">
            <div class="clients-card-header">
                <i class="bi bi-table fs-5"></i>
                <h5>Resultados</h5>
            </div>
            <div class="card-body p-0">
                <div class="clients-table-wrap">
                    <table class="clients-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th class="text-start">Producto</th>
                                <th class="text-start">Usuario</th>
                                <th class="text-end">Cantidad</th>
                                <th>Tipo</th>
                                <th class="text-start">Motivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ajustes)
                            {
                                bool esEntrada = string.Equals((string)item.Tipo, "Entrada", System.StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td>
                                        <small class="client-email">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td class="text-start">
                                        <div class="client-name">
                                            <i class="bi bi-box-seam"></i>
                                            <span>@item.Producto</span>
                                        </div>
                                    </td>
                                    <td class="text-start client-email">
                                        @(string.IsNullOrWhiteSpace((string)item.Usuario) ? "-" : item.Usuario)
                                    </td>
                                    <td class="text-end">@item.Cantidad</td>
                                    <td class="@(esEntrada ? "text-success fw-bold" : "text-danger fw-bold")">
                                        @item.Tipo
                                    </td>
                                    <td class="text-start client-email">@item.Motivo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- VACÍO (estilo compras) -->
        <div class="clients-card text-center p-5">
            <div class="clients-header-icon" style="margin:0 auto 10px;">
                <i class="bi bi-search"></i>
            </div>
            <h4 class="mb-2" style="color:var(--clients-text);">No se encontraron ajustes</h4>
            <p class="client-email mb-3">No hay registros que coincidan con los filtros aplicados.</p>
            <button type="button" id="btnLimpiarVacio" class="btn btn-clients-search d-inline-flex align-items-center gap-2">
                <i class="bi bi-eraser"></i> Limpiar Filtros
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            function limpiar() {
                document.querySelector('input[name="desde"]').value = '';
                document.querySelector('input[name="hasta"]').value = '';
                document.querySelector('input[name="nombreUsuario"]').value = '';
                document.querySelector('select[name="tipo"]').value = '';
                document.getElementById('filtroForm').submit();
            }

            document.addEventListener('DOMContentLoaded', function () {
                const btn = document.getElementById('btnLimpiar');
                if (btn) btn.addEventListener('click', limpiar);

                const btnVacio = document.getElementById('btnLimpiarVacio');
                if (btnVacio) btnVacio.addEventListener('click', limpiar);

                // Validación de fechas rápida (sin cambios)
                const desde = document.querySelector('input[name="desde"]');
                const hasta = document.querySelector('input[name="hasta"]');
                const form  = document.getElementById('filtroForm');
                if (form && desde && hasta) {
                    form.addEventListener('submit', function (e) {
                        if (desde.value && hasta.value && new Date(desde.value) > new Date(hasta.value)) {
                            e.preventDefault();
                            alert('La fecha "Desde" no puede ser mayor que la fecha "Hasta".');
                        }
                    });
                }
            });
        })();
    </script>
}

@section styles {
    <style>
        :root {
            /* Paleta “usuarios/menta” (igual a Reporte de Compras) */
            --clients-primary: #062926; /* menta oscuro */
            --clients-secondary: #12C6A1; /* menta vibrante */
            --clients-accent: #5EF2C1; /* acento brillante */
            --clients-bg: #f5f6fa; /* fondo claro */
            --clients-card: #ffffff;
            --clients-text: #111827;
            --clients-muted: #6b7280;
            --clients-radius: .75rem;
            --clients-border-soft: #e5e7eb;
            --clients-danger: #dc2626;
            --clients-success: #16a34a;
        }

        /* CONTENEDOR GENERAL */
        .clients-theme {
            background: var(--clients-bg);
            padding: 1.5rem 0 2rem;
        }

        /* HEADER */
        .clients-header {
            background: linear-gradient(90deg,var(--clients-primary),var(--clients-secondary));
            border-radius: var(--clients-radius);
            border: 1px solid rgba(255,255,255,.16);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1rem;
            box-shadow: 0 6px 18px rgba(15,23,42,.18);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #fff;
        }

        .clients-header-title {
            display: flex;
            align-items: center;
            gap: .7rem;
        }

        .clients-header-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(0,0,0,.22);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: var(--clients-accent);
        }

        .clients-header h2 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: .02em;
            color: #fff;
        }

        .clients-header p {
            margin: .1rem 0 0;
            font-size: .85rem;
            color: rgba(241,245,249,.9);
        }

        .clients-header-actions .btn {
            font-size: .86rem;
            border-radius: var(--clients-radius);
            padding: .5rem 1rem;
        }

        /* Botones base */
        .btn-clients-outline {
            border: 1px solid var(--clients-accent);
            background: transparent;
            color: #fff; /* pensado para header oscuro */
            border-radius: var(--clients-radius);
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: all .25s ease;
            text-decoration: none;
        }

            .btn-clients-outline:hover {
                background: rgba(94,242,193,.16);
                color: #fff;
                box-shadow: 0 4px 10px rgba(15,23,42,.25);
                transform: translateY(-1px);
            }

        .btn-clients-primary {
            background: #fff;
            color: var(--clients-primary);
            border: 1px solid var(--clients-border-soft);
            border-radius: var(--clients-radius);
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: all .25s ease;
            text-decoration: none;
            padding: .6rem 1.3rem;
            font-size: .85rem;
        }

            .btn-clients-primary:hover {
                background: #f9fafb;
                color: var(--clients-secondary);
                box-shadow: 0 4px 12px rgba(15,23,42,.25);
                transform: translateY(-1px);
            }

        .btn-clients-search {
            border-radius: var(--clients-radius);
            padding: .6rem 1.3rem;
            font-size: .85rem;
            background: var(--clients-secondary);
            border: 1px solid var(--clients-secondary);
            color: #020814;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: all .25s ease;
        }

            .btn-clients-search:hover {
                background: var(--clients-primary);
                border-color: var(--clients-primary);
                color: #fff;
                box-shadow: 0 4px 10px rgba(15,23,42,.18);
                transform: translateY(-1px);
            }

        /* === Overrides de visibilidad dentro de la tarjeta de filtros (arregla "Limpiar Filtros") === */
        .clients-search-card .btn-clients-outline {
            background: #fff !important; /* fondo claro */
            color: var(--clients-primary) !important; /* texto oscuro y legible */
            border-color: var(--clients-secondary) !important;
        }

            .clients-search-card .btn-clients-outline:hover {
                background: var(--clients-secondary) !important;
                color: #020814 !important;
                box-shadow: 0 4px 10px rgba(15,23,42,.16);
                transform: translateY(-1px);
            }

        /* BUSCADOR */
        .clients-search-card {
            background: var(--clients-card);
            border: 1px solid var(--clients-border-soft);
            border-radius: var(--clients-radius);
            padding: .9rem 1.1rem;
            margin-bottom: 1.1rem;
            box-shadow: 0 2px 8px rgba(15,23,42,.04);
        }

        .clients-search-label {
            font-size: .82rem;
            color: var(--clients-muted);
            margin-bottom: .15rem;
        }

        .clients-search-input {
            background: #fff;
            border-radius: var(--clients-radius);
            border: 1px solid var(--clients-border-soft);
            color: var(--clients-text);
            padding: .6rem .85rem;
            min-width: 220px;
            font-size: .88rem;
            transition: all .22s ease;
            width: 100%;
        }

            .clients-search-input::placeholder {
                color: #9ca3af;
            }

            .clients-search-input:focus {
                outline: none;
                border-color: var(--clients-secondary);
                box-shadow: 0 0 0 .16rem rgba(18,198,161,.18);
                background: #fff;
            }

        /* TARJETAS / TABLAS */
        .clients-card {
            background: var(--clients-card);
            border: 1px solid var(--clients-border-soft);
            border-radius: var(--clients-radius);
            overflow: hidden;
            margin-bottom: 1.1rem;
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            transition: all .22s ease;
        }

            .clients-card:hover {
                box-shadow: 0 7px 20px rgba(15,23,42,.10);
                transform: translateY(-1px);
            }

        .clients-card-header {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .85rem 1.15rem;
            border-bottom: 1px solid rgba(15,23,42,.06);
            color: #fff;
            background: linear-gradient(90deg,var(--clients-primary),var(--clients-secondary));
        }

            .clients-card-header h5 {
                margin: 0;
                font-size: .98rem;
                font-weight: 700;
                color: #fff;
            }

            .clients-card-header i {
                font-size: 1.2rem;
                color: #bbf7d0;
            }

        .clients-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .clients-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
            font-size: .85rem;
            color: var(--clients-text);
            background: transparent;
        }

            .clients-table thead th {
                background: #e5f9f3;
                font-weight: 600;
                font-size: .78rem;
                border-bottom: 1px solid var(--clients-border-soft);
                white-space: nowrap;
                text-transform: uppercase;
                letter-spacing: .03em;
                color: var(--clients-muted);
                padding: .7rem .9rem;
            }

            .clients-table tbody td {
                padding: .7rem .9rem;
                border-bottom: 1px solid var(--clients-border-soft);
                vertical-align: middle;
                color: var(--clients-text);
            }

            .clients-table tbody tr:nth-child(even) {
                background: #f9fafb;
            }

            .clients-table tbody tr:hover {
                background: #ecfdf5;
            }

        .client-name {
            display: flex;
            align-items: center;
            gap: .35rem;
            font-weight: 600;
            color: var(--clients-text);
        }

            .client-name i {
                color: var(--clients-secondary);
            }

        .client-email {
            color: var(--clients-muted);
            font-size: .8rem;
        }

        /* Stats mint */
        .statcard-mint {
            border-radius: .8rem;
            padding: .9rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
        }

        .stat-label {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--clients-muted);
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--clients-text);
        }

        .stat-icon-mint {
            font-size: 1.5rem;
            color: var(--clients-secondary);
        }

        .border-left-mint {
            border-left: 3px solid var(--clients-secondary);
            background: #fff;
            border: 1px solid var(--clients-border-soft);
        }

        .border-left-info {
            border-left: 3px solid #0ea5e9;
            background: #fff;
            border: 1px solid var(--clients-border-soft);
        }

        .border-left-success {
            border-left: 3px solid #22c55e;
            background: #fff;
            border: 1px solid var(--clients-border-soft);
        }

        /* Responsive */
        @@media (max-width:768px) {
            .clients-header {
                flex-direction: column;
                align-items: flex-start;
                padding: .9rem 1rem;
            }

                .clients-header h2 {
                    font-size: 1.1rem;
                }

                .clients-header p {
                    font-size: .8rem;
                }

            .clients-header-actions {
                width: 100%;
                display: flex;
                flex-wrap: wrap;
                gap: .45rem;
            }

                .clients-header-actions .btn {
                    flex: 1 1 auto;
                    justify-content: center;
                }

            .clients-search-card {
                padding: .8rem .9rem;
            }

            .clients-search-input {
                min-width: 0;
            }
        }
    </style>
}
