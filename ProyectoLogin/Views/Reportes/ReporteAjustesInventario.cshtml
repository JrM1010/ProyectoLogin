@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Reporte de Ajustes de Inventario";
    var ajustes = Model?.ToList() ?? new List<dynamic>();

    // Para el select de tipo (evitar C# en atributos de <option>)
    var tipoQuery = Context.Request.Query["tipo"].ToString();

    // Métricas rápidas
    var totalRegistros = ajustes.Count;
    var totalEntradas = ajustes.Count(a => (string)a.Tipo == "Entrada" || (string)a.Tipo == "entrada");
    var totalSalidas = ajustes.Count(a => (string)a.Tipo == "Salida" || (string)a.Tipo == "salida");
}

<div class="container-fluid py-4 ajustes-inventario-page">
    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-wrapper-main me-3">
                <i class="bi bi-box-arrow-up-right fs-3"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 fw-bold text-white">Reporte de Ajustes de Inventario</h1>
                <p class="mb-0 text-muted-small">Filtra y analiza entradas/salidas con detalle de usuario y motivo.</p>
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left-circle"></i>
            Volver a Reportes
        </a>
    </div>

    <div class="card main-card shadow-sm border-0">
        <div class="card-header d-flex align-items-center gap-2 border-0">
            <div class="icon-wrapper-soft">
                <i class="bi bi-funnel fs-6"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-semibold text-white">Filtros</h5>
                <small class="text-muted-small">Rango de fechas, usuario y tipo de ajuste.</small>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- FORMULARIO DE FILTROS -->
            <form method="get" class="row g-3 mb-4 align-items-end" id="filtroForm">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label"><i class="bi bi-calendar-date me-1"></i>Desde</label>
                    <input type="date" name="desde" class="form-control input-dark" value="@Context.Request.Query["desde"]" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label"><i class="bi bi-calendar-date me-1"></i>Hasta</label>
                    <input type="date" name="hasta" class="form-control input-dark" value="@Context.Request.Query["hasta"]" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label"><i class="bi bi-person me-1"></i>Usuario</label>
                    <input type="text" name="nombreUsuario" class="form-control input-dark" placeholder="Nombre del usuario" value="@Context.Request.Query["nombreUsuario"]" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label"><i class="bi bi-arrow-left-right me-1"></i>Tipo de Ajuste</label>
                    <select name="tipo" class="form-select input-dark">
                        @if (string.IsNullOrEmpty(tipoQuery))
                        {
                            <option value="" selected>Todos</option>
                        }
                        else
                        {
                            <option value="">Todos</option>
                        }

                        @if (tipoQuery == "entrada")
                        {
                            <option value="entrada" selected>Entrada</option>
                        }
                        else
                        {
                            <option value="entrada">Entrada</option>
                        }

                        @if (tipoQuery == "salida")
                        {
                            <option value="salida" selected>Salida</option>
                        }
                        else
                        {
                            <option value="salida">Salida</option>
                        }
                    </select>
                </div>

                <!-- BOTONES -->
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2 justify-content-end border-top border-soft pt-3">
                        <button type="submit" class="btn btn-primary-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-search"></i> Filtrar
                        </button>

                        <a asp-action="ReporteAjustesInventario" asp-route-pdf="true"
                           class="btn btn-success-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                        </a>

                        <button type="button" id="btnLimpiar"
                                class="btn btn-outline-warning-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-eraser"></i> Limpiar Filtros
                        </button>
                    </div>
                </div>
            </form>

            @if (ajustes.Any())
            {
                <!-- ESTADÍSTICAS RÁPIDAS -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-info-soft">
                            <div>
                                <div class="stat-label">Ajustes encontrados</div>
                                <div class="stat-value">@totalRegistros</div>
                            </div>
                            <i class="bi bi-receipt stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-success-soft">
                            <div>
                                <div class="stat-label">Entradas</div>
                                <div class="stat-value">@totalEntradas</div>
                            </div>
                            <i class="bi bi-arrow-down-circle stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-warning-soft">
                            <div>
                                <div class="stat-label">Salidas</div>
                                <div class="stat-value">@totalSalidas</div>
                            </div>
                            <i class="bi bi-arrow-up-circle stat-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- TABLA -->
                <div class="card table-card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 pb-2">
                        <i class="bi bi-table text-accent"></i>
                        <h6 class="mb-0 fw-semibold text-white">Resultados</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 report-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th class="text-start">Producto</th>
                                        <th class="text-start">Usuario</th>
                                        <th class="text-end">Cantidad</th>
                                        <th>Tipo</th>
                                        <th class="text-start">Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ajustes)
                                    {
                                        bool esEntrada = string.Equals((string)item.Tipo, "Entrada", System.StringComparison.OrdinalIgnoreCase);
                                        <tr>
                                            <td>
                                                <small class="text-muted-small">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td class="text-start text-light fw-semibold">@item.Producto</td>
                                            <td class="text-start text-muted-small">
                                                @(string.IsNullOrWhiteSpace((string)item.Usuario) ? "-" : item.Usuario)
                                            </td>
                                            <td class="text-end">@item.Cantidad</td>
                                            <td class="@(esEntrada ? "text-success fw-bold" : "text-danger fw-bold")">
                                                @item.Tipo
                                            </td>
                                            <td class="text-start text-muted-small">@item.Motivo</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card main-card-empty border-0 shadow-sm text-center py-5 mt-2">
                    <div class="icon-empty mb-3">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <h4 class="text-white mb-2">No se encontraron ajustes</h4>
                    <p class="text-muted-small mb-4">
                        No hay registros que coincidan con los filtros aplicados.
                    </p>
                    <button type="button" id="btnLimpiarVacio"
                            class="btn btn-primary-custom rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i> Limpiar Filtros
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function limpiar() {
                document.querySelector('input[name="desde"]').value = '';
                document.querySelector('input[name="hasta"]').value = '';
                document.querySelector('input[name="nombreUsuario"]').value = '';
                document.querySelector('select[name="tipo"]').value = '';
                document.getElementById('filtroForm').submit();
            }

            document.addEventListener('DOMContentLoaded', function () {
                const btn = document.getElementById('btnLimpiar');
                if (btn) btn.addEventListener('click', limpiar);

                const btnVacio = document.getElementById('btnLimpiarVacio');
                if (btnVacio) btnVacio.addEventListener('click', limpiar);

                // Validación de fechas rápida
                const desde = document.querySelector('input[name="desde"]');
                const hasta = document.querySelector('input[name="hasta"]');
                const form  = document.getElementById('filtroForm');
                if (form && desde && hasta) {
                    form.addEventListener('submit', function (e) {
                        if (desde.value && hasta.value && new Date(desde.value) > new Date(hasta.value)) {
                            e.preventDefault();
                            alert('La fecha "Desde" no puede ser mayor que la fecha "Hasta".');
                        }
                    });
                }
            });
        })();
    </script>
}

@section styles{
    <style>
        :root {
            --primary-blue: #1C1973;
            --secondary-blue: #514BF2;
            --accent-blue: #8B88F2;
            --dark-bg: #0D0E26;
            --alt-bg: #081C59;
            --light-text: #F0F0F7;
            --muted-text: #9ba4c4;
            --border-soft: rgba(139, 136, 242, 0.22);
            --card-bg: #0F122F;
            --card-bg-soft: #151838;
        }

        .ajustes-inventario-page {
            color: var(--light-text);
        }

        .icon-wrapper-main {
            width: 52px;
            height: 52px;
            border-radius: 999px;
            background: radial-gradient(circle at 20% 0, var(--secondary-blue), transparent), rgba(12, 18, 58, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.55);
        }

        .icon-wrapper-soft {
            width: 32px;
            height: 32px;
            border-radius: 999px;
            background: rgba(81, 75, 242, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
        }

        .main-card, .main-card-empty {
            background: linear-gradient(145deg, #0D0E26, #111433);
            border-radius: 1rem;
            border: 1px solid var(--border-soft);
        }

        .border-soft {
            border-color: var(--border-soft) !important;
        }

        .text-label {
            color: var(--muted-text);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .text-muted-small {
            color: var(--muted-text) !important;
            font-size: 0.85rem;
        }

        .text-accent {
            color: var(--accent-blue) !important;
        }

        .input-dark, .input-dark:focus, .input-dark:active {
            background-color: #080a1c;
            border: 1px solid rgba(139, 136, 242, 0.32);
            color: var(--light-text);
            box-shadow: none;
        }

            .input-dark::placeholder {
                color: rgba(155,164,196,0.7);
            }

        .btn-primary-custom {
            background: var(--secondary-blue);
            border-color: var(--secondary-blue);
            color: #fff;
        }

            .btn-primary-custom:hover {
                background: #3c36cc;
                border-color: #3c36cc;
            }

        .btn-success-custom {
            background: #27ae60;
            border-color: #27ae60;
            color: #fff;
        }

            .btn-success-custom:hover {
                background: #1f8a4d;
                border-color: #1f8a4d;
            }

        .btn-outline-warning-custom {
            border-color: #f1c40f;
            color: #f1c40f;
        }

            .btn-outline-warning-custom:hover {
                background-color: #f1c40f;
                color: #111433;
            }

        .table-card {
            background-color: var(--card-bg);
            border-radius: 0.9rem;
            border: 1px solid rgba(139,136,242,0.18);
        }

        .report-table thead tr {
            background: rgba(8,12,40,0.98);
        }

        .report-table thead th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted-text);
            border-bottom-color: rgba(139,136,242,0.35);
        }

        .report-table tbody tr {
            transition: all 0.15s ease-in-out;
        }

            .report-table tbody tr:hover {
                background: radial-gradient(circle at 0 0, rgba(81,75,242,0.14), transparent);
                transform: translateY(-1px);
            }

        .stat-card {
            background: var(--card-bg);
            border-radius: 0.8rem;
            padding: 0.9rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border: 1px solid rgba(139,136,242,0.18);
        }

        .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--muted-text);
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--light-text);
        }

        .stat-icon {
            font-size: 1.5rem;
            color: var(--accent-blue);
        }

        .border-left-success-soft {
            border-left: 3px solid #27ae60;
        }

        .border-left-warning-soft {
            border-left: 3px solid #f1c40f;
        }

        .border-left-info-soft {
            border-left: 3px solid #3498db;
        }

        .icon-empty {
            width: 90px;
            height: 90px;
            border-radius: 999px;
            background: radial-gradient(circle at 30% 0, var(--accent-blue), transparent), rgba(8, 12, 40, 0.96);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--muted-text);
            font-size: 2.2rem;
            margin: 0 auto;
        }
    </style>
}
