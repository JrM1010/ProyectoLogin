@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="container-fluid py-2 inventory-theme reportes-ventas-page">
    <!-- HEADER tipo productos -->
    <div class="page-header">
        <div>
            <h1>
                <i class="bi bi-graph-up-arrow"></i>
                Reporte de Ventas
            </h1>
            <div class="subtitle">Analiza y filtra los resultados de ventas de SmartCell</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-create-outline">
                <i class="bi bi-arrow-left me-1"></i> Volver a Reportes
            </a>
        </div>
    </div>

    <!-- TOAST PARA NOTIFICACIONES (sin cambios funcionales) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="toastNotificacion" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <!-- CARD FILTROS + RESULTADOS (estética productos) -->
    <div class="inventory-card">
        <div class="card-head">
            <i class="bi bi-receipt fs-5"></i>
            <h3 class="title">Filtros y resultados de ventas</h3>
        </div>

        <div class="p-3 p-md-4">

            <!-- FORMULARIO DE FILTROS (en una search-card clara) -->
            <div class="search-card">
                <form method="get" class="row g-3 align-items-end" id="filtroForm">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold inv-search-label">
                            <i class="bi bi-calendar-date me-1"></i>Desde
                        </label>
                        <input type="date" name="desde" class="form-control" value="@Context.Request.Query["desde"]" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold inv-search-label">
                            <i class="bi bi-calendar-date me-1"></i>Hasta
                        </label>
                        <input type="date" name="hasta" class="form-control" value="@Context.Request.Query["hasta"]" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold inv-search-label">
                            <i class="bi bi-person-badge me-1"></i>Vendedor
                        </label>
                        <input type="text" name="vendedor" class="form-control" placeholder="Nombre vendedor" value="@Context.Request.Query["vendedor"]" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold inv-search-label">
                            <i class="bi bi-credit-card me-1"></i>Forma de pago
                        </label>
                        <select name="formaPago" class="form-select">
                        @{
                            var formaPago = Context.Request.Query["formaPago"].ToString();
                        }

                        @* Todas *@
                        @if (string.IsNullOrEmpty(formaPago))
                        {
                            <option value="" selected>Todas</option>
                        }
                        else
                        {
                            <option value="">Todas</option>
                        }

                        @* Efectivo *@
                        @if (formaPago == "Efectivo")
                        {
                            <option value="Efectivo" selected>Efectivo</option>
                        }
                        else
                        {
                            <option value="Efectivo">Efectivo</option>
                        }

                        @* Tarjeta *@
                        @if (formaPago == "Tarjeta")
                        {
                            <option value="Tarjeta" selected>Tarjeta</option>
                        }
                        else
                        {
                            <option value="Tarjeta">Tarjeta</option>
                        }

                        @* Transferencia *@
                        @if (formaPago == "Transferencia")
                        {
                            <option value="Transferencia" selected>Transferencia</option>
                        }
                        else
                        {
                            <option value="Transferencia">Transferencia</option>
                        }

                        @* Mixto *@
                        @if (formaPago == "Mixto")
                        {
                            <option value="Mixto" selected>Mixto</option>
                        }
                        else
                        {
                            <option value="Mixto">Mixto</option>
                        }
                        </select>
                    </div>

                    <!-- BOTONES -->
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-2 justify-content-end border-top pt-3" style="border-color:#e5e7eb!important">
                            <button type="submit" class="btn btn-create-primary d-inline-flex align-items-center gap-2">
                                <i class="bi bi-search"></i> Filtrar
                            </button>

                            <a href="@Url.Action("DescargarPDF", new {
                                    desde = Context.Request.Query["desde"],
                                    hasta = Context.Request.Query["hasta"],
                                    vendedor = Context.Request.Query["vendedor"],
                                    formaPago = Context.Request.Query["formaPago"]
                                })"
                               class="btn btn-create-outline d-inline-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                            </a>

                            <button type="button" id="btnLimpiar" class="btn btn-create-outline d-inline-flex align-items-center gap-2">
                                <i class="bi bi-eraser"></i> Limpiar filtros
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- RESULTADOS -->
            @if (Model != null && Model.Any())
            {
                <!-- ESTADÍSTICAS RÁPIDAS (claras) -->
                <div class="row g-3 mb-3">
                    <div class="col-xl-3 col-md-6">
                        <div class="statcard-light border-left-primary-soft">
                            <div>
                                <div class="stat-label">Total ventas</div>
                                <div class="stat-value">Q @ViewBag.TotalGeneral.ToString("N2")</div>
                            </div>
                            <i class="bi bi-currency-dollar stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="statcard-light border-left-success-soft">
                            <div>
                                <div class="stat-label">Utilidad total</div>
                                <div class="stat-value">Q @ViewBag.UtilidadGeneral.ToString("N2")</div>
                            </div>
                            <i class="bi bi-graph-up stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="statcard-light border-left-info-soft">
                            <div>
                                <div class="stat-label">Ventas encontradas</div>
                                <div class="stat-value">@Model.Count()</div>
                            </div>
                            <i class="bi bi-receipt stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="statcard-light border-left-warning-soft">
                            <div>
                                <div class="stat-label">% promedio utilidad</div>
                                <div class="stat-value">@ViewBag.MargenPromedioGeneral.ToString("N2")%</div>
                            </div>
                            <i class="bi bi-percent stat-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- TABLA DE RESULTADOS (clara, estilo productos) -->
                <div class="inventory-card">
                    <div class="card-head">
                        <i class="bi bi-table fs-5"></i>
                        <h3 class="title">Resultados de ventas</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 report-table">
                            <thead>
                                <tr>
                                    <th class="ps-4">Fecha</th>
                                    <th>No. Factura</th>
                                    <th>Cliente</th>
                                    <th>NIT</th>
                                    <th>Vendedor</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">IVA</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center">Forma de pago</th>
                                    <th class="text-end">Utilidad</th>
                                    <th class="text-end">% Ganancia</th>
                                    <th class="text-center" style="width: 120px;">Detalles</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <small class="text-muted">@v.Fecha.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td><span class="fw-bold text-primary">@v.NoFactura</span></td>
                                        <td>@v.Cliente</td>
                                        <td>
                                            <span class="badge bg-soft text-dark">@v.Nit</span>
                                        </td>
                                        <td><span class="fw-medium">@v.Vendedor</span></td>
                                        <td class="text-end text-muted">Q @v.TotalSinIva.ToString("N2")</td>
                                        <td class="text-end text-warning">Q @v.ValorIva.ToString("N2")</td>
                                        <td class="text-end text-success fw-bold">Q @v.TotalConIva.ToString("N2")</td>
                                        <td class="text-center">
                                            @{
                                                var badgeClass = v.FormaPago switch
                                                {
                                                    "Efectivo" => "bg-success",
                                                    "Tarjeta" => "bg-info",
                                                    "Transferencia" => "bg-primary",
                                                    "Mixto" => "bg-warning text-dark",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge rounded-pill @badgeClass">@v.FormaPago</span>
                                        </td>
                                        <td class="text-end text-primary fw-bold">Q @v.UtilidadTotal.ToString("N2")</td>
                                        <td class="text-end">
                                            <span class="fw-bold @(v.MargenPorcentual >= 25 ? "text-success" : v.MargenPorcentual >= 10 ? "text-warning" : "text-danger")">
                                                @v.MargenPorcentual.ToString("N2")%
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-info action-btn"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#detalles-@v.IdVenta"
                                                    aria-expanded="false"
                                                    aria-controls="detalles-@v.IdVenta"
                                                    title="Detalles">
                                                <i class="bi bi-list-ul"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- DETALLES EXPANDIBLES -->
                                    <tr class="fila-detalle">
                                        <td colspan="12" class="p-0 border-0">
                                            <div class="collapse" id="detalles-@v.IdVenta">
                                                <div class="p-3">
                                                    <div class="inventory-card detalle-card">
                                                        <div class="table-responsive">
                                                            @if (v.Detalles != null && v.Detalles.Count > 0)
                                                            {
                                                                <table class="table table-sm align-middle mb-0">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Producto/Kit</th>
                                                                            <th class="text-center">Cantidad</th>
                                                                            <th class="text-end">Precio unitario</th>
                                                                            <th class="text-end">Precio sin IVA</th>
                                                                            <th class="text-end">IVA</th>
                                                                            <th class="text-end">Subtotal</th>
                                                                            <th class="text-end">Utilidad</th>
                                                                            <th class="text-end">% Utilidad</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var detalle in v.Detalles)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    <div class="d-flex align-items-center gap-2">
                                                                                        @if (detalle.EsKit)
                                                                                        {
                                                                                            <span class="badge text-bg-warning text-dark rounded-pill">KIT</span>
                                                                                        }
                                                                                        <span class="fw-medium">@detalle.NombreProducto</span>
                                                                                    </div>
                                                                                </td>
                                                                                <td class="text-center">
                                                                                    <span class="badge text-bg-primary">@detalle.Cantidad</span>
                                                                                </td>
                                                                                <td class="text-end text-muted">Q @detalle.PrecioUnitario.ToString("N2")</td>
                                                                                <td class="text-end text-muted">Q @detalle.PrecioSinIva.ToString("N2")</td>
                                                                                <td class="text-end text-warning">Q @detalle.Iva.ToString("N2")</td>
                                                                                <td class="text-end fw-semibold">Q @detalle.Subtotal.ToString("N2")</td>
                                                                                <td class="text-end text-success fw-bold">Q @detalle.Utilidad.ToString("N2")</td>
                                                                                <td class="text-end">
                                                                                    <span class="fw-bold @(detalle.MargenPorcentual >= 25 ? "text-success" : detalle.MargenPorcentual >= 10 ? "text-warning" : "text-danger")">
                                                                                        @detalle.MargenPorcentual.ToString("N2")%
                                                                                    </span>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            }
                                                            else
                                                            {
                                                                <div class="p-3">
                                                                    <div class="alert alert-warning-soft text-center mb-0">
                                                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                                                        No se encontraron detalles para esta venta.
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- RESUMEN FINAL (chips estilo inventario) -->
                <div class="row mt-3 g-3">
                    <div class="col-md-6">
                        <div class="resumen-chip resumen-success">
                            <i class="bi bi-currency-dollar me-2"></i>
                            <span>Total General:</span>
                            <strong>Q @ViewBag.TotalGeneral.ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="resumen-chip resumen-primary">
                            <i class="bi bi-graph-up me-2"></i>
                            <span>Utilidad Total:</span>
                            <strong>Q @ViewBag.UtilidadGeneral.ToString("N2")</strong>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="inventory-card text-center py-5">
                    <div class="p-3">
                        <i class="bi bi-search" style="font-size:2rem;color:#6b7280"></i>
                    </div>
                    <h4 class="mb-2">No se encontraron ventas</h4>
                    <p class="text-muted mb-4">Ajusta los parámetros e intenta nuevamente.</p>
                    <button type="button" id="btnLimpiarVacio" class="btn btn-create-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i> Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                const config = {
                    success: { bg: 'bg-success', icon: 'bi-check-circle' },
                    warning: { bg: 'bg-warning', icon: 'bi-exclamation-triangle' },
                    danger: { bg: 'bg-danger', icon: 'bi-x-circle' },
                    info: { bg: 'bg-info', icon: 'bi-info-circle' }
                };

                const { bg, icon } = config[tipo] || config.success;

                toast.className = `toast align-items-center text-white ${bg} border-0`;
                toastIcon.className = `bi ${icon} me-2`;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            function limpiarFiltros() {
                document.querySelectorAll('input[name="desde"], input[name="hasta"], input[name="vendedor"]').forEach(input => {
                    input.value = '';
                });

                const formaSelect = document.querySelector('select[name="formaPago"]');
                if (formaSelect) formaSelect.value = '';

                mostrarToast('Filtros limpiados correctamente', 'info');

                setTimeout(() => {
                    document.getElementById('filtroForm').submit();
                }, 600);
            }

            function inicializar() {
                const btnLimpiar = document.getElementById('btnLimpiar');
                if (btnLimpiar) btnLimpiar.addEventListener('click', limpiarFiltros);

                const btnLimpiarVacio = document.getElementById('btnLimpiarVacio');
                if (btnLimpiarVacio) btnLimpiarVacio.addEventListener('click', limpiarFiltros);

                // Toggle icono/estado botón acción "Detalles" (se mantiene la lógica de collapse)
                document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
                    button.addEventListener('click', function () {
                        const target = this.getAttribute('data-bs-target');
                        const collapseElement = document.querySelector(target);

                        setTimeout(() => {
                            if (collapseElement.classList.contains('show')) {
                                this.title = 'Ocultar';
                            } else {
                                this.title = 'Detalles';
                            }
                        }, 200);
                    });
                });

                // Validación de rango de fechas
                const desdeInput = document.querySelector('input[name="desde"]');
                const hastaInput = document.querySelector('input[name="hasta"]');

                if (desdeInput && hastaInput) {
                    desdeInput.addEventListener('change', function () {
                        if (this.value && hastaInput.value && this.value > hastaInput.value) {
                            mostrarToast('La fecha "Desde" no puede ser mayor que la fecha "Hasta".', 'warning');
                            this.value = '';
                        }
                    });

                    hastaInput.addEventListener('change', function () {
                        if (this.value && desdeInput.value && this.value < desdeInput.value) {
                            mostrarToast('La fecha "Hasta" no puede ser menor que la fecha "Desde".', 'warning');
                            this.value = '';
                        }
                    });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', inicializar);
            } else {
                inicializar();
            }
        })();
    </script>
}

@section styles {
    <style>
        :root{
            --inventory-primary:#1C1973;
            --inventory-secondary:#514BF2;
            --inventory-accent:#8B88F2;
            --inventory-bg:#f5f6fa;
            --inventory-card:#ffffff;
            --inventory-text:#212529;
            --inventory-radius:.75rem;
            --muted:#6b7280;
            --border-soft:#e5e7eb;
        }

        /* Fondo general como productos */
        .inventory-theme{ background:var(--inventory-bg); }

        /* Header gradiente */
        .page-header{
            background:linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
            border:1px solid rgba(255,255,255,.12);
            border-radius:var(--inventory-radius);
            padding:1.1rem 1.4rem;
            margin-bottom:1rem;
            box-shadow:0 6px 18px rgba(15,23,42,.18);
            display:flex;align-items:center;justify-content:space-between;gap:1rem;color:#fff;
        }
        .page-header h1{font-size:1.3rem;margin:0;display:flex;align-items:center;gap:.4rem;font-weight:700;color:#fff}
        .page-header .subtitle{color:rgba(249,250,251,.9);font-size:.85rem;margin-top:.15rem}
        .page-header .btn{font-size:.86rem;border-radius:var(--inventory-radius);padding:.5rem 1rem}

        /* Botones coherentes */
        .btn-create-outline{
            border:1px solid var(--inventory-accent);background:transparent;color:#fff;border-radius:var(--inventory-radius);
            font-weight:500;padding:.5rem 1.4rem;font-size:.86rem;transition:.25s;display:inline-flex;align-items:center;gap:.35rem;text-decoration:none
        }
        .btn-create-outline:hover{background:rgba(139,136,242,.16);color:#fff;box-shadow:0 4px 10px rgba(15,23,42,.25);transform:translateY(-1px)}
        .btn-create-primary{
            background:#fff;color:var(--inventory-primary);border:none;border-radius:var(--inventory-radius);font-weight:600;
            padding:.5rem 1.4rem;font-size:.86rem;display:inline-flex;align-items:center;gap:.35rem;transition:.25s;text-decoration:none
        }
        .btn-create-primary:hover{background:#f9fafb;color:var(--inventory-secondary);box-shadow:0 4px 12px rgba(15,23,42,.25);transform:translateY(-1px)}

        /* Card clara tipo inventario */
        .inventory-card{
            background:var(--inventory-card);
            border:1px solid var(--border-soft);
            border-radius:var(--inventory-radius);
            overflow:hidden;margin-bottom:1.1rem;
            box-shadow:0 4px 14px rgba(15,23,42,.06);transition:.22s
        }
        .inventory-card:hover{box-shadow:0 7px 20px rgba(15,23,42,.10);transform:translateY(-1px)}
        .inventory-card .card-head{
            display:flex;align-items:center;gap:.75rem;padding:.85rem 1.15rem;border-bottom:1px solid rgba(0,0,0,.04);
            background:linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));color:#fff
        }
        .inventory-card .card-head .title{margin:0;font-size:1rem;font-weight:700;color:#fff}

        /* “search-card” para filtros */
        .search-card{
            background:var(--inventory-card);
            border:1px solid var(--border-soft);
            border-radius:var(--inventory-radius);
            padding:1rem 1.1rem;margin-bottom:1.1rem;
            box-shadow:0 2px 8px rgba(15,23,42,.04);
        }
        .inv-search-label{font-size:.8rem;font-weight:600;color:var(--muted);margin-bottom:.25rem}

        /* Tabla clara (idéntica a productos) */
        .table{margin-bottom:0;font-size:.85rem;color:#111827}
        .table thead th{
            background:#f3f4ff;font-weight:600;font-size:.78rem;border-bottom:1px solid var(--border-soft);
            white-space:nowrap;text-transform:uppercase;letter-spacing:.03em;color:#6b7280
        }
        .table tbody td{vertical-align:middle;border-color:var(--border-soft)}
        .table-hover tbody tr:hover{background-color:#f9fafb}

        /* Botón de acción pequeño coherente */
        .action-btn{
            width:2.2rem;height:2.2rem;border-radius:.7rem;display:inline-flex;align-items:center;justify-content:center;
            margin:0 .12rem;padding:0;font-size:.9rem;transition:.2s;border:none
        }
        .btn-info.action-btn{background:#eff6ff;color:#2563eb}
        .btn-info.action-btn i{color:#2563eb!important}
        .btn-info.action-btn:hover{background:#2563eb;color:#fff;transform:translateY(-1px)}

        /* Badges suaves */
        .badge.bg-soft{background-color:rgba(81,75,242,.12);}

        /* Alert suave (detalle vacío) */
        .alert-warning-soft{background-color:rgba(241,196,15,.08);color:#a97900;border:1px solid rgba(241,196,15,.25);border-radius:.6rem}

        /* Stats claras */
        .statcard-light{
            background:#fff;border-radius:.8rem;padding:.9rem 1rem;display:flex;align-items:center;justify-content:space-between;gap:.75rem;border:1px solid var(--border-soft)
        }
        .stat-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}
        .stat-value{font-size:1.05rem;font-weight:700;color:#111827}
        .stat-icon{font-size:1.5rem;color:var(--inventory-secondary)}
        .border-left-primary-soft{border-left:3px solid var(--inventory-secondary)}
        .border-left-success-soft{border-left:3px solid #22c55e}
        .border-left-info-soft{border-left:3px solid #0ea5e9}
        .border-left-warning-soft{border-left:3px solid #f59e0b}

        /* Chip resumen */
        .resumen-chip{
            display:flex;align-items:center;justify-content:center;gap:.4rem;padding:.8rem 1rem;border-radius:.8rem;font-size:.95rem;font-weight:500;color:#fff
        }
        .resumen-success{background:linear-gradient(135deg,#1f8a4d,#27ae60)}
        .resumen-primary{background:linear-gradient(135deg,var(--inventory-primary),var(--inventory-secondary))}

        /* Responsive como productos */
        @@media (max-width:768px){
