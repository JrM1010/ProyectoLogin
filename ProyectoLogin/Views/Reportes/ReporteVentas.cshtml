@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold text-primary">
                <i class="bi bi-receipt"></i> Reporte de Ventas
            </h5>
        </div>

        <div class="card-body">
            <!-- 🔹 Formulario de filtros -->
            <form method="get" class="row g-3 mb-3" id="filtroForm">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Desde</label>
                    <input type="date" name="desde" class="form-control" value="@Context.Request.Query["desde"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Hasta</label>
                    <input type="date" name="hasta" class="form-control" value="@Context.Request.Query["hasta"]" />
                </div>
                
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Vendedor</label>
                    <input type="text" name="vendedor" class="form-control" placeholder="Nombre vendedor" value="@Context.Request.Query["vendedor"]" />
                </div>
                
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Forma de pago</label>
                    <select name="formaPago" class="form-select">
                        <option value="">Todas</option>
                        <option value="Efectivo" selected="@(Context.Request.Query["formaPago"] == "Efectivo")">Efectivo</option>
                        <option value="Tarjeta" selected="@(Context.Request.Query["formaPago"] == "Tarjeta")">Tarjeta</option>
                        <option value="Transferencia" selected="@(Context.Request.Query["formaPago"] == "Transferencia")">Transferencia</option>
                        <option value="Mixto" selected="@(Context.Request.Query["formaPago"] == "Mixto")">Mixto</option>
                    </select>
                </div>

                <!-- 🔘 Botones -->
                <div class="col-12 mt-3 d-flex flex-wrap gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Filtrar
                    </button>

                    <a href="@Url.Action("DescargarPDF", new { 
                        desde = Context.Request.Query["desde"],
                        hasta = Context.Request.Query["hasta"], 
                        vendedor = Context.Request.Query["vendedor"],
                        formaPago = Context.Request.Query["formaPago"] 
                    })" class="btn btn-success me-2">
                        <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                    </a>

                    <button type="button" id="btnLimpiar" class="btn btn-warning me-2">
                        <i class="bi bi-eraser"></i> Limpiar Filtros
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Volver a Reportes
                    </a>
                </div>
            </form>

            <!-- 🔹 Tabla de resultados -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive mt-4">
                    <table class="table table-bordered table-hover align-middle text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>No. Factura</th>
                                <th>Cliente</th>
                                <th>NIT</th>
                                <th>Vendedor</th>
                                <th>Subtotal</th>
                                <th>IVA</th>
                                <th>Total</th>
                                <th>Forma de Pago</th>
                                <th>Detalles</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><strong>@v.NoFactura</strong></td>
                                    <td>@v.Cliente</td>
                                    <td>@v.Nit</td>
                                    <td>@v.Vendedor</td>
                                    <td>Q @v.TotalSinIva.ToString("N2")</td>
                                    <td>Q @v.ValorIva.ToString("N2")</td>
                                    <td><strong class="text-success">Q @v.TotalConIva.ToString("N2")</strong></td>
                                    <td><span class="badge bg-info">@v.FormaPago</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-info" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#detalles-@v.IdVenta"
                                                aria-expanded="false"
                                                aria-controls="detalles-@v.IdVenta">
                                            <i class="bi bi-list-ul"></i> Ver Detalles
                                        </button>
                                    </td>
                                </tr>

                                <tr class="bg-light">
                                    <td colspan="10" class="p-0 border-0">
                                        <div class="collapse" id="detalles-@v.IdVenta">
                                            <div class="p-3">
                                                <h6 class="text-primary mb-3">
                                                    <i class="bi bi-box-seam"></i> Detalles de la Venta - Factura: @v.NoFactura
                                                </h6>

                                                @if (v.Detalles != null && v.Detalles.Count > 0)
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-bordered">
                                                            <thead class="table-secondary">
                                                                <tr>
                                                                    <th>Producto/Kit</th>
                                                                    <th class="text-center">Cantidad</th>
                                                                    <th class="text-end">Precio Unitario</th>
                                                                    <th class="text-end">Precio sin IVA</th>
                                                                    <th class="text-end">IVA</th>
                                                                    <th class="text-end">Subtotal</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var detalle in v.Detalles)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            @if (detalle.EsKit)
                                                                            {
                                                                                <span class="badge bg-warning text-dark me-1">KIT</span>
                                                                            }
                                                                            @detalle.NombreProducto
                                                                        </td>
                                                                        <td class="text-center">@detalle.Cantidad</td>
                                                                        <td class="text-end">Q @detalle.PrecioUnitario.ToString("N2")</td>
                                                                        <td class="text-end">Q @detalle.PrecioSinIva.ToString("N2")</td>
                                                                        <td class="text-end">Q @detalle.Iva.ToString("N2")</td>
                                                                        <td class="text-end"><strong>Q @detalle.Subtotal.ToString("N2")</strong></td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning mb-0">
                                                        <i class="bi bi-exclamation-triangle"></i> No se encontraron detalles para esta venta.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <h5 class="text-success">
                        <strong>Total general:</strong> Q @ViewBag.TotalGeneral.ToString("N2")
                    </h5>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i> No se encontraron ventas con los filtros aplicados.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#btnLimpiar').click(function () {
                $('input[name="desde"], input[name="hasta"], input[name="vendedor"]').val('');
                $('select[name="formaPago"]').val('');
                $('#filtroForm').submit();
            });
        });
    </script>

    <style>
        .table th {
            font-weight: 600;
            font-size: 0.875rem;
        }

        .table td {
            font-size: 0.875rem;
            vertical-align: middle;
        }

        .collapse.show {
            background-color: #f8f9fa;
        }

        .btn-group-sm > .btn, .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }

        .badge {
            font-size: 0.75rem;
        }

        .card {
            border: 1px solid #e3e6f0;
            border-radius: 0.35rem;
        }

        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }
    </style>
}
