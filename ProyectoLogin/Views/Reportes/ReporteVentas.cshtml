@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="container-fluid py-4">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center">
            <div class="bg-gradient-primary rounded-circle p-3 me-3">
                <i class="bi bi-graph-up text-white fs-4"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 text-gray-800">Reporte de Ventas</h1>
                <p class="text-muted mb-0">Analiza y filtra las ventas realizadas en el sistema</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill d-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i>Volver a Reportes
        </a>
    </div>

    <!-- TOAST PARA NOTIFICACIONES -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="toastNotificacion" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <!-- TARJETA PRINCIPAL -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient-primary text-white py-3 border-0">
            <div class="d-flex align-items-center">
                <i class="bi bi-receipt fs-5 me-3"></i>
                <h5 class="mb-0 fw-semibold">Filtros y Resultados de Ventas</h5>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- FORMULARIO DE FILTROS -->
            <form method="get" class="row g-4 mb-4" id="filtroForm">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-gray-700">
                        <i class="bi bi-calendar-date text-primary me-1"></i>Desde
                    </label>
                    <input type="date" name="desde" class="form-control" value="@Context.Request.Query["desde"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-gray-700">
                        <i class="bi bi-calendar-date text-primary me-1"></i>Hasta
                    </label>
                    <input type="date" name="hasta" class="form-control" value="@Context.Request.Query["hasta"]" />
                </div>
                
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-gray-700">
                        <i class="bi bi-person text-primary me-1"></i>Vendedor
                    </label>
                    <input type="text" name="vendedor" class="form-control" placeholder="Nombre vendedor" value="@Context.Request.Query["vendedor"]" />
                </div>
                
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-gray-700">
                        <i class="bi bi-credit-card text-primary me-1"></i>Forma de pago
                    </label>
                    <select name="formaPago" class="form-select">
                        <option value="">Todas</option>
                        <option value="Efectivo" selected="@(Context.Request.Query["formaPago"] == "Efectivo")">Efectivo</option>
                        <option value="Tarjeta" selected="@(Context.Request.Query["formaPago"] == "Tarjeta")">Tarjeta</option>
                        <option value="Transferencia" selected="@(Context.Request.Query["formaPago"] == "Transferencia")">Transferencia</option>
                        <option value="Mixto" selected="@(Context.Request.Query["formaPago"] == "Mixto")">Mixto</option>
                    </select>
                </div>

                <!-- BOTONES DE ACCIÓN -->
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2 justify-content-end border-top pt-4">
                        <button type="submit" class="btn btn-primary rounded-pill d-flex align-items-center">
                            <i class="bi bi-search me-2"></i>Filtrar
                        </button>

                        <a href="@Url.Action("DescargarPDF", new { 
                            desde = Context.Request.Query["desde"],
                            hasta = Context.Request.Query["hasta"], 
                            vendedor = Context.Request.Query["vendedor"],
                            formaPago = Context.Request.Query["formaPago"] 
                        })" class="btn btn-success rounded-pill d-flex align-items-center">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF
                        </a>

                        <button type="button" id="btnLimpiar" class="btn btn-warning rounded-pill d-flex align-items-center">
                            <i class="bi bi-eraser me-2"></i>Limpiar Filtros
                        </button>
                    </div>
                </div>
            </form>

            <!-- RESULTADOS -->
            @if (Model != null && Model.Any())
            {
                <!-- ESTADÍSTICAS RÁPIDAS -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-primary shadow-sm h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                            Total Ventas
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">Q @ViewBag.TotalGeneral.ToString("N2")</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="bi bi-currency-dollar fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-success shadow-sm h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                            Utilidad Total
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">Q @ViewBag.UtilidadGeneral.ToString("N2")</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="bi bi-graph-up fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-info shadow-sm h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                            Ventas Encontradas
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="bi bi-receipt fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- 🔹 NUEVO: Promedio de utilidad general -->
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-left-warning shadow-sm h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                            % Promedio de Utilidad
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.MargenPromedioGeneral.ToString("N2")%</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="bi bi-percent fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TABLA DE RESULTADOS -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light py-3 border-0">
                        <h6 class="mb-0 fw-semibold text-gray-800">
                            <i class="bi bi-table text-primary me-2"></i>Resultados de Ventas
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4 fw-semibold text-gray-700">Fecha</th>
                                        <th class="fw-semibold text-gray-700">No. Factura</th>
                                        <th class="fw-semibold text-gray-700">Cliente</th>
                                        <th class="fw-semibold text-gray-700">NIT</th>
                                        <th class="fw-semibold text-gray-700">Vendedor</th>
                                        <th class="fw-semibold text-gray-700 text-end">Subtotal</th>
                                        <th class="fw-semibold text-gray-700 text-end">IVA</th>
                                        <th class="fw-semibold text-gray-700 text-end">Total</th>
                                        <th class="fw-semibold text-gray-700 text-center">Forma de Pago</th>
                                        <th class="fw-semibold text-gray-700 text-end">Utilidad</th>
                                        <th class="fw-semibold text-gray-700 text-end">% Ganancia</th>
                                        <th class="fw-semibold text-gray-700 text-center" style="width: 120px;">Detalles</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Model)
                                    {
                                        <tr>
                                            <td class="ps-4"><small class="text-muted">@v.Fecha.ToString("dd/MM/yyyy")</small></td>
                                            <td><strong class="text-primary">@v.NoFactura</strong></td>
                                            <td>@v.Cliente</td>
                                            <td><span class="badge bg-light text-dark">@v.Nit</span></td>
                                            <td><span class="fw-medium">@v.Vendedor</span></td>
                                            <td class="text-end text-muted">Q @v.TotalSinIva.ToString("N2")</td>
                                            <td class="text-end text-warning">Q @v.ValorIva.ToString("N2")</td>
                                            <td class="text-end text-success fw-bold">Q @v.TotalConIva.ToString("N2")</td>
                                            <td class="text-center">
                                                @{
                                                    var badgeClass = v.FormaPago switch
                                                    {
                                                        "Efectivo" => "bg-success",
                                                        "Tarjeta" => "bg-info",
                                                        "Transferencia" => "bg-primary",
                                                        "Mixto" => "bg-warning text-dark",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass rounded-pill">@v.FormaPago</span>
                                            </td>
                                            <td class="text-end text-primary fw-bold">Q @v.UtilidadTotal.ToString("N2")</td>
                                            <td class="text-end">
                                                <span class="fw-bold @(v.MargenPorcentual >= 25 ? "text-success" : v.MargenPorcentual >= 10 ? "text-warning" : "text-danger")">
                                                    @v.MargenPorcentual.ToString("N2")%
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-info rounded-pill" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#detalles-@v.IdVenta"
                                                        aria-expanded="false"
                                                        aria-controls="detalles-@v.IdVenta">
                                                    <i class="bi bi-list-ul me-1"></i>Detalles
                                                </button>
                                            </td>
                                        </tr>

                                        <!-- DETALLES EXPANDIBLES -->
                                        <tr class="bg-light">
                                            <td colspan="12" class="p-0 border-0">
                                                <div class="collapse" id="detalles-@v.IdVenta">
                                                    <div class="p-3">
                                                        <div class="card border-0 shadow-sm">
                                                            <div class="card-header bg-light border-0">
                                                                <h6 class="mb-0 fw-semibold text-gray-800">
                                                                    <i class="bi bi-box-seam text-primary me-2"></i>
                                                                    Detalles de la Venta — Factura: <strong class="text-primary">@v.NoFactura</strong>
                                                                </h6>
                                                            </div>
                                                            <div class="card-body">
                                                                @if (v.Detalles != null && v.Detalles.Count > 0)
                                                                {
                                                                    <div class="table-responsive">
                                                                        <table class="table table-sm table-hover align-middle">
                                                                            <thead class="table-light">
                                                                                <tr>
                                                                                    <th>Producto/Kit</th>
                                                                                    <th class="text-center">Cantidad</th>
                                                                                    <th class="text-end">Precio Unitario</th>
                                                                                    <th class="text-end">Precio sin IVA</th>
                                                                                    <th class="text-end">IVA</th>
                                                                                    <th class="text-end">Subtotal</th>
                                                                                    <th class="text-end">Utilidad</th>
                                                                                    <th class="text-end">% Utilidad</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var detalle in v.Detalles)
                                                                                {
                                                                                    <tr>
                                                                                        <td>
                                                                                            <div class="d-flex align-items-center">
                                                                                                @if (detalle.EsKit)
                                                                                                {
                                                                                                    <span class="badge bg-warning text-dark rounded-pill me-2">KIT</span>
                                                                                                }
                                                                                                <span class="fw-medium">@detalle.NombreProducto</span>
                                                                                            </div>
                                                                                        </td>
                                                                                        <td class="text-center"><span class="badge bg-primary rounded-pill">@detalle.Cantidad</span></td>
                                                                                        <td class="text-end text-muted">Q @detalle.PrecioUnitario.ToString("N2")</td>
                                                                                        <td class="text-end text-muted">Q @detalle.PrecioSinIva.ToString("N2")</td>
                                                                                        <td class="text-end text-warning">Q @detalle.Iva.ToString("N2")</td>
                                                                                        <td class="text-end fw-semibold">Q @detalle.Subtotal.ToString("N2")</td>
                                                                                        <td class="text-end text-success fw-bold">Q @detalle.Utilidad.ToString("N2")</td>
                                                                                        <td class="text-end">
                                                                                            <span class="fw-bold @(detalle.MargenPorcentual >= 25 ? "text-success" : detalle.MargenPorcentual >= 10 ? "text-warning" : "text-danger")">
                                                                                                @detalle.MargenPorcentual.ToString("N2")%
                                                                                            </span>
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="alert alert-warning text-center mb-0">
                                                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                                                        No se encontraron detalles para esta venta.
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- RESUMEN FINAL -->
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="card border-0 bg-success text-white">
                            <div class="card-body text-center py-3">
                                <h5 class="mb-0 fw-bold">
                                    <i class="bi bi-currency-dollar me-2"></i>
                                    Total General: Q @ViewBag.TotalGeneral.ToString("N2")
                                </h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 bg-primary text-white">
                            <div class="card-body text-center py-3">
                                <h5 class="mb-0 fw-bold">
                                    <i class="bi bi-graph-up me-2"></i>
                                    Utilidad Total: Q @ViewBag.UtilidadGeneral.ToString("N2")
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                            <i class="bi bi-search text-muted fs-1"></i>
                        </div>
                        <h4 class="text-muted mb-3">No se encontraron ventas</h4>
                        <p class="text-muted mb-4">No hay ventas que coincidan con los filtros aplicados.</p>
                        <button type="button" id="btnLimpiarVacio" class="btn btn-primary rounded-pill d-inline-flex align-items-center">
                            <i class="bi bi-eraser me-2"></i>Limpiar Filtros
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function () {
            // 🔹 Sistema de notificaciones Toast
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');
                
                const config = {
                    success: { bg: 'bg-success', icon: 'bi-check-circle' },
                    warning: { bg: 'bg-warning', icon: 'bi-exclamation-triangle' },
                    danger: { bg: 'bg-danger', icon: 'bi-x-circle' },
                    info: { bg: 'bg-info', icon: 'bi-info-circle' }
                };
                
                const { bg, icon } = config[tipo] || config.success;
                
                toast.className = `toast align-items-center text-white ${bg} border-0`;
                toastIcon.className = `bi ${icon} me-2`;
                toastMessage.textContent = mensaje;
                
                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            // 🔹 Limpiar filtros
            function limpiarFiltros() {
                document.querySelectorAll('input[name="desde"], input[name="hasta"], input[name="vendedor"]').forEach(input => {
                    input.value = '';
                });
                document.querySelector('select[name="formaPago"]').value = '';
                
                mostrarToast('Filtros limpiados correctamente', 'info');
                
                // Enviar formulario después de un breve delay
                setTimeout(() => {
                    document.getElementById('filtroForm').submit();
                }, 1000);
            }

            // 🔹 Inicialización
            function inicializar() {
                // Botón limpiar filtros
                document.getElementById('btnLimpiar').addEventListener('click', limpiarFiltros);
                
                // Botón limpiar en estado vacío
                const btnLimpiarVacio = document.getElementById('btnLimpiarVacio');
                if (btnLimpiarVacio) {
                    btnLimpiarVacio.addEventListener('click', limpiarFiltros);
                }

                // Animación para los detalles expandibles
                document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
                    button.addEventListener('click', function() {
                        const target = this.getAttribute('data-bs-target');
                        const collapseElement = document.querySelector(target);
                        
                        if (collapseElement.classList.contains('show')) {
                            this.innerHTML = '<i class="bi bi-list-ul me-1"></i>Detalles';
                        } else {
                            this.innerHTML = '<i class="bi bi-chevron-up me-1"></i>Ocultar';
                        }
                    });
                });

                // Validación de fechas
                const desdeInput = document.querySelector('input[name="desde"]');
                const hastaInput = document.querySelector('input[name="hasta"]');
                
                if (desdeInput && hastaInput) {
                    desdeInput.addEventListener('change', function() {
                        if (this.value && hastaInput.value && this.value > hastaInput.value) {
                            mostrarToast('La fecha "Desde" no puede ser mayor que la fecha "Hasta"', 'warning');
                            this.value = '';
                        }
                    });
                    
                    hastaInput.addEventListener('change', function() {
                        if (this.value && desdeInput.value && this.value < desdeInput.value) {
                            mostrarToast('La fecha "Hasta" no puede ser menor que la fecha "Desde"', 'warning');
                            this.value = '';
                        }
                    });
                }
            }

            // Ejecutar cuando el DOM esté listo
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', inicializar);
            } else {
                inicializar();
            }
        })();
    </script>

    <style>
        .table td, .table th {
            vertical-align: middle;
        }

        .btn-sm {
            padding: 0.375rem 0.75rem;
            transition: all 0.15s ease-in-out;
        }

        .btn-sm:hover {
            transform: translateY(-1px);
        }

        .card-header {
            border-bottom: none;
        }

        .badge {
            font-size: 0.75rem;
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        }

        .border-left-primary {
            border-left: 0.25rem solid #4e73df !important;
        }

        .border-left-success {
            border-left: 0.25rem solid #1cc88a !important;
        }

        .border-left-info {
            border-left: 0.25rem solid #36b9cc !important;
        }

        .collapse .card {
            background-color: #fdfdfd;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

        .collapse.show .card {
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        }

        /* Animaciones personalizadas */
        @@keyframes slideInDown {
            from {
                transform: translate3d(0, -100%, 0);
                opacity: 0;
            }
            to {
                transform: translate3d(0, 0, 0);
                opacity: 1;
            }
        }

        .toast {
            animation: slideInDown 0.3s ease-out;
        }

        /* Mejoras visuales para la tabla */
        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
            transform: translateY(-1px);
            transition: all 0.15s ease-in-out;
        }

        .table-light th {
            background-color: #f8f9fa !important;
            border-bottom: 2px solid #dee2e6;
        }
    </style>
}