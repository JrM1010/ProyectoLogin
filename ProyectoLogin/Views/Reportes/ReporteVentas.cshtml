@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="container-fluid py-4 reportes-ventas-page">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-wrapper-main me-3">
                <i class="bi bi-graph-up-arrow fs-3"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 fw-bold text-white">Reporte de Ventas</h1>
                <p class="mb-0 text-muted-small">
                    Analiza, filtra y profundiza en los resultados de ventas de SmartCell Company.
                </p>
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left"></i>
            Volver a Reportes
        </a>
    </div>

    <!-- TOAST PARA NOTIFICACIONES -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="toastNotificacion" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <!-- TARJETA PRINCIPAL -->
    <div class="card main-card shadow-sm border-0">
        <!-- HEADER CARD -->
        <div class="card-header d-flex align-items-center gap-2 border-0">
            <div class="icon-wrapper-soft">
                <i class="bi bi-receipt fs-5"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-semibold text-white">Filtros y resultados de ventas</h5>
                <small class="text-muted-small">Aplica filtros y explora el detalle de cada operación.</small>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- FORMULARIO DE FILTROS -->
            <form method="get" class="row g-3 mb-4 align-items-end" id="filtroForm">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-calendar-date me-1"></i>Desde
                    </label>
                    <input type="date"
                           name="desde"
                           class="form-control input-dark"
                           value="@Context.Request.Query["desde"]" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-calendar-date me-1"></i>Hasta
                    </label>
                    <input type="date"
                           name="hasta"
                           class="form-control input-dark"
                           value="@Context.Request.Query["hasta"]" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-person-badge me-1"></i>Vendedor
                    </label>
                    <input type="text"
                           name="vendedor"
                           class="form-control input-dark"
                           placeholder="Nombre vendedor"
                           value="@Context.Request.Query["vendedor"]" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-credit-card me-1"></i>Forma de pago
                    </label>
                    <select name="formaPago" class="form-select input-dark">
    @{
        var formaPago = Context.Request.Query["formaPago"].ToString();
    }

    @* Opción: Todas *@
    @if (string.IsNullOrEmpty(formaPago))
    {
        <option value="" selected>Todas</option>
    }
    else
    {
        <option value="">Todas</option>
    }

    @* Efectivo *@
    @if (formaPago == "Efectivo")
    {
        <option value="Efectivo" selected>Efectivo</option>
    }
    else
    {
        <option value="Efectivo">Efectivo</option>
    }

    @* Tarjeta *@
    @if (formaPago == "Tarjeta")
    {
        <option value="Tarjeta" selected>Tarjeta</option>
    }
    else
    {
        <option value="Tarjeta">Tarjeta</option>
    }

    @* Transferencia *@
    @if (formaPago == "Transferencia")
    {
        <option value="Transferencia" selected>Transferencia</option>
    }
    else
    {
        <option value="Transferencia">Transferencia</option>
    }

    @* Mixto *@
    @if (formaPago == "Mixto")
    {
        <option value="Mixto" selected>Mixto</option>
    }
    else
    {
        <option value="Mixto">Mixto</option>
    }
</select>
                </div>

                <!-- BOTONES DE ACCIÓN -->
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2 justify-content-end border-top border-soft pt-3">
                        <button type="submit"
                                class="btn btn-primary-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-search"></i>
                            Filtrar
                        </button>

                        <a href="@Url.Action("DescargarPDF", new {
                                desde = Context.Request.Query["desde"],
                                hasta = Context.Request.Query["hasta"],
                                vendedor = Context.Request.Query["vendedor"],
                                formaPago = Context.Request.Query["formaPago"]
                            })"
                           class="btn btn-success-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Descargar PDF
                        </a>

                        <button type="button"
                                id="btnLimpiar"
                                class="btn btn-outline-warning-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-eraser"></i>
                            Limpiar filtros
                        </button>
                    </div>
                </div>
            </form>

            <!-- RESULTADOS -->
            @if (Model != null && Model.Any())
            {
                <!-- ESTADÍSTICAS RÁPIDAS -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card border-left-primary-soft">
                            <div>
                                <div class="stat-label">Total ventas</div>
                                <div class="stat-value">Q @ViewBag.TotalGeneral.ToString("N2")</div>
                            </div>
                            <i class="bi bi-currency-dollar stat-icon"></i>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card border-left-success-soft">
                            <div>
                                <div class="stat-label">Utilidad total</div>
                                <div class="stat-value">Q @ViewBag.UtilidadGeneral.ToString("N2")</div>
                            </div>
                            <i class="bi bi-graph-up stat-icon"></i>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card border-left-info-soft">
                            <div>
                                <div class="stat-label">Ventas encontradas</div>
                                <div class="stat-value">@Model.Count()</div>
                            </div>
                            <i class="bi bi-receipt stat-icon"></i>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card border-left-warning-soft">
                            <div>
                                <div class="stat-label">% promedio utilidad</div>
                                <div class="stat-value">@ViewBag.MargenPromedioGeneral.ToString("N2")%</div>
                            </div>
                            <i class="bi bi-percent stat-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- TABLA DE RESULTADOS -->
                <div class="card table-card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 pb-2">
                        <i class="bi bi-table text-accent"></i>
                        <h6 class="mb-0 fw-semibold text-white">Resultados de ventas</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 report-table">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Fecha</th>
                                        <th>No. Factura</th>
                                        <th>Cliente</th>
                                        <th>NIT</th>
                                        <th>Vendedor</th>
                                        <th class="text-end">Subtotal</th>
                                        <th class="text-end">IVA</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Forma de pago</th>
                                        <th class="text-end">Utilidad</th>
                                        <th class="text-end">% Ganancia</th>
                                        <th class="text-center" style="width: 120px;">Detalles</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Model)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <small class="text-muted-small">
                                                    @v.Fecha.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-accent">@v.NoFactura</span>
                                            </td>
                                            <td>@v.Cliente</td>
                                            <td>
                                                <span class="badge bg-soft text-white">@v.Nit</span>
                                            </td>
                                            <td>
                                                <span class="fw-medium text-light">@v.Vendedor</span>
                                            </td>
                                            <td class="text-end text-muted-small">
                                                Q @v.TotalSinIva.ToString("N2")
                                            </td>
                                            <td class="text-end text-warning">
                                                Q @v.ValorIva.ToString("N2")
                                            </td>
                                            <td class="text-end text-success fw-bold">
                                                Q @v.TotalConIva.ToString("N2")
                                            </td>
                                            <td class="text-center">
                                                @{
                                                    var badgeClass = v.FormaPago switch
                                                    {
                                                        "Efectivo" => "bg-success",
                                                        "Tarjeta" => "bg-info",
                                                        "Transferencia" => "bg-primary",
                                                        "Mixto" => "bg-warning text-dark",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge rounded-pill @badgeClass">
                                                    @v.FormaPago
                                                </span>
                                            </td>
                                            <td class="text-end text-primary fw-bold">
                                                Q @v.UtilidadTotal.ToString("N2")
                                            </td>
                                            <td class="text-end">
                                                <span class="fw-bold @(v.MargenPorcentual >= 25 ? "text-success" : v.MargenPorcentual >= 10 ? "text-warning" : "text-danger")">
                                                    @v.MargenPorcentual.ToString("N2")%
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-xs-detail btn-outline-info rounded-pill"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#detalles-@v.IdVenta"
                                                        aria-expanded="false"
                                                        aria-controls="detalles-@v.IdVenta">
                                                    <i class="bi bi-list-ul me-1"></i>Detalles
                                                </button>
                                            </td>
                                        </tr>

                                        <!-- DETALLES EXPANDIBLES -->
                                        <tr class="fila-detalle">
                                            <td colspan="12" class="p-0 border-0">
                                                <div class="collapse" id="detalles-@v.IdVenta">
                                                    <div class="p-3">
                                                        <div class="card detalle-card border-0 shadow-sm">
                                                            <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2">
                                                                <i class="bi bi-box-seam text-accent"></i>
                                                                <h6 class="mb-0 fw-semibold text-white">
                                                                    Detalles de la venta — Factura:
                                                                    <span class="text-accent fw-bold">@v.NoFactura</span>
                                                                </h6>
                                                            </div>
                                                            <div class="card-body pt-2">
                                                                @if (v.Detalles != null && v.Detalles.Count > 0)
                                                                {
                                                                    <div class="table-responsive">
                                                                        <table class="table table-sm table-dark table-striped align-middle mb-0">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th>Producto/Kit</th>
                                                                                    <th class="text-center">Cantidad</th>
                                                                                    <th class="text-end">Precio unitario</th>
                                                                                    <th class="text-end">Precio sin IVA</th>
                                                                                    <th class="text-end">IVA</th>
                                                                                    <th class="text-end">Subtotal</th>
                                                                                    <th class="text-end">Utilidad</th>
                                                                                    <th class="text-end">% Utilidad</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var detalle in v.Detalles)
                                                                                {
                                                                                    <tr>
                                                                                        <td>
                                                                                            <div class="d-flex align-items-center gap-2">
                                                                                                @if (detalle.EsKit)
                                                                                                {
                                                                                                    <span class="badge bg-warning text-dark rounded-pill">
                                                                                                        KIT
                                                                                                    </span>
                                                                                                }
                                                                                                <span class="fw-medium text-light">
                                                                                                    @detalle.NombreProducto
                                                                                                </span>
                                                                                            </div>
                                                                                        </td>
                                                                                        <td class="text-center">
                                                                                            <span class="badge bg-primary rounded-pill">
                                                                                                @detalle.Cantidad
                                                                                            </span>
                                                                                        </td>
                                                                                        <td class="text-end text-muted-small">
                                                                                            Q @detalle.PrecioUnitario.ToString("N2")
                                                                                        </td>
                                                                                        <td class="text-end text-muted-small">
                                                                                            Q @detalle.PrecioSinIva.ToString("N2")
                                                                                        </td>
                                                                                        <td class="text-end text-warning">
                                                                                            Q @detalle.Iva.ToString("N2")
                                                                                        </td>
                                                                                        <td class="text-end fw-semibold">
                                                                                            Q @detalle.Subtotal.ToString("N2")
                                                                                        </td>
                                                                                        <td class="text-end text-success fw-bold">
                                                                                            Q @detalle.Utilidad.ToString("N2")
                                                                                        </td>
                                                                                        <td class="text-end">
                                                                                            <span class="fw-bold @(detalle.MargenPorcentual >= 25 ? "text-success" : detalle.MargenPorcentual >= 10 ? "text-warning" : "text-danger")">
                                                                                                @detalle.MargenPorcentual.ToString("N2")%
                                                                                            </span>
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="alert alert-warning-soft text-center mb-0">
                                                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                                                        No se encontraron detalles para esta venta.
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- RESUMEN FINAL -->
                <div class="row mt-4 g-3">
                    <div class="col-md-6">
                        <div class="resumen-card bg-success-custom">
                            <i class="bi bi-currency-dollar me-2"></i>
                            <span>Total General: </span>
                            <strong>Q @ViewBag.TotalGeneral.ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="resumen-card bg-primary-custom">
                            <i class="bi bi-graph-up me-2"></i>
                            <span>Utilidad Total: </span>
                            <strong>Q @ViewBag.UtilidadGeneral.ToString("N2")</strong>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card main-card-empty border-0 shadow-sm text-center py-5">
                    <div class="icon-empty mb-3">
                        <i class="bi bi-search"></i>
                    </div>
                    <h4 class="text-white mb-2">No se encontraron ventas</h4>
                    <p class="text-muted-small mb-4">
                        No hay registros que coincidan con los filtros aplicados. Intenta ajustar los parámetros.
                    </p>
                    <button type="button"
                            id="btnLimpiarVacio"
                            class="btn btn-primary-custom rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i>
                        Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                const config = {
                    success: { bg: 'bg-success', icon: 'bi-check-circle' },
                    warning: { bg: 'bg-warning', icon: 'bi-exclamation-triangle' },
                    danger: { bg: 'bg-danger', icon: 'bi-x-circle' },
                    info: { bg: 'bg-info', icon: 'bi-info-circle' }
                };

                const { bg, icon } = config[tipo] || config.success;

                toast.className = `toast align-items-center text-white ${bg} border-0`;
                toastIcon.className = `bi ${icon} me-2`;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            function limpiarFiltros() {
                document.querySelectorAll('input[name="desde"], input[name="hasta"], input[name="vendedor"]').forEach(input => {
                    input.value = '';
                });

                const formaSelect = document.querySelector('select[name="formaPago"]');
                if (formaSelect) formaSelect.value = '';

                // Feedback visual
                mostrarToast('Filtros limpiados correctamente', 'info');

                setTimeout(() => {
                    document.getElementById('filtroForm').submit();
                }, 600);
            }

            function inicializar() {
                const btnLimpiar = document.getElementById('btnLimpiar');
                if (btnLimpiar) btnLimpiar.addEventListener('click', limpiarFiltros);

                const btnLimpiarVacio = document.getElementById('btnLimpiarVacio');
                if (btnLimpiarVacio) btnLimpiarVacio.addEventListener('click', limpiarFiltros);

                // Toggle texto botón detalles
                document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
                    button.addEventListener('click', function () {
                        const target = this.getAttribute('data-bs-target');
                        const collapseElement = document.querySelector(target);

                        setTimeout(() => {
                            if (collapseElement.classList.contains('show')) {
                                this.innerHTML = '<i class="bi bi-chevron-up me-1"></i>Ocultar';
                            } else {
                                this.innerHTML = '<i class="bi bi-list-ul me-1"></i>Detalles';
                            }
                        }, 200);
                    });
                });

                // Validación de rango de fechas
                const desdeInput = document.querySelector('input[name="desde"]');
                const hastaInput = document.querySelector('input[name="hasta"]');

                if (desdeInput && hastaInput) {
                    desdeInput.addEventListener('change', function () {
                        if (this.value && hastaInput.value && this.value > hastaInput.value) {
                            mostrarToast('La fecha "Desde" no puede ser mayor que la fecha "Hasta".', 'warning');
                            this.value = '';
                        }
                    });

                    hastaInput.addEventListener('change', function () {
                        if (this.value && desdeInput.value && this.value < desdeInput.value) {
                            mostrarToast('La fecha "Hasta" no puede ser menor que la fecha "Desde".', 'warning');
                            this.value = '';
                        }
                    });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', inicializar);
            } else {
                inicializar();
            }
        })();
    </script>

    <style>
        :root {
            --primary-blue: #1C1973;
            --secondary-blue: #514BF2;
            --accent-blue: #8B88F2;
            --dark-bg: #0D0E26;
            --alt-bg: #081C59;
            --light-text: #F0F0F7;
            --muted-text: #9ba4c4;
            --border-soft: rgba(139, 136, 242, 0.22);
            --card-bg: #0F122F;
            --card-bg-soft: #151838;
        }

        .reportes-ventas-page {
            color: var(--light-text);
        }

        .icon-wrapper-main {
            width: 52px;
            height: 52px;
            border-radius: 999px;
            background: radial-gradient(circle at 20% 0, var(--secondary-blue), transparent),
                        rgba(12, 18, 58, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.55);
        }

        .icon-wrapper-soft {
            width: 36px;
            height: 36px;
            border-radius: 999px;
            background: rgba(81, 75, 242, 0.14);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
        }

        .main-card {
            background: linear-gradient(145deg, #0D0E26, #111433);
            border-radius: 1rem;
            border: 1px solid var(--border-soft);
        }

        .main-card-empty {
            background: linear-gradient(145deg, #0D0E26, #111433);
            border-radius: 1rem;
            border: 1px solid var(--border-soft);
        }

        .border-soft {
            border-color: var(--border-soft) !important;
        }

        .text-label {
            color: var(--muted-text);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .text-muted-small {
            color: var(--muted-text) !important;
            font-size: 0.85rem;
        }

        .text-accent {
            color: var(--accent-blue) !important;
        }

        .input-dark, .input-dark:focus, .input-dark:active {
            background-color: #080a1c;
            border: 1px solid rgba(139, 136, 242, 0.32);
            color: var(--light-text);
            box-shadow: none;
        }

        .input-dark::placeholder {
            color: rgba(155, 164, 196, 0.7);
        }

        .btn-primary-custom {
            background: var(--secondary-blue);
            border-color: var(--secondary-blue);
            color: #fff;
        }

        .btn-primary-custom:hover {
            background: #3c36cc;
            border-color: #3c36cc;
        }

        .btn-success-custom {
            background: #27ae60;
            border-color: #27ae60;
            color: #fff;
        }

        .btn-success-custom:hover {
            background: #1f8a4d;
            border-color: #1f8a4d;
        }

        .btn-outline-warning-custom {
            border-color: #f1c40f;
            color: #f1c40f;
        }

        .btn-outline-warning-custom:hover {
            background-color: #f1c40f;
            color: #111433;
        }

        .btn-xs-detail {
            padding: 0.25rem 0.75rem;
            font-size: 0.75rem;
        }

        .table-card {
            background-color: var(--card-bg);
            border-radius: 0.9rem;
            border: 1px solid rgba(139, 136, 242, 0.18);
        }

        .report-table thead tr {
            background: rgba(12, 18, 58, 0.98);
        }

        .report-table thead th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted-text);
            border-bottom-color: rgba(139, 136, 242, 0.35);
        }

        .report-table tbody tr {
            transition: all 0.15s ease-in-out;
        }

        .report-table tbody tr:hover {
            background: radial-gradient(circle at 0 0, rgba(81, 75, 242, 0.16), transparent);
            transform: translateY(-1px);
        }

        .fila-detalle {
            background: #080a1c;
        }

        .detalle-card {
            background: var(--card-bg-soft);
