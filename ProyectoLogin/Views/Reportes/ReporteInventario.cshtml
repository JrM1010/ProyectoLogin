@model IEnumerable<dynamic>
@using System.Collections.Generic

@{
    ViewData["Title"] = "Reporte de Inventario";
    var categorias = ViewBag.Categorias as List<ProyectoLogin.Models.ModelosProducts.Categoria>;
    var proveedores = ViewBag.Proveedores as List<ProyectoLogin.Models.Proveedor>;

    int? idCategoriaSel = ViewBag.IdCategoria != null ? (int?)ViewBag.IdCategoria : null;
    int? idProveedorSel = ViewBag.IdProveedor != null ? (int?)ViewBag.IdProveedor : null;
    string nombreSel = ViewBag.Nombre as string ?? "";

    decimal totalInventario = 0m;
    if (ViewBag.TotalInventario != null)
    {
        decimal.TryParse(ViewBag.TotalInventario.ToString(), out totalInventario);
    }

    var lista = Model?.ToList() ?? new List<dynamic>();
    var totalProductos = lista.Count;
    var productosBajoMinimo = lista.Count(x => x.StockActual <= x.StockMinimo);
}

<div class="container-fluid py-4 reporte-inventario-page">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-wrapper-main me-3">
                <i class="bi bi-box-seam fs-3"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 fw-bold text-white">Reporte de Inventario</h1>
                <p class="mb-0 text-muted-small">
                    Visualiza el stock actual, valores y productos críticos de SmartCell Company.
                </p>
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left-circle"></i>
            Volver a Reportes
        </a>
    </div>

    <!-- CARD PRINCIPAL -->
    <div class="card main-card shadow-sm border-0">
        <div class="card-header d-flex align-items-center gap-2 border-0">
            <div class="icon-wrapper-soft">
                <i class="bi bi-funnel fs-6"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-semibold text-white">Filtros de inventario</h5>
                <small class="text-muted-small">Filtra por categoría, proveedor o nombre de producto.</small>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- FORMULARIO DE FILTROS -->
            <form asp-action="ReporteInventario"
                  method="get"
                  class="row g-3 mb-4 align-items-end"
                  id="filtroForm">

                <!-- Categoría -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-tags me-1"></i>Categoría
                    </label>
                    <select name="idCategoria" class="form-select input-dark">
                        @if (!idCategoriaSel.HasValue)
                        {
                            <option value="" selected>-- Todas las categorías --</option>
                        }
                        else
                        {
                            <option value="">-- Todas las categorías --</option>
                        }

                        @if (categorias != null)
                        {
                            foreach (var c in categorias)
                            {
                                if (idCategoriaSel.HasValue && idCategoriaSel.Value == c.IdCategoria)
                                {
                                    <option value="@c.IdCategoria" selected>@c.Nombre</option>
                                }
                                else
                                {
                                    <option value="@c.IdCategoria">@c.Nombre</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Proveedor -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-truck me-1"></i>Proveedor
                    </label>
                    <select name="idProveedor" class="form-select input-dark">
                        @if (!idProveedorSel.HasValue)
                        {
                            <option value="" selected>-- Todos los proveedores --</option>
                        }
                        else
                        {
                            <option value="">-- Todos los proveedores --</option>
                        }

                        @if (proveedores != null)
                        {
                            foreach (var p in proveedores)
                            {
                                if (idProveedorSel.HasValue && idProveedorSel.Value == p.IdProveedor)
                                {
                                    <option value="@p.IdProveedor" selected>@p.Nombre</option>
                                }
                                else
                                {
                                    <option value="@p.IdProveedor">@p.Nombre</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Nombre -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-search me-1"></i>Nombre
                    </label>
                    <input type="text"
                           name="nombre"
                           value="@nombreSel"
                           class="form-control input-dark"
                           placeholder="Buscar producto..." />
                </div>

                <!-- BOTONES -->
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2 justify-content-end border-top border-soft pt-3">
                        <button type="submit"
                                class="btn btn-primary-custom rounded-pill d-inline-flex align-items-center gap-2">
                            <i class="bi bi-search"></i> Filtrar
                        </button>

                        <a asp-action="ReporteInventario"
                           asp-route-pdf="true"
                           class="btn btn-success-custom rounded-pill d-inline-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                        </a>

                        <button type="button"
                                id="btnLimpiar"
                                class="btn btn-outline-warning-custom rounded-pill d-inline-flex align-items-center gap-2">
                            <i class="bi bi-eraser"></i> Limpiar filtros
                        </button>
                    </div>
                </div>
            </form>

            @if (lista.Any())
            {
                <!-- ESTADÍSTICAS RÁPIDAS -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-primary-soft">
                            <div>
                                <div class="stat-label">Total inventario (IVA incluido)</div>
                                <div class="stat-value">Q @totalInventario.ToString("N2")</div>
                            </div>
                            <i class="bi bi-currency-dollar stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-info-soft">
                            <div>
                                <div class="stat-label">Productos listados</div>
                                <div class="stat-value">@totalProductos</div>
                            </div>
                            <i class="bi bi-boxes stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-warning-soft">
                            <div>
                                <div class="stat-label">Bajo mínimo</div>
                                <div class="stat-value">@productosBajoMinimo</div>
                            </div>
                            <i class="bi bi-exclamation-triangle stat-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- TABLA -->
                <div class="card table-card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 pb-2">
                        <i class="bi bi-table text-accent"></i>
                        <h6 class="mb-0 fw-semibold text-white">Detalle de inventario</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 report-table">
                                <thead>
                                    <tr>
                                        <th class="text-start">Producto</th>
                                        <th>Categoría</th>
                                        <th>Proveedor</th>
                                        <th class="text-end">Stock</th>
                                        <th class="text-end">Mínimo</th>
                                        <th class="text-end">Precio sin IVA</th>
                                        <th class="text-end">Precio con IVA</th>
                                        <th class="text-end">Total Inventario (IVA)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in lista)
                                    {
                                        bool esCritico = item.StockActual <= item.StockMinimo;
                                        <tr class="@(esCritico ? "row-critical" : "")">
                                            <td class="text-start text-light fw-semibold">
                                                @item.Nombre
                                                @if (esCritico)
                                                {
                                                    <span class="badge badge-critical ms-2">
                                                        <i class="bi bi-exclamation-circle me-1"></i>Bajo stock
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-muted-small">@item.Categoria</td>
                                            <td class="text-muted-small">@item.Proveedor</td>
                                            <td class="text-end">@item.StockActual</td>
                                            <td class="text-end text-muted-small">@item.StockMinimo</td>
                                            <td class="text-end text-muted-small">Q @item.PrecioSinIVA.ToString("N2")</td>
                                            <td class="text-end text-muted-small">Q @item.PrecioConIVA.ToString("N2")</td>
                                            <td class="text-end fw-bold text-success">
                                                Q @item.ValorTotal.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="7" class="text-end fw-bold text-muted-small">
                                            Total Inventario (IVA incluido):
                                        </td>
                                        <td class="text-end fw-bold text-accent">
                                            Q @totalInventario.ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card main-card-empty border-0 shadow-sm text-center py-5 mt-2">
                    <div class="icon-empty mb-3">
                        <i class="bi bi-box"></i>
                    </div>
                    <h4 class="text-white mb-2">No se encontraron productos</h4>
                    <p class="text-muted-small mb-4">
                        No hay productos que coincidan con los filtros actuales. Prueba limpiarlos o ajustar los criterios.
                    </p>
                    <button type="button"
                            id="btnLimpiarVacio"
                            class="btn btn-primary-custom rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i> Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function limpiarFiltros() {
                $('select[name="idCategoria"]').val('');
                $('select[name="idProveedor"]').val('');
                $('input[name="nombre"]').val('');
                $('#filtroForm').submit();
            }

            $('#btnLimpiar').on('click', function () {
                limpiarFiltros();
            });

            $('#btnLimpiarVacio').on('click', function () {
                limpiarFiltros();
            });
        });
    </script>
}

@section styles {
    <style>
        :root {
            /* mismos tokens que ventas */
            --inventory-primary: #1C1973;
            --inventory-secondary: #514BF2;
            --inventory-accent: #8B88F2;
            --inventory-bg: #f5f6fa;
            --inventory-card: #ffffff;
            --inventory-text: #212529;
            --inventory-radius: .75rem;
            --muted: #6b7280;
            --border-soft: #e5e7eb;
        }

        /* Fondo claro tipo ventas */
        .reporte-inventario-page {
            background: var(--inventory-bg);
            color: var(--inventory-text);
        }

            /* HEADER aplicado al contenedor existente */
            .reporte-inventario-page > .d-flex.flex-wrap.justify-content-between.align-items-center.mb-4.gap-3 {
                background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
                border: 1px solid rgba(255,255,255,.12);
                border-radius: var(--inventory-radius);
                padding: 1.1rem 1.4rem;
                box-shadow: 0 6px 18px rgba(15,23,42,.18);
                color: #fff;
            }

            .reporte-inventario-page h1 {
                color: #fff;
                margin: 0;
            }

            .reporte-inventario-page .text-muted-small {
                color: rgba(249,250,251,.9) !important;
            }

        /* Icono header */
        .icon-wrapper-main {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(0,0,0,.22);
            color: #e9eaff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Card principal */
        .main-card, .main-card-empty {
            background: var(--inventory-card);
            border: 1px solid var(--border-soft);
            border-radius: var(--inventory-radius);
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            overflow: hidden;
        }

        .border-soft {
            border-color: var(--border-soft) !important;
        }

        .main-card .card-header {
            background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
            color: #fff;
            padding: .85rem 1.15rem;
            border-bottom: 1px solid rgba(0,0,0,.04);
        }

        .icon-wrapper-soft {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .text-label {
            font-size: .8rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        .text-accent {
            color: var(--inventory-secondary) !important;
        }

        .text-muted-small {
            color: var(--muted) !important;
        }

        .input-dark, .input-dark:focus, .input-dark:active {
            background: #fff;
            border: 1px solid var(--border-soft);
            color: #111827;
            box-shadow: none;
        }

            .input-dark::placeholder {
                color: #9aa3b2;
            }

        .btn-primary-custom {
            background: #fff;
            color: var(--inventory-primary);
            border: 1px solid var(--border-soft);
        }

            .btn-primary-custom:hover {
                background: #f9fafb;
                color: var(--inventory-secondary);
                box-shadow: 0 4px 12px rgba(15,23,42,.12);
                border-color: var(--inventory-secondary);
                transform: translateY(-1px);
            }

        .btn-success-custom {
            background: transparent;
            color: var(--inventory-secondary);
            border: 1px solid var(--inventory-secondary);
        }

            .btn-success-custom:hover {
                background: var(--inventory-secondary);
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(81,75,242,.22);
            }

        .btn-outline-warning-custom {
            background: #fff;
            color: #a97900;
            border: 1px solid #f1c40f;
        }

            .btn-outline-warning-custom:hover {
                background: #f1c40f;
                color: #111827;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(241,196,15,.22);
            }

        .btn i {
            margin-right: 4px;
        }

        /* Tarjeta de tabla */
        .table-card {
            background: #fff;
            border: 1px solid var(--border-soft);
            border-radius: .9rem;
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
        }

        /* ===== Overrides fuertes para convertir la table-dark en clara ===== */
        .report-table.table-dark {
            color: #111827 !important;
            background: #fff !important;
        }

            .report-table.table-dark thead tr {
                background: #f3f4ff !important;
            }

            .report-table.table-dark thead th {
                color: #6b7280 !important;
                border-bottom: 1px solid var(--border-soft) !important;
                font-weight: 600;
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .03em;
            }
            /* Forzar color/fondo en TODAS las celdas (incluye Stock) */
            .report-table.table-dark > :not(caption) > * > * {
                color: #111827 !important;
                background-color: #fff !important;
                border-color: var(--border-soft) !important;
            }

            /* ==== Eliminar por completo efectos de hover/animaciones en filas ==== */
            .report-table.table-dark tbody tr {
                transition: none !important;
                cursor: default !important;
            }

                .report-table.table-dark tbody tr:hover {
                    background: transparent !important;
                    transform: none !important;
                    box-shadow: none !important;
                }

            .report-table.table-dark.table-hover > tbody > tr:hover > * {
                background-color: transparent !important;
            }

            /* Ajustes utilidades */
            .report-table.table-dark .text-light {
                color: #111827 !important;
            }

            .report-table.table-dark .text-muted-small {
                color: var(--muted) !important;
            }

            .report-table.table-dark td.text-end {
                color: #111827 !important;
            }

        /* Fila crítica */
        .row-critical {
            background: rgba(231,76,60,.06) !important;
        }

        .badge-critical {
            background-color: #f87171;
            color: #fff;
            font-size: .65rem;
            border-radius: 999px;
            padding: .15rem .55rem;
        }

        /* Stats claras */
        .stat-card {
            background: #fff;
            border: 1px solid var(--border-soft);
            border-radius: .8rem;
            padding: .9rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            box-shadow: 0 2px 8px rgba(15,23,42,.04);
        }

        .stat-label {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--muted);
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827;
        }

        .stat-icon {
            font-size: 1.5rem;
            color: var(--inventory-secondary);
        }

        .border-left-primary-soft {
            border-left: 3px solid var(--inventory-secondary);
        }

        .border-left-info-soft {
            border-left: 3px solid #0ea5e9;
        }

        .border-left-warning-soft {
            border-left: 3px solid #f59e0b;
        }

        /* Empty state */
        .main-card-empty {
            text-align: center;
        }

        .icon-empty {
            width: 80px;
            height: 80px;
            border-radius: 999px;
            margin: 0 auto;
            background: #f3f4ff;
            color: #6b7280;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            border: 1px solid var(--border-soft);
        }

        /* Responsive */
        @@media (max-width:768px) {
            .reporte-inventario-page > .d-flex.flex-wrap.justify-content-between.align-items-center.mb-4.gap-3 {
                padding: .9rem 1rem;
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}
