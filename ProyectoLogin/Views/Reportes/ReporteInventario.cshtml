@model IEnumerable<dynamic>
@using System.Collections.Generic

@{
    ViewData["Title"] = "Reporte de Inventario";
    var categorias = ViewBag.Categorias as List<ProyectoLogin.Models.ModelosProducts.Categoria>;
    var proveedores = ViewBag.Proveedores as List<ProyectoLogin.Models.Proveedor>;

    int? idCategoriaSel = ViewBag.IdCategoria != null ? (int?)ViewBag.IdCategoria : null;
    int? idProveedorSel = ViewBag.IdProveedor != null ? (int?)ViewBag.IdProveedor : null;
    string nombreSel = ViewBag.Nombre as string ?? "";

    decimal totalInventario = 0m;
    if (ViewBag.TotalInventario != null)
    {
        decimal.TryParse(ViewBag.TotalInventario.ToString(), out totalInventario);
    }

    var lista = Model?.ToList() ?? new List<dynamic>();
    var totalProductos = lista.Count;
    var productosBajoMinimo = lista.Count(x => x.StockActual <= x.StockMinimo);
}

<div class="container-fluid py-4 reporte-inventario-page">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-wrapper-main me-3">
                <i class="bi bi-box-seam fs-3"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 fw-bold text-white">Reporte de Inventario</h1>
                <p class="mb-0 text-muted-small">
                    Visualiza el stock actual, valores y productos críticos de SmartCell Company.
                </p>
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left-circle"></i>
            Volver a Reportes
        </a>
    </div>

    <!-- CARD PRINCIPAL -->
    <div class="card main-card shadow-sm border-0">
        <div class="card-header d-flex align-items-center gap-2 border-0">
            <div class="icon-wrapper-soft">
                <i class="bi bi-funnel fs-6"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-semibold text-white">Filtros de inventario</h5>
                <small class="text-muted-small">Filtra por categoría, proveedor o nombre de producto.</small>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- FORMULARIO DE FILTROS -->
            <form asp-action="ReporteInventario"
                  method="get"
                  class="row g-3 mb-4 align-items-end"
                  id="filtroForm">

                <!-- Categoría -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-tags me-1"></i>Categoría
                    </label>
                    <select name="idCategoria" class="form-select input-dark">
                        @if (!idCategoriaSel.HasValue)
                        {
                            <option value="" selected>-- Todas las categorías --</option>
                        }
                        else
                        {
                            <option value="">-- Todas las categorías --</option>
                        }

                        @if (categorias != null)
                        {
                            foreach (var c in categorias)
                            {
                                if (idCategoriaSel.HasValue && idCategoriaSel.Value == c.IdCategoria)
                                {
                                    <option value="@c.IdCategoria" selected>@c.Nombre</option>
                                }
                                else
                                {
                                    <option value="@c.IdCategoria">@c.Nombre</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Proveedor -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-truck me-1"></i>Proveedor
                    </label>
                    <select name="idProveedor" class="form-select input-dark">
                        @if (!idProveedorSel.HasValue)
                        {
                            <option value="" selected>-- Todos los proveedores --</option>
                        }
                        else
                        {
                            <option value="">-- Todos los proveedores --</option>
                        }

                        @if (proveedores != null)
                        {
                            foreach (var p in proveedores)
                            {
                                if (idProveedorSel.HasValue && idProveedorSel.Value == p.IdProveedor)
                                {
                                    <option value="@p.IdProveedor" selected>@p.Nombre</option>
                                }
                                else
                                {
                                    <option value="@p.IdProveedor">@p.Nombre</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Nombre -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-search me-1"></i>Nombre
                    </label>
                    <input type="text"
                           name="nombre"
                           value="@nombreSel"
                           class="form-control input-dark"
                           placeholder="Buscar producto..." />
                </div>

                <!-- BOTONES -->
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2 justify-content-end border-top border-soft pt-3">
                        <button type="submit"
                                class="btn btn-primary-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-search"></i> Filtrar
                        </button>

                        <a asp-action="ReporteInventario"
                           asp-route-pdf="true"
                           class="btn btn-success-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                        </a>

                        <button type="button"
                                id="btnLimpiar"
                                class="btn btn-outline-warning-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-eraser"></i> Limpiar filtros
                        </button>
                    </div>
                </div>
            </form>

            @if (lista.Any())
            {
                <!-- ESTADÍSTICAS RÁPIDAS -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-primary-soft">
                            <div>
                                <div class="stat-label">Total inventario (IVA incluido)</div>
                                <div class="stat-value">Q @totalInventario.ToString("N2")</div>
                            </div>
                            <i class="bi bi-currency-dollar stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-info-soft">
                            <div>
                                <div class="stat-label">Productos listados</div>
                                <div class="stat-value">@totalProductos</div>
                            </div>
                            <i class="bi bi-boxes stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="stat-card border-left-warning-soft">
                            <div>
                                <div class="stat-label">Bajo mínimo</div>
                                <div class="stat-value">@productosBajoMinimo</div>
                            </div>
                            <i class="bi bi-exclamation-triangle stat-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- TABLA -->
                <div class="card table-card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 pb-2">
                        <i class="bi bi-table text-accent"></i>
                        <h6 class="mb-0 fw-semibold text-white">Detalle de inventario</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 report-table">
                                <thead>
                                    <tr>
                                        <th class="text-start">Producto</th>
                                        <th>Categoría</th>
                                        <th>Proveedor</th>
                                        <th class="text-end">Stock</th>
                                        <th class="text-end">Mínimo</th>
                                        <th class="text-end">Precio sin IVA</th>
                                        <th class="text-end">Precio con IVA</th>
                                        <th class="text-end">Total Inventario (IVA)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in lista)
                                    {
                                        bool esCritico = item.StockActual <= item.StockMinimo;
                                        <tr class="@(esCritico ? "row-critical" : "")">
                                            <td class="text-start text-light fw-semibold">
                                                @item.Nombre
                                                @if (esCritico)
                                                {
                                                    <span class="badge badge-critical ms-2">
                                                        <i class="bi bi-exclamation-circle me-1"></i>Bajo stock
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-muted-small">@item.Categoria</td>
                                            <td class="text-muted-small">@item.Proveedor</td>
                                            <td class="text-end">@item.StockActual</td>
                                            <td class="text-end text-muted-small">@item.StockMinimo</td>
                                            <td class="text-end text-muted-small">Q @item.PrecioSinIVA.ToString("N2")</td>
                                            <td class="text-end text-muted-small">Q @item.PrecioConIVA.ToString("N2")</td>
                                            <td class="text-end fw-bold text-success">
                                                Q @item.ValorTotal.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="7" class="text-end fw-bold text-muted-small">
                                            Total Inventario (IVA incluido):
                                        </td>
                                        <td class="text-end fw-bold text-accent">
                                            Q @totalInventario.ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card main-card-empty border-0 shadow-sm text-center py-5 mt-2">
                    <div class="icon-empty mb-3">
                        <i class="bi bi-box"></i>
                    </div>
                    <h4 class="text-white mb-2">No se encontraron productos</h4>
                    <p class="text-muted-small mb-4">
                        No hay productos que coincidan con los filtros actuales. Prueba limpiarlos o ajustar los criterios.
                    </p>
                    <button type="button"
                            id="btnLimpiarVacio"
                            class="btn btn-primary-custom rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i> Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function limpiarFiltros() {
                $('select[name="idCategoria"]').val('');
                $('select[name="idProveedor"]').val('');
                $('input[name="nombre"]').val('');
                $('#filtroForm').submit();
            }

            $('#btnLimpiar').on('click', function () {
                limpiarFiltros();
            });

            $('#btnLimpiarVacio').on('click', function () {
                limpiarFiltros();
            });
        });
    </script>
}

@section styles{
    <style>
        :root {
            --primary-blue: #1C1973;
            --secondary-blue: #514BF2;
            --accent-blue: #8B88F2;
            --dark-bg: #0D0E26;
            --alt-bg: #081C59;
            --light-text: #F0F0F7;
            --muted-text: #9ba4c4;
            --border-soft: rgba(139, 136, 242, 0.22);
            --card-bg: #0F122F;
            --card-bg-soft: #151838;
            --danger-soft: rgba(231, 76, 60, 0.16);
        }

        .reporte-inventario-page {
            color: var(--light-text);
        }

        .icon-wrapper-main {
            width: 52px;
            height: 52px;
            border-radius: 999px;
            background: radial-gradient(circle at 20% 0, var(--secondary-blue), transparent), rgba(12, 18, 58, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.55);
        }

        .icon-wrapper-soft {
            width: 32px;
            height: 32px;
            border-radius: 999px;
            background: rgba(81, 75, 242, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
        }

        .main-card,
        .main-card-empty {
            background: linear-gradient(145deg, #0D0E26, #111433);
            border-radius: 1rem;
            border: 1px solid var(--border-soft);
        }

        .border-soft {
            border-color: var(--border-soft) !important;
        }

        .text-label {
            color: var(--muted-text);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .text-muted-small {
            color: var(--muted-text) !important;
            font-size: 0.85rem;
        }

        .text-accent {
            color: var(--accent-blue) !important;
        }

        .input-dark,
        .input-dark:focus,
        .input-dark:active {
            background-color: #080a1c;
            border: 1px solid rgba(139, 136, 242, 0.32);
            color: var(--light-text);
            box-shadow: none;
        }

            .input-dark::placeholder {
                color: rgba(155, 164, 196, 0.7);
            }

        .btn-primary-custom {
            background: var(--secondary-blue);
            border-color: var(--secondary-blue);
            color: #fff;
        }

            .btn-primary-custom:hover {
                background: #3c36cc;
                border-color: #3c36cc;
            }

        .btn-success-custom {
            background: #27ae60;
            border-color: #27ae60;
            color: #fff;
        }

            .btn-success-custom:hover {
                background: #1f8a4d;
                border-color: #1f8a4d;
            }

        .btn-outline-warning-custom {
            border-color: #f1c40f;
            color: #f1c40f;
        }

            .btn-outline-warning-custom:hover {
                background-color: #f1c40f;
                color: #111433;
            }

        .table-card {
            background-color: var(--card-bg);
            border-radius: 0.9rem;
            border: 1px solid rgba(139, 136, 242, 0.18);
        }

        .report-table thead tr {
            background: rgba(8, 12, 40, 0.98);
        }

        .report-table thead th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted-text);
            border-bottom-color: rgba(139, 136, 242, 0.35);
        }

        .report-table tbody tr {
            transition: all 0.15s ease-in-out;
        }

            .report-table tbody tr:hover {
                background: radial-gradient(circle at 0 0, rgba(81, 75, 242, 0.14), transparent);
                transform: translateY(-1px);
            }

        .row-critical {
            background: var(--danger-soft);
        }

        .badge-critical {
            background-color: rgba(231, 76, 60, 0.9);
            color: #fff;
            font-size: 0.65rem;
            border-radius: 999px;
            padding: 0.15rem 0.55rem;
        }

        .stat-card {
            background: var(--card-bg);
            border-radius: 0.8rem;
            padding: 0.9rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border: 1px solid rgba(139, 136, 242, 0.18);
        }

        .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--muted-text);
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--light-text);
        }

        .stat-icon {
            font-size: 1.5rem;
            color: var(--accent-blue);
        }

        .border-left-primary-soft {
            border-left: 3px solid var(--secondary-blue);
        }

        .border-left-info-soft {
            border-left: 3px solid #3498db;
        }

        .border-left-warning-soft {
            border-left: 3px solid #f1c40f;
        }

        .icon-empty {
            width: 90px;
            height: 90px;
            border-radius: 999px;
            background: radial-gradient(circle at 30% 0, var(--accent-blue), transparent), rgba(8, 12, 40, 0.96);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--muted-text);
            font-size: 2.4rem;
            margin: 0 auto;
        }

        .btn i {
            margin-right: 4px;
        }
    </style>

}
