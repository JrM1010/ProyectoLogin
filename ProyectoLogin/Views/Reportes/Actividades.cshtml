@model IEnumerable<ProyectoLogin.Models.BitacoraMovimiento>

@{
    ViewData["Title"] = "Reporte de Actividades de Usuarios";

    var actividades = Model?.ToList() ?? new List<ProyectoLogin.Models.BitacoraMovimiento>();
    string idUsuarioQuery = Context.Request.Query["idUsuario"].ToString();

    var totalActividades = actividades.Count;
    var usuariosUnicos = actividades
        .Where(a => a.IdUsuario != 0)
        .Select(a => a.IdUsuario)
        .Distinct()
        .Count();

    var ultimas24Horas = actividades
        .Count(a => a.Fecha >= DateTime.Now.AddHours(-24));
}

<div class="container-fluid py-2 inventory-theme">
    <!-- HEADER (igual estilo ventas) -->
    <div class="page-header">
        <div>
            <h1>
                <i class="bi bi-list-check"></i>
                Reporte de Actividades de Usuarios
            </h1>
            <div class="subtitle">Monitorea acciones realizadas en el sistema por usuario, módulo y fecha.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-create-outline">
                <i class="bi bi-arrow-left me-1"></i> Volver a Reportes
            </a>
        </div>
    </div>

    <!-- CARD FILTROS + RESULTADOS (estética ventas/productos) -->
    <div class="inventory-card">
        <div class="card-head">
            <i class="bi bi-receipt fs-5"></i>
            <h3 class="title">Filtros y resultados de actividades</h3>
        </div>

        <div class="p-3 p-md-4">
            <!-- FORMULARIO DE FILTROS (search-card clara) -->
            <div class="search-card">
                <form method="get" class="row g-3 align-items-end" id="filtroForm">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold inv-search-label">
                            <i class="bi bi-calendar-date me-1"></i>Desde
                        </label>
                        <input type="date" name="desde" class="form-control" value="@Context.Request.Query["desde"]" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold inv-search-label">
                            <i class="bi bi-calendar-date me-1"></i>Hasta
                        </label>
                        <input type="date" name="hasta" class="form-control" value="@Context.Request.Query["hasta"]" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold inv-search-label">
                            <i class="bi bi-person-badge me-1"></i>Usuario
                        </label>
                        <select name="idUsuario" class="form-select">
                            @if (string.IsNullOrEmpty(idUsuarioQuery))
                            {
                                <option value="" selected>-- Todos los usuarios --</option>
                            }
                            else
                            {
                                <option value="">-- Todos los usuarios --</option>
                            }

                            @if (ViewBag.Usuarios != null)
                            {
                                foreach (var u in ViewBag.Usuarios)
                                {
                                    string idStr = u.IdUsuario.ToString();
                                    if (idUsuarioQuery == idStr)
                                    {
                                        <option value="@idStr" selected>@u.NombreUsuario</option>
                                    }
                                    else
                                    {
                                        <option value="@idStr">@u.NombreUsuario</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- BOTONES -->
                    <div class="col-md-3 d-flex flex-wrap gap-2 justify-content-end align-items-end">
                        <button type="submit" class="btn btn-create-primary d-inline-flex align-items-center gap-2">
                            <i class="bi bi-search"></i> Filtrar
                        </button>

                        <button type="button" id="btnLimpiar" class="btn btn-create-outline d-inline-flex align-items-center gap-2">
                            <i class="bi bi-eraser"></i> Limpiar
                        </button>
                    </div>
                </form>
            </div>

            @if (actividades.Any())
            {
                <!-- ESTADÍSTICAS RÁPIDAS (claras, como ventas) -->
                <div class="row g-3 mb-3">
                    <div class="col-xl-4 col-md-6">
                        <div class="statcard-light border-left-info-soft">
                            <div>
                                <div class="stat-label">Actividades registradas</div>
                                <div class="stat-value">@totalActividades</div>
                            </div>
                            <i class="bi bi-list-ul stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="statcard-light border-left-primary-soft">
                            <div>
                                <div class="stat-label">Usuarios involucrados</div>
                                <div class="stat-value">@usuariosUnicos</div>
                            </div>
                            <i class="bi bi-people stat-icon"></i>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="statcard-light border-left-success-soft">
                            <div>
                                <div class="stat-label">Últimas 24 horas</div>
                                <div class="stat-value">@ultimas24Horas</div>
                            </div>
                            <i class="bi bi-clock-history stat-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- TABLA DE RESULTADOS (clara, estilo ventas) -->
                <div class="inventory-card">
                    <div class="card-head">
                        <i class="bi bi-table fs-5"></i>
                        <h3 class="title">Detalle de actividades</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 report-table">
                            <thead>
                                <tr>
                                    <th class="ps-4">Fecha</th>
                                    <th class="text-start">Usuario</th>
                                    <th>Módulo</th>
                                    <th>Acción</th>
                                    <th class="text-start">Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in actividades)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <small class="text-muted">@m.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td class="text-start">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-circle" style="color:var(--inventory-secondary);"></i>
                                                <span class="fw-medium">@(m.Usuario?.NombreUsuario ?? "-")</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-soft text-dark">@m.Modulo</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark rounded-pill px-3">@m.Accion</span>
                                        </td>
                                        <td class="text-start text-muted">@m.Descripcion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <!-- VACÍO (igual patrón ventas) -->
                <div class="inventory-card text-center py-5">
                    <div class="p-3">
                        <i class="bi bi-search" style="font-size:2rem;color:#6b7280"></i>
                    </div>
                    <h4 class="mb-2">No se encontraron actividades</h4>
                    <p class="text-muted mb-4">No hay registros que coincidan con los filtros aplicados.</p>
                    <button type="button" id="btnLimpiarVacio" class="btn btn-create-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i> Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function limpiar() {
                const desde = document.querySelector('input[name="desde"]');
                const hasta = document.querySelector('input[name="hasta"]');
                const user  = document.querySelector('select[name="idUsuario"]');
                if (desde) desde.value = '';
                if (hasta) hasta.value = '';
                if (user)  user.value  = '';
                document.getElementById('filtroForm').submit();
            }

            function validarRango(e) {
                const desde = document.querySelector('input[name="desde"]');
                const hasta = document.querySelector('input[name="hasta"]');
                if (desde && hasta && desde.value && hasta.value && new Date(desde.value) > new Date(hasta.value)) {
                    e.preventDefault();
                    alert('La fecha "Desde" no puede ser mayor que la fecha "Hasta".');
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                const btn = document.getElementById('btnLimpiar');
                if (btn) btn.addEventListener('click', limpiar);

                const btnVacio = document.getElementById('btnLimpiarVacio');
                if (btnVacio) btnVacio.addEventListener('click', limpiar);

                const form = document.getElementById('filtroForm');
                if (form) form.addEventListener('submit', validarRango);
            });
        })();
    </script>
}

@section Styles {
    <style>
        :root {
            --inventory-primary: #1C1973;
            --inventory-secondary: #514BF2;
            --inventory-accent: #8B88F2;
            --inventory-bg: #f5f6fa;
            --inventory-card: #ffffff;
            --inventory-text: #212529;
            --inventory-radius: .75rem;
            --muted: #6b7280;
            --border-soft: #e5e7eb;
        }

        /* Fondo general como ventas */
        .inventory-theme {
            background: var(--inventory-bg);
        }

        /* Header gradiente (igual ventas) */
        .page-header {
            background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
            border: 1px solid rgba(255,255,255,.12);
            border-radius: var(--inventory-radius);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1rem;
            box-shadow: 0 6px 18px rgba(15,23,42,.18);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #fff;
        }

            .page-header h1 {
                font-size: 1.3rem;
                margin: 0;
                display: flex;
                align-items: center;
                gap: .4rem;
                font-weight: 700;
                color: #fff
            }

            .page-header .subtitle {
                color: rgba(249,250,251,.9);
                font-size: .85rem;
                margin-top: .15rem
            }

            .page-header .btn {
                font-size: .86rem;
                border-radius: var(--inventory-radius);
                padding: .5rem 1rem
            }

        /* Botones coherentes (ventas) */
        .btn-create-outline {
            border: 1px solid var(--inventory-accent);
            background: transparent;
            color: #fff;
            border-radius: var(--inventory-radius);
            font-weight: 500;
            padding: .5rem 1.4rem;
            font-size: .86rem;
            transition: .25s;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            text-decoration: none
        }

            .btn-create-outline:hover {
                background: rgba(139,136,242,.16);
                color: #fff;
                box-shadow: 0 4px 10px rgba(15,23,42,.25);
                transform: translateY(-1px)
            }

        .btn-create-primary {
            background: #fff;
            color: var(--inventory-primary);
            border: none;
            border-radius: var(--inventory-radius);
            font-weight: 600;
            padding: .5rem 1.4rem;
            font-size: .86rem;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: .25s;
            text-decoration: none
        }

            .btn-create-primary:hover {
                background: #f9fafb;
                color: var(--inventory-secondary);
                box-shadow: 0 4px 12px rgba(15,23,42,.25);
                transform: translateY(-1px)
            }

        /* Card clara tipo inventario */
        .inventory-card {
            background: var(--inventory-card);
            border: 1px solid var(--border-soft);
            border-radius: var(--inventory-radius);
            overflow: hidden;
            margin-bottom: 1.1rem;
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            transition: .22s
        }

            .inventory-card:hover {
                box-shadow: 0 7px 20px rgba(15,23,42,.10);
                transform: translateY(-1px)
            }

            .inventory-card .card-head {
                display: flex;
                align-items: center;
                gap: .75rem;
                padding: .85rem 1.15rem;
                border-bottom: 1px solid rgba(0,0,0,.04);
                background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
                color: #fff
            }

                .inventory-card .card-head .title {
                    margin: 0;
                    font-size: 1rem;
                    font-weight: 700;
                    color: #fff
                }

        /* “search-card” para filtros */
        .search-card {
            background: var(--inventory-card);
            border: 1px solid var(--border-soft);
            border-radius: var(--inventory-radius);
            padding: 1rem 1.1rem;
            margin-bottom: 1.1rem;
            box-shadow: 0 2px 8px rgba(15,23,42,.04);
        }

        .inv-search-label {
            font-size: .8rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: .25rem
        }

        /* Tabla clara como ventas */
        .table {
            margin-bottom: 0;
            font-size: .85rem;
            color: #111827
        }

            .table thead th {
                background: #f3f4ff;
                font-weight: 600;
                font-size: .78rem;
                border-bottom: 1px solid var(--border-soft);
                white-space: nowrap;
                text-transform: uppercase;
                letter-spacing: .03em;
                color: #6b7280
            }

            .table tbody td {
                vertical-align: middle;
                border-color: var(--border-soft)
            }

        .table-hover tbody tr:hover {
            background-color: #f9fafb
        }

        /* Badges suaves */
        .badge.bg-soft {
            background-color: rgba(81,75,242,.12);
        }

        /* Stats claras */
        .statcard-light {
            background: #fff;
            border-radius: .8rem;
            padding: .9rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            border: 1px solid var(--border-soft)
        }

        .stat-label {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--muted)
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827
        }

        .stat-icon {
            font-size: 1.5rem;
            color: var(--inventory-secondary)
        }

        .border-left-primary-soft {
            border-left: 3px solid var(--inventory-secondary)
        }

        .border-left-success-soft {
            border-left: 3px solid #22c55e
        }

        .border-left-info-soft {
            border-left: 3px solid #0ea5e9
        }

        /* ===== Overrides de visibilidad en la tarjeta de filtros (para el botón Limpiar) ===== */
        .search-card .btn-create-outline {
            color: var(--inventory-primary) !important;
            border-color: var(--inventory-accent) !important;
            background: #ffffff !important;
        }

            .search-card .btn-create-outline:hover {
                background: var(--inventory-accent) !important;
                color: #101232 !important;
                box-shadow: 0 4px 10px rgba(15,23,42,.16);
                transform: translateY(-1px);
            }

        /* Responsive como ventas */
        @@media (max-width:768px) {
            .page-header {
                flex-direction: column;
                align-items: flex-start;
                padding: .9rem 1rem
            }

                .page-header h1 {
                    font-size: 1.1rem
                }

                .page-header .subtitle {
                    font-size: .8rem
                }

            .search-card {
                padding: .8rem .9rem
            }
        }
    </style>
}
