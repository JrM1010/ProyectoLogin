@model IEnumerable<dynamic>
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "Reporte de Compras por Proveedor";
    var proveedores = ViewBag.Proveedores as List<Proveedor>;
    var totalGeneral = ViewBag.TotalGeneral ?? 0m;

    var comprasList = Model?.ToList() ?? new List<dynamic>();
    var totalCompras = comprasList.Count;
    var proveedoresConCompra = comprasList
        .Select(c => (string)c.Proveedor)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct()
        .Count();
}

<div class="container-fluid py-4 reportes-compras-page">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-wrapper-main me-3">
                <i class="bi bi-basket2-fill fs-3"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 fw-bold text-white">@ViewData["Title"]</h1>
                <p class="mb-0 text-muted-small">
                    Consulta, filtra y analiza las compras realizadas a tus proveedores.
                </p>
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left-circle"></i>
            Volver a Reportes
        </a>
    </div>

    <div class="card main-card shadow-sm border-0">
        <div class="card-header d-flex align-items-center gap-2 border-0">
            <div class="icon-wrapper-soft">
                <i class="bi bi-funnel fs-6"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-semibold text-white">Filtros y resultados de compras</h5>
                <small class="text-muted-small">Refina tu búsqueda por fecha y proveedor.</small>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- FORMULARIO DE FILTROS -->
            <form id="filtroForm" method="get" asp-action="Compras" class="row g-3 mb-4 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-calendar-date me-1"></i>Fecha desde
                    </label>
                    <input type="date"
                           class="form-control input-dark"
                           id="desde"
                           name="desde"
                           value="@Context.Request.Query["desde"]" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-calendar-date me-1"></i>Fecha hasta
                    </label>
                    <input type="date"
                           class="form-control input-dark"
                           id="hasta"
                           name="hasta"
                           value="@Context.Request.Query["hasta"]" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold text-label">
                        <i class="bi bi-truck me-1"></i>Proveedor
                    </label>
                    <select class="form-select input-dark" id="proveedorId" name="proveedorId">
                        @{
                            var proveedorIdQuery = Context.Request.Query["proveedorId"].ToString();
                        }

                        @if (string.IsNullOrEmpty(proveedorIdQuery))
                        {
                            <option value="" selected>-- Todos los proveedores --</option>
                        }
                        else
                        {
                            <option value="">-- Todos los proveedores --</option>
                        }

                        @if (proveedores != null)
                        {
                            foreach (var proveedor in proveedores)
                            {
                                var isSelected = proveedorIdQuery == proveedor.IdProveedor.ToString();
                                if (isSelected)
                                {
                                    <option value="@proveedor.IdProveedor" selected>@proveedor.Nombre</option>
                                }
                                else
                                {
                                    <option value="@proveedor.IdProveedor">@proveedor.Nombre</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- BOTONES -->
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2 justify-content-end border-top border-soft pt-3">
                        <button type="submit"
                                class="btn btn-primary-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-search"></i>
                            Filtrar
                        </button>

                        <button type="button"
                                id="btnDescargarPDF"
                                class="btn btn-success-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Descargar PDF
                        </button>

                        <button type="button"
                                id="btnLimpiar"
                                class="btn btn-outline-warning-custom rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-eraser"></i>
                            Limpiar filtros
                        </button>
                    </div>
                </div>
            </form>

            @if (comprasList.Any())
            {
            <!-- ESTADÍSTICAS RÁPIDAS -->
            <div class="row g-3 mb-4">
                <div class="col-xl-4 col-md-6">
                    <div class="stat-card border-left-primary-soft">
                        <div>
                            <div class="stat-label">Total general compras</div>
                            <div class="stat-value">Q @totalGeneral.ToString("N2")</div>
                        </div>
                        <i class="bi bi-currency-dollar stat-icon"></i>
                    </div>
                </div>
                <div class="col-xl-4 col-md-6">
                    <div class="stat-card border-left-info-soft">
                        <div>
                            <div class="stat-label">Compras encontradas</div>
                            <div class="stat-value">@totalCompras</div>
                        </div>
                        <i class="bi bi-receipt stat-icon"></i>
                    </div>
                </div>
                <div class="col-xl-4 col-md-6">
                    <div class="stat-card border-left-success-soft">
                        <div>
                            <div class="stat-label">Proveedores involucrados</div>
                            <div class="stat-value">@proveedoresConCompra</div>
                        </div>
                        <i class="bi bi-truck-front stat-icon"></i>
                    </div>
                </div>
            </div>

                <!-- FUNCIÓN AUXILIAR PARA PRODUCTOS -->
            @functions {
                string GetProductos(dynamic detalles)
                {
                    var lista = new List<string>();
                    foreach (var d in detalles)
                        lista.Add((string)d.Producto);
                    return string.Join(", ", lista);
                }
            }

            <!-- TABLA DE RESULTADOS -->
            <div class="card table-card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 pb-2">
                    <i class="bi bi-table text-accent"></i>
                    <h6 class="mb-0 fw-semibold text-white">Resultados de compras</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 report-table" id="tablaCompras">
                            <thead>
                                <tr>
                                    <th>No. Compra</th>
                                    <th>Fecha</th>
                                    <th>Proveedor</th>
                                    <th>Productos comprados</th>
                                    <th style="width: 130px;">Detalles</th>
                                    <th class="text-end">Total compra</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var compra in comprasList)
                                {
                                    var detalleId = $"detalles-{compra.GetHashCode()}";
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-accent">@compra.Numero</span>
                                        </td>
                                        <td>
                                            <small class="text-muted-small">
                                                @compra.Fecha.ToString("dd/MM/yyyy")
                                            </small>
                                        </td>
                                        <td>
                                            <strong class="text-light">@compra.Proveedor</strong>
                                        </td>
                                        <td class="text-muted-small text-start">
                                            @GetProductos(compra.Detalles)
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs-detail btn-outline-info rounded-pill"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@detalleId"
                                                    aria-expanded="false"
                                                    aria-controls="@detalleId">
                                                <i class="bi bi-list-ul me-1"></i>Detalles
                                            </button>
                                        </td>
                                        <td class="fw-bold text-success text-end">
                                            Q @compra.TotalCompra.ToString("N2")
                                        </td>
                                    </tr>

                                    <tr class="fila-detalle">
                                        <td colspan="6" class="p-0 border-0">
                                            <div class="collapse" id="@detalleId">
                                                <div class="p-3">
                                                    <div class="card detalle-card border-0 shadow-sm">
                                                        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2">
                                                            <i class="bi bi-box-seam text-accent"></i>
                                                            <h6 class="mb-0 fw-semibold text-white">
                                                                Detalles de la compra — Compra:
                                                                <span class="text-accent fw-bold">@compra.Numero</span>
                                                            </h6>
                                                        </div>
                                                        <div class="card-body pt-2">
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-dark table-striped align-middle mb-0">
                                                                    <thead>
                                                                        <tr>
                                                                            <th class="text-start">Producto</th>
                                                                            <th class="text-center">Cantidad</th>
                                                                            <th>Unidad</th>
                                                                            <th class="text-end">Precio compra</th>
                                                                            <th class="text-end">Unidades base</th>
                                                                            <th class="text-end">PV sin IVA</th>
                                                                            <th class="text-end">PV con IVA</th>
                                                                            <th class="text-end">PV Unidad</th>
                                                                            <th class="text-end">PV Paquete</th>
                                                                            <th class="text-end">PV Caja</th>
                                                                            <th class="text-end">Subtotal</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var detalle in compra.Detalles)
                                                                        {
                                                                            <tr>
                                                                                <td class="text-start text-light">
                                                                                    @detalle.Producto
                                                                                </td>
                                                                                <td class="text-center">
                                                                                    <span class="badge bg-primary rounded-pill">
                                                                                        @detalle.Cantidad
                                                                                    </span>
                                                                                </td>
                                                                                <td>@detalle.Unidad</td>
                                                                                <td class="text-end text-muted-small">
                                                                                    Q @detalle.PrecioCompraUnit.ToString("N2")
                                                                                </td>
                                                                                <td class="text-end text-muted-small">
                                                                                    @detalle.CantidadUnidadesBase.ToString("N2")
                                                                                </td>
                                                                                <td class="text-end text-muted-small">
                                                                                    Q @detalle.PrecioVentaSinIVA.ToString("N2")
                                                                                </td>
                                                                                <td class="text-end text-muted-small">
                                                                                    Q @detalle.PrecioVentaConIVA.ToString("N2")
                                                                                </td>
                                                                                <td class="text-end text-muted-small">
                                                                                    Q @detalle.PrecioVentaUnidad.ToString("N2")
                                                                                </td>
                                                                                <td class="text-end text-muted-small">
                                                                                    Q @detalle.PrecioVentaPaquete.ToString("N2")
                                                                                </td>
                                                                                <td class="text-end text-muted-small">
                                                                                    Q @detalle.PrecioVentaCaja.ToString("N2")
                                                                                </td>
                                                                                <td class="text-end fw-semibold text-success">
                                                                                    Q @detalle.Subtotal.ToString("N2")
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end fw-bold text-muted-small">
                                        TOTAL GENERAL:
                                    </td>
                                    <td class="text-end fw-bold text-warning">
                                        Q @totalGeneral.ToString("N2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
                        }
                        else
            {
                <div class="card main-card-empty border-0 shadow-sm text-center py-5">
                    <div class="icon-empty mb-3">
                        <i class="bi bi-search"></i>
                    </div>
                    <h4 class="text-white mb-2">No se encontraron compras</h4>
                    <p class="text-muted-small mb-4">
                        No hay registros que coincidan con los filtros aplicados. Ajusta las fechas o el proveedor.
                    </p>
                    <button type="button"
                            id="btnLimpiarVacio"
                            class="btn btn-primary-custom rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i>
                        Limpiar filtros
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            function limpiarFiltros() {
                $('#desde').val('');
                $('#hasta').val('');
                $('#proveedorId').val('');
                $('#filtroForm').submit();
            }

            $('#btnLimpiar').click(function () {
                limpiarFiltros();
            });

            $('#btnLimpiarVacio').click(function () {
                limpiarFiltros();
            });

            // Descargar PDF (misma lógica existente)
            $('#btnDescargarPDF').click(function () {
                const desde = $('#desde').val();
                const hasta = $('#hasta').val();
                const proveedorId = $('#proveedorId').val();

                let url = '@Url.Action("DescargarComprasPDF", "Reportes")';
                const params = new URLSearchParams();

                if (desde) params.append('desde', desde);
                if (hasta) params.append('hasta', hasta);
                if (proveedorId) params.append('proveedorId', proveedorId);

                if (params.toString()) url += '?' + params.toString();
                window.location.href = url;
            });

            // Validación de rango de fechas
            $('#filtroForm').submit(function (e) {
                const desde = $('#desde').val();
                const hasta = $('#hasta').val();
                if (desde && hasta && new Date(desde) > new Date(hasta)) {
                    e.preventDefault();
                    alert('La fecha "Desde" no puede ser mayor a la fecha "Hasta".');
                }
            });

            // Toggle texto del botón de detalles
            $(document).on('click', '[data-bs-toggle="collapse"]', function () {
                const $btn = $(this);
                const target = $btn.data('bs-target');
                const $collapse = $(target);

                setTimeout(function () {
                    if ($collapse.hasClass('show')) {
                        $btn.html('<i class="bi bi-chevron-up me-1"></i>Ocultar');
                    } else {
                        $btn.html('<i class="bi bi-list-ul me-1"></i>Detalles');
                    }
                }, 200);
            });

            // DataTable (se mantiene funcionalidad original)
            @if (comprasList.Any())
            {
                    <text>
                    if ($.fn.DataTable) {
                        $('#tablaCompras').DataTable({
                            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                            order: [[0, 'desc']],
                            pageLength: 10,
                            responsive: true
                        });
                    }
                    </text>
            }
        });
    </script>

    <style>
        :root {
            --primary-blue: #1C1973;
            --secondary-blue: #514BF2;
            --accent-blue: #8B88F2;
            --dark-bg: #0D0E26;
            --alt-bg: #081C59;
            --light-text: #F0F0F7;
            --muted-text: #9ba4c4;
            --border-soft: rgba(139, 136, 242, 0.22);
            --card-bg: #0F122F;
            --card-bg-soft: #151838;
        }

        .reportes-compras-page {
            color: var(--light-text);
        }

        .icon-wrapper-main {
            width: 52px;
            height: 52px;
            border-radius: 999px;
            background: radial-gradient(circle at 20% 0, var(--secondary-blue), transparent), rgba(12, 18, 58, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.55);
        }

        .icon-wrapper-soft {
            width: 32px;
            height: 32px;
            border-radius: 999px;
            background: rgba(81, 75, 242, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
        }

        .main-card,
        .main-card-empty {
            background: linear-gradient(145deg, #0D0E26, #111433);
            border-radius: 1rem;
            border: 1px solid var(--border-soft);
        }

        .border-soft {
            border-color: var(--border-soft) !important;
        }

        .text-label {
            color: var(--muted-text);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .text-muted-small {
            color: var(--muted-text) !important;
            font-size: 0.85rem;
        }

        .text-accent {
            color: var(--accent-blue) !important;
        }

        .input-dark,
        .input-dark:focus,
        .input-dark:active {
            background-color: #080a1c;
            border: 1px solid rgba(139, 136, 242, 0.32);
            color: var(--light-text);
            box-shadow: none;
        }

            .input-dark::placeholder {
                color: rgba(155, 164, 196, 0.7);
            }

        .btn-primary-custom {
            background: var(--secondary-blue);
            border-color: var(--secondary-blue);
            color: #fff;
        }

            .btn-primary-custom:hover {
                background: #3c36cc;
                border-color: #3c36cc;
            }

        .btn-success-custom {
            background: #27ae60;
            border-color: #27ae60;
            color: #fff;
        }

            .btn-success-custom:hover {
                background: #1f8a4d;
                border-color: #1f8a4d;
            }

        .btn-outline-warning-custom {
            border-color: #f1c40f;
            color: #f1c40f;
        }

            .btn-outline-warning-custom:hover {
                background-color: #f1c40f;
                color: #111433;
            }

        .btn-xs-detail {
            padding: 0.25rem 0.7rem;
            font-size: 0.75rem;
        }

        .table-card {
            background-color: var(--card-bg);
            border-radius: 0.9rem;
            border: 1px solid rgba(139, 136, 242, 0.18);
        }

        .report-table thead tr {
            background: rgba(8, 12, 40, 0.98);
        }

        .report-table thead th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted-text);
            border-bottom-color: rgba(139, 136, 242, 0.35);
        }

        .report-table tbody tr {
            transition: all 0.15s ease-in-out;
        }

            .report-table tbody tr:hover {
                background: radial-gradient(circle at 0 0, rgba(81, 75, 242, 0.14), transparent);
                transform: translateY(-1px);
            }

        .fila-detalle {
            background: #080a1c;
        }

        .detalle-card {
            background: var(--card-bg-soft);
            border-radius: 0.8rem;
            border: 1px solid rgba(139, 136, 242, 0.22);
        }

        .stat-card {
            background: var(--card-bg);
            border-radius: 0.8rem;
            padding: 0.9rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border: 1px solid rgba(139, 136, 242, 0.18);
        }

        .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--muted-text);
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--light-text);
        }

        .stat-icon {
            font-size: 1.5rem;
            color: var(--accent-blue);
        }

        .border-left-primary-soft {
            border-left: 3px solid var(--secondary-blue);
        }

        .border-left-success-soft {
            border-left: 3px solid #27ae60;
        }

        .border-left-info-soft {
            border-left: 3px solid #3498db;
        }

        .icon-empty {
            width: 90px;
            height: 90px;
            border-radius: 999px;
            background: radial-gradient(circle at 30% 0, var(--accent-blue), transparent), rgba(8, 12, 40, 0.96);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--muted-text);
            font-size: 2.4rem;
            margin: 0 auto;
        }
    </style>
}
