@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Reporte de Compras por Proveedor";
    var proveedores = ViewBag.Proveedores as List<Proveedor>;
    var totalGeneral = ViewBag.TotalGeneral ?? 0m;
}

<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold text-primary">
                <i class="bi bi-basket"></i> @ViewData["Title"]
            </h5>
        </div>

        <div class="card-body">
            <!-- 🔹 Formulario de filtros -->
            <form id="filtroForm" method="get" asp-action="Compras" class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Fecha Desde</label>
                    <input type="date" class="form-control" id="desde" name="desde"
                           value="@Context.Request.Query["desde"]" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Fecha Hasta</label>
                    <input type="date" class="form-control" id="hasta" name="hasta"
                           value="@Context.Request.Query["hasta"]" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Proveedor</label>
                    <select class="form-select" id="proveedorId" name="proveedorId">
                        <option value="">-- Todos los proveedores --</option>
                        @if (proveedores != null)
                        {
                            foreach (var proveedor in proveedores)
                            {
                                var selected = Context.Request.Query["proveedorId"] == proveedor.IdProveedor.ToString();
                                <option value="@proveedor.IdProveedor" selected="@selected">@proveedor.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <!-- 🔘 Botones -->
                <div class="col-12 mt-3 d-flex flex-wrap gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Filtrar
                    </button>

                    <button type="button" id="btnDescargarPDF" class="btn btn-success me-2">
                        <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                    </button>

                    <button type="button" id="btnLimpiar" class="btn btn-warning me-2">
                        <i class="bi bi-eraser"></i> Limpiar Filtros
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Volver a Reportes
                    </a>
                </div>
            </form>


            <!-- 🔹 Tabla de resultados -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive mt-4">

                @functions {
                    string GetProductos(dynamic detalles)
                    {
                        var lista = new List<string>();
                        foreach (var d in detalles)
                            lista.Add((string)d.Producto);
                        return string.Join(", ", lista);
                    }
                }
                    <table class="table table-bordered table-hover align-middle text-center" id="tablaCompras">
                        <thead class="table-dark">
                            <tr>
                                <th>No. Compra</th>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                                <th>Productos Comprados</th>
                                <th>Detalles</th>
                                <th>Total Compra</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var compra in Model)
                            {
                                <tr>
                                    <td>@compra.Numero</td> <!-- 🔹 nuevo -->
                                    <td>@compra.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><strong>@compra.Proveedor</strong></td>
                                    <td class="text-muted">
                                        <td class="text-muted">@GetProductos(compra.Detalles)</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-info"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#detalles-@(compra.GetHashCode())">
                                            <i class="bi bi-list-ul"></i> Ver Detalles
                                        </button>
                                    </td>
                                    <td class="fw-bold text-success text-end">Q @compra.TotalCompra.ToString("N2")</td>
                                </tr>

                                <tr class="bg-light">
                                    <td colspan="5" class="p-0 border-0">
                                        <div class="collapse" id="detalles-@(compra.GetHashCode())">
                                            <div class="d-flex justify-content-center py-3">
                                                <div class="card shadow-sm border-0 w-75">
                                                    <div class="card-body">
                                                        <h6 class="text-primary mb-3 text-center">
                                                            <i class="bi bi-box-seam"></i> Detalles de la Compra
                                                        </h6>
                                                        <div class="table-responsive">

                                                    
                                                            <table class="table table-sm table-bordered align-middle text-center">
                                                                <thead class="table-secondary">
                                                                    <tr>
                                                                        <th>Producto</th>
                                                                        <th class="text-center">Cantidad</th>
                                                                        <th>Unidad</th>
                                                                        <th class="text-end">Precio Compra</th>
                                                                        <th class="text-end">PV sin IVA</th>
                                                                        <th class="text-end">PV con IVA</th>
                                                                        <th class="text-end">PV Unidad</th>
                                                                        <th class="text-end">PV Paquete</th>
                                                                        <th class="text-end">PV Caja</th>
                                                                        <th class="text-end">Subtotal</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var detalle in compra.Detalles)
                                                                    {
                                                                        <tr>
                                                                            <td class="text-start">@detalle.Producto</td>
                                                                            <td class="text-center">@detalle.Cantidad</td>
                                                                            <td>@detalle.Unidad</td>
                                                                            <td class="text-end">Q @detalle.PrecioCompraUnit.ToString("N2")</td>
                                                                            <td class="text-end">Q @detalle.PrecioVentaSinIVA.ToString("N2")</td>
                                                                            <td class="text-end">Q @detalle.PrecioVentaConIVA.ToString("N2")</td>
                                                                            <td class="text-end">Q @detalle.PrecioVentaUnidad.ToString("N2")</td>
                                                                            <td class="text-end">Q @detalle.PrecioVentaPaquete.ToString("N2")</td>
                                                                            <td class="text-end">Q @detalle.PrecioVentaCaja.ToString("N2")</td>
                                                                            <td class="text-end fw-semibold">Q @detalle.Subtotal.ToString("N2")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-dark">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">TOTAL GENERAL:</td>
                                <td class="text-end text-warning fw-bold">Q @totalGeneral.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3 text-center">
                    <i class="bi bi-search"></i> No se encontraron compras con los filtros aplicados.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Limpiar filtros
            $('#btnLimpiar').click(function () {
                $('#desde, #hasta, #proveedorId').val('');
                $('#filtroForm').submit();
            });

            // Descargar PDF
            $('#btnDescargarPDF').click(function () {
                const desde = $('#desde').val();
                const hasta = $('#hasta').val();
                const proveedorId = $('#proveedorId').val();

                let url = '@Url.Action("DescargarComprasPDF", "Reportes")';
                const params = new URLSearchParams();

                if (desde) params.append('desde', desde);
                if (hasta) params.append('hasta', hasta);
                if (proveedorId) params.append('proveedorId', proveedorId);

                if (params.toString()) url += '?' + params.toString();
                window.location.href = url;
            });

            // Validación fechas
            $('#filtroForm').submit(function (e) {
                const desde = $('#desde').val();
                const hasta = $('#hasta').val();
                if (desde && hasta && new Date(desde) > new Date(hasta)) {
                    e.preventDefault();
                    alert('La fecha "Desde" no puede ser mayor a la fecha "Hasta"');
                }
            });

            // DataTable
            @if (Model != null && Model.Any())
            {
                    <text>
                    $('#tablaCompras').DataTable({
                        language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                        order: [[0, 'desc']],
                        pageLength: 10,
                        responsive: true
                    });
                    </text>
            }
        });
    </script>

    <style>
        .table th {
            font-weight: 600;
            font-size: 0.875rem;
        }

        .table td {
            font-size: 0.875rem;
            vertical-align: middle;
        }

        .collapse.show {
            background-color: #f8f9fa;
        }

        .badge {
            font-size: 0.75rem;
        }

        .card {
            border: 1px solid #e3e6f0;
            border-radius: 0.35rem;
        }

        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }

        .collapse .card {
            background-color: #fdfdfd;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        z
        .collapse.show .card {
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.15);
        }

        .table-sm th, .table-sm td {
            vertical-align: middle;
        }

        .table-secondary th {
            background-color: #e9ecef !important;
        }
    </style>
}
