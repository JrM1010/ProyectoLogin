@model IEnumerable<dynamic>
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "Reporte de Compras por Proveedor";
    var proveedores = ViewBag.Proveedores as List<Proveedor>;
    var totalGeneral = ViewBag.TotalGeneral ?? 0m;

    var comprasList = Model?.ToList() ?? new List<dynamic>();
    var totalCompras = comprasList.Count;
    var proveedoresConCompra = comprasList
        .Select(c => (string)c.Proveedor)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct()
        .Count();
}

<div class="container-fluid clients-theme">

    <!-- HEADER (estilo clientes/menta) -->
    <div class="clients-header">
        <div class="clients-header-title">
            <div class="clients-header-icon">
                <i class="bi bi-basket2-fill"></i>
            </div>
            <div>
                <h2>@ViewData["Title"]</h2>
                <p>Consulta, filtra y analiza las compras realizadas a tus proveedores</p>
            </div>
        </div>

        <div class="clients-header-actions d-flex gap-2">
            <a asp-action="Index" class="btn btn-clients-outline">
                <i class="bi bi-arrow-left"></i> Volver a Reportes
            </a>
        </div>
    </div>

    <!-- TARJETA DE FILTROS (calcada a clientes, con overrides de visibilidad de botones) -->
    <div class="clients-search-card">
        <form id="filtroForm" method="get" asp-action="Compras" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="clients-search-label fw-semibold">
                    <i class="bi bi-calendar-date me-1"></i>Fecha desde
                </label>
                <input type="date" class="clients-search-input" id="desde" name="desde"
                       value="@Context.Request.Query["desde"]" />
            </div>

            <div class="col-md-4">
                <label class="clients-search-label fw-semibold">
                    <i class="bi bi-calendar-date me-1"></i>Fecha hasta
                </label>
                <input type="date" class="clients-search-input" id="hasta" name="hasta"
                       value="@Context.Request.Query["hasta"]" />
            </div>

            <div class="col-md-4">
                <label class="clients-search-label fw-semibold">
                    <i class="bi bi-truck me-1"></i>Proveedor
                </label>
                <select class="clients-search-input" id="proveedorId" name="proveedorId">
                    @{
                        var proveedorIdQuery = Context.Request.Query["proveedorId"].ToString();
                    }

                    @if (string.IsNullOrEmpty(proveedorIdQuery))
                    {
                        <option value="" selected>-- Todos los proveedores --</option>
                    }
                    else
                    {
                        <option value="">-- Todos los proveedores --</option>
                    }

                    @if (proveedores != null)
                    {
                        foreach (var proveedor in proveedores)
                        {
                            var isSelected = proveedorIdQuery == proveedor.IdProveedor.ToString();
                            if (isSelected)
                            {
                                <option value="@proveedor.IdProveedor" selected>@proveedor.Nombre</option>
                            }
                            else
                            {
                                <option value="@proveedor.IdProveedor">@proveedor.Nombre</option>
                            }
                        }
                    }
                </select>
            </div>

            <!-- BOTONES -->
            <div class="col-12">
                <div class="d-flex flex-wrap gap-2 justify-content-end" style="border-top:1px solid var(--clients-border-soft); padding-top:.8rem;">
                    <button type="submit" class="btn btn-clients-search d-inline-flex align-items-center gap-2">
                        <i class="bi bi-search"></i> Filtrar
                    </button>

                    <button type="button" id="btnDescargarPDF" class="btn btn-clients-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                    </button>

                    <button type="button" id="btnLimpiar" class="btn btn-clients-outline d-inline-flex align-items-center gap-2">
                        <i class="bi bi-eraser"></i> Limpiar filtros
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (comprasList.Any())
    {
    <!-- ESTADÍSTICAS RÁPIDAS (estilo clientes) -->
    <div class="row g-3 mb-3">
        <div class="col-xl-4 col-md-6">
            <div class="clients-card statcard-mint border-left-mint">
                <div>
                    <div class="stat-label">Total general compras</div>
                    <div class="stat-value">Q @totalGeneral.ToString("N2")</div>
                </div>
                <i class="bi bi-currency-dollar stat-icon-mint"></i>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="clients-card statcard-mint border-left-info">
                <div>
                    <div class="stat-label">Compras encontradas</div>
                    <div class="stat-value">@totalCompras</div>
                </div>
                <i class="bi bi-receipt stat-icon-mint"></i>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="clients-card statcard-mint border-left-success">
                <div>
                    <div class="stat-label">Proveedores involucrados</div>
                    <div class="stat-value">@proveedoresConCompra</div>
                </div>
                <i class="bi bi-truck-front stat-icon-mint"></i>
            </div>
        </div>
    </div>

        <!-- FUNCIÓN AUXILIAR PARA PRODUCTOS (sin cambios) -->
    @functions {
        string GetProductos(dynamic detalles)
        {
            var lista = new List<string>();
            foreach (var d in detalles)
                lista.Add((string)d.Producto);
            return string.Join(", ", lista);
        }
    }

    <!-- TABLA DE RESULTADOS (estética clientes) -->
    <div class="clients-card">
        <div class="clients-card-header active">
            <i class="bi bi-table fs-5"></i>
            <h5>Resultados de compras</h5>
        </div>
        <div class="card-body p-0">
            <div class="clients-table-wrap">
                <table class="clients-table" id="tablaCompras">
                    <thead>
                        <tr>
                            <th>No. Compra</th>
                            <th>Fecha</th>
                            <th>Proveedor</th>
                            <th>Productos comprados</th>
                            <th style="width: 150px;">Detalles</th>
                            <th class="text-end">Total compra</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var compra in comprasList)
                        {
                            var detalleId = $"detalles-{compra.GetHashCode()}";
                            <tr>
                                <td class="ps-3">
                                    <span class="client-id">@compra.Numero</span>
                                </td>
                                <td>
                                    <small class="client-email">@compra.Fecha.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    <div class="client-name">
                                        <i class="bi bi-box-seam"></i>
                                        <span>@compra.Proveedor</span>
                                    </div>
                                </td>
                                <td class="client-email text-start">
                                    @GetProductos(compra.Detalles)
                                </td>
                                <td class="text-center">
                                    <button class="clients-action-btn clients-detail-btn"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@detalleId"
                                            aria-expanded="false"
                                            aria-controls="@detalleId">
                                        <i class="bi bi-list-ul"></i> Detalles
                                    </button>
                                </td>
                                <td class="text-end fw-semibold" style="color:var(--clients-success);">
                                    Q @compra.TotalCompra.ToString("N2")
                                </td>
                            </tr>

                            <!-- DETALLES -->
                            <tr class="fila-detalle-light">
                                <td colspan="6" class="p-0 border-0">
                                    <div class="collapse" id="@detalleId">
                                        <div class="p-3">
                                            <div class="clients-card detalle-card-light">
                                                <div class="clients-table-wrap">
                                                    <table class="clients-table" style="font-size:.82rem;">
                                                        <thead>
                                                            <tr>
                                                                <th class="text-start">Producto</th>
                                                                <th class="text-center">Cantidad</th>
                                                                <th>Unidad</th>
                                                                <th class="text-end">Precio compra</th>
                                                                <th class="text-end">Unidades base</th>
                                                                <th class="text-end">PV sin IVA</th>
                                                                <th class="text-end">PV con IVA</th>
                                                                <th class="text-end">PV Unidad</th>
                                                                <th class="text-end">PV Paquete</th>
                                                                <th class="text-end">PV Caja</th>
                                                                <th class="text-end">Subtotal</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var detalle in compra.Detalles)
                                                            {
                                                                <tr>
                                                                    <td class="text-start">@detalle.Producto</td>
                                                                    <td class="text-center">
                                                                        <span class="badge-soft">@detalle.Cantidad</span>
                                                                    </td>
                                                                    <td>@detalle.Unidad</td>
                                                                    <td class="text-end client-email">
                                                                        Q @detalle.PrecioCompraUnit.ToString("N2")
                                                                    </td>
                                                                    <td class="text-end client-email">
                                                                        @detalle.CantidadUnidadesBase.ToString("N2")
                                                                    </td>
                                                                    <td class="text-end client-email">
                                                                        Q @detalle.PrecioVentaSinIVA.ToString("N2")
                                                                    </td>
                                                                    <td class="text-end client-email">
                                                                        Q @detalle.PrecioVentaConIVA.ToString("N2")
                                                                    </td>
                                                                    <td class="text-end client-email">
                                                                        Q @detalle.PrecioVentaUnidad.ToString("N2")
                                                                    </td>
                                                                    <td class="text-end client-email">
                                                                        Q @detalle.PrecioVentaPaquete.ToString("N2")
                                                                    </td>
                                                                    <td class="text-end client-email">
                                                                        Q @detalle.PrecioVentaCaja.ToString("N2")
                                                                    </td>
                                                                    <td class="text-end fw-semibold" style="color:var(--clients-primary);">
                                                                        Q @detalle.Subtotal.ToString("N2")
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="text-end fw-bold client-email">TOTAL GENERAL:</td>
                            <td class="text-end fw-bold" style="color:#b45309;">Q @totalGeneral.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
        }
        else
    {
        <!-- VACÍO (estilo clientes) -->
        <div class="clients-card text-center p-5">
            <div class="clients-header-icon" style="margin:0 auto 10px;">
                <i class="bi bi-search"></i>
            </div>
            <h4 class="mb-2" style="color:var(--clients-text);">No se encontraron compras</h4>
            <p class="client-email mb-3">Ajusta las fechas o el proveedor e intenta nuevamente.</p>
            <button type="button" id="btnLimpiarVacio" class="btn btn-clients-search d-inline-flex align-items-center gap-2">
                <i class="bi bi-eraser"></i> Limpiar filtros
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function limpiarFiltros() {
                $('#desde').val('');
                $('#hasta').val('');
                $('#proveedorId').val('');
                $('#filtroForm').submit();
            }

            $('#btnLimpiar').click(limpiarFiltros);
            $('#btnLimpiarVacio').click(limpiarFiltros);

            // Descargar PDF (misma lógica existente)
            $('#btnDescargarPDF').click(function () {
                const desde = $('#desde').val();
                const hasta = $('#hasta').val();
                const proveedorId = $('#proveedorId').val();

                let url = '@Url.Action("DescargarComprasPDF", "Reportes")';
                const params = new URLSearchParams();

                if (desde) params.append('desde', desde);
                if (hasta) params.append('hasta', hasta);
                if (proveedorId) params.append('proveedorId', proveedorId);

                if (params.toString()) url += '?' + params.toString();
                window.location.href = url;
            });

            // Validación de rango de fechas
            $('#filtroForm').submit(function (e) {
                const desde = $('#desde').val();
                const hasta = $('#hasta').val();
                if (desde && hasta && new Date(desde) > new Date(hasta)) {
                    e.preventDefault();
                    alert('La fecha "Desde" no puede ser mayor a la fecha "Hasta".');
                }
            });

            // Toggle texto del botón de detalles (mantiene funcionalidad)
            $(document).on('click', '[data-bs-toggle="collapse"]', function () {
                const $btn = $(this);
                const target = $btn.data('bs-target');
                const $collapse = $(target);

                setTimeout(function () {
                    if ($collapse.hasClass('show')) {
                        $btn.html('<i class="bi bi-chevron-up"></i> Ocultar');
                    } else {
                        $btn.html('<i class="bi bi-list-ul"></i> Detalles');
                    }
                }, 200);
            });

            // DataTable (sin cambios)
            @if (comprasList.Any())
            {
                    <text>
                    if ($.fn.DataTable) {
                        $('#tablaCompras').DataTable({
                            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                            order: [[0, 'desc']],
                            pageLength: 10,
                            responsive: true
                        });
                    }
                    </text>
            }
        });
    </script>
}

@section styles {
    <style>
        :root {
            /* Paleta “usuarios/menta” aplicada a Reporte Compras */
            --clients-primary: #062926; /* menta oscuro */
            --clients-secondary: #12C6A1; /* menta vibrante */
            --clients-accent: #5EF2C1; /* acento brillante */
            --clients-bg: #f5f6fa; /* fondo claro */
            --clients-card: #ffffff;
            --clients-text: #111827;
            --clients-muted: #6b7280;
            --clients-radius: .75rem;
            --clients-border-soft: #e5e7eb;
            --clients-danger: #dc2626;
            --clients-success: #16a34a;
        }

        /* CONTENEDOR GENERAL */
        .clients-theme {
            background: var(--clients-bg);
            padding: 1.5rem 0 2rem;
        }

        /* HEADER */
        .clients-header {
            background: linear-gradient(90deg,var(--clients-primary),var(--clients-secondary));
            border-radius: var(--clients-radius);
            border: 1px solid rgba(255,255,255,.16);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1rem;
            box-shadow: 0 6px 18px rgba(15,23,42,.18);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #fff;
        }

        .clients-header-title {
            display: flex;
            align-items: center;
            gap: .7rem;
        }

        .clients-header-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(0,0,0,.22);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: var(--clients-accent);
        }

        .clients-header h2 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: .02em;
            color: #fff;
        }

        .clients-header p {
            margin: .1rem 0 0;
            font-size: .85rem;
            color: rgba(241,245,249,.9);
        }

        .clients-header-actions .btn {
            font-size: .86rem;
            border-radius: var(--clients-radius);
            padding: .5rem 1rem;
        }

        .btn-clients-outline {
            border: 1px solid var(--clients-accent);
            background: transparent;
            color: #fff;
            border-radius: var(--clients-radius);
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: all .25s ease;
            text-decoration: none;
        }

            .btn-clients-outline:hover {
                background: rgba(94,242,193,.16);
                color: #fff;
                box-shadow: 0 4px 10px rgba(15,23,42,.25);
                transform: translateY(-1px);
            }

        .btn-clients-primary {
            background: #fff;
            color: var(--clients-primary);
            border: 1px solid var(--clients-border-soft);
            border-radius: var(--clients-radius);
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: all .25s ease;
            text-decoration: none;
            padding: .6rem 1.3rem;
            font-size: .85rem;
        }

            .btn-clients-primary:hover {
                background: #f9fafb;
                color: var(--clients-secondary);
                box-shadow: 0 4px 12px rgba(15,23,42,.25);
                transform: translateY(-1px);
            }

        .btn-clients-search {
            border-radius: var(--clients-radius);
            padding: .6rem 1.3rem;
            font-size: .85rem;
            background: var(--clients-secondary);
            border: 1px solid var(--clients-secondary);
            color: #020814;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: all .25s ease;
        }

            .btn-clients-search:hover {
                background: var(--clients-primary);
                border-color: var(--clients-primary);
                color: #fff;
                box-shadow: 0 4px 10px rgba(15,23,42,.18);
                transform: translateY(-1px);
            }

        /* BUSCADOR */
        .clients-search-card {
            background: var(--clients-card);
            border: 1px solid var(--clients-border-soft);
            border-radius: var(--clients-radius);
            padding: .9rem 1.1rem;
            margin-bottom: 1.1rem;
            box-shadow: 0 2px 8px rgba(15,23,42,.04);
        }

        .clients-search-label {
            font-size: .82rem;
            color: var(--clients-muted);
            margin-bottom: .15rem;
        }

        .clients-search-input {
            background: #fff;
            border-radius: var(--clients-radius);
            border: 1px solid var(--clients-border-soft);
            color: var(--clients-text);
            padding: .6rem .85rem;
            min-width: 220px;
            font-size: .88rem;
            transition: all .22s ease;
            width: 100%;
        }

            .clients-search-input::placeholder {
                color: #9ca3af;
            }

            .clients-search-input:focus {
                outline: none;
                border-color: var(--clients-secondary);
                box-shadow: 0 0 0 .16rem rgba(18,198,161,.18);
                background: #fff;
            }

        /* ===== Overrides de visibilidad dentro de la tarjeta de filtros ===== */
        .clients-search-card .btn-clients-outline {
            background: #fff !important;
            color: var(--clients-primary) !important;
            border-color: var(--clients-secondary) !important;
        }

            .clients-search-card .btn-clients-outline:hover {
                background: var(--clients-secondary) !important;
                color: #020814 !important;
                box-shadow: 0 4px 10px rgba(15,23,42,.16);
                transform: translateY(-1px);
            }

        .clients-search-card .btn-clients-primary { /* botón PDF con buena visibilidad */
            background: #fff;
            color: var(--clients-primary);
            border: 1px solid var(--clients-border-soft);
        }

        /* TARJETAS / TABLAS */
        .clients-card {
            background: var(--clients-card);
            border: 1px solid var(--clients-border-soft);
            border-radius: var(--clients-radius);
            overflow: hidden;
            margin-bottom: 1.1rem;
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            transition: all .22s ease;
        }

            .clients-card:hover {
                box-shadow: 0 7px 20px rgba(15,23,42,.10);
                transform: translateY(-1px);
            }

        .clients-card-header {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .85rem 1.15rem;
            border-bottom: 1px solid rgba(15,23,42,.06);
            color: #fff;
            background: linear-gradient(90deg,var(--clients-primary),var(--clients-secondary));
        }

            .clients-card-header h5 {
                margin: 0;
                font-size: .98rem;
                font-weight: 700;
                color: #fff;
            }

            .clients-card-header i {
                font-size: 1.2rem;
                color: #bbf7d0;
            }

        .clients-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .clients-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
            font-size: .85rem;
            color: var(--clients-text);
            background: transparent;
        }

            .clients-table thead th {
                background: #e5f9f3;
                font-weight: 600;
                font-size: .78rem;
                border-bottom: 1px solid var(--clients-border-soft);
                white-space: nowrap;
                text-transform: uppercase;
                letter-spacing: .03em;
                color: var(--clients-muted);
                padding: .7rem .9rem;
            }

            .clients-table tbody td {
                padding: .7rem .9rem;
                border-bottom: 1px solid var(--clients-border-soft);
                vertical-align: middle;
                color: var(--clients-text);
            }

            .clients-table tbody tr:nth-child(even) {
                background: #f9fafb;
            }

            .clients-table tbody tr:hover {
                background: #ecfdf5;
            }

        .client-id {
            font-weight: 600;
            font-size: .78rem;
            color: var(--clients-muted);
        }

        .client-name {
            display: flex;
            align-items: center;
            gap: .35rem;
            font-weight: 600;
            color: var(--clients-text);
        }

            .client-name i {
                color: var(--clients-secondary);
            }

        .client-email {
            color: var(--clients-muted);
            font-size: .8rem;
        }

        .badge-soft {
            padding: .22rem .7rem;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 600;
            border: 1px solid var(--clients-secondary);
            background: #ecfdf5;
            color: var(--clients-primary);
        }

        /* Stats mint */
        .statcard-mint {
            border-radius: .8rem;
            padding: .9rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
        }

        .stat-label {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--clients-muted);
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--clients-text);
        }

        .stat-icon-mint {
            font-size: 1.5rem;
            color: var(--clients-secondary);
        }

        .border-left-mint {
            border-left: 3px solid var(--clients-secondary);
            background: #fff;
            border: 1px solid var(--clients-border-soft);
        }

        .border-left-info {
            border-left: 3px solid #0ea5e9;
            background: #fff;
            border: 1px solid var(--clients-border-soft);
        }

        .border-left-success {
            border-left: 3px solid #22c55e;
            background: #fff;
            border: 1px solid var(--clients-border-soft);
        }

        /* Detalle light */
        .fila-detalle-light {
