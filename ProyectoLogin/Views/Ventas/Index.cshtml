@{
    ViewData["Title"] = "Punto de Venta";
}

<div class="container-fluid mt-4">
    <div class="row g-3">

        <!-- PANEL IZQUIERDO: PRODUCTOS -->
        <div class="col-lg-8 col-md-7">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-basket2-fill me-2"></i>Venta</h5>
                </div>

                <div class="card-body pt-3">

                    <!-- Buscadores -->
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        <div class="search-container flex-grow-1">
                            <input type="text" id="busqueda" class="form-control form-control-sm"
                                   placeholder="Buscar producto o Promocion..." autocomplete="off" />
                        </div>
                    </div>

                    <!-- Tabla de productos -->
                    <div class="table-responsive border rounded">
                        <table class="table table-hover table-sm align-middle text-center mb-0" id="tablaProductos">
                            <thead class="table-light">
                                <tr class="text-uppercase small">
                                    <th style="width: 35%;">Producto/Promoción</th>
                                    <th>Precio</th>
                                    <th>Presentacion</th>
                                    <th>Cantidad</th>
                                    <th>Desc. %</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL DERECHO: CLIENTE + TOTALES -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow border-0 sticky-top" style="top: 1rem;">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary fw-bold mb-3">
                        <i class="bi bi-person-vcard me-1"></i> Datos del Cliente
                    </h5>

                    <!-- Tipo de cliente -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar tipo de cliente</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoCliente" id="opcionNit" checked>
                                <label class="form-check-label" for="opcionNit">Con NIT</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoCliente" id="opcionCF">
                                <label class="form-check-label" for="opcionCF">Consumidor Final (CF)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Buscar cliente -->
                    <div id="seccionNit" class="mb-3">
                        <div class="input-group">
                            <input type="text" id="nitCliente" class="form-control form-control-sm"
                                   placeholder="NIT del cliente..." />
                            <button id="btnBuscarCliente" class="btn btn-sm btn-primary">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                        </div>

                        <!-- Datos del cliente encontrado -->
                        <div id="datosCliente" class="border rounded p-2 mt-3 bg-light d-none">
                            <p class="mb-1"><strong>Nombre:</strong> <span id="nombreCliente"></span></p>
                            <p class="mb-1"><strong>Correo:</strong> <span id="correoCliente"></span></p>
                            <p class="mb-0"><strong>Dirección:</strong> <span id="direccionCliente"></span></p>
                        </div>

                        <!-- Registrar nuevo cliente -->
                        <div id="formNuevoCliente" class="border rounded p-2 mt-3 d-none bg-light">
                            <h6 class="fw-bold text-secondary">Registrar nuevo cliente</h6>
                            <input type="text" id="nuevoNombre" class="form-control form-control-sm mb-2" placeholder="Nombres" />
                            <input type="text" id="nuevoApellido" class="form-control form-control-sm mb-2" placeholder="Apellidos" />
                            <input type="email" id="nuevoCorreo" class="form-control form-control-sm mb-2" placeholder="Correo" />
                            <input type="text" id="nuevoDireccion" class="form-control form-control-sm mb-2" placeholder="Dirección" />
                            <button id="btnGuardarCliente" class="btn btn-success btn-sm w-100">
                                <i class="bi bi-person-plus"></i> Guardar Cliente
                            </button>
                        </div>
                    </div>

                    <!-- Consumidor final -->
                    <div id="seccionCF" class="border rounded p-2 mt-3 d-none bg-light">
                        <p class="mb-0"><strong>Nombre:</strong> Consumidor Final (CF)</p>
                        <p class="mb-0 text-muted small">Todos los precios incluyen IVA</p>
                    </div>

                    <hr class="my-3">

                    <!-- Totales -->
                    <h6 class="fw-bold text-center text-primary mb-3">
                        <i class="bi bi-receipt-cutoff me-1"></i> Resumen de Venta
                    </h6>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Total</label>
                        <input type="text" id="total" class="form-control form-control-sm text-end fs-5 fw-bold text-success" value="Q0.00" readonly />
                        <div class="text-muted small text-end mt-1">IVA incluido</div>
                    </div>

                    <hr />

                    <!-- Botones de acción -->
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" id="btnCobrar">
                            <i class="bi bi-cash-coin me-1"></i> Cobrar / Pagar
                        </button>
                        <button class="btn btn-outline-danger" id="btnCancelar">
                            <i class="bi bi-x-circle me-1"></i> Cancelar Venta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE PAGO -->
<div class="modal fade" id="modalCobro" tabindex="-1" aria-labelledby="modalCobroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-cash-stack"></i> Finalizar Venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div id="contenidoVentaActiva">
                    <h5 class="text-center">Total a pagar: <strong class="text-success fs-4" id="totalCobro">Q0.00</strong></h5>
                    <div class="text-center text-muted small mb-3">IVA incluido</div>
                    <hr>

                    <!-- Selección de método de pago -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Método de Pago</label>
                        <select id="metodoPago" class="form-select">
                            <option value="efectivo">Efectivo</option>
                            <option value="tarjeta">Tarjeta de Crédito / Débito</option>
                            <option value="transferencia">Transferencia Bancaria</option>
                            <option value="mixto">Pago Mixto</option>
                        </select>
                    </div>

                    <!-- EFECTIVO -->
                    <div id="pagoEfectivo" class="metodoPago">
                        <label class="form-label">Monto recibido:</label>
                        <input type="number" id="montoRecibido" class="form-control" min="0" step="0.01" />
                        <label class="form-label mt-2">Cambio:</label>
                        <input type="text" id="cambio" class="form-control" readonly />
                    </div>

                    <!-- TARJETA -->
                    <div id="pagoTarjeta" class="metodoPago d-none">
                        <label class="form-label">Monto con tarjeta:</label>
                        <input type="number" id="montoTarjeta" class="form-control" min="0" step="0.01" />
                    </div>

                    <!-- TRANSFERENCIA -->
                    <div id="pagoTransferencia" class="metodoPago d-none">
                        <label class="form-label">Monto por transferencia:</label>
                        <input type="number" id="montoTransferencia" class="form-control" min="0" step="0.01" />
                        <small class="text-muted">Ingrese el monto transferido.</small>
                    </div>

                    <!-- MIXTO -->
                    <div id="pagoMixto" class="metodoPago d-none">
                        <label class="form-label">Monto en efectivo:</label>
                        <input type="number" id="montoMixtoEfectivo" class="form-control mb-2" min="0" step="0.01" />
                        <label class="form-label">Monto en tarjeta:</label>
                        <input type="number" id="montoMixtoTarjeta" class="form-control mb-2" min="0" step="0.01" />
                        <label class="form-label">Monto en transferencia:</label>
                        <input type="number" id="montoMixtoTransferencia" class="form-control" min="0" step="0.01" />
                    </div>
                </div>

                <!-- MENSAJE DESPUÉS DE GUARDAR LA VENTA -->
                <div id="contenidoVentaFinalizada" class="text-center d-none">
                    <h4 class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Venta Completada</h4>
                    <p class="text-muted mb-4">La información de pago ha sido guardada. Descargue Factura.</p>
                    <button id="btnDescargarFactura" class="btn btn-outline-primary">
                        <i class="bi bi-file-earmark-arrow-down"></i> Descargar factura
                    </button>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button class="btn btn-success" id="btnConfirmarCobro"><i class="bi bi-check2-circle"></i> Confirmar Pago</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA SELECCIÓN DE UNIDAD -->
<div class="modal fade" id="modalUnidad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Seleccionar Presentación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="contenidoUnidades">
                <!-- Las opciones de unidad se cargarán aquí dinámicamente -->
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .card {
        border-radius: 8px;
    }

    .card-header {
        border-radius: 8px 8px 0 0 !important;
    }

    .table th {
        background-color: #f1f3f5;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.9rem;
    }

    .search-container {
        flex-grow: 1;
        min-width: 200px;
        position: relative;
    }

    .suggestions-box {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #dee2e6;
        border-top: none;
        z-index: 1000;
        max-height: 250px;
        overflow-y: auto;
        margin-top: 2px;
    }

        .suggestions-box button {
            border: none;
            background: #fff;
            width: 100%;
            text-align: left;
            padding: 8px 12px;
        }

            .suggestions-box button:hover {
                background: #f8f9fa;
            }

    #total {
        background-color: #e9f7ef;
        font-size: 1.1rem;
    }

    .form-control.text-end {
        text-align: right !important;
    }

    .unidad-option {
        padding: 10px;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        margin-bottom: 5px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .unidad-option:hover {
            background-color: #f8f9fa;
            border-color: #007bff;
        }

        .unidad-option.selected {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }

    .precio-unidad {
        font-weight: bold;
        color: #28a745;
    }

</style>

@section Scripts {
    <script>
         const tablaBody = document.querySelector("#tablaProductos tbody");
         const inputBusqueda = document.querySelector("#busqueda");
         const btnCobrar = document.querySelector("#btnCobrar");
         const btnCancelar = document.querySelector("#btnCancelar");

         let productosSeleccionados = [];
         let ultimosResultados = [];
         let clienteSeleccionado = null;
         let productoSeleccionadoParaUnidad = null;

         function setValueIfExists(selector, value) {
             const el = document.querySelector(selector);
             if (el) el.value = value;
         }

         function mostrarMensaje(texto, tipo = "info", duracion = 3000) {
             let contenedor = document.getElementById("centroAlertas");
             if (!contenedor) {
                 contenedor = document.createElement("div");
                 contenedor.id = "centroAlertas";
                 contenedor.style.position = "fixed";
                 contenedor.style.bottom = "20px";
                 contenedor.style.left = "20px";
                 contenedor.style.zIndex = "1055";
                 contenedor.style.display = "flex";
                 contenedor.style.flexDirection = "column";
                 contenedor.style.gap = "8px";
                 document.body.appendChild(contenedor);
             }

             const alerta = document.createElement("div");
             alerta.className = `alert alert-${tipo} shadow-sm border-0 fade show`;
             alerta.style.minWidth = "260px";
             alerta.style.maxWidth = "320px";
             alerta.style.padding = "10px 14px";
             alerta.style.fontSize = "0.9rem";
             alerta.style.cursor = "pointer";
             alerta.style.borderRadius = "10px";
             alerta.innerHTML = `<strong>${texto}</strong>`;

             alerta.addEventListener("click", () => alerta.remove());
             contenedor.appendChild(alerta);

             if (duracion > 0) {
                 setTimeout(() => alerta.remove(), duracion);
             }
         }

        function parseFactorUnidad(unidad) {
            let raw = unidad?.FactorConversion ?? unidad?.factorConversion ?? unidad?.factor ?? unidad?.Factor ?? unidad?.factor_default ?? unidad?.FactorDefault ?? unidad?.cantidadPorPresentacion;
            if (raw === undefined || raw === null) {
                return 1;
            }
            if (typeof raw === 'string') raw = raw.replace(',', '.').trim();
            const n = parseFloat(raw);
            if (!isFinite(n) || n <= 0) return 1;
            return Math.max(1, Math.round(n));
        }

         function mostrarModalUnidades(producto) {
            const contenidoUnidades = document.getElementById("contenidoUnidades");
            contenidoUnidades.innerHTML = '';

            const unidades = producto.preciosPorUnidad || producto.unidades || [];

            if (!unidades.length) {
                contenidoUnidades.innerHTML = '<p class="text-muted">No hay presentaciones disponibles</p>';
                return;
            }

            unidades.forEach(unidad => {
                const idUnidad = unidad.IdUnidad || unidad.idUnidad || unidad.Id || unidad.id;
                const nombre = unidad.Nombre || unidad.nombre || "Presentación";
                const factor = unidad.FactorConversion || unidad.factorConversion || unidad.EquivalenciaEnUnidades || 1;
                const precioVenta = unidad.PrecioVenta || unidad.precioVenta || unidad.Precio || unidad.precio || 0;

                const div = document.createElement("div");
                div.className = "unidad-option";
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>${nombre}</strong>
                        </div>
                        <div class="precio-unidad">${formatearMonedaGuatemala(precioVenta)}</div>
                    </div>
                `;
                div.onclick = () => {
                    seleccionarUnidadParaProducto(producto, {
                        IdUnidad: idUnidad,
                        Nombre: nombre,
                        FactorConversion: factor,
                        PrecioVenta: precioVenta,
                        DescuentoAplicable: 0
                    });
                    bootstrap.Modal.getInstance(document.getElementById('modalUnidad')).hide();
                };
                contenidoUnidades.appendChild(div);
            });

            const modal = new bootstrap.Modal(document.getElementById('modalUnidad'));
            modal.show();
        }

        function seleccionarUnidadParaProducto(producto, unidad) {
            const factor = parseFloat(unidad.FactorConversion ?? unidad.factorConversion ?? 1) || 1;
            const stockBase = Number(producto.stock ?? 0);
            const disponiblesEnUnidad = Math.floor(stockBase / factor);

            if (disponiblesEnUnidad < 1) {
                mostrarMensaje(`❌ No hay stock suficiente para ${unidad.Nombre ?? unidad.nombre ?? 'esta presentación'}.`, "danger");
                return;
            }

            const productoParaAgregar = {
                id: producto.id,
                nombre: producto.text,
                precio: parseFloat(unidad.PrecioVenta ?? unidad.precioVenta ?? unidad.Precio ?? unidad.precio) || 0,
                cantidad: 1,
                descuento: 0,
                stock: stockBase,
                esKit: false,
                unidades: producto.preciosPorUnidad || producto.unidades || [],
                idUnidadSeleccionada: unidad.IdUnidad ?? unidad.idUnidad ?? unidad.Id ?? unidad.id ?? null,
                unidadNombre: unidad.Nombre ?? unidad.nombre ?? "Unidad",
                factorConversion: factor,
                stockBase: stockBase
            };

            const existente = productosSeleccionados.find(p => p.id === producto.id && String(p.idUnidadSeleccionada) === String(productoParaAgregar.idUnidadSeleccionada));

            const maxPermitido = Math.floor(stockBase / factor);
            if (existente) {
                if (existente.cantidad >= maxPermitido) {
                    mostrarMensaje(`⚠️ Solo puedes vender ${maxPermitido} ${productoParaAgregar.unidadNombre}(s) según el stock disponible.`, "warning");
                    return;
                }
                existente.cantidad++;
            } else {
                if (maxPermitido < 1) {
                    mostrarMensaje(`❌ No hay suficiente stock para la presentación "${productoParaAgregar.unidadNombre}".`, "danger");
                    return;
                }
                productoParaAgregar.maxPermitido = maxPermitido;
                productosSeleccionados.push(productoParaAgregar);
            }

            mostrarMensaje(`✅ ${producto.text} (${productoParaAgregar.unidadNombre}) añadido a la venta.`, "success");
            renderTabla();
        }

         inputBusqueda.addEventListener("keyup", async (e) => {
             const term = e.target.value.trim();
             const contenedor = inputBusqueda.closest(".search-container");
             if (term.length < 2) {
                 const prev = contenedor.querySelector(".suggestions-box");
                 if (prev) prev.remove();
                 return;
             }

             const resp = await fetch(`/Ventas/BuscarProducto?term=${encodeURIComponent(term)}`);
             const data = await resp.json();
             ultimosResultados = data.results || [];
             mostrarSugerencias(ultimosResultados, contenedor);
         });

         inputBusqueda.addEventListener("keydown", (e) => {
             if (e.key === "Enter") {
                 e.preventDefault();
                 if (ultimosResultados.length > 0) {
                     const producto = ultimosResultados[0];
                     if (producto.preciosPorUnidad && producto.preciosPorUnidad.length > 1) {
                         mostrarModalUnidades(producto);
                     } else {
                         seleccionarProducto(producto);
                     }
                     const contenedor = inputBusqueda.closest(".search-container");
                     const lista = contenedor.querySelector(".suggestions-box");
                     if (lista) lista.remove();
                 }
             }
         });

         function formatearNumeroGuatemala(numero) {
             if (numero === null || numero === undefined || isNaN(numero)) {
                 return "0.00";
             }
             const num = typeof numero === 'string' ? parseFloat(numero) : numero;
             return num.toLocaleString('en-US', {
                 minimumFractionDigits: 2,
                 maximumFractionDigits: 2
             });
         }

         function formatearMonedaGuatemala(monto) {
             return `Q${formatearNumeroGuatemala(monto)}`;
         }

         function limpiarFormatoMoneda(valor) {
             if (!valor) return 0;
             return parseFloat(
                 valor.toString()
                     .replace(/[Q,\s]/g, '')
                     .replace(/[^\d.-]/g, '')
             ) || 0;
         }

                 function mostrarSugerencias(lista, contenedor) {
            const prev = contenedor.querySelector(".suggestions-box");
            if (prev) prev.remove();
            if (!lista.length) return;

            const div = document.createElement("div");
            div.classList.add("suggestions-box");

            lista.forEach(p => {
                const stock = p.stock ?? 0;
                const esKit = p.tipo === "kit";
                let colorStock = "text-success";
                let estado = "Disponible";

                if (!esKit) {
                    if (stock <= 0) { colorStock = "text-danger"; estado = "Sin existencias"; }
                    else if (stock <= 3) { colorStock = "text-warning"; estado = "Stock bajo"; }
                }

                const item = document.createElement("button");
                item.type = "button";

                let precioTexto = formatearMonedaGuatemala(p.precio);
                const tieneMultiplesUnidades = (p.preciosPorUnidad && p.preciosPorUnidad.length > 1) ||
                                             (p.unidades && p.unidades.length > 1);

                if (tieneMultiplesUnidades) {
                    precioTexto = `<span class="text-primary">Múltiples presentaciones</span>`;
                }

                item.innerHTML = `
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <strong>${p.text}</strong> ${esKit ? '<span class="badge bg-info text-dark ms-2">KIT</span>' : ""}
                        <br>
                        ${!esKit ? `<small class="${colorStock}">${estado} — Stock: ${stock}</small>` : '<small class="text-primary">Promoción especial</small>'}
                    </div>
                    <span>${precioTexto}</span>
                </div>`;

                item.onclick = () => {
                    if (tieneMultiplesUnidades) {
                        mostrarModalUnidades(p);
                    } else {
                        seleccionarProducto(p);
                    }
                    div.remove();
                };
                div.appendChild(item);
            });

            contenedor.appendChild(div);
            document.addEventListener("click", (ev) => {
                if (!contenedor.contains(ev.target)) {
                    const list = contenedor.querySelector(".suggestions-box");
                    if (list) list.remove();
                }
            }, { once: true });
        }

                function seleccionarProducto(prod) {
            const esKit = prod.tipo === "kit";

            if (esKit) {
                const existente = productosSeleccionados.find(p => p.idKit === prod.id);
                if (existente) {
                    existente.cantidad++;
                } else {
                    productosSeleccionados.push({
                        idKit: prod.id,
                        id: null,
                        nombre: prod.text,
                        precio: parseFloat(prod.precio),
                        cantidad: 1,
                        descuento: 0,
                        stock: 9999,
                        esKit: true
                    });
                }
                mostrarMensaje(`✅ Kit "${prod.text}" añadido a la venta.`, "success");

            }
            else {
                const stockBase = prod.stock ?? 0;
                if (stockBase <= 0) {
                    mostrarMensaje(`❌ El producto "${prod.text}" no tiene existencias.`, "danger");
                    return;
                }

                const unidades = prod.preciosPorUnidad || prod.unidades || [];
                const tieneMultiplesUnidades = unidades.length > 1;

                if (tieneMultiplesUnidades) {
                    mostrarModalUnidades(prod);
                    return;
                }

                const defaultUnidad = unidades[0] || {};
                const defaultIdUnidad = defaultUnidad.IdUnidad || defaultUnidad.idUnidad || null;
                const defaultPrecio = defaultUnidad.PrecioVenta || defaultUnidad.precioVenta || prod.precio;
                const defaultFactor = defaultUnidad.FactorConversion || defaultUnidad.factorConversion || 1;
                const disponiblesEnUnidad = Math.floor(stockBase / defaultFactor);

                const existente = productosSeleccionados.find(p => p.id === prod.id && !p.esKit);
                if (existente) {
                    const nuevasUnidadesNecesarias = (existente.cantidad + 1) * existente.factorConversion;
                    if (nuevasUnidadesNecesarias > stockBase) {
                        const maxPermitido = Math.floor(stockBase / existente.factorConversion);
                        mostrarMensaje(`⚠️ No puedes agregar más unidades. Máximo disponible: ${maxPermitido}`, "warning");
                        return;
                    }
                    existente.cantidad++;
                } else {
                    if (disponiblesEnUnidad < 1) {
                        mostrarMensaje(`❌ No hay stock suficiente para la presentación "${defaultUnidad.Nombre || 'Unidad'}".`, "danger");
                        return;
                    }

                    productosSeleccionados.push({
                        id: prod.id,
                        nombre: prod.text,
                        precio: parseFloat(defaultPrecio) || 0,
                        cantidad: 1,
                        descuento: 0,
                        stock: stockBase,
