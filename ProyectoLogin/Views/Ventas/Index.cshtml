@{
    ViewData["Title"] = "Punto de Venta";
}

<div class="container-fluid mt-4">
    <div class="row g-3">

        <!-- PANEL IZQUIERDO: PRODUCTOS -->
        <div class="col-lg-8 col-md-7">
            <div class="card shadow border-0">
                <div class="card-header bg-gradient-primary text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-basket2-fill me-2"></i>Venta</h5>
                </div>

                <div class="card-body pt-3">
                    
                    <!-- Buscadores -->
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        <div class="search-container flex-grow-1">
                            <input type="text" id="busqueda" class="form-control form-control-sm"
                                   placeholder="Buscar producto o Promocion..." autocomplete="off" />
                        </div>
                    </div>

                    <!-- Tabla de productos -->
                    <div class="table-responsive border rounded">
                        <table class="table table-hover table-sm align-middle text-center mb-0" id="tablaProductos">
                            <thead class="table-light">
                                <tr class="text-uppercase small">
                                    <th style="width: 35%;">Producto/Promoción</th>
                                    <th>Precio</th>
                                    <th>Presentacion</th>
                                    <th>Cantidad</th>
                                    <th>Desc. %</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL DERECHO: CLIENTE + TOTALES -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow border-0 sticky-top" style="top: 1rem;">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary fw-bold mb-3">
                        <i class="bi bi-person-vcard me-1"></i> Datos del Cliente
                    </h5>

                    <!-- Tipo de cliente -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar tipo de cliente</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoCliente" id="opcionNit" checked>
                                <label class="form-check-label" for="opcionNit">Con NIT</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoCliente" id="opcionCF">
                                <label class="form-check-label" for="opcionCF">Consumidor Final (CF)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Buscar cliente -->
                    <div id="seccionNit" class="mb-3">
                        <div class="input-group">
                            <input type="text" id="nitCliente" class="form-control form-control-sm"
                                   placeholder="NIT del cliente..." />
                            <button id="btnBuscarCliente" class="btn btn-sm btn-primary">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                        </div>

                        <!-- Datos del cliente encontrado -->
                        <div id="datosCliente" class="border rounded p-2 mt-3 bg-light d-none">
                            <p class="mb-1"><strong>Nombre:</strong> <span id="nombreCliente"></span></p>
                            <p class="mb-1"><strong>Correo:</strong> <span id="correoCliente"></span></p>
                            <p class="mb-0"><strong>Dirección:</strong> <span id="direccionCliente"></span></p>
                        </div>

                        <!-- Registrar nuevo cliente -->
                        <div id="formNuevoCliente" class="border rounded p-2 mt-3 d-none bg-light">
                            <h6 class="fw-bold text-secondary">Registrar nuevo cliente</h6>
                            <input type="text" id="nuevoNombre" class="form-control form-control-sm mb-2" placeholder="Nombres" />
                            <input type="text" id="nuevoApellido" class="form-control form-control-sm mb-2" placeholder="Apellidos" />
                            <input type="email" id="nuevoCorreo" class="form-control form-control-sm mb-2" placeholder="Correo" />
                            <input type="text" id="nuevoDireccion" class="form-control form-control-sm mb-2" placeholder="Dirección" />
                            <button id="btnGuardarCliente" class="btn btn-success btn-sm w-100">
                                <i class="bi bi-person-plus"></i> Guardar Cliente
                            </button>
                        </div>
                    </div>

                    <!-- Consumidor final -->
                    <div id="seccionCF" class="border rounded p-2 mt-3 d-none bg-light">
                        <p class="mb-0"><strong>Nombre:</strong> Consumidor Final (CF)</p>
                    </div>

                    <hr class="my-3">

                    <!-- Totales -->
                    <h6 class="fw-bold text-center text-primary mb-3">
                        <i class="bi bi-receipt-cutoff me-1"></i> Resumen de Venta
                    </h6>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Subtotal</label>
                        <input type="text" id="subtotal" class="form-control form-control-sm text-end" value="Q0.00" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">IVA (12%)</label>
                        <input type="text" id="iva" class="form-control form-control-sm text-end" value="Q0.00" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Total</label>
                        <input type="text" id="total" class="form-control form-control-sm text-end fs-5 fw-bold text-success" value="Q0.00" readonly />
                    </div>

                    <hr />

                    <!-- Botones de acción -->
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" id="btnCobrar">
                            <i class="bi bi-cash-coin me-1"></i> Cobrar / Pagar
                        </button>
                        <button class="btn btn-outline-danger" id="btnCancelar">
                            <i class="bi bi-x-circle me-1"></i> Cancelar Venta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE PAGO -->
<div class="modal fade" id="modalCobro" tabindex="-1" aria-labelledby="modalCobroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-cash-stack"></i> Finalizar Venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div id="contenidoVentaActiva">
                    <h5 class="text-center">Total a pagar: <strong class="text-success fs-4" id="totalCobro">Q0.00</strong></h5>
                    <hr>

                    <!-- Selección de método de pago -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Método de Pago</label>
                        <select id="metodoPago" class="form-select">
                            <option value="efectivo">Efectivo</option>
                            <option value="tarjeta">Tarjeta de Crédito / Débito</option>
                            <option value="transferencia">Transferencia Bancaria</option>
                            <option value="mixto">Pago Mixto</option>
                        </select>
                    </div>

                    <!-- EFECTIVO -->
                    <div id="pagoEfectivo" class="metodoPago">
                        <label class="form-label">Monto recibido:</label>
                        <input type="number" id="montoRecibido" class="form-control" min="0" step="0.01" />
                        <label class="form-label mt-2">Cambio:</label>
                        <input type="text" id="cambio" class="form-control" readonly />
                    </div>

                    <!-- TARJETA -->
                    <div id="pagoTarjeta" class="metodoPago d-none">
                        <label class="form-label">Monto con tarjeta:</label>
                        <input type="number" id="montoTarjeta" class="form-control" min="0" step="0.01" />
                    </div>

                    <!-- TRANSFERENCIA -->
                    <div id="pagoTransferencia" class="metodoPago d-none">
                        <label class="form-label">Monto por transferencia:</label>
                        <input type="number" id="montoTransferencia" class="form-control" min="0" step="0.01" />
                        <small class="text-muted">Ingrese el monto transferido.</small>
                    </div>

                    <!-- MIXTO -->
                    <div id="pagoMixto" class="metodoPago d-none">
                        <label class="form-label">Monto en efectivo:</label>
                        <input type="number" id="montoMixtoEfectivo" class="form-control mb-2" min="0" step="0.01" />
                        <label class="form-label">Monto en tarjeta:</label>
                        <input type="number" id="montoMixtoTarjeta" class="form-control mb-2" min="0" step="0.01" />
                        <label class="form-label">Monto en transferencia:</label>
                        <input type="number" id="montoMixtoTransferencia" class="form-control" min="0" step="0.01" />
                    </div>
                </div>

                <!-- MENSAJE DESPUÉS DE GUARDAR LA VENTA -->
                <div id="contenidoVentaFinalizada" class="text-center d-none">
                    <h4 class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Venta Completada</h4>
                    <p class="text-muted mb-4">La información de pago ha sido guardada. Descargue Factura.</p>
                    <button id="btnDescargarFactura" class="btn btn-outline-primary">
                        <i class="bi bi-file-earmark-arrow-down"></i> Descargar factura
                    </button>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button class="btn btn-success" id="btnConfirmarCobro"><i class="bi bi-check2-circle"></i> Confirmar Pago</button>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .card {
        border-radius: 8px;
    }

    .card-header {
        border-radius: 8px 8px 0 0 !important;
    }

    .table th {
        background-color: #f1f3f5;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.9rem;
    }

    .search-container {
        flex-grow: 1;
        min-width: 200px;
    }

    .suggestions-box {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #dee2e6;
        border-top: none;
        z-index: 1000;
        max-height: 250px;
        overflow-y: auto;
    }

        .suggestions-box button {
            border: none;
            background: #fff;
            width: 100%;
            text-align: left;
            padding: 8px 12px;
        }

            .suggestions-box button:hover {
                background: #f8f9fa;
            }

    #subtotal,
    #iva {
        background-color: #f8f9fa;
    }

    #total {
        background-color: #e9f7ef;
        font-size: 1.1rem;
    }

    .form-control.text-end {
        text-align: right !important;
    }

</style>

@section Scripts {
    <script>
        const tablaBody = document.querySelector("#tablaProductos tbody");
        const inputBusqueda = document.querySelector("#busqueda");
        const btnCobrar = document.querySelector("#btnCobrar");
        const btnCancelar = document.querySelector("#btnCancelar");

        let productosSeleccionados = [];
        let ultimosResultados = [];
        let clienteSeleccionado = null; 

        function setValueIfExists(selector, value) {
            const el = document.querySelector(selector);
            if (el) el.value = value;
        }

         function mostrarMensaje(texto, tipo = "info", duracion = 3000) {
             let contenedor = document.getElementById("centroAlertas");
             if (!contenedor) {
                 contenedor = document.createElement("div");
                 contenedor.id = "centroAlertas";
                 contenedor.style.position = "fixed";
                 contenedor.style.bottom = "20px";
                 contenedor.style.left = "20px";
                 contenedor.style.zIndex = "1055";
                 contenedor.style.display = "flex";
                 contenedor.style.flexDirection = "column";
                 contenedor.style.gap = "8px";
                 document.body.appendChild(contenedor);
             }

              const alerta = document.createElement("div");
             alerta.className = `alert alert-${tipo} shadow-sm border-0 fade show`;
             alerta.style.minWidth = "260px";
             alerta.style.maxWidth = "320px";
             alerta.style.padding = "10px 14px";
             alerta.style.fontSize = "0.9rem";
             alerta.style.cursor = "pointer";
             alerta.style.borderRadius = "10px";
             alerta.innerHTML = `<strong>${texto}</strong>`;

             alerta.addEventListener("click", () => alerta.remove());
             contenedor.appendChild(alerta);

             if (duracion > 0) {
                 setTimeout(() => alerta.remove(), duracion);
             }
         }

        inputBusqueda.addEventListener("keyup", async (e) => {
            const term = e.target.value.trim();
            const contenedor = inputBusqueda.closest(".search-container");
            if (term.length < 2) {
                const prev = contenedor.querySelector(".suggestions-box");
                if (prev) prev.remove();
                return;
            }

             const resp = await fetch(`/Ventas/BuscarProducto?term=${encodeURIComponent(term)}`);

            const data = await resp.json();
            ultimosResultados = data.results || [];
            mostrarSugerencias(ultimosResultados, contenedor);
        });

        inputBusqueda.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                if (ultimosResultados.length > 0) {
                    seleccionarProducto(ultimosResultados[0]);
                    const contenedor = inputBusqueda.closest(".search-container");
                    const lista = contenedor.querySelector(".suggestions-box");
                    if (lista) lista.remove();
                }
            }
        });

                // FUNCIÓN PARA FORMATEAR NÚMEROS EN FORMATO GUATEMALTECO
        function formatearNumeroGuatemala(numero) {
            if (numero === null || numero === undefined || isNaN(numero)) {
                return "0.00";
            }

            // Convertir a número si es string
            const num = typeof numero === 'string' ? parseFloat(numero) : numero;

            return num.toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        // FUNCIÓN PARA FORMATEAR MONEDA EN FORMATO GUATEMALTECO
        function formatearMonedaGuatemala(monto) {
            return `Q${formatearNumeroGuatemala(monto)}`;
        }

                // 🔧 Función para limpiar el formato de moneda "Q1,234.56" -> 1234.56
        function limpiarFormatoMoneda(valor) {
            if (!valor) return 0;
            return parseFloat(
                valor.toString()
                    .replace(/[Q,\s]/g, '') // Q y comas
                    .replace(/[^\d.-]/g, '') // cualquier otro símbolo no numérico
            ) || 0;
        }


         function mostrarSugerencias(lista, contenedor) {
             const prev = contenedor.querySelector(".suggestions-box");
             if (prev) prev.remove();
             if (!lista.length) return;

             const div = document.createElement("div");
             div.classList.add("suggestions-box");

            lista.forEach(p => {
                const stock = p.stock ?? 0;
                const esKit = p.tipo === "kit";
                    let colorStock = "text-success";
                    let estado = "Disponible";

            if (!esKit) {
                if (stock <= 0) { colorStock = "text-danger"; estado = "Sin existencias"; }
                else if (stock <= 3) { colorStock = "text-warning"; estado = "Stock bajo"; }
            }

            const item = document.createElement("button");
            item.type = "button";
            item.innerHTML = `
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <strong>${p.text}</strong> ${esKit ? '<span class="badge bg-info text-dark ms-2">KIT</span>' : ""}
                    <br>
                    ${!esKit ? `<small class="${colorStock}">${estado} — Stock: ${stock}</small>` : '<small class="text-primary">Promoción especial</small>'}
                </div>
                <span class="text-muted">${formatearMonedaGuatemala(p.precio)}</span>
            </div>`;
            item.onclick = () => { seleccionarProducto(p); div.remove(); };
            div.appendChild(item);
       });

              contenedor.appendChild(div);
             document.addEventListener("click", (ev) => {
                 if (!contenedor.contains(ev.target)) {
                     const list = contenedor.querySelector(".suggestions-box");
                     if (list) list.remove();
                 }
             }, { once: true });
         }


        function seleccionarProducto(prod) {
            const esKit = prod.tipo === "kit";

            if (esKit) {
                const existente = productosSeleccionados.find(p => p.idKit === prod.id);
                if (existente) {
                    existente.cantidad++;
                } else {
                    productosSeleccionados.push({
                        idKit: prod.id,
                        id: null,
                        nombre: prod.text + " (KIT)",
                        precio: parseFloat(prod.precio),
                        cantidad: 1,
                        descuento: 0,
                        stock: 9999,
                        esKit: true
                    });
                }
                mostrarMensaje(`✅ Kit "${prod.text}" añadido a la venta.`, "success");
            }
            else {
                const stockBase = prod.stock ?? 0; // stock en unidades base (ej. unidades individuales)
                if (stockBase <= 0) {
                    mostrarMensaje(`❌ El producto "${prod.text}" no tiene existencias.`, "danger");
                    return;
                } else if (stockBase <= 3) {
                    mostrarMensaje(`⚠️ Stock bajo: ${stockBase} unidades disponibles.`, "warning");
                } else {
                    mostrarMensaje(`✅ Stock disponible: ${stockBase} unidades.`, "success");
                }

                // Unidades que vino en el JSON
                const unidades = prod.unidades || []; // [{IdUnidad, Nombre, FactorConversion}]

                // determinar unidad por defecto (primera)
                const defaultIdUnidad = (unidades[0] ? unidades[0].IdUnidad : null);

                const existente = productosSeleccionados.find(p => p.id === prod.id && !p.esKit);
                if (existente) {
                    // calcular unidades disponibles en la unidad actualmente seleccionada
                    const unidadSel = (existente.unidades || []).find(u => u.IdUnidad == existente.idUnidadSeleccionada);
                    const factorSel = unidadSel ? parseFloat(unidadSel.FactorConversion) || 1 : 1;
                    const disponiblesEnUnidad = Math.floor((existente.stock || stockBase) / factorSel);

                    if (existente.cantidad + 1 > disponiblesEnUnidad) {
                        mostrarMensaje(`⚠️ No puedes agregar más unidades. Disponible en la unidad seleccionada: ${disponiblesEnUnidad}`, "warning");
                        return;
                    }
                    existente.cantidad++;
                } else {
                    productosSeleccionados.push({
                        id: prod.id,
                        nombre: prod.text,
                        precio: parseFloat(prod.precio) || 0,
                        cantidad: 1,
                        descuento: 0,
                        stock: stockBase, // guardamos stock en unidades base
                        esKit: false,
                        unidades: unidades,
                        idUnidadSeleccionada: defaultIdUnidad // default
                    });
                }
            }

            inputBusqueda.value = "";
            renderTabla();
        }


        //Renderiza la tabla para el listado
        function renderTabla() {
            tablaBody.innerHTML = "";

            productosSeleccionados.forEach((p, i) => {
                // VALIDAR QUE LA UNIDAD SELECCIONADA SIGUE SIENDO VÁLIDA
                let unidadActual = (p.unidades || []).find(u =>
                    (u.IdUnidad ?? u.idUnidad) == p.idUnidadSeleccionada
                );

                // Si la unidad actual no es válida o no tiene stock, buscar la primera disponible
                if (!unidadActual) {
                    const primeraUnidadValida = (p.unidades || []).find(u => {
                        const factorU = parseFloat(u.FactorConversion) || 1;
                        const disponibles = Math.floor((p.stock || 0) / factorU);
                        return disponibles >= 1;
                    });

                    if (primeraUnidadValida) {
                        p.idUnidadSeleccionada = primeraUnidadValida.IdUnidad ?? primeraUnidadValida.idUnidad;
                        unidadActual = primeraUnidadValida;
                    } else {
                        // Si no hay ninguna unidad disponible, usar la primera
                        p.idUnidadSeleccionada = (p.unidades[0]?.IdUnidad ?? p.unidades[0]?.idUnidad) || null;
                        unidadActual = p.unidades[0] || null;
                    }
                }

                const factor = unidadActual ? (parseFloat(unidadActual.FactorConversion) || 1) : 1;
                const disponiblesEnUnidad = Math.floor((p.stock || 0) / factor);
                const subtotal = p.precio * p.cantidad * (1 - (p.descuento || 0) / 100);

                const tr = document.createElement("tr");

                // MEJORAR OPCIONES CON VALIDACIÓN DE STOCK
                const opcionesUnidades = (p.unidades || []).map(u => {
                    const id = u.IdUnidad ?? u.idUnidad;
                    const nombre = u.Nombre ?? u.nombre ?? "Sin nombre";
                    const factorU = parseFloat(u.FactorConversion) || 1;
                    const disponibles = Math.floor((p.stock || 0) / factorU);

                    const disabled = disponibles < 1 ? "disabled" : "";
                    const selected = id === p.idUnidadSeleccionada ? "selected" : "";
                    const alertaStock = disponibles < 1 ? " (Sin stock)" : "";

                    return `<option value="${id}" ${selected} ${disabled}>
                                ${nombre}${alertaStock}
                            </option>`;
                }).join("");

                let badgeStock = "";
                if (p.stock <= 3 && p.stock > 0)
                    badgeStock = `<span class="badge bg-warning text-dark ms-2">Stock bajo</span>`;
                else if (p.stock <= 0)
                    badgeStock = `<span class="badge bg-danger ms-2">Sin stock</span>`;


                        tr.innerHTML = `
            <td class="text-start">
                ${p.nombre} ${badgeStock}
                <div class="small text-muted">Unidades Disponibles: ${formatearNumeroGuatemala(p.stock)}</div>
            </td>

            <td>${formatearMonedaGuatemala(p.precio)}</td>

            <td>
                <select class="form-select form-select-sm text-center unidadSelect"
                        data-index="${i}"
                        onchange="cambiarUnidad(${i}, this.value)">
                    ${opcionesUnidades}
                </select>
            </td>

            <td>
                <div class="input-group input-group-sm justify-content-center">
                    <button class="btn btn-outline-secondary btn-sm"
                            onclick="cambiarCantidadProducto(${i}, -1)"
                            ${disponiblesEnUnidad < 1 ? 'disabled' : ''}>-</button>
                    <input type="number"
                           min="1"
                           max="${disponiblesEnUnidad}"
                           class="form-control text-center"
                           style="max-width:60px;"
                           value="${p.cantidad}"
                           onchange="actualizarCantidadProducto(${i}, this.value)"
                           ${disponiblesEnUnidad < 1 ? 'disabled' : ''}>
                    <button class="btn btn-outline-secondary btn-sm"
                            onclick="cambiarCantidadProducto(${i}, 1)"
                            ${disponiblesEnUnidad < 1 ? 'disabled' : ''}>+</button>
                </div>
                ${disponiblesEnUnidad < 1 ?
                  '<div class="text-danger small mt-1">❌ Sin stock en esta presentación</div>' : ''}
            </td>

            <td>
                <input type="number"
                       class="form-control form-control-sm text-center"
                       min="0" max="100"
                       value="${p.descuento}"
                       onchange="actualizarDescuento(${i}, this.value)"
                       ${disponiblesEnUnidad < 1 ? 'disabled' : ''}>
            </td>

            <td>
                <button class="btn btn-sm btn-outline-danger" onclick="eliminarProducto(${i})">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

                tablaBody.appendChild(tr);
            });

            recalcularTotales();
        }


        function cambiarUnidad(index, idUnidadSeleccionada) {
            const producto = productosSeleccionados[index];

            const unidadAnterior = producto.idUnidadSeleccionada;
         
            // Encontrar la unidad seleccionada
            const unidadSeleccionada = producto.unidades.find(u =>
                (u.IdUnidad ?? u.idUnidad) == idUnidadSeleccionada
            );

            if (!unidadSeleccionada) {
                // Si no encuentra la unidad, restaurar inmediatamente
                restaurarSelectUnidad(index, unidadAnterior);
                return;
            }

            const factor = parseFloat(unidadSeleccionada.FactorConversion ?? unidadSeleccionada.factorConversion ?? 1);
            const precioBase = producto.precioBase ?? producto.precio;

            // VALIDAR STOCK ANTES DE CAMBIAR
            const disponiblesEnUnidad = Math.floor((producto.stock || 0) / factor);

            if (disponiblesEnUnidad < 1) {
                const nombreUnidad = unidadSeleccionada.Nombre ?? unidadSeleccionada.nombre ?? "esta presentación";
                mostrarMensaje(`❌ No hay stock suficiente para ${nombreUnidad}.`, "danger");

                // RESTAURAR INMEDIATAMENTE el valor anterior
                restaurarSelectUnidad(index, unidadAnterior);
                return;
            }

            // Si la cantidad actual supera el nuevo disponible, ajustarla
            if (producto.cantidad > disponiblesEnUnidad) {
                producto.cantidad = disponiblesEnUnidad;
                mostrarMensaje(`⚠️ La cantidad se ajustó al máximo disponible: ${disponiblesEnUnidad}`, "warning");
            }

            // Aplicar cambios solo si pasa todas las validaciones
            producto.idUnidadSeleccionada = parseInt(idUnidadSeleccionada);
            producto.precioBase = precioBase;
            producto.precio = precioBase * factor;

            mostrarMensaje(`🔁 Presentación cambiada a: ${unidadSeleccionada.Nombre ?? unidadSeleccionada.nombre}`, "info");
            renderTabla();
        }

        // FUNCIÓN PARA RESTAURAR EL SELECT INMEDIATAMENTE
        function restaurarSelectUnidad(index, valorAnterior) {
            
            setTimeout(() => {
                const select = document.querySelector(`.unidadSelect[data-index="${index}"]`);
                if (select) {
                    select.value = valorAnterior;
                }
            }, 0);
        }

        // FUNCIÓN CENTRALIZADA PARA CAMBIAR CANTIDAD
        function cambiarCantidadProducto(index, delta) {
            const producto = productosSeleccionados[index];
            if (!producto) return;

            // Obtener información de la unidad seleccionada
            const unidadSel = (producto.unidades || []).find(u =>
                (u.IdUnidad ?? u.idUnidad) == producto.idUnidadSeleccionada
            );

            const factor = unidadSel ? (parseFloat(unidadSel.FactorConversion) || 1) : 1;
            const disponiblesEnUnidad = Math.floor((producto.stock || 0) / factor);

            // Calcular nueva cantidad
            let nuevaCantidad = producto.cantidad + delta;

            // VALIDACIONES CENTRALIZADAS
            if (nuevaCantidad < 1) {
                nuevaCantidad = 1;
                mostrarMensaje("❌ La cantidad mínima es 1", "warning");
            } else if (nuevaCantidad > disponiblesEnUnidad) {
                nuevaCantidad = disponiblesEnUnidad;
                mostrarMensaje(`⚠️ No hay suficiente stock. Máximo disponible: ${disponiblesEnUnidad}`, "warning");
            }

            // Aplicar cambio
            producto.cantidad = nuevaCantidad;
            renderTabla();
        }

        // 🔴 FUNCIÓN CENTRALIZADA PARA ACTUALIZAR CANTIDAD DESDE INPUT
        function actualizarCantidadProducto(index, nuevaCantidadStr) {
            const producto = productosSeleccionados[index];
            if (!producto) return;

            // Obtener información de la unidad seleccionada
            const unidadSel = (producto.unidades || []).find(u =>
                (u.IdUnidad ?? u.idUnidad) == producto.idUnidadSeleccionada
            );

            const factor = unidadSel ? (parseFloat(unidadSel.FactorConversion) || 1) : 1;
            const disponiblesEnUnidad = Math.floor((producto.stock || 0) / factor);

            // Convertir y validar
            let nuevaCantidad = parseInt(nuevaCantidadStr);
            if (isNaN(nuevaCantidad) || nuevaCantidad < 1) {
                nuevaCantidad = 1;
            }

            // 🔴 VALIDACIONES CENTRALIZADAS
            if (nuevaCantidad > disponiblesEnUnidad) {
                nuevaCantidad = disponiblesEnUnidad;
                mostrarMensaje(`⚠️ No hay suficiente stock. Máximo disponible: ${disponiblesEnUnidad}`, "warning");
            }

            // Aplicar cambio
            producto.cantidad = nuevaCantidad;
            renderTabla();
        }


           function actualizarDescuento(i, v) { productosSeleccionados[i].descuento = Math.max(0, parseFloat(v)); renderTabla(); }
           function eliminarProducto(i) { productosSeleccionados.splice(i, 1); renderTabla(); mostrarMensaje("Producto eliminado de la venta.", "info"); }

