                            window.open(`/Ventas/DescargarFactura?idVenta=${idVenta}`, '_blank');
                        } else {
                            mostrarMensaje("No se pudo obtener el ID de la venta para descargar la factura.", "danger");
                        }
                    };

                    btnDescargar.focus();
                }

            }catch (err) {
                console.error("Error guardando venta:", err);
                mostrarMensaje("Ocurrió un error al intentar guardar la venta. Revisa la consola.", "danger", 6000);
            }
            });

                        function limpiarCamposDespuesVenta() {
                clienteSeleccionado = null;
                const nitInput = document.querySelector("#nitCliente");
                if (nitInput) nitInput.value = "";

                const nombreSpan = document.querySelector("#nombreCliente");
                const correoSpan = document.querySelector("#correoCliente");
                const direccionSpan = document.querySelector("#direccionCliente");
                if (nombreSpan) nombreSpan.innerText = "";
                if (correoSpan) correoSpan.innerText = "";
                if (direccionSpan) direccionSpan.innerText = "";

                const totalEl = document.querySelector("#total");
                if (totalEl) totalEl.value = "Q0.00";

                const busquedaInput = document.querySelector("#busqueda");
                if (busquedaInput) busquedaInput.value = "";

                document.querySelector("#alertaStock")?.remove();

                const montoRecibido = document.querySelector("#montoRecibido");
                const cambio = document.querySelector("#cambio");
                const montoTarjeta = document.querySelector("#montoTarjeta");
                const montoTransferencia = document.querySelector("#montoTransferencia");
                const montoMixtoE = document.querySelector("#montoMixtoEfectivo");
                const montoMixtoT = document.querySelector("#montoMixtoTarjeta");
                const montoMixtoTr = document.querySelector("#montoMixtoTransferencia");

                if (montoRecibido) montoRecibido.value = "";
                if (cambio) cambio.value = "";
                if (montoTarjeta) montoTarjeta.value = "";
                if (montoTransferencia) montoTransferencia.value = "";
                if (montoMixtoE) montoMixtoE.value = "";
                if (montoMixtoT) montoMixtoT.value = "";
                if (montoMixtoTr) montoMixtoTr.value = "";
            }

             btnCancelar.addEventListener("click", () => {
                 productosSeleccionados = [];
                 renderTabla();
                 mostrarMensaje("Venta cancelada correctamente.", "info");
             });


            const opcionNit = document.getElementById("opcionNit");
            const opcionCF = document.getElementById("opcionCF");
            const seccionNit = document.getElementById("seccionNit");
            const seccionCF = document.getElementById("seccionCF");

            opcionNit?.addEventListener("change", () => {
                if (opcionNit.checked) {
                    seccionNit.classList.remove("d-none");
                    seccionCF.classList.add("d-none");
                    document.getElementById("nitCliente").focus();
                }
            });

            opcionCF?.addEventListener("change", () => {
                if (opcionCF.checked) {
                    seccionCF.classList.remove("d-none");
                    seccionNit.classList.add("d-none");
                    clienteSeleccionado = null;
                    console.log("CF seleccionado. clienteSeleccionado set to null");
                }
            });

            function limpiarFormularioVenta() {
                productosSeleccionados = [];
                renderTabla();

                clienteSeleccionado = null;

                const nitInput = document.querySelector("#nitCliente");
                if (nitInput) nitInput.value = "";

                const busquedaInput = document.querySelector("#busqueda");
                if (busquedaInput) busquedaInput.value = "";

                document.getElementById("datosCliente")?.classList.add("d-none");
                document.getElementById("formNuevoCliente")?.classList.add("d-none");

                const nombreSpan = document.querySelector("#nombreCliente");
                const correoSpan = document.querySelector("#correoCliente");
                const direccionSpan = document.querySelector("#direccionCliente");
                if (nombreSpan) nombreSpan.innerText = "";
                if (correoSpan) correoSpan.innerText = "";
                if (direccionSpan) direccionSpan.innerText = "";

                const totalEl = document.querySelector("#total");
                if (totalEl) totalEl.value = "Q0.00";

                document.querySelector("#contenidoVentaActiva")?.classList.remove("d-none");
                document.querySelector("#contenidoVentaFinalizada")?.classList.add("d-none");

                const metodoPago = document.querySelector("#metodoPago");
                if (metodoPago) {
                    metodoPago.value = "efectivo";
                    document.querySelectorAll(".metodoPago").forEach(div => div.classList.add("d-none"));
                    document.querySelector("#pagoEfectivo")?.classList.remove("d-none");
                }

                ["#montoRecibido", "#cambio", "#montoTarjeta", "#montoTransferencia", "#montoMixtoEfectivo", "#montoMixtoTarjeta", "#montoMixtoTransferencia"].forEach(sel => {
                    const el = document.querySelector(sel);
                    if (el) el.value = "";
                });

                const btnConfirmar = document.getElementById("btnConfirmarCobro");
                if (btnConfirmar) {
                    btnConfirmar.disabled = false;
                    btnConfirmar.classList.remove("d-none");
                }

                const btnDescargar = document.querySelector("#btnDescargarFactura");
                if (btnDescargar) {
                    btnDescargar.classList.add("d-none");
                    btnDescargar.onclick = null;
                }

                document.querySelector("#alertaStock")?.remove();
                const cont = document.querySelector(".search-container");
                if (cont) cont.querySelector(".suggestions-box")?.remove();
            }

            const modalEl = document.getElementById("modalCobro");
            if (modalEl) {
                modalEl.addEventListener('hidden.bs.modal', function () {
                    limpiarFormularioVenta();
                });
            }

    </script>

