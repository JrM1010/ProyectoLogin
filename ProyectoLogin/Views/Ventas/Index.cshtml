@{
    ViewData["Title"] = "Punto de Venta";
}

<div class="container-fluid mt-4">
    <div class="row g-3">

        <!-- =========================== -->
        <!-- 🧾 PANEL IZQUIERDO: PRODUCTOS -->
        <!-- =========================== -->
        <div class="col-lg-8 col-md-7">
            <div class="card shadow border-0">
                <div class="card-header bg-gradient-primary text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-basket2-fill me-2"></i>Punto de Venta</h5>
                </div>

                <div class="card-body pt-3">
                    <!-- 🔹 Buscadores -->
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        <div class="search-container flex-grow-1">
                            <input type="text" id="busqueda" class="form-control form-control-sm"
                                   placeholder="Buscar producto por nombre o código..." autocomplete="off" />
                        </div>

                        <div class="input-group input-group-sm flex-grow-1">
                            <input type="text" id="busquedaPromocion" class="form-control form-control-sm"
                                   placeholder="Buscar promoción o combo..." />
                            <button class="btn btn-outline-success" id="btnBuscarPromocion">
                                <i class="bi bi-gift-fill me-1"></i>Agregar
                            </button>
                        </div>
                    </div>

                    <!-- 🔹 Tabla de productos -->
                    <div class="table-responsive border rounded">
                        <table class="table table-hover table-sm align-middle text-center mb-0" id="tablaProductos">
                            <thead class="table-light">
                                <tr class="text-uppercase small">
                                    <th style="width: 35%;">Producto / Promoción</th>
                                    <th>Precio</th>
                                    <th>Cantidad</th>
                                    <th>Desc. %</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- =========================== -->
        <!-- 💳 PANEL DERECHO: CLIENTE + TOTALES -->
        <!-- =========================== -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow border-0 sticky-top" style="top: 1rem;">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary fw-bold mb-3">
                        <i class="bi bi-person-vcard me-1"></i> Datos del Cliente
                    </h5>

                    <!-- 🔸 Tipo de cliente -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar tipo de cliente</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoCliente" id="opcionNit" checked>
                                <label class="form-check-label" for="opcionNit">Con NIT</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoCliente" id="opcionCF">
                                <label class="form-check-label" for="opcionCF">Consumidor Final (CF)</label>
                            </div>
                        </div>
                    </div>

                    <!-- 🔹 Buscar cliente -->
                    <div id="seccionNit" class="mb-3">
                        <div class="input-group">
                            <input type="text" id="nitCliente" class="form-control form-control-sm"
                                   placeholder="NIT del cliente..." />
                            <button id="btnBuscarCliente" class="btn btn-sm btn-primary">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                        </div>

                        <!-- Datos del cliente encontrado -->
                        <div id="datosCliente" class="border rounded p-2 mt-3 bg-light d-none">
                            <p class="mb-1"><strong>Nombre:</strong> <span id="nombreCliente"></span></p>
                            <p class="mb-1"><strong>Correo:</strong> <span id="correoCliente"></span></p>
                            <p class="mb-0"><strong>Dirección:</strong> <span id="direccionCliente"></span></p>
                        </div>

                        <!-- Registrar nuevo cliente -->
                        <div id="formNuevoCliente" class="border rounded p-2 mt-3 d-none bg-light">
                            <h6 class="fw-bold text-secondary">Registrar nuevo cliente</h6>
                            <input type="text" id="nuevoNombre" class="form-control form-control-sm mb-2" placeholder="Nombres" />
                            <input type="text" id="nuevoApellido" class="form-control form-control-sm mb-2" placeholder="Apellidos" />
                            <input type="email" id="nuevoCorreo" class="form-control form-control-sm mb-2" placeholder="Correo" />
                            <input type="text" id="nuevoDireccion" class="form-control form-control-sm mb-2" placeholder="Dirección" />
                            <button id="btnGuardarCliente" class="btn btn-success btn-sm w-100">
                                <i class="bi bi-person-plus"></i> Guardar Cliente
                            </button>
                        </div>
                    </div>

                    <!-- 🔹 Consumidor final -->
                    <div id="seccionCF" class="border rounded p-2 mt-3 d-none bg-light">
                        <p class="mb-0"><strong>Nombre:</strong> Consumidor Final (CF)</p>
                    </div>

                    <hr class="my-3">

                    <!-- 🔸 Totales -->
                    <h6 class="fw-bold text-center text-primary mb-3">
                        <i class="bi bi-receipt-cutoff me-1"></i> Resumen de Venta
                    </h6>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Subtotal</label>
                        <input type="text" id="subtotal" class="form-control form-control-sm text-end" value="0.00" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">IVA (12%)</label>
                        <input type="text" id="iva" class="form-control form-control-sm text-end" value="0.00" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Total</label>
                        <input type="text" id="total" class="form-control form-control-sm text-end fs-5 fw-bold text-success" value="0.00" readonly />
                    </div>

                    <hr />

                    <!-- 🔸 Botones de acción -->
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" id="btnCobrar">
                            <i class="bi bi-cash-coin me-1"></i> Cobrar / Pagar
                        </button>
                        <button class="btn btn-outline-danger" id="btnCancelar">
                            <i class="bi bi-x-circle me-1"></i> Cancelar Venta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<!-- =========================== -->
<!-- 🔹 MODAL DE PAGO -->
<!-- =========================== -->
<div class="modal fade" id="modalCobro" tabindex="-1" aria-labelledby="modalCobroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-cash-stack"></i> Finalizar Venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div id="contenidoVentaActiva">
                    <h5 class="text-center">Total a pagar: <strong class="text-success fs-4" id="totalCobro">Q0.00</strong></h5>
                    <hr>

                    <!-- 🔹 Selección de método de pago -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Método de Pago</label>
                        <select id="metodoPago" class="form-select">
                            <option value="efectivo">Efectivo</option>
                            <option value="tarjeta">Tarjeta de Crédito / Débito</option>
                            <option value="transferencia">Transferencia Bancaria</option>
                            <option value="mixto">Pago Mixto</option>
                        </select>
                    </div>

                    <!-- 🔹 EFECTIVO -->
                    <div id="pagoEfectivo" class="metodoPago">
                        <label class="form-label">Monto recibido:</label>
                        <input type="number" id="montoRecibido" class="form-control" min="0" step="0.01" />
                        <label class="form-label mt-2">Cambio:</label>
                        <input type="text" id="cambio" class="form-control" readonly />
                    </div>

                    <!-- 🔹 TARJETA -->
                    <div id="pagoTarjeta" class="metodoPago d-none">
                        <label class="form-label">Monto con tarjeta:</label>
                        <input type="number" id="montoTarjeta" class="form-control" min="0" step="0.01" />
                    </div>

                    <!-- 🔹 TRANSFERENCIA -->
                    <div id="pagoTransferencia" class="metodoPago d-none">
                        <label class="form-label">Monto por transferencia:</label>
                        <input type="number" id="montoTransferencia" class="form-control" min="0" step="0.01" />
                        <small class="text-muted">Ingrese el monto transferido.</small>
                    </div>

                    <!-- 🔹 MIXTO -->
                    <div id="pagoMixto" class="metodoPago d-none">
                        <label class="form-label">Monto en efectivo:</label>
                        <input type="number" id="montoMixtoEfectivo" class="form-control mb-2" min="0" step="0.01" />
                        <label class="form-label">Monto en tarjeta:</label>
                        <input type="number" id="montoMixtoTarjeta" class="form-control mb-2" min="0" step="0.01" />
                        <label class="form-label">Monto en transferencia:</label>
                        <input type="number" id="montoMixtoTransferencia" class="form-control" min="0" step="0.01" />
                    </div>
                </div>

                <!-- 🔹 MENSAJE DESPUÉS DE GUARDAR LA VENTA -->
                <div id="contenidoVentaFinalizada" class="text-center d-none">
                    <h4 class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Venta Completada</h4>
                    <p class="text-muted mb-4">La información de pago ha sido guardada. Descargue Factura.</p>
                    <button id="btnDescargarFactura" class="btn btn-outline-primary">
                        <i class="bi bi-file-earmark-arrow-down"></i> Descargar factura
                    </button>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button class="btn btn-success" id="btnConfirmarCobro"><i class="bi bi-check2-circle"></i> Confirmar Pago</button>
            </div>
        </div>
    </div>
</div>



<!-- =========================== -->
<!-- 🔸 ESTILOS SIMPLES -->
<!-- =========================== -->
<style>
    body {
        background-color: #f8f9fa;
    }

    .card {
        border-radius: 8px;
    }

    .card-header {
        border-radius: 8px 8px 0 0 !important;
    }

    .table th {
        background-color: #f1f3f5;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.9rem;
    }

    .search-container {
        flex-grow: 1;
        min-width: 200px;
    }

    .suggestions-box {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #dee2e6;
        border-top: none;
        z-index: 1000;
        max-height: 250px;
        overflow-y: auto;
    }

        .suggestions-box button {
            border: none;
            background: #fff;
            width: 100%;
            text-align: left;
            padding: 8px 12px;
        }

            .suggestions-box button:hover {
                background: #f8f9fa;
            }

    #subtotal,
    #iva {
        background-color: #f8f9fa;
    }

    #total {
        background-color: #e9f7ef;
        font-size: 1.1rem;
    }
</style>


<!-- =========================== -->
<!-- 🔸 SCRIPT PRINCIPAL -->
<!-- =========================== -->
@section Scripts {
    <script>
        const tablaBody = document.querySelector("#tablaProductos tbody");
        const inputBusqueda = document.querySelector("#busqueda");
        const btnCobrar = document.querySelector("#btnCobrar");
        const btnCancelar = document.querySelector("#btnCancelar");

        let productosSeleccionados = [];
        let ultimosResultados = [];
        let clienteSeleccionado = null; // guarda id del cliente si se encontró/registró

        // helper para asignar value de forma segura (evita usar ?. en el LHS)
        function setValueIfExists(selector, value) {
            const el = document.querySelector(selector);
            if (el) el.value = value;
        }


         // ==========================================================
         // 🧱 CENTRO DE ALERTAS FLOTANTES (en esquina inferior izquierda)
         // ==========================================================
         function mostrarMensaje(texto, tipo = "info", duracion = 3000) {
             let contenedor = document.getElementById("centroAlertas");
             if (!contenedor) {
                 contenedor = document.createElement("div");
                 contenedor.id = "centroAlertas";
                 contenedor.style.position = "fixed";
                 contenedor.style.bottom = "20px";
                 contenedor.style.left = "20px";
                 contenedor.style.zIndex = "1055";
                 contenedor.style.display = "flex";
                 contenedor.style.flexDirection = "column";
                 contenedor.style.gap = "8px";
                 document.body.appendChild(contenedor);
             }

              const alerta = document.createElement("div");
             alerta.className = `alert alert-${tipo} shadow-sm border-0 fade show`;
             alerta.style.minWidth = "260px";
             alerta.style.maxWidth = "320px";
             alerta.style.padding = "10px 14px";
             alerta.style.fontSize = "0.9rem";
             alerta.style.cursor = "pointer";
             alerta.style.borderRadius = "10px";
             alerta.innerHTML = `<strong>${texto}</strong>`;

             alerta.addEventListener("click", () => alerta.remove());
             contenedor.appendChild(alerta);

             if (duracion > 0) {
                 setTimeout(() => alerta.remove(), duracion);
             }
         }


       // ==========================================================
        // 🔍 BUSQUEDA DE PRODUCTOS + ALERTA DE STOCK
        // ==========================================================
        inputBusqueda.addEventListener("keyup", async (e) => {
            const term = e.target.value.trim();
            const contenedor = inputBusqueda.closest(".search-container");
            if (term.length < 2) {
                const prev = contenedor.querySelector(".suggestions-box");
                if (prev) prev.remove();
                return;
            }

            const resp = await fetch(`/Ventas/BuscarProducto?term=${encodeURIComponent(term)}`);
            const data = await resp.json();
            ultimosResultados = data.results || [];
            mostrarSugerencias(ultimosResultados, contenedor);
        });

        inputBusqueda.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                if (ultimosResultados.length > 0) {
                    seleccionarProducto(ultimosResultados[0]);
                    const contenedor = inputBusqueda.closest(".search-container");
                    const lista = contenedor.querySelector(".suggestions-box");
                    if (lista) lista.remove();
                }
            }
        });

          function mostrarSugerencias(lista, contenedor) {
             const prev = contenedor.querySelector(".suggestions-box");
             if (prev) prev.remove();
             if (!lista.length) return;

             const div = document.createElement("div");
             div.classList.add("suggestions-box");

             lista.forEach(p => {
                 const stock = p.stock ?? 0;
                 let colorStock = "text-success";
                 let estado = "Disponible";
                 if (stock <= 0) { colorStock = "text-danger"; estado = "Sin existencias"; }
                 else if (stock <= 3) { colorStock = "text-warning"; estado = "Stock bajo"; }

                 const item = document.createElement("button");
                 item.type = "button";
                 item.innerHTML = `
                     <div class="d-flex justify-content-between align-items-center w-100">
                         <div>
                             <strong>${p.text}</strong><br>
                             <small class="${colorStock}">${estado} — Stock: ${stock}</small>
                         </div>
                         <span class="text-muted">Q${p.precio.toFixed(2)}</span>
                     </div>
                 `;
                 item.onclick = () => { seleccionarProducto(p); div.remove(); };
                 div.appendChild(item);
             });

              contenedor.appendChild(div);
             document.addEventListener("click", (ev) => {
                 if (!contenedor.contains(ev.target)) {
                     const list = contenedor.querySelector(".suggestions-box");
                     if (list) list.remove();
                 }
             }, { once: true });
         }

          // ==========================================================
         // 🧾 GESTIÓN DE PRODUCTOS CON VALIDACIÓN DE STOCK
         // ==========================================================
         function seleccionarProducto(prod) {
             const stock = prod.stock ?? 0;

             if (stock <= 0) {
                 mostrarMensaje(`❌ El producto "${prod.text}" no tiene existencias.`, "danger");
                 return;
             } else if (stock <= 3) {
                 mostrarMensaje(`⚠️ Stock bajo: ${stock} unidades disponibles.`, "warning");
             } else {
                 mostrarMensaje(`✅ Stock disponible: ${stock} unidades.`, "success");
             }

             const existente = productosSeleccionados.find(p => p.id === prod.id);
             if (existente) {
                 if (existente.cantidad + 1 > stock) {
                     mostrarMensaje(`⚠️ No puedes agregar más unidades. Stock disponible: ${stock}`, "warning");
                     return;
                 }
                 existente.cantidad++;
             } else {
                 productosSeleccionados.push({
                     id: prod.id,
                     nombre: prod.text,
                     precio: parseFloat(prod.precio),
                     cantidad: 1,
                     descuento: 0,
                     stock: stock
                 });
             }

             inputBusqueda.value = "";
             renderTabla();
         }

        // =============================
        // 🔍 Buscar y agregar promoción
        // =============================
        document.getElementById("btnBuscarPromocion").addEventListener("click", async () => {
            const term = document.getElementById("busquedaPromocion").value.trim();
            if (!term) return;

            const res = await fetch(`/Ventas/BuscarPromocion?term=${encodeURIComponent(term)}`);
            const data = await res.json();

            if (!data.results.length) {
                mostrarMensaje("No se encontró ninguna promoción.", "warning");
                return;
            }

            const promo = data.results[0];
            agregarPromocionAVenta(promo);
        });

        function agregarPromocionAVenta(promo) {
            const existente = productosSeleccionados.find(p => p.idKit === promo.id);
            if (existente) {
                existente.cantidad += 1;
                existente.subtotal = existente.precio * existente.cantidad;
            } else {
                productosSeleccionados.push({
                    idKit: promo.id,
                    id: null, // no tiene idProducto
                    nombre: promo.text + " (Promoción)",
                    cantidad: 1,
                    precio: parseFloat(promo.total) || 0,
                    descuento: 0, // compatibilidad con renderTabla
                    stock: 9999, // no limitado (no se edita en tabla)
                    subtotal: parseFloat(promo.total) || 0,
                    esKit: true
                });
            }

            renderTabla();
            recalcularTotales();
            mostrarMensaje(`✅ Promoción "${promo.text}" añadida a la venta.`, "success");
        }







          // ==========================================================
         // 🧮 TABLA Y TOTALES
         // ==========================================================
         function renderTabla() {
             tablaBody.innerHTML = "";
             productosSeleccionados.forEach((p, i) => {
                 const subtotal = p.precio * p.cantidad * (1 - p.descuento / 100);
                 const tr = document.createElement("tr");

                 let badgeStock = "";
                 if (p.stock <= 3 && p.stock > 0)
                     badgeStock = `<span class="badge bg-warning text-dark ms-2">Stock bajo</span>`;
                 else if (p.stock <= 0)
                     badgeStock = `<span class="badge bg-danger ms-2">Sin stock</span>`;

                 tr.innerHTML = `
                     <td class="text-start">${p.nombre} ${badgeStock}</td>
                     <td>Q${p.precio.toFixed(2)}</td>
                     <td>
                         <div class="input-group input-group-sm justify-content-center">
                             <button class="btn btn-outline-secondary btn-sm" onclick="cambiarCantidad(${i}, -1)">-</button>
                             <input type="number" min="1" max="${p.stock}" class="form-control text-center" style="max-width:60px;"
                                 value="${p.cantidad}" onchange="actualizarCantidad(${i}, this.value)">
                             <button class="btn btn-outline-secondary btn-sm" onclick="cambiarCantidad(${i}, 1)">+</button>
                         </div>
                     </td>
                     <td><input type="number" class="form-control form-control-sm text-center" min="0" max="100"
                         value="${p.descuento}" onchange="actualizarDescuento(${i}, this.value)"></td>
                      <td>Q${isNaN(subtotal) ? "0.00" : subtotal.toFixed(2)}</td>
                     <td><button class="btn btn-sm btn-outline-danger" onclick="eliminarProducto(${i})">
                         <i class="bi bi-trash"></i></button></td>
                 `;
                 tablaBody.appendChild(tr);
             });
             recalcularTotales();
         }

          function cambiarCantidad(i, d) {
             const p = productosSeleccionados[i];
             const nuevaCantidad = p.cantidad + d;
             if (nuevaCantidad > p.stock) {
                 mostrarMensaje(`⚠️ No puedes superar el stock disponible (${p.stock}).`, "warning");
                 return;
             }
             p.cantidad = Math.max(1, nuevaCantidad);
             renderTabla();
         }

          function actualizarCantidad(i, v) {
             const p = productosSeleccionados[i];
             const val = parseInt(v);
             if (val > p.stock) {
                 mostrarMensaje(`⚠️ Stock máximo: ${p.stock}`, "warning");
                 renderTabla();
                 return;
             }
             p.cantidad = Math.max(1, val);
             renderTabla();
         }

           function actualizarDescuento(i, v) { productosSeleccionados[i].descuento = Math.max(0, parseFloat(v)); renderTabla(); }
           function eliminarProducto(i) { productosSeleccionados.splice(i, 1); renderTabla(); mostrarMensaje("Producto eliminado de la venta.", "info"); }


        function recalcularTotales() {
            let subtotal = 0;

            productosSeleccionados.forEach(p => {
                const precioConDescuento = p.precio * p.cantidad * (1 - (p.descuento || 0) / 100);
                subtotal += precioConDescuento;
            });

            const iva = subtotal * 0.12;
            const total = subtotal + iva;

            const subEl = document.querySelector("#subtotal");
            const ivaEl = document.querySelector("#iva");
            const totEl = document.querySelector("#total");

            if (subEl) subEl.value = subtotal.toFixed(2);
            if (ivaEl) ivaEl.value = iva.toFixed(2);
            if (totEl) totEl.value = total.toFixed(2);
        }


        // BUSCAR CLIENTE POR NIT
        document.getElementById("btnBuscarCliente").addEventListener("click", async function () {
            const nit = document.getElementById("nitCliente").value.trim();
            const nitLimpio = nit.replace(/[^0-9a-zA-Z]/g, "");
            if (!nit) {
                mostrarMensaje("Por favor ingrese un NIT antes de buscar.", "warning");
                return;
            }

            const res = await fetch(`/Ventas/BuscarClientePorNit?nit=${encodeURIComponent(nitLimpio)}`);
            const data = await res.json();

            console.log("Respuesta BuscarClientePorNit:", data);

            if (data.encontrado) {
                // tolerancia a múltiples nombres de propiedad que el servidor pueda devolver
                clienteSeleccionado = data?.cliente?.idCliente ?? data?.cliente?.IdCliente ?? data?.cliente?.id ?? data?.cliente?.Id ?? data?.idCliente ?? data?.IdCliente ?? data?.id ?? data?.Id ?? data?.clienteId ?? null;

                // mostrar datos con tolerancia a nombres
                const nombres = data?.cliente?.nombres ?? data?.nombres ?? data?.Nombres ?? "";
                const apellidos = data?.cliente?.apellidos ?? data?.apellidos ?? data?.Apellidos ?? "";
                const correo = data?.cliente?.correo ?? data?.correo ?? data?.Correo ?? "";
                const direccion = data?.cliente?.direccion ?? data?.direccion ?? data?.Direccion ?? "";

                document.getElementById("nombreCliente").innerText = `${nombres} ${apellidos}`.trim();
                document.getElementById("correoCliente").innerText = correo;
                document.getElementById("direccionCliente").innerText = direccion;
                document.getElementById("datosCliente").classList.remove("d-none");
                document.getElementById("formNuevoCliente").classList.add("d-none");
                mostrarMensaje("Cliente encontrado correctamente.", "success");

                console.log("clienteSeleccionado asignado:", clienteSeleccionado);
            } else {
                clienteSeleccionado = null;
                document.getElementById("formNuevoCliente").classList.remove("d-none");
                document.getElementById("datosCliente").classList.add("d-none");
                mostrarMensaje("Cliente no encontrado. Complete los datos para registrarlo.", "info");
                console.log("Cliente no encontrado. clienteSeleccionado=", clienteSeleccionado);
            }
        });

        document.getElementById("nitCliente").addEventListener("keypress", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                document.getElementById("btnBuscarCliente").click();
            }
        });

        document.getElementById("nitCliente").addEventListener("input", function () {
            const nit = this.value.trim();
            if (!nit) {
                document.getElementById("datosCliente").classList.add("d-none");
                document.getElementById("formNuevoCliente").classList.add("d-none");
                clienteSeleccionado = null;
            }
        });

        // REGISTRAR CLIENTE RAPIDO
        document.getElementById("btnGuardarCliente").addEventListener("click", async function () {
            const nuevo = {
                nit: document.getElementById("nitCliente").value.trim(),
                nombres: document.getElementById("nuevoNombre").value,
                apellidos: document.getElementById("nuevoApellido").value,
                correo: document.getElementById("nuevoCorreo").value,
                direccion: document.getElementById("nuevoDireccion").value,
                telefono: "N/A"
            };

            const res = await fetch("/Ventas/RegistrarClienteRapido", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(nuevo)
            });

            console.log("Respuesta RegistrarClienteRapido (raw):", res);

            if (res.ok) {
                const data = await res.json();
                console.log("RegistrarClienteRapido -> data:", data);

                clienteSeleccionado = data?.cliente?.idCliente ?? data?.cliente?.IdCliente ?? data?.idCliente ?? data?.IdCliente ?? data?.id ?? data?.Id ?? data?.clienteId ?? null;

                // mostrar datos
                const nombres = data?.cliente?.nombres ?? data?.nombres ?? data?.Nombres ?? "";
                const apellidos = data?.cliente?.apellidos ?? data?.apellidos ?? data?.Apellidos ?? "";
                const correo = data?.cliente?.correo ?? data?.correo ?? data?.Correo ?? "";
                const direccion = data?.cliente?.direccion ?? data?.direccion ?? data?.Direccion ?? "";

                document.getElementById("nombreCliente").innerText = `${nombres} ${apellidos}`.trim();
                document.getElementById("correoCliente").innerText = correo;
                document.getElementById("direccionCliente").innerText = direccion;
                document.getElementById("datosCliente").classList.remove("d-none");
                document.getElementById("formNuevoCliente").classList.add("d-none");

                mostrarMensaje("Cliente registrado correctamente.", "success");
                console.log("clienteSeleccionado (post-registro):", clienteSeleccionado);
            } else {
                const err = await res.text();
                mostrarMensaje("Error al registrar cliente: " + err, "danger", 0);
                console.error("Error RegistrarClienteRapido:", err);
            }
        });

        // PROCESO DE PAGO Y COBRO
        const metodoPago = document.getElementById("metodoPago");
        const seccionesPago = document.querySelectorAll(".metodoPago");
        const totalInput = document.querySelector("#total");
        const totalCobro = document.querySelector("#totalCobro");

        metodoPago.addEventListener("change", () => {
            seccionesPago.forEach(div => div.classList.add("d-none"));
            const id = `#pago${metodoPago.value.charAt(0).toUpperCase() + metodoPago.value.slice(1)}`;
            const el = document.querySelector(id);
            if (el) el.classList.remove("d-none");
        });


            btnCobrar.addEventListener("click", async () => {
        // 1) Validar que hay productos
        if (!productosSeleccionados.length) {
            mostrarMensaje("No hay productos en la venta. Agrega al menos uno antes de cobrar.", "warning");
            const tabla = document.getElementById("tablaProductos");
            if (tabla) tabla.scrollIntoView({ behavior: "smooth", block: "center" });
            return;
        }

        // referencias
        const opcionNit = document.getElementById("opcionNit");
        const nitInput = document.getElementById("nitCliente");

        // helper: intenta buscar cliente por nit usando el endpoint ya existente
        async function buscarClientePorNitAuto(nitRaw) {
            try {
                const nitLimpio = (nitRaw || "").replace(/[^0-9a-zA-Z]/g, "");
                const resp = await fetch(`/Ventas/BuscarClientePorNit?nit=${encodeURIComponent(nitLimpio)}`);
                if (!resp.ok) {
                    // si el endpoint devuelve 4xx/5xx, tratamos como "no encontrado"
                    return { encontrado: false };
                }
                const data = await resp.json();
                return data || { encontrado: false };
            } catch (err) {
                console.error("Error en buscarClientePorNitAuto:", err);
                return { encontrado: false };
            }
        }

        // 2) Validar NIT/CF: si está NIT, asegurarnos de que exista el nit y esté verificado
        if (opcionNit?.checked) {
            const nit = nitInput?.value.trim();

            // 2.a) Si no hay nit escrito, avisar y detener
            if (!nit) {
                mostrarMensaje("Por favor ingresa un NIT antes de continuar con el cobro.", "warning");
                nitInput?.focus();
                return;
            }

            // 2.b) Si hay nit escrito pero clienteSeleccionado es null -> intentar buscar automáticamente
            if (clienteSeleccionado == null) {
                mostrarMensaje("Buscando cliente por NIT...", "info", 1500);
                const resultado = await buscarClientePorNitAuto(nit);

                if (resultado.encontrado) {
                    // Toleramos distintos nombres de propiedad devueltos por el backend
                    const cli = resultado.cliente ?? resultado;
                    clienteSeleccionado = cli?.idCliente ?? cli?.IdCliente ?? cli?.id ?? cli?.Id ?? resultado?.idCliente ?? resultado?.IdCliente ?? null;

                    // mostrar datos en UI si vienen
                    const nombres = cli?.nombres ?? cli?.Nombres ?? resultado?.nombres ?? "";
                    const apellidos = cli?.apellidos ?? cli?.Apellidos ?? resultado?.apellidos ?? "";
                    const correo = cli?.correo ?? cli?.Correo ?? resultado?.correo ?? "";
                    const direccion = cli?.direccion ?? cli?.Direccion ?? resultado?.direccion ?? "";

                    if (document.getElementById("nombreCliente")) document.getElementById("nombreCliente").innerText = `${nombres} ${apellidos}`.trim();
                    if (document.getElementById("correoCliente")) document.getElementById("correoCliente").innerText = correo;
                    if (document.getElementById("direccionCliente")) document.getElementById("direccionCliente").innerText = direccion;
                    document.getElementById("datosCliente")?.classList.remove("d-none");
                    document.getElementById("formNuevoCliente")?.classList.add("d-none");

                    mostrarMensaje("Cliente encontrado automáticamente.", "success", 2000);
                    // continúa el flujo: clienteSeleccionado ahora tiene valor
                } else {
                    // No se encontró cliente: avisar y detener, el usuario puede registrar o corregir
                    mostrarMensaje("No se encontró un cliente con ese NIT. Registra el cliente o corrige el NIT.", "warning");
                    // mostrar formulario de registro para que el usuario pueda crearlo rápidamente
                    document.getElementById("formNuevoCliente")?.classList.remove("d-none");
                    document.getElementById("datosCliente")?.classList.add("d-none");
                    nitInput?.focus();
                    return;
                }
            }
        }

            const total = parseFloat(totalInput.value || 0);
            totalCobro.textContent = `Q${total.toFixed(2)}`;
            metodoPago.value = "efectivo";
            seccionesPago.forEach(div => div.classList.add("d-none"));
            const el = document.querySelector("#pagoEfectivo");
            if (el) el.classList.remove("d-none");

            // limpiar montos cada vez que se abre el modal (evita valores residuales)
            setValueIfExists("#montoRecibido", "");
            setValueIfExists("#cambio", "");
            setValueIfExists("#montoTarjeta", "");
            setValueIfExists("#montoTransferencia", "");
            setValueIfExists("#montoMixtoEfectivo", "");
            setValueIfExists("#montoMixtoTarjeta", "");
            setValueIfExists("#montoMixtoTransferencia", "");

            new bootstrap.Modal(document.getElementById("modalCobro")).show();
        });

        document.querySelector("#montoRecibido")?.addEventListener("input", () => {
            const total = parseFloat(totalInput.value || 0);
            const recibido = parseFloat(document.querySelector("#montoRecibido").value || 0);
            const cambio = recibido - total;
            document.querySelector("#cambio").value = cambio >= 0 ? `Q${cambio.toFixed(2)}` : "—";
        });

        // Confirmar cobro -> enviar venta
                // Confirmar cobro -> enviar venta
        document.querySelector("#btnConfirmarCobro").addEventListener("click", async () => {
            try {
                const total = parseFloat(document.querySelector("#total").value || 0);
                const subtotal = parseFloat(document.querySelector("#subtotal").value || 0);
                const iva = parseFloat(document.querySelector("#iva").value || 0);
                const metodo = document.getElementById("metodoPago").value || "efectivo";

                if (!productosSeleccionados.length) {
                    mostrarMensaje("No hay productos en la venta.", "warning");
                    return;
                }

                        const detalles = productosSeleccionados.map(p => {
            const sub = parseFloat((p.precio * p.cantidad * (1 - (p.descuento || 0) / 100)).toFixed(2));
            return {
                IdProducto: p.esKit ? null : Number(p.id),
                IdKit: p.esKit ? p.idKit : null,
                Cantidad: Number(p.cantidad),
                PrecioUnitario: Number(p.precio),
                Descuento: Number(p.descuento || 0),
                Subtotal: sub
            };
        });


                const payload = {
                    IdCliente: clienteSeleccionado ?? null,
                    MetodoPago: metodo,
                    Estado: "Completada",
                    Subtotal: subtotal,
                    IVA: iva,
                    Total: total,
                    Detalles: detalles
                };


                console.log("Venta enviada:", payload);
                const res = await fetch("/Ventas/GuardarVenta", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                let data;
                try { data = await res.json(); } catch { data = { message: await res.text() }; }

                if (!res.ok) throw new Error(data.message || "Error al guardar la venta.");

                mostrarMensaje(`✅ ${data.message || "Venta registrada correctamente."}`, "success");


                 // Ocultar el cuadro de datos del cliente (ya no corresponde mostrar info del cliente anterior)
                document.getElementById("datosCliente")?.classList.add("d-none");
                document.getElementById("formNuevoCliente")?.classList.add("d-none");

                 // Mostrar la sección finalizada (descarga) y ocultar la parte activa del modal
                document.querySelector("#contenidoVentaActiva")?.classList.add("d-none");
                document.querySelector("#contenidoVentaFinalizada")?.classList.remove("d-none");

                // Asegurar que el botón confirmar queda desactivado y oculto
                const btnConfirmar = document.getElementById("btnConfirmarCobro");
                if (btnConfirmar) {
                    btnConfirmar.disabled = true;
                    btnConfirmar.classList.add("d-none");
                }


                // Vaciar productos y refrescar tabla
                productosSeleccionados = [];
                renderTabla();


                 limpiarCamposDespuesVenta();

                        // Preparar el botón de descarga y hacerlo visible
        const idVenta = data.idVenta;
        const btnDescargar = document.getElementById("btnDescargarFactura");
        if (btnDescargar) {
            btnDescargar.classList.remove("d-none");
            btnDescargar.onclick = () => {
                if (idVenta) {
                    // abre la ruta de descarga en la misma ventana
                    window.location.href = `/Ventas/DescargarFactura/${idVenta}`;
                } else {
                    mostrarMensaje("No se pudo obtener el ID de la venta para descargar la factura.", "danger");
                }
            };
            // llevar foco y hacer scroll al apartado de descarga dentro del modal
            btnDescargar.focus();
            setTimeout(() => {
                btnDescargar.scrollIntoView({ behavior: "smooth", block: "center" });
            }, 120);
        }

            } catch (err) {
                console.error("Error guardando venta:", err);
                mostrarMensaje("Ocurrió un error al intentar guardar la venta. Revisa la consola.", "danger", 6000);
            }
        });

                    function limpiarCamposDespuesVenta() {
            // Limpiar cliente (estado)
            clienteSeleccionado = null;
            const nitInput = document.querySelector("#nitCliente");
            if (nitInput) nitInput.value = "";

            // Limpiar campos de etiqueta del cliente por si quedaron visibles en otro lugar
            const nombreSpan = document.querySelector("#nombreCliente");
            const correoSpan = document.querySelector("#correoCliente");
            const direccionSpan = document.querySelector("#direccionCliente");
            if (nombreSpan) nombreSpan.innerText = "";
            if (correoSpan) correoSpan.innerText = "";
            if (direccionSpan) direccionSpan.innerText = "";

            // Reset totales (aunque la vista finalizada muestra info guardada, dejar inputs listos)
            const subtotalEl = document.querySelector("#subtotal");
            const ivaEl = document.querySelector("#iva");
            const totalEl = document.querySelector("#total");
            if (subtotalEl) subtotalEl.value = "0.00";
            if (ivaEl) ivaEl.value = "0.00";
            if (totalEl) totalEl.value = "0.00";

            // Limpiar búsqueda de producto
            const busquedaInput = document.querySelector("#busqueda");
            if (busquedaInput) busquedaInput.value = "";

            // eliminar alertaStock si quedó
            document.querySelector("#alertaStock")?.remove();

            // ---- NUEVO: limpiar los campos del modal de pago ----
            const montoRecibido = document.querySelector("#montoRecibido");
            const cambio = document.querySelector("#cambio");
            const montoTarjeta = document.querySelector("#montoTarjeta");
            const montoTransferencia = document.querySelector("#montoTransferencia");
            const montoMixtoE = document.querySelector("#montoMixtoEfectivo");
            const montoMixtoT = document.querySelector("#montoMixtoTarjeta");
            const montoMixtoTr = document.querySelector("#montoMixtoTransferencia");

            if (montoRecibido) montoRecibido.value = "";
            if (cambio) cambio.value = "";
            if (montoTarjeta) montoTarjeta.value = "";
            if (montoTransferencia) montoTransferencia.value = "";
            if (montoMixtoE) montoMixtoE.value = "";
            if (montoMixtoT) montoMixtoT.value = "";
            if (montoMixtoTr) montoMixtoTr.value = "";
        }




         btnCancelar.addEventListener("click", () => {
             productosSeleccionados = [];
             renderTabla();
             mostrarMensaje("Venta cancelada correctamente.", "info");
         });

        function cambiarCantidad(i, d) { productosSeleccionados[i].cantidad = Math.max(1, productosSeleccionados[i].cantidad + d); renderTabla(); }
        function actualizarCantidad(i, v) { productosSeleccionados[i].cantidad = Math.max(1, parseInt(v)); renderTabla(); }
        function actualizarDescuento(i, v) { productosSeleccionados[i].descuento = Math.max(0, parseFloat(v)); renderTabla(); }
        function eliminarProducto(i) { productosSeleccionados.splice(i, 1); renderTabla(); mostrarMensaje("Producto eliminado de la venta.", "warning"); }

        function recalcularTotales() {
            let subtotal = 0;
            productosSeleccionados.forEach(p => subtotal += p.precio * p.cantidad * (1 - p.descuento / 100));
            document.querySelector("#subtotal").value = subtotal.toFixed(2);
            document.querySelector("#iva").value = (subtotal * 0.12).toFixed(2);
            document.querySelector("#total").value = (subtotal * 1.12).toFixed(2);
        }

        // SELECCION TIPO CLIENTE (NIT / CF)
        const opcionNit = document.getElementById("opcionNit");
        const opcionCF = document.getElementById("opcionCF");
        const seccionNit = document.getElementById("seccionNit");
        const seccionCF = document.getElementById("seccionCF");

        opcionNit?.addEventListener("change", () => {
            if (opcionNit.checked) {
                seccionNit.classList.remove("d-none");
                seccionCF.classList.add("d-none");
                document.getElementById("nitCliente").focus();
            }
        });

        opcionCF?.addEventListener("change", () => {
            if (opcionCF.checked) {
                seccionCF.classList.remove("d-none");
                seccionNit.classList.add("d-none");
                // consumidor final -> aseguramos que no se envíe id de cliente
                clienteSeleccionado = null;
                console.log("CF seleccionado. clienteSeleccionado set to null");
            }
        });






        //Reseteo de datos en la vista
                    function limpiarFormularioVenta() {
            // Vaciar productos y refrescar tabla
            productosSeleccionados = [];
            renderTabla();

            // Limpiar estado de cliente
            clienteSeleccionado = null;

            // Limpiar inputs principales
            const nitInput = document.querySelector("#nitCliente");
            if (nitInput) nitInput.value = "";

            const busquedaInput = document.querySelector("#busqueda");
            if (busquedaInput) busquedaInput.value = "";

            // Ocultar cuadro y formulario de cliente (si estaban visibles)
            document.getElementById("datosCliente")?.classList.add("d-none");
            document.getElementById("formNuevoCliente")?.classList.add("d-none");

            // Limpiar spans/labels de cliente
            const nombreSpan = document.querySelector("#nombreCliente");
            const correoSpan = document.querySelector("#correoCliente");
            const direccionSpan = document.querySelector("#direccionCliente");
            if (nombreSpan) nombreSpan.innerText = "";
            if (correoSpan) correoSpan.innerText = "";
            if (direccionSpan) direccionSpan.innerText = "";

            // Reset totales
            const subtotalEl = document.querySelector("#subtotal");
            const ivaEl = document.querySelector("#iva");
            const totalEl = document.querySelector("#total");
            if (subtotalEl) subtotalEl.value = "0.00";
            if (ivaEl) ivaEl.value = "0.00";
            if (totalEl) totalEl.value = "0.00";

            // Reset modal: dejar contenido activo visible (pero no forzar ocultación de "finalizada" si la quieres mostrar)
            // En caso de querer forzar volver al estado inicial completo:
            document.querySelector("#contenidoVentaActiva")?.classList.remove("d-none");
            document.querySelector("#contenidoVentaFinalizada")?.classList.add("d-none");

            // Restaurar método de pago inicial
            const metodoPago = document.querySelector("#metodoPago");
            if (metodoPago) {
                metodoPago.value = "efectivo";
                document.querySelectorAll(".metodoPago").forEach(div => div.classList.add("d-none"));
                document.querySelector("#pagoEfectivo")?.classList.remove("d-none");
            }

            // Limpiar montos del modal
            ["#montoRecibido", "#cambio", "#montoTarjeta", "#montoTransferencia", "#montoMixtoEfectivo", "#montoMixtoTarjeta", "#montoMixtoTransferencia"].forEach(sel => {
                const el = document.querySelector(sel);
                if (el) el.value = "";
            });

            // Restaurar botón confirmar
            const btnConfirmar = document.getElementById("btnConfirmarCobro");
            if (btnConfirmar) {
                btnConfirmar.disabled = false;
                btnConfirmar.classList.remove("d-none");
            }

            // Ocultar y limpiar botón descargar (no lo removemos si quieres mantener la sección finalizada visible,
            // pero normalmente es mejor ocultarlo hasta que haya una nueva venta)
            const btnDescargar = document.querySelector("#btnDescargarFactura");
            if (btnDescargar) {
                btnDescargar.classList.add("d-none");
                btnDescargar.onclick = null;
            }

            // Remover alertas temporales
            document.querySelector("#alertaStock")?.remove();
            const cont = document.querySelector(".search-container");
            if (cont) cont.querySelector(".suggestions-box")?.remove();
        }

        const modalEl = document.getElementById("modalCobro");
        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function () {
                // limpiar todo cuando el modal se cierre para iniciar nueva venta
                limpiarFormularioVenta();
            });
        }


    </script>

