        function cambiarUnidad(index, idUnidadSeleccionada) {
            const producto = productosSeleccionados[index];
            if (!producto) return;
            const unidadAnterior = producto.idUnidadSeleccionada;

            const unidadSeleccionada = (producto.unidades || []).find(u =>
                String(u.IdUnidad ?? u.idUnidad ?? u.Id ?? u.id) === String(idUnidadSeleccionada)
            );

            if (!unidadSeleccionada) {
                restaurarSelectUnidad(index, unidadAnterior);
                return;
            }

            const factor = parseFloat(unidadSeleccionada.FactorConversion ?? unidadSeleccionada.factorConversion ?? 1) || 1;
            const stockBase = Number(producto.stockBase ?? producto.stock ?? 0);
            const disponiblesEnUnidad = Math.floor(stockBase / factor);

            if (disponiblesEnUnidad < 1) {
                const nombreUnidad = unidadSeleccionada.Nombre ?? unidadSeleccionada.nombre ?? "esta presentación";
                mostrarMensaje(`❌ No hay stock suficiente para ${nombreUnidad}.`, "danger");
                restaurarSelectUnidad(index, unidadAnterior);
                return;
            }

            if ((producto.cantidad || 0) > disponiblesEnUnidad) {
                producto.cantidad = disponiblesEnUnidad;
                mostrarMensaje(`⚠️ La cantidad se ajustó al máximo disponible: ${disponiblesEnUnidad} ${unidadSeleccionada.Nombre ?? unidadSeleccionada.nombre}`, "warning");
            }

            producto.idUnidadSeleccionada = parseInt(idUnidadSeleccionada, 10);
            producto.precio = parseFloat(unidadSeleccionada.PrecioVenta ?? unidadSeleccionada.precioVenta ?? unidadSeleccionada.Precio ?? unidadSeleccionada.precio) || producto.precio || 0;
            producto.unidadNombre = unidadSeleccionada.Nombre ?? unidadSeleccionada.nombre ?? producto.unidadNombre ?? "Unidad";
            producto.factorConversion = factor;
            producto.descuento = 0;

            mostrarMensaje(`🔁 Presentación cambiada a: ${producto.unidadNombre}`, "info");
            renderTabla();
        }

         function restaurarSelectUnidad(index, valorAnterior) {
             setTimeout(() => {
                 const select = document.querySelector(`.unidadSelect[data-index="${index}"]`);
                 if (select) {
                     select.value = valorAnterior;
                 }
             }, 0);
         }

        function cambiarCantidadProducto(index, delta) {
            const producto = productosSeleccionados[index];
            if (!producto) return;

            const factor = Number(producto.factorConversion || 1);
            const stockBase = Number(producto.stockBase || producto.stock || 0);

            const usoExcluyendoEsta = productosSeleccionados
                .filter((p, idx) => String(p.id) === String(producto.id) && idx !== index)
                .reduce((s, p) => s + (Number(p.cantidad || 0) * Number(p.factorConversion || 1)), 0);

            const maxParaEsta = Math.floor((stockBase - usoExcluyendoEsta) / factor);

            let nuevaCantidad = Number(producto.cantidad || 0) + Number(delta || 0);

            if (nuevaCantidad < 1) nuevaCantidad = 1;
            if (nuevaCantidad > maxParaEsta) {
                nuevaCantidad = Math.max(1, maxParaEsta);
                mostrarMensaje(`⚠️ No puedes vender más de ${maxParaEsta} ${producto.unidadNombre || 'unidades'}.`, 'warning');
            }

            producto.cantidad = nuevaCantidad;
            producto.maxPermitido = maxParaEsta;
            renderTabla();
        }

        function actualizarCantidadProducto(index, nuevaCantidadStr) {
            const producto = productosSeleccionados[index];
            if (!producto) return;

            const factor = parseFloat(producto.factorConversion) || 1;
            const stockBase = Number(producto.stockBase ?? producto.stock ?? 0);
            const disponiblesEnUnidad = Math.floor(stockBase / factor);

            let nuevaCantidad = parseInt(nuevaCantidadStr, 10);
            if (isNaN(nuevaCantidad) || nuevaCantidad < 1) nuevaCantidad = 1;

            if (nuevaCantidad > disponiblesEnUnidad) {
                nuevaCantidad = disponiblesEnUnidad;
                mostrarMensaje(`⚠️ No hay suficiente stock. Máximo disponible: ${disponiblesEnUnidad}`, "warning");
            }

            producto.cantidad = nuevaCantidad;
            renderTabla();
        }

        function actualizarDescuento(i, v) {
            productosSeleccionados[i].descuento = Math.max(0, parseFloat(v));
            renderTabla();
        }

        function eliminarProducto(i) {
            productosSeleccionados.splice(i, 1);
            renderTabla();
            mostrarMensaje("Producto eliminado de la venta.", "info");
        }

        function recalcularTotales() {
            let total = 0;
            productosSeleccionados.forEach(p => {
                const precioConDescuento = p.precio * p.cantidad;
                total += precioConDescuento;
            });

            const totEl = document.querySelector("#total");
            if (totEl) totEl.value = formatearMonedaGuatemala(total);
        }

