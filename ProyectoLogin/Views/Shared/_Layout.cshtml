<!DOCTYPE html>
<html lang="es">

@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartCell POS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoLogin.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    @RenderSection("Styles", required: false)

    <style>
        :root {
            --primary-blue: #1C1973;
            --secondary-blue: #514BF2;
            --accent-blue: #8B88F2;
            --dark-bg: #0D0E26;
            --alt-bg: #081C59;
            --light-text: #F0F0F7;
            --border-radius: 0.5rem;
            --body-bg: #ffffff;
            --body-text: #212529;
            --shadow-soft: 0 4px 14px rgba(0, 0, 0, 0.08);
        }

        body {
            background-color: var(--body-bg);
            color: var(--body-text);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
        }

        .navbar {
            background-color: var(--alt-bg) !important;
            border-bottom: 1px solid var(--secondary-blue);
            padding: 0.75rem 0;
            box-shadow: var(--shadow-soft);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .navbar-brand {
            color: var(--light-text) !important;
            font-weight: 700;
            font-size: 1.5rem;
            padding: 0.4rem 0.9rem;
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.3s ease;
        }

            .navbar-brand i {
                font-size: 1.4rem;
                color: var(--accent-blue);
            }

            .navbar-brand:hover {
                background-color: rgba(255, 255, 255, 0.08);
            }

        .nav-link {
            color: var(--light-text) !important;
            padding: 0.45rem 0.9rem !important;
            border-radius: var(--border-radius);
            margin: 0 0.15rem;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.93rem;
        }

            .nav-link i {
                font-size: 1.05rem;
            }

            .nav-link:hover,
            .nav-link:focus {
                background-color: var(--secondary-blue);
                color: #ffffff !important;
            }

        /* 🔽 Dropdown con animación suave (Gestión, Movimientos, Reportes, Usuario) */
        .navbar .dropdown-menu {
            background-color: var(--alt-bg);
            border: 1px solid var(--accent-blue);
            border-radius: var(--border-radius);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
            padding: 0.35rem 0;
            display: block;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(8px);
            transition: opacity 0.22s ease-out, transform 0.22s ease-out, visibility 0.22s ease-out;
            will-change: opacity, transform;
        }

            .navbar .dropdown-menu.show {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
                transform: translateY(0);
            }

        .nav-link.dropdown-toggle[aria-expanded="true"] {
            background-color: var(--secondary-blue);
            color: #ffffff !important;
        }

        .dropdown-item {
            color: var(--light-text);
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

            .dropdown-item i {
                width: 1.1rem;
                text-align: center;
                font-size: 1rem;
            }

            .dropdown-item:hover,
            .dropdown-item:focus {
                background-color: var(--secondary-blue);
                color: #ffffff;
            }

        .dropdown-divider {
            border-color: var(--accent-blue);
            opacity: 0.25;
        }

        .navbar-toggler {
            border: 1px solid var(--accent-blue);
            padding: 0.25rem 0.5rem;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 2px var(--accent-blue);
            }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.85%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        .layout-container {
            max-width: 100%;
            padding: 1.5rem 1.5rem 2rem 1.5rem;
        }

        main {
            min-height: calc(100vh - 90px);
        }

        .btn-logout {
            color: #ff6b6b !important;
        }

            .btn-logout:hover {
                background-color: rgba(255, 107, 107, 0.12) !important;
            }

        .nav-item.active .nav-link,
        .nav-link.active {
            background-color: var(--secondary-blue) !important;
            color: #ffffff !important;
            font-weight: 600;
        }

        /* 📱 Ajustes para móvil: menú del layout como panel flotante y dropdowns sobrepuestos */
        @@media (max-width: 991.98px) {
            .navbar {
                position: relative;
                top: 0;
            }

            .navbar-collapse {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background-color: var(--alt-bg);
                box-shadow: var(--shadow-soft);
                padding: 0.75rem 1rem 1rem;
                z-index: 1090;
            }

            .navbar-nav {
                flex-direction: column;
            }

            .nav-link {
                margin: 0.25rem 0;
            }

            .navbar-nav .nav-item.dropdown {
                position: relative;
            }

            .navbar .dropdown-menu {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                border: none;
                box-shadow: none;
                background-color: rgba(8, 28, 89, 0.96);
                margin: 0;
                margin-top: 0.35rem;
                z-index: 1100;
            }
        }

        @@media (min-width: 992px) {
            .navbar .dropdown-menu {
                margin-top: 0.45rem;
            }
        }
    </style>
</head>

<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        var user = HttpContextAccessor.HttpContext?.User;
        bool isAuth = user?.Identity?.IsAuthenticated ?? false;
        bool isAdmin = user?.IsInRole("Administrador") ?? false;
        bool isEmpleado = user?.IsInRole("Vendedor") ?? false;

        bool hideNav =
        (currentController == "Inicio" && currentAction == "IniciarSesion") ||
        (currentController == "Access" && (currentAction == "StartRecovery" || currentAction == "Recovery"));
    }

    <header>
        @if (!hideNav)
        {
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-phone"></i>
                        <span>SmartCell Company</span>
                    </a>

                    <button class="navbar-toggler" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarSmartcell"
                            aria-controls="navbarSmartcell"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSmartcell">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <!-- Gestión -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#"
                                   id="gestionDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill"></i> Gestión
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="gestionDropdown">
                                    @if (isAuth && (isAdmin || isEmpleado))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-phone"></i> Productos</a></li>
                                    }
                                    @if (isAuth && isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Usuarios"><i class="bi bi-people-fill"></i> Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-controller="Proveedores" asp-action="Index"><i class="bi bi-truck"></i> Proveedores</a></li>
                                    }
                                    @if (isAuth && (isAdmin || isEmpleado))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index"><i class="bi bi-person-badge-fill"></i> Clientes</a></li>
                                    }
                                </ul>
                            </li>

                            <!-- Movimientos -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#"
                                   id="movimientosDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-arrow-left-right"></i> Movimientos
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="movimientosDropdown">
                                    @if (isAuth && isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Compras" asp-action="Index"><i class="bi bi-basket-fill"></i> Compras</a></li>
                                    }
                                    @if (isAuth && (isAdmin || isEmpleado))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Ventas" asp-action="Index"><i class="bi bi-cart-fill"></i> Ventas</a></li>
                                        <li><a class="dropdown-item" asp-controller="Kits" asp-action="Index"><i class="bi bi-gift-fill"></i> Promociones</a></li>
                                        <li><a class="dropdown-item" asp-controller="Utilidades" asp-action="AjustesInventario"><i class="bi bi-tools"></i> Ajustes de Inventario</a></li>
                                    }
                                </ul>
                            </li>

                            <!-- Reportes -->
                            @if (isAuth && isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#"
                                       id="reportesDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-bar-chart-fill"></i> Reportes
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="reportesDropdown">
                                        <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Ventas"><i class="bi bi-cash-stack"></i> Ventas</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Compras"><i class="bi bi-bag-fill"></i> Compras</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reportes" asp-action="ReporteInventario"><i class="bi bi-box-seam"></i> Inventario</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reportes" asp-action="ReporteAjustesInventario"><i class="bi bi-tools"></i> Ajustes de Inventario</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Actividades"><i class="bi bi-activity"></i> Actividades</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <!-- Usuario / Cerrar sesión -->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center"
                                   href="#" id="userDropdown"
                                   role="button" data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="bi bi-person-circle me-2"></i>
                                    @ViewData["nombreUsuario"]
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Home" asp-action="CerrarSesion" method="post">
                                            <button type="submit" class="dropdown-item btn-logout">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>

                    </div>
                </div>
            </nav>
        }
    </header>

    <div class="layout-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Resaltar el elemento de menú activo + evitar "latigazo" al abrir dropdown
        document.addEventListener('DOMContentLoaded', function () {
            const currentController = '@currentController';
            const currentAction = '@currentAction';

            const navLinks = document.querySelectorAll('.nav-link, .dropdown-item');
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (!href || href === '#') return;

                const url = new URL(href, window.location.origin);
                const path = url.pathname;
                const parts = path.split('/').filter(p => p);
                const linkController = parts[0] || 'Home';
                const linkAction = parts[1] || 'Index';

                if (linkController === currentController &&
                    (linkAction === currentAction ||
                        (linkAction === 'Index' && currentAction === 'Index'))) {

                    link.classList.add('active');

                    if (link.classList.contains('dropdown-item')) {
                        const dropdownToggle = link.closest('.dropdown-menu')?.previousElementSibling;
                        if (dropdownToggle) dropdownToggle.classList.add('active');
                    }
                }
            });

            // 🔧 Evitar que los dropdown-toggle con href="#" hagan scroll a la parte superior
            const dropdownToggles = document.querySelectorAll('.nav-link.dropdown-toggle');
            dropdownToggles.forEach(toggle => {
                toggle.addEventListener('click', function (e) {
                    // Bootstrap seguirá manejando el dropdown por data-bs-toggle,
                    // solo evitamos la navegación al "#"
                    e.preventDefault();
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
