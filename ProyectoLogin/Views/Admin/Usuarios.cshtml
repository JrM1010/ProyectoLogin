@model IEnumerable<ProyectoLogin.Models.Usuario>
@{
    // Usar las listas paginadas del ViewBag
    var activos = ViewBag.Activos as List<ProyectoLogin.Models.Usuario>
                  ?? new List<ProyectoLogin.Models.Usuario>();
    var inactivos = ViewBag.Inactivos as List<ProyectoLogin.Models.Usuario>
                   ?? new List<ProyectoLogin.Models.Usuario>();

    // Variables de paginación
    var totalActivos = ViewBag.TotalActivos ?? 0;
    var totalInactivos = ViewBag.TotalInactivos ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
    var pageActivos = ViewBag.PageActivos ?? 1;
    var pageInactivos = ViewBag.PageInactivos ?? 1;
    var totalPagesActivos = ViewBag.TotalPagesActivos ?? 1;
    var totalPagesInactivos = ViewBag.TotalPagesInactivos ?? 1;
}

<style>
    :root {
        /* Aprovechamos la paleta del layout / productos */
        --users-primary: var(--primary-blue, #1C1973);
        --users-secondary: var(--secondary-blue, #514BF2);
        --users-accent: var(--accent-blue, #8B88F2);
        --users-bg: var(--dark-bg, #0D0E26);
        --users-alt-bg: var(--alt-bg, #081C59);
        --users-text: var(--light-text, #F0F0F7);
        --users-radius: 0.75rem;
        --users-border: rgba(139, 136, 242, 0.35);
        --users-muted: #A0A0CC;
        --users-danger: #ff6b6b;
        --users-success: #35D399;
    }

    .users-theme {
        background: radial-gradient(circle at top left, rgba(81, 75, 242, 0.12), transparent),
                    radial-gradient(circle at top right, rgba(139, 136, 242, 0.08), transparent),
                    linear-gradient(135deg, var(--users-bg) 0%, #050814 100%);
        min-height: 100vh;
        padding: 1.5rem 0 2rem 0;
    }

    /* HEADER PRINCIPAL */
    .users-header {
        background: linear-gradient(135deg, var(--users-primary) 0%, var(--users-secondary) 100%);
        border-radius: var(--users-radius);
        padding: 1.5rem 2rem;
        margin-bottom: 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.55);
        border: 1px solid var(--users-accent);
        color: var(--users-text);
    }

    .users-header-title {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .users-header-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(8, 12, 32, 0.35);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: var(--users-accent);
    }

    .users-header h2 {
        margin: 0;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .users-header p {
        margin: 0;
        font-size: 0.86rem;
        color: rgba(240, 240, 247, 0.8);
    }

    .users-header-actions .btn {
        border-radius: var(--users-radius);
        font-weight: 600;
        padding: 0.55rem 1.35rem;
        font-size: 0.86rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .btn-users-outline {
        border: 1px solid rgba(240, 240, 247, 0.7);
        background: transparent;
        color: var(--users-text);
        transition: all 0.25s ease;
    }

    .btn-users-outline:hover {
        background: rgba(255, 255, 255, 0.08);
        transform: translateY(-1px);
    }

    .btn-users-primary {
        background: var(--users-secondary);
        border: none;
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
        transition: all 0.25s ease;
    }

    .btn-users-primary:hover {
        background: var(--users-primary);
        transform: translateY(-1px);
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.6);
        color: #ffffff;
    }

    /* BARRA DE BÚSQUEDA */
    .users-search-card {
        background: #121633;
        border-radius: var(--users-radius);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.75rem;
        border: 1px solid var(--users-border);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
        color: var(--users-text);
    }

    .users-search-label {
        font-size: 0.86rem;
        color: var(--users-muted);
        margin-bottom: 0.25rem;
    }

    .users-search-input {
        background: rgba(10, 12, 34, 0.95);
        border-radius: var(--users-radius);
        border: 1px solid var(--users-border);
        color: var(--users-text);
        padding: 0.7rem 1rem;
        width: 260px;
        transition: all 0.25s ease;
        font-size: 0.88rem;
    }

    .users-search-input::placeholder {
        color: rgba(160, 160, 204, 0.7);
    }

    .users-search-input:focus {
        outline: none;
        border-color: var(--users-secondary);
        box-shadow: 0 0 0 0.16rem rgba(81, 75, 242, 0.3);
        background: #111632;
    }

    .btn-users-search {
        border-radius: var(--users-radius);
        padding: 0.7rem 1.4rem;
        font-size: 0.85rem;
        background: var(--users-secondary);
        border: 1px solid var(--users-accent);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.25s ease;
    }

    .btn-users-search:hover {
        background: var(--users-accent);
        color: var(--users-bg);
        box-shadow: 0 6px 18px rgba(139, 136, 242, 0.35);
        transform: translateY(-1px);
    }

    /* CARDS CONTENEDORAS */
    .users-card {
        background: #15183A;
        border-radius: var(--users-radius);
        border: 1px solid var(--users-border);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        margin-bottom: 1.75rem;
        overflow: hidden;
    }

    .users-card-header {
        padding: 0.95rem 1.4rem;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        border-bottom: 1px solid rgba(139, 136, 242, 0.25);
        color: var(--users-text);
    }

    .users-card-header.active {
        background: linear-gradient(135deg, var(--users-primary), var(--users-secondary));
    }

    .users-card-header.inactive {
        background: linear-gradient(135deg, #3b1b2c, #1f0f18);
    }

    .users-card-header h5 {
        margin: 0;
        font-weight: 600;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.55px;
    }

    .users-header-badge {
        padding: 0.2rem 0.7rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-left: auto;
    }

    .badge-active-count {
        background: rgba(81, 75, 242, 0.18);
        border: 1px solid var(--users-accent);
        color: var(--users-accent);
    }

    .badge-inactive-count {
        background: rgba(255, 107, 107, 0.16);
        border: 1px solid rgba(255, 107, 107, 0.7);
        color: #ffb3b3;
    }

    .users-card-body {
        padding: 0;
    }

    .users-empty {
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--users-muted);
    }

    .users-empty i {
        font-size: 2.4rem;
        margin-bottom: 0.75rem;
        color: rgba(139, 136, 242, 0.6);
    }

    /* TABLA USUARIOS */
    .users-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        background: #15183A;
        color: var(--users-text);
        table-layout: fixed;
    }

    .users-table thead {
        background: #1E2050;
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .users-table thead th {
        padding: 0.9rem 0.9rem;
        text-align: left;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.78rem;
        letter-spacing: 0.4px;
        color: #ffffff;
        border-bottom: 2px solid var(--users-secondary);
        white-space: nowrap;
    }

    .users-table thead th.text-center {
        text-align: center;
    }

    .users-table tbody tr {
        transition: all 0.25s ease;
        background: #15183A;
    }

    .users-table tbody tr:nth-child(even) {
        background: #191C44;
    }

    .users-table tbody tr:hover {
        background: rgba(81, 75, 242, 0.16);
        box-shadow: inset 4px 0 0 var(--users-secondary);
        transform: translateX(2px);
    }

    .users-table td {
        padding: 0.8rem 0.9rem;
        border-bottom: 1px solid rgba(139, 136, 242, 0.18);
        vertical-align: middle;
        font-size: 0.86rem;
        color: var(--users-text);
    }

    .user-id {
        font-weight: 600;
        color: var(--users-muted);
        font-size: 0.78rem;
    }

    .user-name {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
        color: var(--users-text);
    }

    .user-name i {
        color: var(--users-accent);
    }

    .user-email {
        color: var(--users-muted);
        font-size: 0.8rem;
    }

    .badge-role {
        padding: 0.26rem 0.7rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        border: 1px solid var(--users-accent);
        background: rgba(81, 75, 242, 0.12);
        color: var(--users-accent);
    }

    .badge-role-muted {
        border-color: rgba(160, 160, 204, 0.6);
        background: rgba(10, 11, 28, 0.9);
        color: var(--users-muted);
    }

    /* ACCIONES */
    .user-actions {
        display: flex;
        justify-content: center;
        gap: 0.3rem;
    }

    .btn-user-action {
        width: 30px;
        height: 30px;
        border-radius: 999px;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        transition: all 0.22s ease;
        background: transparent;
        color: var(--users-muted);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    }

    .btn-user-edit {
        border-color: rgba(255, 193, 7, 0.45);
        color: #ffc107;
        background: rgba(255, 193, 7, 0.06);
    }

    .btn-user-edit:hover {
        background: #ffc107;
        color: #111;
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 6px 14px rgba(255, 193, 7, 0.4);
    }

    .btn-user-disable {
        border-color: rgba(255, 107, 107, 0.55);
        color: #ff6b6b;
        background: rgba(255, 107, 107, 0.06);
    }

    .btn-user-disable:hover {
        background: #ff6b6b;
        color: #111;
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 6px 14px rgba(255, 107, 107, 0.4);
    }

    .btn-user-enable {
        border-color: rgba(53, 211, 153, 0.55);
        color: var(--users-success);
        background: rgba(53, 211, 153, 0.06);
    }

    .btn-user-enable:hover {
        background: var(--users-success);
        color: #111;
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 6px 14px rgba(53, 211, 153, 0.4);
    }

    /* PAGINACIÓN */
    .users-pagination-bar {
        padding: 0.85rem 1.2rem;
        border-top: 1px solid rgba(139, 136, 242, 0.25);
        background: #101331;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font-size: 0.78rem;
        color: var(--users-muted);
    }

    .users-pagination .page-link {
        padding: 0.25rem 0.6rem;
        font-size: 0.75rem;
        border-radius: 0.4rem;
        border: 1px solid rgba(139, 136, 242, 0.5);
        background: rgba(5, 7, 22, 0.98);
        color: var(--users-muted);
        transition: all 0.25s ease;
    }

    .users-pagination .page-link:hover {
        background: rgba(81, 75, 242, 0.18);
        color: var(--users-accent);
        border-color: var(--users-accent);
    }

    .users-pagination .page-item.active .page-link {
        background: var(--users-secondary);
        border-color: var(--users-secondary);
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(81, 75, 242, 0.45);
    }

    .users-pagination .page-item.disabled .page-link {
        opacity: 0.35;
        background: #070816;
        border-color: rgba(139, 136, 242, 0.25);
        color: var(--users-muted);
    }

    .text-soft-muted {
        color: var(--users-muted);
    }

    /* MODAL CONFIRMACIÓN */
    .modal-users .modal-content {
        background: #15183A;
        color: var(--users-text);
        border-radius: 1rem;
        border: 1px solid var(--users-accent);
        box-shadow: 0 10px 32px rgba(0, 0, 0, 0.7);
    }

    .modal-users .modal-header {
        border-bottom-color: rgba(139, 136, 242, 0.25);
    }

    .modal-users .modal-footer {
        border-top-color: rgba(139, 136, 242, 0.18);
    }

    .modal-users .btn-cancel {
        border-radius: 0.7rem;
        padding: 0.45rem 1.2rem;
        background: transparent;
        color: var(--users-muted);
        border: 1px solid rgba(139, 136, 242, 0.4);
        transition: all 0.2s ease;
    }

    .modal-users .btn-cancel:hover {
        background: rgba(139, 136, 242, 0.15);
        color: var(--users-text);
    }

    .modal-users .btn-confirm {
        border-radius: 0.7rem;
        padding: 0.45rem 1.4rem;
        background: var(--users-secondary);
        color: #fff;
        border: 1px solid var(--users-accent);
        transition: all 0.2s ease;
    }

    .modal-users .btn-confirm:hover {
        background: var(--users-primary);
        box-shadow: 0 6px 18px rgba(81, 75, 242, 0.5);
    }
</style>

<div class="container-fluid users-theme">
    <!-- HEADER -->
    <div class="users-header">
        <div class="users-header-title">
            <div class="users-header-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2>Gestión de Usuarios</h2>
                <p>Administra cuentas, roles y accesos del sistema</p>
            </div>
        </div>
        <div class="users-header-actions d-flex gap-2">
            <a href="@Url.Action("Index", "Home")" class="btn btn-users-outline">
                <i class="bi bi-arrow-left"></i> Inicio
            </a>
            <a class="btn btn-users-primary"
               asp-controller="Inicio" asp-action="Registrarse"
               title="Registrar nuevo usuario">
                <i class="bi bi-person-plus"></i> Registrar Usuario
            </a>
        </div>
    </div>

    <!-- BARRA DE BÚSQUEDA -->
    <div class="users-search-card">
        <form method="get" asp-action="Usuarios" class="row g-3 align-items-center">
            <div class="col-auto">
                <div class="users-search-label">Buscar usuario</div>
            </div>
            <div class="col-auto">
                <input type="text" name="q" value="@(ViewData["q"] ?? "")"
                       class="users-search-input"
                       placeholder="Nombre o correo del usuario..." />
            </div>
            <div class="col-auto">
                <input type="hidden" name="pageActivos" value="1" />
                <input type="hidden" name="pageInactivos" value="1" />
                <button class="btn-users-search" type="submit">
                    <i class="bi bi-search"></i><span>Buscar</span>
                </button>
            </div>
        </form>
    </div>

    <!-- USUARIOS ACTIVOS -->
    <div class="users-card">
        <div class="users-card-header active">
            <i class="bi bi-person-check fs-5"></i>
            <h5>Usuarios Activos</h5>
            <span class="users-header-badge badge-active-count">
                <i class="bi bi-people"></i>@totalActivos
            </span>
        </div>
        <div class="users-card-body">
            @if (!activos.Any())
            {
                <div class="users-empty">
                    <i class="bi bi-people"></i>
                    <p class="mb-0">No hay usuarios activos registrados.</p>
                </div>
            }
            else
            {
                <div class="users-table-wrap">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in activos)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="user-id">#@usuario.IdUsuario</span>
                                    </td>
                                    <td>
                                        <div class="user-name">
                                            <i class="bi bi-person-circle"></i>
                                            <span>@usuario.NombreUsuario</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="user-email">@usuario.Correo</span>
                                    </td>
                                    <td>
                                        <span class="badge-role">
                                            @usuario.Rol?.NombreRol
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="user-actions">
                                            <!-- Editar -->
                                            <a asp-action="Editar" asp-route-id="@usuario.IdUsuario"
                                               class="btn-user-action btn-user-edit"
                                               title="Editar usuario">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <!-- Desactivar (con modal) -->
                                            <form asp-action="Desactivar" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="btn-user-action btn-user-disable btn-user-confirm"
                                                        data-user-name="@usuario.NombreUsuario"
                                                        data-action="desactivar"
                                                        title="Desactivar usuario">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesActivos > 1)
                {
                    <div class="users-pagination-bar">
                        <div>
                            Página @pageActivos de @totalPagesActivos •
                            Mostrando @activos.Count() de @totalActivos usuarios
                        </div>
                        <ul class="pagination users-pagination mb-0">
                            @* Anterior *@
                            @if (pageActivos > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                           q = ViewData["q"],
                                           pageActivos = pageActivos - 1,
                                           pageInactivos = pageInactivos,
                                           pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                </li>
                            }

                            @{
                                int startPage = Math.Max(1, pageActivos - 2);
                                int endPage = Math.Min(totalPagesActivos, pageActivos + 2);

                                if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                               q = ViewData["q"],
                                               pageActivos = 1,
                                               pageInactivos = pageInactivos,
                                               pageSize = pageSize
                                           })">1</a>
                                    </li>
                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == pageActivos ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                               q = ViewData["q"],
                                               pageActivos = i,
                                               pageInactivos = pageInactivos,
                                               pageSize = pageSize
                                           })">@i</a>
                                    </li>
                                }

                                if (endPage < totalPagesActivos)
                                {
                                    if (endPage < totalPagesActivos - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                               q = ViewData["q"],
                                               pageActivos = totalPagesActivos,
                                               pageInactivos = pageInactivos,
                                               pageSize = pageSize
                                           })">@totalPagesActivos</a>
                                    </li>
                                }
                            }

                            @* Siguiente *@
                            @if (pageActivos < totalPagesActivos)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                           q = ViewData["q"],
                                           pageActivos = pageActivos + 1,
                                           pageInactivos = pageInactivos,
                                           pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    </div>

    <!-- USUARIOS INACTIVOS -->
    @if (totalInactivos > 0)
    {
        <div class="users-card">
            <div class="users-card-header inactive">
                <i class="bi bi-person-x fs-5"></i>
                <h5>Usuarios Inactivos</h5>
                <span class="users-header-badge badge-inactive-count">
                    <i class="bi bi-archive"></i>@totalInactivos
                </span>
            </div>
            <div class="users-card-body">
                <div class="users-table-wrap">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in inactivos)
                            {
                                <tr class="text-soft-muted">
                                    <td class="ps-3">
                                        <span class="user-id">#@usuario.IdUsuario</span>
                                    </td>
                                    <td>
                                        <div class="user-name">
                                            <i class="bi bi-person-circle text-soft-muted"></i>
                                            <span>@usuario.NombreUsuario</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="user-email">@usuario.Correo</span>
                                    </td>
                                    <td>
                                        <span class="badge-role badge-role-muted">
                                            @usuario.Rol?.NombreRol
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="user-actions">
                                            <!-- Activar (con modal) -->
                                            <form asp-action="Activar" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="btn-user-action btn-user-enable btn-user-confirm"
                                                        data-user-name="@usuario.NombreUsuario"
                                                        data-action="activar"
                                                        title="Activar usuario">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesInactivos > 1)
                {
                    <div class="users-pagination-bar">
                        <div>
                            Página @pageInactivos de @totalPagesInactivos •
                            Mostrando @inactivos.Count() de @totalInactivos usuarios
                        </div>
                        <ul class="pagination users-pagination mb-0">
                            @* Anterior *@
                            @if (pageInactivos > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                           q = ViewData["q"],
                                           pageActivos = pageActivos,
                                           pageInactivos = pageInactivos - 1,
                                           pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                </li>
                            }

                            @{
                                int startPageInactivos = Math.Max(1, pageInactivos - 2);
                                int endPageInactivos = Math.Min(totalPagesInactivos, pageInactivos + 2);

                                if (startPageInactivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                               q = ViewData["q"],
                                               pageActivos = pageActivos,
                                               pageInactivos = 1,
                                               pageSize = pageSize
                                           })">1</a>
                                    </li>
                                    if (startPageInactivos > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                for (int i = startPageInactivos; i <= endPageInactivos; i++)
                                {
                                    <li class="page-item @(i == pageInactivos ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                               q = ViewData["q"],
                                               pageActivos = pageActivos,
                                               pageInactivos = i,
                                               pageSize = pageSize
                                           })">@i</a>
                                    </li>
                                }

                                if (endPageInactivos < totalPagesInactivos)
                                {
                                    if (endPageInactivos < totalPagesInactivos - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                               q = ViewData["q"],
                                               pageActivos = pageActivos,
                                               pageInactivos = totalPagesInactivos,
                                               pageSize = pageSize
                                           })">@totalPagesInactivos</a>
                                    </li>
                                }
                            }

                            @* Siguiente *@
                            @if (pageInactivos < totalPagesInactivos)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                           q = ViewData["q"],
                                           pageActivos = pageActivos,
                                           pageInactivos = pageInactivos + 1,
                                           pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL DE CONFIRMACIÓN -->
<div class="modal fade modal-users" id="confirmUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmUserTitle">Confirmar acción</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="confirmUserText" class="mb-0">¿Deseas continuar?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn-confirm" id="btnConfirmUser">
                    Sí, continuar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.querySelector('input[name="q"]');
            if (input) input.focus();

            const modalEl = document.getElementById('confirmUserModal');
            let confirmModal = null;
            if (modalEl && window.bootstrap) {
                confirmModal = new bootstrap.Modal(modalEl);
            }

            const titleEl = document.getElementById('confirmUserTitle');
            const textEl = document.getElementById('confirmUserText');
            const btnConfirm = document.getElementById('btnConfirmUser');
            let formToSubmit = null;

            // Botones que disparan el modal
            document.querySelectorAll('.btn-user-confirm').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();

                    const form = btn.closest('form');
                    if (!form) return;

                    const userName = btn.getAttribute('data-user-name') || 'este usuario';
                    const action = (btn.getAttribute('data-action') || '').toLowerCase();

                    let title = 'Confirmar acción';
                    let message = '';
                    if (action === 'desactivar') {
                        title = 'Desactivar usuario';
                        message = `<strong>${userName}</strong><br>El usuario no podrá acceder al sistema hasta que sea activado nuevamente.`;
                    } else if (action === 'activar') {
                        title = 'Activar usuario';
                        message = `<strong>${userName}</strong><br>El usuario recuperará el acceso al sistema.`;
                    } else {
                        message = `¿Deseas continuar con la operación para <strong>${userName}</strong>?`;
                    }

                    if (titleEl) titleEl.textContent = title;
                    if (textEl) textEl.innerHTML = message;

                    formToSubmit = form;

                    if (confirmModal) {
                        confirmModal.show();
                    } else {
                        // Fallback si no está Bootstrap JS
                        if (confirm(title + ' - ' + userName + '?')) {
                            form.submit();
                        }
                    }
                });
            });

            // Confirmar desde el modal
            if (btnConfirm) {
                btnConfirm.addEventListener('click', () => {
                    if (formToSubmit) {
                        formToSubmit.submit();
                        formToSubmit = null;
                    }
                    if (confirmModal) {
                        confirmModal.hide();
                    }
                });
            }
        });
    </script>
}
