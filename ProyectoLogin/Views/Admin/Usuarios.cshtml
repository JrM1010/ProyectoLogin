@model IEnumerable<ProyectoLogin.Models.Usuario>
@{
    var inactivos = ViewBag.UsuariosInactivos as List<ProyectoLogin.Models.Usuario>;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i>Gestión de Usuarios
        </h2>
        <a class="btn btn-success rounded-pill" asp-controller="Inicio" asp-action="Registrarse" title="Registrar nuevo usuario">
            <i class="bi bi-person-plus me-1"></i>Registrar Usuario
        </a>
    </div>

    <!-- USUARIOS ACTIVOS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white d-flex align-items-center">
            <i class="bi bi-person-check fs-5 me-2"></i>
            <h5 class="mb-0 me-2">Usuarios Activos</h5>
            <span class="badge bg-light text-success fs-6">@Model.Count()</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-people fs-1 mb-2"></i>
                    <p class="mb-0">No hay usuarios activos</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold text-muted">#@usuario.IdUsuario</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person-circle text-primary me-2"></i>
                                            @usuario.NombreUsuario
                                        </div>
                                    </td>
                                    <td>@usuario.Correo</td>
                                    <td>
                                        <span class="badge bg-primary">@usuario.Rol?.NombreRol</span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Editar -->
                                            <a asp-action="Editar" asp-route-id="@usuario.IdUsuario"
                                               class="btn btn-outline-warning rounded-circle btn-sm" title="Editar usuario">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Desactivar -->
                                            <form asp-action="Desactivar" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger rounded-circle btn-sm"
                                                        title="Desactivar usuario"
                                                        onclick="return confirm('¿Estás seguro de desactivar a @usuario.NombreUsuario?')">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- USUARIOS INACTIVOS -->
    @if (inactivos != null && inactivos.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white d-flex align-items-center">
                <i class="bi bi-person-x fs-5 me-2"></i>
                <h5 class="mb-0 me-2">Usuarios Inactivos</h5>
                <span class="badge bg-light text-secondary fs-6">@inactivos.Count()</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in inactivos)
                            {
                                <tr class="text-muted">
                                    <td class="ps-3 fw-semibold">#@usuario.IdUsuario</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person-circle me-2"></i>
                                            @usuario.NombreUsuario
                                        </div>
                                    </td>
                                    <td>@usuario.Correo</td>
                                    <td>
                                        <span class="badge bg-secondary">@usuario.Rol?.NombreRol</span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Activar -->
                                            <form asp-action="Activar" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-success rounded-circle btn-sm"
                                                        title="Activar usuario"
                                                        onclick="return confirm('¿Estás seguro de activar a @usuario.NombreUsuario?')">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-person-x me-2"></i>Usuarios Inactivos
                </h5>
            </div>
            <div class="card-body text-center py-4 text-muted">
                <i class="bi bi-emoji-smile fs-1 mb-2"></i>
                <p class="mb-0">No hay usuarios inactivos</p>
            </div>
        </div>
    }
</div>

<style>
    .table td {
        vertical-align: middle;
    }

    .btn-sm {
        padding: 0.375rem 0.5rem;
    }

    .card-header {
        border-bottom: none;
    }
</style>