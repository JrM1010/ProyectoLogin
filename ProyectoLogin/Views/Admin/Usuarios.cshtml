@model IEnumerable<ProyectoLogin.Models.Usuario>
@{
    // Usar las listas paginadas del ViewBag
    var activos = ViewBag.Activos as List<ProyectoLogin.Models.Usuario>
                  ?? new List<ProyectoLogin.Models.Usuario>();
    var inactivos = ViewBag.Inactivos as List<ProyectoLogin.Models.Usuario>
                    ?? new List<ProyectoLogin.Models.Usuario>();

    // Variables de paginación
    var totalActivos = ViewBag.TotalActivos ?? 0;
    var totalInactivos = ViewBag.TotalInactivos ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
    var pageActivos = ViewBag.PageActivos ?? 1;
    var pageInactivos = ViewBag.PageInactivos ?? 1;
    var totalPagesActivos = ViewBag.TotalPagesActivos ?? 1;
    var totalPagesInactivos = ViewBag.TotalPagesInactivos ?? 1;
}

@section Styles {
    <style>
        :root {
            --users-primary: #062926;          /* menta oscuro */
            --users-secondary: #12C6A1;        /* menta vibrante */
            --users-accent: #5EF2C1;           /* acento brillante */
            --users-bg: #f5f6fa;               /* fondo claro */
            --users-card: #ffffff;
            --users-text: #111827;
            --users-muted: #6b7280;
            --users-radius: 0.75rem;
            --users-border-soft: #e5e7eb;
            --users-danger: #dc2626;
            --users-success: #16a34a;
        }

        /* Fondo general del módulo (similar a productos) */
        .users-theme {
            background: var(--users-bg);
            padding: 1.5rem 0 2rem;
        }

        /* HEADER PRINCIPAL - gradiente "Gestión de Usuarios" */
        .users-header {
            background: linear-gradient(90deg, var(--users-primary), var(--users-secondary));
            border-radius: var(--users-radius);
            border: 1px solid rgba(255, 255, 255, 0.16);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1rem;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.18);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #ffffff;
        }

        .users-header-title {
            display: flex;
            align-items: center;
            gap: 0.7rem;
        }

        .users-header-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.22);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: var(--users-accent);
        }

        .users-header h2 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            color: #ffffff;
        }

        .users-header p {
            margin: 0.1rem 0 0;
            font-size: 0.85rem;
            color: rgba(241, 245, 249, 0.9);
        }

        .users-header-actions .btn {
            font-size: 0.86rem;
            border-radius: var(--users-radius);
            padding: 0.5rem 1rem;
        }

        .btn-users-outline {
            border: 1px solid var(--users-accent);
            background: transparent;
            color: #ffffff;
            border-radius: var(--users-radius);
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.25s ease;
            text-decoration: none;
        }

        .btn-users-outline:hover {
            background: rgba(94, 242, 193, 0.16);
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.25);
            transform: translateY(-1px);
        }

        .btn-users-primary {
            background: #ffffff;
            color: var(--users-primary);
            border: none;
            border-radius: var(--users-radius);
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.25s ease;
            text-decoration: none;
        }

        .btn-users-primary:hover {
            background: #f9fafb;
            color: var(--users-secondary);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25);
            transform: translateY(-1px);
        }

        /* TARJETA DE BÚSQUEDA (similar a search-card) */
        .users-search-card {
            background: var(--users-card);
            border: 1px solid var(--users-border-soft);
            border-radius: var(--users-radius);
            padding: 0.9rem 1.1rem;
            margin-bottom: 1.1rem;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        }

        .users-search-card .users-search-label {
            font-size: 0.82rem;
            color: var(--users-muted);
            margin-bottom: 0.15rem;
        }

        .users-search-input {
            background: #ffffff;
            border-radius: var(--users-radius);
            border: 1px solid var(--users-border-soft);
            color: var(--users-text);
            padding: 0.6rem 0.85rem;
            min-width: 240px;
            font-size: 0.88rem;
            transition: all 0.22s ease;
        }

        .users-search-input::placeholder {
            color: #9ca3af;
        }

        .users-search-input:focus {
            outline: none;
            border-color: var(--users-secondary);
            box-shadow: 0 0 0 0.16rem rgba(18, 198, 161, 0.18);
            background: #ffffff;
        }

        .btn-users-search {
            border-radius: var(--users-radius);
            padding: 0.6rem 1.3rem;
            font-size: 0.85rem;
            background: var(--users-secondary);
            border: 1px solid var(--users-secondary);
            color: #020814;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.25s ease;
        }

        .btn-users-search:hover {
            background: var(--users-primary);
            border-color: var(--users-primary);
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.18);
            transform: translateY(-1px);
        }

        /* TARJETAS LISTADO (Activos / Inactivos) - similar a inventory-card */
        .users-card {
            background: var(--users-card);
            border: 1px solid var(--users-border-soft);
            border-radius: var(--users-radius);
            overflow: hidden;
            margin-bottom: 1.25rem;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
            transition: all 0.22s ease;
        }

        .users-card:hover {
            box-shadow: 0 7px 20px rgba(15, 23, 42, 0.10);
            transform: translateY(-1px);
        }

        /* Encabezados con gradiente donde dice "Usuarios Activos / Inactivos" */
        .users-card-header {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.85rem 1.15rem;
            border-bottom: 1px solid rgba(15, 23, 42, 0.06);
            color: #ffffff;
        }

        .users-card-header.active {
            background: linear-gradient(90deg, var(--users-primary), var(--users-secondary));
        }

        .users-card-header.inactive {
            background: linear-gradient(90deg, #6b7280, #9ca3af);
        }

        .users-card-header h5 {
            margin: 0;
            font-size: 0.98rem;
            font-weight: 700;
            text-transform: none;
            letter-spacing: 0.02em;
            color: #ffffff;
        }

        .users-card-header i {
            font-size: 1.2rem;
            color: #bbf7d0;
        }

        .users-card-header.inactive i {
            color: #e5e7eb;
        }

        .users-header-badge {
            margin-left: auto;
            padding: 0.22rem 0.75rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            background: rgba(15, 23, 42, 0.12);
            border: 1px solid rgba(226, 232, 240, 0.5);
            color: #f9fafb;
        }

        .users-card-body {
            padding: 0;
        }

        .users-empty {
            text-align: center;
            padding: 2rem 1rem;
            color: var(--users-muted);
        }

        .users-empty i {
            font-size: 2.2rem;
            margin-bottom: 0.5rem;
            color: var(--users-secondary);
            opacity: 0.5;
        }

        /* TABLA USUARIOS (alineada a estilo productos) */
        .users-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .users-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
            font-size: 0.85rem;
            color: var(--users-text);
            background: transparent;
        }

        .users-table thead th {
            background: #e5f9f3;
            font-weight: 600;
            font-size: 0.78rem;
            border-bottom: 1px solid var(--users-border-soft);
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: var(--users-muted);
            padding: 0.7rem 0.9rem;
        }

        .users-table thead th.text-center {
            text-align: center;
        }

        .users-table tbody td {
            padding: 0.7rem 0.9rem;
            border-bottom: 1px solid var(--users-border-soft);
            vertical-align: middle;
            color: var(--users-text);
        }

        .users-table tbody tr:nth-child(even) {
            background: #f9fafb;
        }

        .users-table tbody tr:hover {
            background-color: #ecfdf5;
        }

        .user-id {
            font-weight: 600;
            font-size: 0.78rem;
            color: var(--users-muted);
        }

        .user-name {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-weight: 600;
            color: var(--users-text);
        }

        .user-name i {
            color: var(--users-secondary);
        }

        .user-email {
            color: var(--users-muted);
            font-size: 0.8rem;
        }

        .badge-role {
            padding: 0.22rem 0.7rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 600;
            border: 1px solid var(--users-secondary);
            background: #ecfdf5;
            color: var(--users-primary);
        }

        .badge-role-muted {
            border-color: #d1d5db;
            background: #f3f4f6;
            color: var(--users-muted);
        }

        .text-soft-muted {
            color: var(--users-muted);
        }

        /* ACCIONES - similar a action-btn */
        .user-actions {
            display: flex;
            justify-content: center;
            gap: 0.25rem;
        }

        .btn-user-action {
            width: 2.2rem;
            height: 2.2rem;
            border-radius: 0.7rem;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            background: #f3f4f6;
            color: var(--users-muted);
        }

        .btn-user-edit {
            background: #fef3c7;
            color: #92400e;
        }

        .btn-user-edit:hover {
            background: #fbbf24;
            color: #111827;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(251, 191, 36, 0.4);
        }

        .btn-user-disable {
            background: #fee2e2;
            color: #b91c1c;
        }

        .btn-user-disable:hover {
            background: #dc2626;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(220, 38, 38, 0.4);
        }

        .btn-user-enable {
            background: #dcfce7;
            color: #166534;
        }

        .btn-user-enable:hover {
            background: #22c55e;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(34, 197, 94, 0.4);
        }

        /* PAGINACIÓN (alineada con productos) */
        .users-pagination-bar {
            padding: 0.85rem 1.15rem;
            border-top: 1px solid var(--users-border-soft);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            font-size: 0.78rem;
            color: var(--users-muted);
            background: #ffffff;
        }

        .users-pagination .page-link {
            border-radius: 999px !important;
            font-size: 0.75rem;
            padding: 0.24rem 0.6rem;
            border: 1px solid var(--users-border-soft);
            color: var(--users-muted);
            background: #ffffff;
            transition: all 0.2s ease;
        }

        .users-pagination .page-link:hover {
            background: #ecfdf5;
            color: var(--users-secondary);
            border-color: var(--users-secondary);
        }

        .users-pagination .page-item.active .page-link {
            background-color: var(--users-secondary);
            border-color: var(--users-secondary);
            color: #020814;
            box-shadow: 0 3px 8px rgba(18, 198, 161, 0.4);
        }

        .users-pagination .page-item.disabled .page-link {
            opacity: 0.4;
            background: #f9fafb;
        }

        /* MODAL CONFIRMACIÓN (similar a productos, con menta) */
        .modal-users .modal-content {
            background: #ffffff;
            color: var(--users-text);
            border-radius: var(--users-radius);
            border: 1px solid var(--users-border-soft);
            box-shadow: 0 10px 32px rgba(15, 23, 42, 0.18);
        }

        .modal-users .modal-header {
            background: linear-gradient(90deg, var(--users-primary), var(--users-secondary));
            border-bottom: 1px solid rgba(255, 255, 255, 0.16);
            color: #ffffff;
            border-radius: var(--users-radius) var(--users-radius) 0 0;
        }

        .modal-users .modal-title {
            font-size: 0.98rem;
            font-weight: 600;
        }

        .modal-users .modal-footer {
            border-top: 1px solid var(--users-border-soft);
        }

        .modal-users .btn-cancel {
            border-radius: var(--users-radius);
            padding: 0.45rem 1.2rem;
            background: transparent;
            color: var(--users-muted);
            border: 1px solid var(--users-border-soft);
            transition: all 0.2s ease;
        }

        .modal-users .btn-cancel:hover {
            background: #f9fafb;
            color: var(--users-text);
        }

        .modal-users .btn-confirm {
            border-radius: var(--users-radius);
            padding: 0.45rem 1.4rem;
            background: var(--users-secondary);
            color: #020814;
            border: none;
            transition: all 0.2s ease;
            font-weight: 600;
        }

        .modal-users .btn-confirm:hover {
            background: var(--users-primary);
            color: #ffffff;
            box-shadow: 0 5px 14px rgba(18, 198, 161, 0.38);
        }

        @@media (max-width: 768px) {
            .users-header {
                flex-direction: column;
                align-items: flex-start;
                padding: 0.9rem 1rem;
            }

            .users-header h2 {
                font-size: 1.1rem;
            }

            .users-header p {
                font-size: 0.8rem;
            }

            .users-header-actions {
                width: 100%;
                display: flex;
                flex-wrap: wrap;
                gap: 0.45rem;
            }

            .users-header-actions .btn {
                flex: 1 1 auto;
                justify-content: center;
            }

            .users-search-card {
                padding: 0.8rem 0.9rem;
            }

            .users-search-input {
                width: 100%;
                min-width: 0;
            }

            .users-card-header {
                padding: 0.75rem 0.9rem;
            }

            .users-pagination-bar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}

<div class="container-fluid users-theme">
    <!-- HEADER -->
    <div class="users-header">
        <div class="users-header-title">
            <div class="users-header-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h2>Gestión de Usuarios</h2>
                <p>Administra cuentas, roles y accesos del sistema</p>
            </div>
        </div>
        <div class="users-header-actions d-flex gap-2">
            <a href="@Url.Action("Index", "Home")" class="btn btn-users-outline">
                <i class="bi bi-arrow-left"></i> Inicio
            </a>
            <a class="btn btn-users-primary"
               asp-controller="Inicio" asp-action="Registrarse"
               title="Registrar nuevo usuario">
                <i class="bi bi-person-plus"></i> Registrar Usuario
            </a>
        </div>
    </div>

    <!-- BARRA DE BÚSQUEDA -->
    <div class="users-search-card">
        <form method="get" asp-action="Usuarios" class="row g-3 align-items-center">
            <div class="col-auto">
                <div class="users-search-label">Buscar usuario</div>
            </div>
            <div class="col-auto">
                <input type="text" name="q" value="@(ViewData["q"] ?? "")"
                       class="users-search-input"
                       placeholder="Nombre o correo del usuario..." />
            </div>
            <div class="col-auto">
                <input type="hidden" name="pageActivos" value="1" />
                <input type="hidden" name="pageInactivos" value="1" />
                <button class="btn-users-search" type="submit">
                    <i class="bi bi-search"></i><span>Buscar</span>
                </button>
            </div>
        </form>
    </div>

    <!-- USUARIOS ACTIVOS -->
    <div class="users-card">
        <div class="users-card-header active">
            <i class="bi bi-person-check fs-5"></i>
            <h5>Usuarios Activos</h5>
            <span class="users-header-badge">
                <i class="bi bi-people"></i>@totalActivos
            </span>
        </div>
        <div class="users-card-body">
            @if (!activos.Any())
            {
                <div class="users-empty">
                    <i class="bi bi-people"></i>
                    <p class="mb-0">No hay usuarios activos registrados.</p>
                </div>
            }
            else
            {
                <div class="users-table-wrap">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in activos)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="user-id">#@usuario.IdUsuario</span>
                                    </td>
                                    <td>
                                        <div class="user-name">
                                            <i class="bi bi-person-circle"></i>
                                            <span>@usuario.NombreUsuario</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="user-email">@usuario.Correo</span>
                                    </td>
                                    <td>
                                        <span class="badge-role">
                                            @usuario.Rol?.NombreRol
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="user-actions">
                                            <!-- Editar -->
                                            <a asp-action="Editar" asp-route-id="@usuario.IdUsuario"
                                               class="btn-user-action btn-user-edit"
                                               title="Editar usuario">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <!-- Desactivar -->
                                            <form asp-action="Desactivar" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="btn-user-action btn-user-disable btn-user-confirm"
                                                        data-user-name="@usuario.NombreUsuario"
                                                        data-action="desactivar"
                                                        title="Desactivar usuario">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesActivos > 1)
                {
                    <div class="users-pagination-bar">
                        <div>
                            Página @pageActivos de @totalPagesActivos •
                            Mostrando @activos.Count() de @totalActivos usuarios
                        </div>
                        <ul class="pagination users-pagination mb-0">
                            @* Anterior *@
                            @if (pageActivos > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos - 1,
                                            pageInactivos = pageInactivos,
                                            pageSize = pageSize
                                        })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                </li>
                            }

                            @{
                                int startPage = Math.Max(1, pageActivos - 2);
                                int endPage = Math.Min(totalPagesActivos, pageActivos + 2);

                                if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                                q = ViewData["q"],
                                                pageActivos = 1,
                                                pageInactivos = pageInactivos,
                                                pageSize = pageSize
                                            })">1</a>
                                    </li>
                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == pageActivos ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                                q = ViewData["q"],
                                                pageActivos = i,
                                                pageInactivos = pageInactivos,
                                                pageSize = pageSize
                                            })">@i</a>
                                    </li>
                                }

                                if (endPage < totalPagesActivos)
                                {
                                    if (endPage < totalPagesActivos - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                                q = ViewData["q"],
                                                pageActivos = totalPagesActivos,
                                                pageInactivos = pageInactivos,
                                                pageSize = pageSize
                                            })">@totalPagesActivos</a>
                                    </li>
                                }
                            }

                            @* Siguiente *@
                            @if (pageActivos < totalPagesActivos)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos + 1,
                                            pageInactivos = pageInactivos,
                                            pageSize = pageSize
                                        })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    </div>

    <!-- USUARIOS INACTIVOS -->
    @if (totalInactivos > 0)
    {
        <div class="users-card">
            <div class="users-card-header inactive">
                <i class="bi bi-person-x fs-5"></i>
                <h5>Usuarios Inactivos</h5>
                <span class="users-header-badge">
                    <i class="bi bi-archive"></i>@totalInactivos
                </span>
            </div>
            <div class="users-card-body">
                <div class="users-table-wrap">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in inactivos)
                            {
                                <tr class="text-soft-muted">
                                    <td class="ps-3">
                                        <span class="user-id">#@usuario.IdUsuario</span>
                                    </td>
                                    <td>
                                        <div class="user-name">
                                            <i class="bi bi-person-circle text-soft-muted"></i>
                                            <span>@usuario.NombreUsuario</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="user-email">@usuario.Correo</span>
                                    </td>
                                    <td>
                                        <span class="badge-role badge-role-muted">
                                            @usuario.Rol?.NombreRol
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="user-actions">
                                            <!-- Activar -->
                                            <form asp-action="Activar" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="btn-user-action btn-user-enable btn-user-confirm"
                                                        data-user-name="@usuario.NombreUsuario"
                                                        data-action="activar"
                                                        title="Activar usuario">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesInactivos > 1)
                {
                    <div class="users-pagination-bar">
                        <div>
                            Página @pageInactivos de @totalPagesInactivos •
                            Mostrando @inactivos.Count() de @totalInactivos usuarios
                        </div>
                        <ul class="pagination users-pagination mb-0">
                            @* Anterior *@
                            @if (pageInactivos > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos,
                                            pageInactivos = pageInactivos - 1,
                                            pageSize = pageSize
                                        })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                </li>
                            }

                            @{
                                int startPageInactivos = Math.Max(1, pageInactivos - 2);
                                int endPageInactivos = Math.Min(totalPagesInactivos, pageInactivos + 2);

                                if (startPageInactivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                                q = ViewData["q"],
                                                pageActivos = pageActivos,
                                                pageInactivos = 1,
                                                pageSize = pageSize
                                            })">1</a>
                                    </li>
                                    if (startPageInactivos > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                for (int i = startPageInactivos; i <= endPageInactivos; i++)
                                {
                                    <li class="page-item @(i == pageInactivos ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                                q = ViewData["q"],
                                                pageActivos = pageActivos,
                                                pageInactivos = i,
                                                pageSize = pageSize
                                            })">@i</a>
                                    </li>
                                }

                                if (endPageInactivos < totalPagesInactivos)
                                {
                                    if (endPageInactivos < totalPagesInactivos - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Usuarios", new {
                                                q = ViewData["q"],
                                                pageActivos = pageActivos,
                                                pageInactivos = totalPagesInactivos,
                                                pageSize = pageSize
                                            })">@totalPagesInactivos</a>
                                    </li>
                                }
                            }

                            @if (pageInactivos < totalPagesInactivos)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Usuarios", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos,
                                            pageInactivos = pageInactivos + 1,
                                            pageSize = pageSize
                                        })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL DE CONFIRMACIÓN -->
<div class="modal fade modal-users" id="confirmUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmUserTitle">Confirmar acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="confirmUserText" class="mb-0">¿Deseas continuar?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn-confirm" id="btnConfirmUser">
                    Sí, continuar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.querySelector('input[name="q"]');
            if (input) input.focus();

            const modalEl = document.getElementById('confirmUserModal');
            let confirmModal = null;
            if (modalEl && window.bootstrap) {
                confirmModal = new bootstrap.Modal(modalEl);
            }

            const titleEl = document.getElementById('confirmUserTitle');
            const textEl = document.getElementById('confirmUserText');
            const btnConfirm = document.getElementById('btnConfirmUser');
            let formToSubmit = null;

            document.querySelectorAll('.btn-user-confirm').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();

                    const form = btn.closest('form');
                    if (!form) return;

                    const userName = btn.getAttribute('data-user-name') || 'este usuario';
                    const action = (btn.getAttribute('data-action') || '').toLowerCase();

                    let title = 'Confirmar acción';
                    let message = '';

                    if (action === 'desactivar') {
                        title = 'Desactivar usuario';
                        message = `<strong>${userName}</strong><br>El usuario no podrá acceder al sistema hasta que sea activado nuevamente.`;
                    } else if (action === 'activar') {
                        title = 'Activar usuario';
                        message = `<strong>${userName}</strong><br>El usuario recuperará el acceso al sistema.`;
                    } else {
                        message = `¿Deseas continuar con la operación para <strong>${userName}</strong>?`;
                    }

                    if (titleEl) titleEl.textContent = title;
                    if (textEl) textEl.innerHTML = message;

                    formToSubmit = form;

                    if (confirmModal) {
                        confirmModal.show();
                    } else {
                        if (confirm(`${title} - ${userName}`)) {
                            form.submit();
                        }
                    }
                });
            });

            if (btnConfirm) {
                btnConfirm.addEventListener('click', () => {
                    if (formToSubmit) {
                        formToSubmit.submit();
                        formToSubmit = null;
                    }
                    if (confirmModal) {
                        confirmModal.hide();
                    }
                });
            }
        });
    </script>
}
