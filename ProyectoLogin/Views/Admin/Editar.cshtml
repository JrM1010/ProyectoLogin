@model ProyectoLogin.Models.Usuario

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-gear fs-4 me-2"></i>
                        <h4 class="mb-0">Editar Rol de Usuario</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdUsuario" />

                        <!-- INFORMACIÓN DEL USUARIO -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold text-primary mb-2">
                                                    <i class="bi bi-person-circle me-1"></i>Nombre de usuario
                                                </label>
                                                <input asp-for="NombreUsuario" class="form-control bg-white" readonly />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold text-primary mb-2">
                                                    <i class="bi bi-envelope me-1"></i>Correo electrónico
                                                </label>
                                                <input asp-for="Correo" class="form-control bg-white" readonly />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SELECCIÓN DE ROL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold text-primary mb-3">
                                    <i class="bi bi-shield-check me-1"></i>Asignar Rol
                                </label>
                                <select class="form-select form-select-lg" asp-for="IdRol"
                                        asp-items="@(new SelectList(ViewBag.Roles, "IdRol", "NombreRol", Model.IdRol))">
                                </select>
                                <div class="form-text text-muted mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Selecciona el rol que determinará los permisos del usuario en el sistema
                                </div>
                            </div>
                        </div>

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Usuarios" class="btn btn-outline-secondary rounded-pill" title="Volver a la lista de usuarios">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary rounded-pill" title="Guardar cambios del rol">
                                <i class="bi bi-check2-circle me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Información sobre roles
                    </h6>
                    <div class="row text-muted small">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Administrador:</strong> Acceso completo al sistema</p>
                            <p class="mb-2"><strong>Vendedor:</strong> Gestión de ventas e inventario</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:read-only {
        background-color: #f8f9fa !important;
        border-color: #dee2e6;
    }

    .form-select-lg {
        padding: 0.75rem 1rem;
        font-size: 1rem;
    }

    .card.bg-light {
        background-color: #f8f9fa !important;
    }
</style>