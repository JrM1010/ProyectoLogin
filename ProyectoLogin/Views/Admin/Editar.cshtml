@model ProyectoLogin.Models.Usuario

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-black py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-gear fs-4 me-2"></i>
                        <h4 class="mb-0">Editar Usuario</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Editar" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdUsuario" />

                        <!-- INFORMACIÓN DEL USUARIO -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-primary mb-2">
                                                    <i class="bi bi-person-circle me-1"></i>Nombre de usuario
                                                </label>
                                                <input asp-for="NombreUsuario" class="form-control" />
                                                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label fw-bold text-primary mb-2">
                                                    <i class="bi bi-envelope me-1"></i>Correo electrónico
                                                </label>
                                                <input asp-for="Correo" class="form-control" />
                                                <span asp-validation-for="Correo" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        

                        <!-- SELECCIÓN DE ROL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold text-primary mb-3">
                                    <i class="bi bi-shield-check me-1"></i>Asignar Rol
                                </label>
                                <select class="form-select form-select-lg" asp-for="IdRol"
                                        asp-items="@(new SelectList(ViewBag.Roles, "IdRol", "NombreRol", Model.IdRol))">
                                </select>
                                <span asp-validation-for="IdRol" class="text-danger small"></span>
                                <div class="form-text text-muted mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Selecciona el rol que determinará los permisos del usuario en el sistema
                                </div>
                            </div>
                        </div>

                        <!-- MENSAJES DE ALERTA -->
                        @if (ViewData["Mensaje"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @ViewData["Mensaje"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Usuarios" class="btn btn-outline-secondary rounded-pill" title="Volver a la lista de usuarios">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary rounded-pill" title="Guardar cambios">
                                <i class="bi bi-check2-circle me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Información
                    </h6>
                    <div class="row text-muted small">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Administrador:</strong> Acceso completo al sistema</p>
                            <p class="mb-2"><strong>Vendedor:</strong> Gestión de ventas e inventario</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Contraseñas:</strong> Se gestionan mediante el sistema de recuperación</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-ocultar alertas después de 5 segundos
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
}

<style>
    .form-select-lg {
        padding: 0.75rem 1rem;
        font-size: 1rem;
    }

    .card.bg-light {
        background-color: #f8f9fa !important;
    }

    /* Estilo para campos de solo lectura */
    .form-control[readonly] {
        background-color: #f8f9fa !important;
        border-color: #dee2e6;
        color: #6c757d;
        cursor: not-allowed;
    }

    /* Estilo para botones deshabilitados */
    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }
</style>