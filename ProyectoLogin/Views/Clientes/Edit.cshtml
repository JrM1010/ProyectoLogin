@model ProyectoLogin.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <!-- CARD PRINCIPAL -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-black py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-gear fs-4 me-2"></i>
                        <h4 class="mb-0">Editar Cliente</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Mostrar errores de validación generales -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Errores de validación:</strong>
                            <ul class="mb-0 mt-1">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post" id="clienteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdCliente" />

                        <!-- INFORMACIÓN BÁSICA -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-card-checklist me-2"></i>Información Básica
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nit" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-credit-card me-1"></i>NIT
                                </label>
                                <input asp-for="Nit" class="form-control"
                                       placeholder="Ej: 12345678-9"
                                       required
                                       pattern="[0-9]+(-[0-9kK])?"
                                       title="Formato: 12345678-9"
                                       id="nitInput" />
                                <span asp-validation-for="Nit" class="text-danger small d-block mt-1"></span>
                                <div class="form-text text-muted">
                                    <i class="bi bi-info-circle me-1"></i>Formato: 12345678-9 (el guion se agregará automáticamente)
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Estado
                                </label>
                                <div class="form-control bg-light border-0">
                                    @if (Model.Activo)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>Inactivo
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN PERSONAL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-person-lines-fill me-2"></i>Información Personal
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombres" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Nombres
                                </label>
                                <input asp-for="Nombres" class="form-control"
                                       placeholder="Nombres del cliente"
                                       required
                                       minlength="2"
                                       maxlength="100"
                                       pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                                       title="Solo letras y espacios" />
                                <span asp-validation-for="Nombres" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellidos" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Apellidos
                                </label>
                                <input asp-for="Apellidos" class="form-control"
                                       placeholder="Apellidos del cliente"
                                       required
                                       minlength="2"
                                       maxlength="100"
                                       pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                                       title="Solo letras y espacios" />
                                <span asp-validation-for="Apellidos" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- INFORMACIÓN DE CONTACTO -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-telephone me-2"></i>Información de Contacto
                                </h6>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Correo" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-envelope me-1"></i>Correo Electrónico
                                </label>
                                <input asp-for="Correo" class="form-control"
                                       type="email"
                                       placeholder="cliente@correo.com"
                                       maxlength="150" />
                                <span asp-validation-for="Correo" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- DIRECCIÓN -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-geo-alt me-2"></i>Dirección
                                </h6>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Direccion" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-house me-1"></i>Dirección Completa
                                </label>
                                <textarea asp-for="Direccion" class="form-control"
                                          rows="3"
                                          maxlength="250"
                                          placeholder="Dirección completa del cliente"></textarea>
                                <span asp-validation-for="Direccion" class="text-danger small d-block mt-1"></span>
                                <div class="form-text text-muted">
                                    <span id="direccionContador">0</span>/250 caracteres
                                </div>
                            </div>
                        </div>

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Volver al listado de clientes">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary rounded-pill" id="btnSubmit" title="Guardar cambios del cliente">
                                    <i class="bi bi-check2-circle me-1"></i>Guardar Cambios
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Información Importante
                    </h6>
                    <div class="row text-muted small">
                        <div class="col-12">
                            <p class="mb-2">
                                <i class="bi bi-info-circle text-primary me-1"></i>
                                <strong>NIT:</strong> Es recomendable mantener el NIT actualizado para facturación.
                            </p>
                            <p class="mb-2">
                                <i class="bi bi-telephone text-success me-1"></i>
                                <strong>Contacto:</strong> La información de contacto facilita la comunicación con el cliente.
                            </p>
                            <p class="mb-0">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <strong>Estado:</strong> Los clientes inactivos no aparecerán en las opciones de venta.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('clienteForm');
            const submitBtn = document.getElementById('btnSubmit');
            const originalBtnText = submitBtn.innerHTML;

            // Contador de caracteres para dirección
            const direccionTextarea = document.getElementById('Direccion');
            const contador = document.getElementById('direccionContador');

            if (direccionTextarea && contador) {
                direccionTextarea.addEventListener('input', function() {
                    contador.textContent = this.value.length;

                    if (this.value.length > 240) {
                        contador.classList.add('text-warning');
                    } else {
                        contador.classList.remove('text-warning');
                    }

                    if (this.value.length >= 250) {
                        contador.classList.add('text-danger');
                    } else {
                        contador.classList.remove('text-danger');
                    }
                });

                // Inicializar contador
                contador.textContent = direccionTextarea.value.length;
            }

            // Auto-formatear NIT mientras se escribe
            const nitInput = document.getElementById('nitInput');
            if (nitInput) {
                nitInput.addEventListener('input', function(e) {
                    // Permitir solo números, K y guion
                    let value = this.value.replace(/[^0-9kK-]/g, '').toUpperCase();

                    // Si tiene más de 8 dígitos y no tiene guion, agregarlo automáticamente
                    if (value.length > 8 && !value.includes('-')) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }

                    this.value = value;
                });

                // También formatear al perder el foco
                nitInput.addEventListener('blur', function() {
                    let value = this.value.replace(/[^0-9kK]/g, '').toUpperCase();
                    if (value.length >= 9) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }
                    this.value = value;
                });

                // Validar formato al enviar el formulario
                form.addEventListener('submit', function() {
                    let value = nitInput.value.replace(/[^0-9kK]/g, '').toUpperCase();
                    if (value.length >= 9) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }
                    nitInput.value = value;
                });
            }

            // Validación en tiempo real
            const inputs = document.querySelectorAll('input, textarea');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    this.classList.remove('is-valid', 'is-invalid');

                    if (this.checkValidity()) {
                        this.classList.add('is-valid');
                    } else {
                        this.classList.add('is-invalid');
                    }
                });

                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                    }
                });
            });

            // SOLUCIÓN: Validar el formulario antes de deshabilitar el botón
            form.addEventListener('submit', function(e) {
                // Primero validar si el formulario es válido
                if (!form.checkValidity()) {
                    // Si no es válido, mostrar validaciones y no deshabilitar el botón
                    e.preventDefault();
                    e.stopPropagation();

                    // Mostrar errores de validación
                    inputs.forEach(input => {
                        input.classList.remove('is-valid', 'is-invalid');
                        if (!input.checkValidity()) {
                            input.classList.add('is-invalid');
                        }
                    });

                    return;
                }

                // Solo deshabilitar el botón si el formulario es válido
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Procesando...';

                // Re-habilitar el botón después de 10 segundos por si hay algún error
                setTimeout(() => {
                    if (submitBtn.disabled) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                    }
                }, 10000);
            });

            // Restaurar el botón si hay errores del servidor (cuando la página se recarga con errores)
            if (!@ViewData.ModelState.IsValid.ToString().ToLower()) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
            }

            // Focus en el primer campo al cargar
            const firstInput = document.querySelector('input[type="text"]');
            if (firstInput) firstInput.focus();
        });

        // Función global para restaurar el botón desde otras partes del código
        function restaurarBotonSubmit() {
            const submitBtn = document.getElementById('btnSubmit');
            if (submitBtn && submitBtn.disabled) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Guardar Cambios';
            }
        }
    </script>
}