@model ProyectoLogin.Models.Cliente
@using System.Security.Claims

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Editar Cliente";

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

@if (isAuth && isAdmin)
{
    <div class="clients-edit-theme">
        <div class="clients-edit-wrapper">
            <div class="clients-edit-card">
                <!-- HEADER (estilo menta como usuarios) -->
                <div class="clients-edit-header">
                    <div class="clients-edit-header-icon">
                        <i class="bi bi-person-gear"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4>Editar Cliente</h4>
                        <p class="clients-edit-subtitle">
                            Actualiza la información manteniendo los datos consistentes para facturación y ventas.
                        </p>
                    </div>

                    <!-- Estado (con pastilla) -->
                    <div class="clients-status">
                        <span class="clients-status-label">Estado</span>
                        <div>
                            @if (Model.Activo)
                            {
                                <span class="clients-status-badge clients-status-active">
                                    <i class="bi bi-check-circle me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="clients-status-badge clients-status-inactive">
                                    <i class="bi bi-x-circle me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- BODY / FORM -->
                <div class="clients-edit-body">
                    <!-- Errores generales -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Hay errores en el formulario.</strong>
                            <ul class="mb-0 mt-1 small">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post" id="clienteForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdCliente" />

                        <!-- Información básica -->
                        <div class="clients-info-block">
                            <div class="clients-info-label">
                                <i class="bi bi-card-checklist"></i> Información Básica
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Nit" class="clients-form-label">
                                        <i class="bi bi-credit-card"></i> NIT
                                    </label>
                                    <input asp-for="Nit"
                                           class="clients-input"
                                           placeholder="Ej: 12345678-9"
                                           required
                                           pattern="[0-9]+(-[0-9kK])?"
                                           title="Formato: 12345678-9"
                                           id="nitInput" />
                                    <span asp-validation-for="Nit" class="text-danger small d-block mt-1"></span>
                                    <div class="clients-help-text">
                                        <i class="bi bi-info-circle"></i>
                                        El guion se ajusta automáticamente al validar el formato.
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="clients-form-label">
                                        <i class="bi bi-fingerprint"></i> ID Interno
                                    </label>
                                    <div class="clients-input clients-input-readonly">
                                        @Model.IdCliente
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Información personal -->
                        <div class="clients-info-block">
                            <div class="clients-info-label">
                                <i class="bi bi-person-lines-fill"></i> Información Personal
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Nombres" class="clients-form-label">
                                        <i class="bi bi-person"></i> Nombres
                                    </label>
                                    <input asp-for="Nombres"
                                           class="clients-input"
                                           placeholder="Nombres del cliente"
                                           required
                                           minlength="2"
                                           maxlength="100"
                                           pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                                           title="Solo letras y espacios" />
                                    <span asp-validation-for="Nombres" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Apellidos" class="clients-form-label">
                                        <i class="bi bi-person"></i> Apellidos
                                    </label>
                                    <input asp-for="Apellidos"
                                           class="clients-input"
                                           placeholder="Apellidos del cliente"
                                           required
                                           minlength="2"
                                           maxlength="100"
                                           pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                                           title="Solo letras y espacios" />
                                    <span asp-validation-for="Apellidos" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Contacto -->
                        <div class="clients-info-block">
                            <div class="clients-info-label">
                                <i class="bi bi-telephone"></i> Información de Contacto
                            </div>

                            <div class="row">
                                <div class="col-12 mb-3">
                                    <label asp-for="Correo" class="clients-form-label">
                                        <i class="bi bi-envelope"></i> Correo Electrónico
                                    </label>
                                    <input asp-for="Correo"
                                           class="clients-input"
                                           type="email"
                                           placeholder="cliente@correo.com"
                                           maxlength="150" />
                                    <span asp-validation-for="Correo" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Dirección -->
                        <div class="clients-info-block">
                            <div class="clients-info-label">
                                <i class="bi bi-geo-alt"></i> Dirección
                            </div>

                            <div class="mb-3">
                                <label asp-for="Direccion" class="clients-form-label">
                                    <i class="bi bi-house"></i> Dirección Completa
                                </label>
                                <textarea asp-for="Direccion"
                                          class="clients-input"
                                          rows="3"
                                          maxlength="250"
                                          placeholder="Dirección completa del cliente"
                                          id="Direccion"></textarea>
                                <span asp-validation-for="Direccion" class="text-danger small d-block mt-1"></span>
                                <div class="clients-help-text">
                                    <i class="bi bi-info-circle"></i>
                                    <span id="direccionContador">0</span>/250 caracteres
                                </div>
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="clients-actions">
                            <a asp-action="Index"
                               class="btn-clients-cancel"
                               title="Volver al listado de clientes">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>

                            <button type="submit"
                                    class="btn-clients-save"
                                    id="btnSubmit"
                                    title="Guardar cambios del cliente">
                                <i class="bi bi-check2-circle"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tarjeta informativa (blanco, como usuarios) -->
            <div class="clients-info-card">
                <h6>
                    <i class="bi bi-lightbulb"></i>
                    Información rápida
                </h6>
                <ul class="mb-0">
                    <li><strong>NIT:</strong> Mantener el NIT correcto asegura una facturación válida.</li>
                    <li><strong>Contacto:</strong> Un correo actualizado facilita la comunicación con el cliente.</li>
                    <li><strong>Estado:</strong> Clientes inactivos no se mostrarán en el flujo de ventas.</li>
                </ul>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('clienteForm');
            const submitBtn = document.getElementById('btnSubmit');
            const originalBtnText = submitBtn ? submitBtn.innerHTML : '';

            const direccionTextarea = document.getElementById('Direccion');
            const contador = document.getElementById('direccionContador');

            // Contador dirección
            if (direccionTextarea && contador) {
                const updateCount = () => {
                    const len = direccionTextarea.value.length;
                    contador.textContent = len;

                    contador.classList.remove('text-warning', 'text-danger');

                    if (len > 240 && len < 250) {
                        contador.classList.add('text-warning');
                    }
                    if (len >= 250) {
                        contador.classList.add('text-danger');
                    }
                };

                direccionTextarea.addEventListener('input', updateCount);
                updateCount();
            }

            // NIT: autoformato
            const nitInput = document.getElementById('nitInput');
            if (nitInput) {
                nitInput.addEventListener('input', function () {
                    let value = this.value.replace(/[^0-9kK-]/g, '').toUpperCase();

                    if (value.length > 8 && !value.includes('-')) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }

                    this.value = value;
                });

                nitInput.addEventListener('blur', function () {
                    let value = this.value.replace(/[^0-9kK]/g, '').toUpperCase();
                    if (value.length >= 9) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }
                    this.value = value;
                });

                form.addEventListener('submit', function () {
                    let value = nitInput.value.replace(/[^0-9kK]/g, '').toUpperCase();
                    if (value.length >= 9) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }
                    nitInput.value = value;
                });
            }

            // Validación visual en tiempo real
            const inputs = document.querySelectorAll('#clienteForm input, #clienteForm textarea');
            inputs.forEach(input => {
                input.addEventListener('blur', function () {
                    this.classList.remove('is-valid', 'is-invalid');
                    if (this.checkValidity()) {
                        this.classList.add('is-valid');
                    } else if (this.value.trim() !== '') {
                        this.classList.add('is-invalid');
                    }
                });

                input.addEventListener('input', function () {
                    if (this.value.trim() !== '') {
                        this.classList.remove('is-invalid');
                    }
                });
            });

            // Manejo del submit
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();

                    inputs.forEach(input => {
                        input.classList.remove('is-valid', 'is-invalid');
                        if (!input.checkValidity()) {
                            input.classList.add('is-invalid');
                        }
                    });

                    return;
                }

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Guardando...';

                    setTimeout(() => {
                        if (submitBtn.disabled) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnText;
                        }
                    }, 10000);
                }
            });

            // Restaurar botón si la página viene con errores del servidor
            if (!@ViewData.ModelState.IsValid.ToString().ToLower())
            {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                }
            }

            // Focus inicial
            const firstInput = document.querySelector('#clienteForm input[type="text"]');
            if (firstInput) firstInput.focus();
        });

        // Función global para restaurar botón
        function restaurarBotonSubmit() {
            const submitBtn = document.getElementById('btnSubmit');
            if (submitBtn && submitBtn.disabled) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Guardar Cambios';
            }
        }
    </script>
}

<style>
    :root {
        /* Paleta menta (igual a usuarios) */
        --clients-primary: #062926;
        --clients-secondary: #12C6A1;
        --clients-accent: #5EF2C1;
        --clients-bg: #f5f6fa;
        --clients-card: #ffffff;
        --clients-text: #111827;
        --clients-muted: #6b7280;
        --clients-radius: .75rem;
        --clients-border-soft: #e5e7eb;
        --clients-danger: #b91c1c;
        --clients-success: #16a34a;
    }

    .clients-edit-theme {
        min-height: 100vh;
        padding: 1.5rem 0 2rem;
        background: var(--clients-bg);
        display: flex;
        justify-content: center;
    }

    .clients-edit-wrapper {
        width: 100%;
        max-width: 780px;
    }

    .clients-edit-card {
        background: var(--clients-card);
        border-radius: var(--clients-radius);
        border: 1px solid var(--clients-border-soft);
        box-shadow: 0 6px 20px rgba(15,23,42,.08);
        overflow: hidden;
        transition: all .25s ease;
    }

        .clients-edit-card:hover {
            box-shadow: 0 10px 28px rgba(15,23,42,.12);
            transform: translateY(-1px);
        }

    .clients-edit-header {
        padding: 1.25rem 1.75rem;
        display: flex;
        align-items: center;
        gap: .75rem;
        background: linear-gradient(90deg,var(--clients-primary),var(--clients-secondary));
        border-bottom: 1px solid rgba(255,255,255,.16);
        color: #fff;
    }

    .clients-edit-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(0,0,0,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--clients-accent);
    }

    .clients-edit-header h4 {
        margin: 0;
        font-weight: 700;
        letter-spacing: .4px;
    }

    .clients-edit-subtitle {
        margin: 0;
        font-size: .8rem;
        color: rgba(241,245,249,.9);
    }

    .clients-status {
        text-align: right;
        margin-left: auto;
    }

    .clients-status-label {
        font-size: .72rem;
        color: #e5fff8;
        opacity: .85;
        display: block;
    }

    .clients-status-badge {
        padding: .18rem .6rem;
        font-size: .72rem;
        border-radius: 999px;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        font-weight: 600;
        background: #ecfdf5;
        color: #064e3b;
        border-color: #bbf7d0;
    }

    .clients-status-inactive {
        background: #fef2f2;
        color: #7f1d1d;
        border-color: #fecaca;
    }

    .clients-edit-body {
        padding: 1.5rem 1.75rem 1.6rem;
        color: var(--clients-text);
    }

    .clients-info-block {
        background: #fff;
        border-radius: var(--clients-radius);
        border: 1px solid var(--clients-border-soft);
        padding: 1.25rem 1.25rem 1rem;
        margin-bottom: 1.1rem;
        transition: all .25s ease;
    }

        .clients-info-block:hover {
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            border-color: var(--clients-accent);
        }

    .clients-info-label {
        font-size: .9rem;
        font-weight: 700;
        color: var(--clients-text);
        display: flex;
        align-items: center;
        gap: .35rem;
        margin-bottom: .7rem;
        padding-bottom: .5rem;
        border-bottom: 2px solid rgba(18,198,161,.16);
    }

        .clients-info-label i {
            background: var(--clients-secondary);
            color: #fff;
            width: 1.8rem;
            height: 1.8rem;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
        }

    .clients-form-label {
        font-size: .88rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: .3rem;
        display: flex;
        align-items: center;
        gap: .35rem;
    }

        .clients-form-label i {
            color: var(--clients-secondary);
            font-size: 1rem;
        }

    .clients-input {
        background: #fff;
        border-radius: var(--clients-radius);
        border: 1px solid #d1d5db;
        padding: .6rem .85rem;
        font-size: .9rem;
        color: var(--clients-text);
        transition: all .25s ease;
        width: 100%;
    }

        .clients-input::placeholder {
            color: #9ca3af;
        }

        .clients-input:focus {
            outline: none;
            border-color: var(--clients-secondary);
            box-shadow: 0 0 0 .16rem rgba(18,198,161,.15);
            background: #fff;
            color: var(--clients-text);
        }

    .clients-input-readonly {
        background: #f9fafb;
        border: 1px dashed #e5e7eb;
        color: var(--clients-muted);
    }

    .clients-help-text {
        font-size: .78rem;
        color: var(--clients-muted);
        margin-top: .25rem;
        display: flex;
        gap: .3rem;
        align-items: center;
    }

        .clients-help-text i {
            color: var(--clients-secondary);
            font-size: .9rem;
        }

    .alert {
        border-radius: var(--clients-radius);
        padding: .7rem .9rem;
        font-size: .86rem;
        margin-top: .4rem;
        border-width: 1px;
        box-shadow: 0 6px 16px rgba(15,23,42,.08);
    }

    .alert-danger {
        background: #fef2f2;
        border-color: #fecaca;
        color: var(--clients-danger);
    }

    .alert .btn-close {
        filter: none;
    }

    .clients-actions {
        padding-top: 1rem;
        margin-top: .75rem;
        border-top: 1px solid var(--clients-border-soft);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-clients-cancel {
        border-radius: var(--clients-radius);
        padding: .6rem 1.4rem;
        font-size: .88rem;
        border: 1px solid var(--clients-secondary);
        color: var(--clients-secondary);
        background: transparent;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        transition: all .25s ease;
        text-decoration: none;
    }

        .btn-clients-cancel:hover {
            background: var(--clients-secondary);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(15,23,42,.16);
        }

    .btn-clients-save {
        border-radius: var(--clients-radius);
        padding: .6rem 1.6rem;
        font-size: .9rem;
        font-weight: 600;
        border: none;
        background: var(--clients-secondary);
        color: #020814;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        box-shadow: 0 6px 18px rgba(15,23,42,.18);
        transition: all .25s ease;
    }

        .btn-clients-save:hover {
            background: var(--clients-primary);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(15,23,42,.22);
        }

    .btn:disabled {
        cursor: not-allowed;
        opacity: .6;
    }

    .clients-info-card {
        margin-top: 1.4rem;
        background: #fff;
        color: var(--clients-text);
        border-radius: var(--clients-radius);
        border: 1px solid var(--clients-border-soft);
        padding: 1rem 1.2rem .9rem;
        box-shadow: 0 8px 20px rgba(15,23,42,.08);
    }

        .clients-info-card h6 {
            font-size: .9rem;
            font-weight: 600;
            margin-bottom: .5rem;
            display: flex;
            align-items: center;
            gap: .3rem;
            color: var(--clients-primary);
        }

            .clients-info-card h6 i {
                font-size: 1rem;
                color: var(--clients-secondary);
            }

        .clients-info-card ul {
            margin: 0;
            padding-left: 1rem;
        }

        .clients-info-card li {
            font-size: .82rem;
            color: var(--clients-muted);
            margin-bottom: .25rem;
        }

        .clients-info-card strong {
            color: var(--clients-text);
        }

    @@media (max-width:576px) {
        .clients-edit-body

    {
        padding: 1.3rem 1.1rem 1.2rem;
    }

    .clients-edit-header {
        padding: 1rem 1.25rem;
        gap: .6rem;
    }

    .clients-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-clients-cancel, .btn-clients-save {
        width: 100%;
        justify-content: center;
    }

    }
</style>
