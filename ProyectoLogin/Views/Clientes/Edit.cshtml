@model ProyectoLogin.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <!-- CARD PRINCIPAL -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-gear fs-4 me-2"></i>
                        <h4 class="mb-0">Editar Cliente</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdCliente" />

                        <!-- INFORMACIÓN BÁSICA -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-card-checklist me-2"></i>Información Básica
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nit" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-credit-card me-1"></i>NIT
                                </label>
                                <input asp-for="Nit" class="form-control" placeholder="Número de NIT" />
                                <span asp-validation-for="Nit" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Estado
                                </label>
                                <div class="form-control bg-light border-0">
                                    @if (Model.Activo)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>Inactivo
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN PERSONAL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-person-lines-fill me-2"></i>Información Personal
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombres" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Nombres
                                </label>
                                <input asp-for="Nombres" class="form-control" placeholder="Nombres del cliente" />
                                <span asp-validation-for="Nombres" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellidos" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Apellidos
                                </label>
                                <input asp-for="Apellidos" class="form-control" placeholder="Apellidos del cliente" />
                                <span asp-validation-for="Apellidos" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- INFORMACIÓN DE CONTACTO -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-telephone me-2"></i>Información de Contacto
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-envelope me-1"></i>Correo Electrónico
                                </label>
                                <input asp-for="Correo" class="form-control" type="email" placeholder="cliente@correo.com" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-phone me-1"></i>Teléfono
                                </label>
                                <input asp-for="Telefono" class="form-control" placeholder="Número de teléfono" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- DIRECCIÓN -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-geo-alt me-2"></i>Dirección
                                </h6>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Direccion" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-house me-1"></i>Dirección Completa
                                </label>
                                <textarea asp-for="Direccion" class="form-control" rows="3"
                                          placeholder="Dirección completa del cliente"></textarea>
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Volver al listado de clientes">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>

                            <div class="d-flex gap-2">
                                

                                <button type="submit" class="btn btn-primary rounded-pill" title="Guardar cambios del cliente">
                                    <i class="bi bi-check2-circle me-1"></i>Guardar Cambios
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Información Importante
                    </h6>
                    <div class="row text-muted small">
                        <div class="col-12">
                            <p class="mb-2">
                                <i class="bi bi-info-circle text-primary me-1"></i>
                                <strong>NIT:</strong> Es recomendable mantener el NIT actualizado para facturación.
                            </p>
                            <p class="mb-2">
                                <i class="bi bi-telephone text-success me-1"></i>
                                <strong>Contacto:</strong> La información de contacto facilita la comunicación con el cliente.
                            </p>
                            <p class="mb-0">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <strong>Estado:</strong> Los clientes inactivos no aparecerán en las opciones de venta.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Focus en el primer campo al cargar
            const firstInput = document.querySelector('input[type="text"]');
            if (firstInput) firstInput.focus();

            // Validación en tiempo real para campos
            const inputs = document.querySelectorAll('input, textarea');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    const errorSpan = this.nextElementSibling;
                    if (errorSpan && errorSpan.classList.contains('text-danger') && errorSpan.textContent.trim() !== '') {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                });
            });
        });
    </script>
}