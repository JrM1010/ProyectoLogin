@model IEnumerable<ProyectoLogin.Models.Cliente>

@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Gestión de Clientes";

    var activos = ViewBag.Activos as List<ProyectoLogin.Models.Cliente> ?? new List<ProyectoLogin.Models.Cliente>();
    var inactivos = ViewBag.Inactivos as List<ProyectoLogin.Models.Cliente> ?? new List<ProyectoLogin.Models.Cliente>();

    var totalActivos = ViewBag.TotalActivos ?? 0;
    var totalInactivos = ViewBag.TotalInactivos ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
    var pageActivos = ViewBag.PageActivos ?? 1;
    var pageInactivos = ViewBag.PageInactivos ?? 1;
    var totalPagesActivos = ViewBag.TotalPagesActivos ?? 1;
    var totalPagesInactivos = ViewBag.TotalPagesInactivos ?? 1;

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

<div class="container-fluid clientes-theme py-4">

    <!-- HEADER PRINCIPAL -->
    <div class="clientes-header mb-4">
        <div class="row align-items-center g-3">
            <div class="col-md-8 d-flex align-items-center gap-3 flex-wrap">
                <div class="clientes-icon-wrapper">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h1 class="h3 mb-1 text-white">
                        Gestión de Clientes
                    </h1>
                    <p class="mb-0 clientes-header-subtitle">
                        Administra clientes activos e inactivos con una vista clara y consistente.
                    </p>
                </div>
            </div>
            <div class="col-md-4 d-flex justify-content-md-end justify-content-start gap-2 flex-wrap">
                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-outline-clientes">
                    <i class="bi bi-arrow-left me-2"></i> Volver al Inicio
                </a>

                @if (isAuth && (isAdmin || isEmpleado))
                {
                    <a asp-action="Create"
                       class="btn btn-clientes-primary"
                       title="Agregar nuevo cliente">
                        <i class="bi bi-person-plus me-2"></i> Nuevo Cliente
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- MENSAJES TEMPORALES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-smart shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">
                    <strong>¡Éxito!</strong> @TempData["Mensaje"]
                </div>
                <button type="button" class="btn-close btn-close-white ms-2"
                        data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-smart shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div class="flex-grow-1">
                    <strong>¡Error!</strong> @TempData["Error"]
                </div>
                <button type="button" class="btn-close btn-close-white ms-2"
                        data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        </div>
    }

    @if (TempData["Advertencia"] != null)
    {
        <div class="alert alert-warning alert-smart shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Advertencia:</strong> @TempData["Advertencia"]
                </div>
                <button type="button" class="btn-close btn-close-white ms-2"
                        data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        </div>
    }

    <!-- BARRA DE BÚSQUEDA -->
    <div class="clientes-card mb-4">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-semibold text-accent">Buscar cliente</label>
                </div>
                <div class="col-md-6 col-sm-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text clientes-input-addon">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               name="q"
                               value="@(ViewData["q"] ?? "")"
                               class="form-control clientes-input"
                               placeholder="NIT, nombre, correo..." />
                    </div>
                </div>
                <div class="col-auto">
                    <input type="hidden" name="pageActivos" value="1" />
                    <input type="hidden" name="pageInactivos" value="1" />
                    <button class="btn btn-clientes-primary btn-sm clientes-btn-pill" type="submit">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- CLIENTES ACTIVOS -->
    <div class="clientes-card mb-4">
        <div class="clientes-card-header d-flex align-items-center">
            <i class="bi bi-person-check fs-5 me-2 text-success"></i>
            <h5 class="mb-0 me-2 text-white">Clientes Activos</h5>
            <span class="badge clientes-badge">@totalActivos</span>
        </div>

        <div class="card-body p-0">
            @if (!activos.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <h5 class="mb-1">No hay clientes activos registrados</h5>
                    <p class="mb-0">Agrega nuevos clientes para comenzar a registrar ventas.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table clientes-table mb-0 align-middle clientes-table-activos">
                        <thead>
                            <tr>
                                <th class="ps-3">NIT</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Dirección</th>
                                @if (isAuth && isAdmin)
                                {
                                    <th class="text-center">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in activos)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        <span class="badge clientes-badge-soft">@c.Nit</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-person-circle text-accent"></i>
                                            <span class="text-white">
                                                @c.Nombres @c.Apellidos
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Correo))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-envelope text-muted"></i>
                                                <a href="mailto:@c.Correo" class="clientes-link">@c.Correo</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted-small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(c.Direccion) ? "-" : c.Direccion)
                                    </td>

                                    @if (isAuth && isAdmin)
                                    {
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <!-- Editar -->
                                                <a asp-action="Edit"
                                                   asp-route-id="@c.IdCliente"
                                                   class="btn btn-outline-warning btn-sm rounded-circle clientes-action-btn"
                                                   title="Editar cliente">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <!-- Desactivar (confirm personalizado) -->
                                                <form asp-action="ToggleActivo"
                                                      asp-route-id="@c.IdCliente"
                                                      method="post"
                                                      class="d-inline clientes-confirm-form"
                                                      data-mensaje="¿Desactivar a @c.Nombres @c.Apellidos?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button"
                                                            class="btn btn-outline-danger btn-sm rounded-circle clientes-action-btn clientes-confirm-trigger"
                                                            title="Desactivar cliente">
                                                        <i class="bi bi-person-dash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN ACTIVOS -->
                @if (totalPagesActivos > 1)
                {
                    <div class="clientes-pagination-bar">
                        <div class="text-muted-small">
                            Página @pageActivos de @totalPagesActivos •
                            Mostrando @activos.Count() de @totalActivos clientes
                        </div>
                        <ul class="pagination pagination-sm mb-0 clientes-pagination">
                            @if (pageActivos > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos - 1,
                                            pageInactivos = pageInactivos,
                                            pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                </li>
                            }

                            @{
                                int startPage = Math.Max(1, pageActivos - 2);
                                int endPage = Math.Min(totalPagesActivos, pageActivos + 2);

                                if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                                q = ViewData["q"],
                                                pageActivos = 1,
                                                pageInactivos = pageInactivos,
                                                pageSize = pageSize
                                           })">1</a>
                                    </li>
                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == pageActivos ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                                q = ViewData["q"],
                                                pageActivos = i,
                                                pageInactivos = pageInactivos,
                                                pageSize = pageSize
                                           })">@i</a>
                                    </li>
                                }

                                if (endPage < totalPagesActivos)
                                {
                                    if (endPage < totalPagesActivos - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                                q = ViewData["q"],
                                                pageActivos = totalPagesActivos,
                                                pageInactivos = pageInactivos,
                                                pageSize = pageSize
                                           })">@totalPagesActivos</a>
                                    </li>
                                }
                            }

                            @if (pageActivos < totalPagesActivos)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos + 1,
                                            pageInactivos = pageInactivos,
                                            pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    </div>

    <!-- CLIENTES INACTIVOS -->
    @if (totalInactivos > 0 && isAuth && isAdmin)
    {
        <div class="clientes-card">
            <div class="clientes-card-header-secondary d-flex align-items-center">
                <i class="bi bi-person-x fs-5 me-2 text-warning"></i>
                <h5 class="mb-0 me-2 text-white">Clientes Inactivos</h5>
                <span class="badge clientes-badge">@totalInactivos</span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table clientes-table mb-0 align-middle clientes-table-inactivos">
                        <thead>
                            <tr>
                                <th class="ps-3">NIT</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in inactivos)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        <span class="badge clientes-badge-muted">@c.Nit</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-person-circle text-muted"></i>
                                            <span class="text-muted-small">
                                                @c.Nombres @c.Apellidos
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Correo))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-envelope text-muted"></i>
                                                <span class="text-muted-small">@c.Correo</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted-small">-</span>
                                        }
                                    </td>
                                    <td class="text-muted-small">
                                        @(string.IsNullOrEmpty(c.Direccion) ? "-" : c.Direccion)
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <form asp-action="ToggleActivo"
                                                  asp-route-id="@c.IdCliente"
                                                  method="post"
                                                  class="d-inline clientes-confirm-form"
                                                  data-mensaje="¿Activar a @c.Nombres @c.Apellidos?">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="btn btn-outline-success btn-sm rounded-circle clientes-action-btn clientes-confirm-trigger"
                                                        title="Activar cliente">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN INACTIVOS -->
                @if (totalPagesInactivos > 1)
                {
                    <div class="clientes-pagination-bar">
                        <div class="text-muted-small">
                            Página @pageInactivos de @totalPagesInactivos •
                            Mostrando @inactivos.Count() de @totalInactivos clientes
                        </div>
                        <ul class="pagination pagination-sm mb-0 clientes-pagination">
                            @if (pageInactivos > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos,
                                            pageInactivos = pageInactivos - 1,
                                            pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                </li>
                            }

                            @{
                                int startPageInactivos = Math.Max(1, pageInactivos - 2);
                                int endPageInactivos = Math.Min(totalPagesInactivos, pageInactivos + 2);

                                if (startPageInactivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                                q = ViewData["q"],
                                                pageActivos = pageActivos,
                                                pageInactivos = 1,
                                                pageSize = pageSize
                                           })">1</a>
                                    </li>
                                    if (startPageInactivos > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                for (int i = startPageInactivos; i <= endPageInactivos; i++)
                                {
                                    <li class="page-item @(i == pageInactivos ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                                q = ViewData["q"],
                                                pageActivos = pageActivos,
                                                pageInactivos = i,
                                                pageSize = pageSize
                                           })">@i</a>
                                    </li>
                                }

                                if (endPageInactivos < totalPagesInactivos)
                                {
                                    if (endPageInactivos < totalPagesInactivos - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                                q = ViewData["q"],
                                                pageActivos = pageActivos,
                                                pageInactivos = totalPagesInactivos,
                                                pageSize = pageSize
                                           })">@totalPagesInactivos</a>
                                    </li>
                                }
                            }

                            @if (pageInactivos < totalPagesInactivos)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                            q = ViewData["q"],
                                            pageActivos = pageActivos,
                                            pageInactivos = pageInactivos + 1,
                                            pageSize = pageSize
                                       })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL CONFIRM CUSTOM -->
<div id="clientesConfirm" class="clientes-confirm d-none">
    <div class="clientes-confirm-box">
        <h6 class="mb-2 text-white">
            <i class="bi bi-question-circle me-1"></i> Confirmar acción
        </h6>
        <p id="clientesConfirmMessage" class="mb-3 text-muted-small"></p>
        <div class="d-flex justify-content-end gap-2">
            <button type="button"
                    class="btn btn-sm clientes-btn-soft"
                    id="clientesConfirmCancel">Cancelar</button>
            <button type="button"
                    class="btn btn-sm btn-clientes-primary clientes-btn-pill"
                    id="clientesConfirmOk">Confirmar</button>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-blue: #1C1973;
        --secondary-blue: #514BF2;
        --accent-blue: #8B88F2;
        --dark-bg: #0D0E26;
        --alt-bg: #081C59;
        --light-text: #F0F0F7;
        --muted-text: #A4A5D4;
        --radius: 0.75rem;
    }

    .clientes-theme {
        min-height: 100vh;
        background:
            radial-gradient(circle at top left, rgba(81,75,242,0.14), transparent),
            radial-gradient(circle at top right, rgba(139,136,242,0.08), transparent),
            linear-gradient(180deg, #0D0E26, #040611);
        color: var(--light-text);
    }

    .clientes-header {
        background: linear-gradient(135deg, var(--alt-bg), var(--primary-blue));
        border-radius: var(--radius);
        padding: 1.5rem 1.75rem;
        border: 1px solid rgba(139,136,242,0.35);
        box-shadow: 0 8px 24px rgba(0,0,0,0.55);
    }

    .clientes-header-subtitle {
        color: var(--muted-text);
        font-size: 0.85rem;
    }

    .clientes-icon-wrapper {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 0, var(--accent-blue), var(--primary-blue));
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: 0 5px 16px rgba(0,0,0,0.55);
        font-size: 1.4rem;
    }

    .clientes-card {
        background: rgba(8, 28, 89, 0.97);
        border-radius: var(--radius);
        border: 1px solid rgba(81,75,242,0.24);
        box-shadow: 0 10px 26px rgba(0,0,0,0.6);
        backdrop-filter: blur(4px);
        overflow: hidden;
    }

    .clientes-card-header {
        background: linear-gradient(90deg, rgba(28,25,115,0.98), rgba(81,75,242,0.92));
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid rgba(139,136,242,0.35);
    }

    .clientes-card-header-secondary {
        background: linear-gradient(90deg, rgba(24,24,48,0.98), rgba(8,28,89,0.98));
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid rgba(139,136,242,0.25);
    }

    .clientes-badge,
    .clientes-badge-soft,
    .clientes-badge-muted {
        border-radius: 999px;
        font-size: 0.72rem;
        padding: 0.18rem 0.6rem;
        display: inline-flex;
        align-items: center;
        gap: 0.15rem;
    }

    .clientes-badge {
        background-color: #F0F0F7;
        color: var(--primary-blue);
        font-weight: 600;
    }

    .clientes-badge-soft {
        background-color: rgba(81,75,242,0.18);
        color: var(--accent-blue);
    }

    .clientes-badge-muted {
        background-color: rgba(255,255,255,0.06);
        color: var(--muted-text);
    }

    .text-muted-small {
        color: var(--muted-text);
        font-size: 0.8rem;
    }

    /* Tablas (override completo para evitar fondo blanco) */
    .clientes-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background-color: transparent !important;
        color: var(--light-text);
    }

    .clientes-table thead {
        background-color: #050A23;
    }

    .clientes-table thead th {
        color: var(--muted-text);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-bottom: 1px solid rgba(139,136,242,0.35) !important;
        padding-top: 0.6rem;
        padding-bottom: 0.45rem;
        background-color: transparent;
    }

    .clientes-table tbody tr {
        background-color: #090F2D !important;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: all 0.2s ease;
    }

    .clientes-table tbody tr:nth-child(even) {
        background-color: #060A22 !important;
    }

    .clientes-table-activos tbody tr:hover {
        background:
            radial-gradient(circle at 0 0, rgba(81,75,242,0.25), transparent),
            #050918;
        transform: translateY(-1px);
    }

    .clientes-table-inactivos tbody tr {
        opacity: 0.9;
    }

    .clientes-table-inactivos tbody tr:hover {
        background:
            radial-gradient(circle at 0 0, rgba(255,193,7,0.18), transparent),
            #050918;
        transform: translateY(-1px);
    }

    .clientes-table td {
        color: var(--light-text);
        vertical-align: middle;
        font-size: 0.86rem;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        background-color: transparent;
    }

    .clientes-link {
        color: var(--accent-blue);
        text-decoration: none;
        font-size: 0.82rem;
