@model IEnumerable<ProyectoLogin.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i>Gestión de Clientes
        </h2>
        <a asp-action="Create" class="btn btn-success rounded-pill" title="Agregar nuevo cliente">
            <i class="bi bi-person-plus me-1"></i>Nuevo Cliente
        </a>
    </div>

    <!-- BARRA DE BÚSQUEDA -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-semibold text-primary">Buscar Cliente</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="q" value="@(ViewData["q"] ?? "")" class="form-control"
                               placeholder="Buscar por NIT, nombre, correo..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary rounded-pill w-100" title="Buscar clientes">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MENSAJES TEMPORALES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- CLIENTES ACTIVOS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white d-flex align-items-center">
            <i class="bi bi-person-check fs-5 me-2"></i>
            <h5 class="mb-0 me-2">Clientes Activos</h5>
            <span class="badge bg-light text-success fs-6">@Model.Count(x => x.Activo)</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any(x => x.Activo))
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-people fs-1 mb-2"></i>
                    <p class="mb-0">No hay clientes activos</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">NIT</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Teléfono</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Where(x => x.Activo))
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        <span class="badge bg-primary">@c.Nit</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person-circle text-primary me-2"></i>
                                            @c.Nombres @c.Apellidos
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Correo))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-envelope text-muted me-2"></i>
                                                <a href="mailto:@c.Correo" class="text-decoration-none">@c.Correo</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Telefono))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-telephone text-muted me-2"></i>
                                                @c.Telefono
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(c.Direccion) ? "-" : c.Direccion)</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Editar -->
                                            <a asp-action="Edit" asp-route-id="@c.IdCliente"
                                               class="btn btn-outline-warning rounded-circle btn-sm" title="Editar cliente">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Desactivar -->
                                            <form asp-action="ToggleActivo" asp-route-id="@c.IdCliente" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger rounded-circle btn-sm"
                                                        title="Desactivar cliente"
                                                        onclick="return confirm('¿Estás seguro de desactivar a @c.Nombres @c.Apellidos?')">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- CLIENTES INACTIVOS -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white d-flex align-items-center">
            <i class="bi bi-person-x fs-5 me-2"></i>
            <h5 class="mb-0 me-2">Clientes Inactivos</h5>
            <span class="badge bg-light text-secondary fs-6">@Model.Count(x => !x.Activo)</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any(x => !x.Activo))
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-emoji-smile fs-1 mb-2"></i>
                    <p class="mb-0">No hay clientes inactivos</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">NIT</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Teléfono</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Where(x => !x.Activo))
                            {
                                <tr class="text-muted">
                                    <td class="ps-3 fw-semibold">
                                        <span class="badge bg-secondary">@c.Nit</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person-circle me-2"></i>
                                            @c.Nombres @c.Apellidos
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Correo))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-envelope me-2"></i>
                                                @c.Correo
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Telefono))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-telephone me-2"></i>
                                                @c.Telefono
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(c.Direccion) ? "-" : c.Direccion)</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Activar -->
                                            <form asp-action="ToggleActivo" asp-route-id="@c.IdCliente" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success rounded-circle btn-sm"
                                                        title="Activar cliente"
                                                        onclick="return confirm('¿Estás seguro de activar a @c.Nombres @c.Apellidos?')">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table td {
        vertical-align: middle;
    }

    .btn-sm {
        padding: 0.375rem 0.5rem;
    }

    .card-header {
        border-bottom: none;
    }

    a.text-decoration-none:hover {
        text-decoration: underline !important;
    }
</style>

@section Scripts {
    <script>
        // Auto-ocultar alertas después de 5 segundos
        document.addEventListener('DOMContentLoaded', function() {
            const alert = document.querySelector('.alert');
            if (alert) {
                setTimeout(() => {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                }, 5000);
            }
        });
    </script>
}