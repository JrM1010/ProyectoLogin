@model ProyectoLogin.Models.Cliente

@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <!-- CARD PRINCIPAL -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-plus fs-4 me-2"></i>
                        <h4 class="mb-0">Crear Nuevo Cliente</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- INFORMACIÓN BÁSICA -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-card-checklist me-2"></i>Información Básica
                                </h6>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Nit" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-credit-card me-1"></i>NIT *
                                </label>
                                <input asp-for="Nit" class="form-control" placeholder="Número de NIT del cliente" required />
                                <span asp-validation-for="Nit" class="text-danger small"></span>
                                <div class="form-text text-muted">
                                    <i class="bi bi-info-circle me-1"></i>El NIT es requerido para facturación
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN PERSONAL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-person-lines-fill me-2"></i>Información Personal
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombres" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Nombres *
                                </label>
                                <input asp-for="Nombres" class="form-control" placeholder="Nombres del cliente" required />
                                <span asp-validation-for="Nombres" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellidos" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Apellidos *
                                </label>
                                <input asp-for="Apellidos" class="form-control" placeholder="Apellidos del cliente" required />
                                <span asp-validation-for="Apellidos" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- INFORMACIÓN DE CONTACTO -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-telephone me-2"></i>Información de Contacto
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-envelope me-1"></i>Correo Electrónico
                                </label>
                                <input asp-for="Correo" class="form-control" type="email" placeholder="cliente@correo.com" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-phone me-1"></i>Teléfono
                                </label>
                                <input asp-for="Telefono" class="form-control" placeholder="Número de teléfono" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- DIRECCIÓN -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-geo-alt me-2"></i>Dirección
                                </h6>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Direccion" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-house me-1"></i>Dirección Completa
                                </label>
                                <textarea asp-for="Direccion" class="form-control" rows="3"
                                          placeholder="Dirección completa del cliente"></textarea>
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Volver al listado de clientes">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>

                            <div class="d-flex gap-2">
                                <button type="reset" class="btn btn-outline-warning rounded-pill" title="Limpiar formulario">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Limpiar
                                </button>

                                <button type="submit" class="btn btn-success rounded-pill" title="Crear nuevo cliente">
                                    <i class="bi bi-person-plus me-1"></i>Crear Cliente
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Información Importante
                    </h6>
                    <div class="row text-muted small">
                        <div class="col-12">
                            <p class="mb-2">
                                <i class="bi bi-asterisk text-danger me-1"></i>
                                <strong>Campos obligatorios:</strong> NIT, Nombres y Apellidos son requeridos.
                            </p>
                            <p class="mb-2">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <strong>NIT único:</strong> Cada cliente debe tener un NIT único en el sistema.
                            </p>
                            <p class="mb-0">
                                <i class="bi bi-telephone text-primary me-1"></i>
                                <strong>Contacto:</strong> Se recomienda incluir al menos un método de contacto.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Focus en el primer campo al cargar
            const firstInput = document.querySelector('input[type="text"]');
            if (firstInput) firstInput.focus();

            // Confirmación antes de limpiar el formulario
            const resetButton = document.querySelector('button[type="reset"]');
            if (resetButton) {
                resetButton.addEventListener('click', function(e) {
                    if (!confirm('¿Estás seguro de que deseas limpiar todos los campos del formulario?')) {
                        e.preventDefault();
                    }
                });
            }

            // Validación en tiempo real para campos requeridos
            const requiredInputs = document.querySelectorAll('input[required]');
            requiredInputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (!this.value.trim()) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                });
            });
        });
    </script>
}