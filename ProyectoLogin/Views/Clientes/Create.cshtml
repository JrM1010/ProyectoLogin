@model ProyectoLogin.Models.Cliente
@using System.Security.Claims

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Crear Cliente";

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

<div class="container-fluid cliente-edit-theme py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">

            <!-- CARD PRINCIPAL -->
            <div class="card cliente-edit-card">
                <div class="card-header cliente-edit-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <div class="cliente-edit-icon">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 text-white">Crear Nuevo Cliente</h4>
                            <small class="cliente-edit-subtitle">
                                Registra un nuevo cliente para asociarlo a ventas y facturación.
                            </small>
                        </div>
                    </div>
                    <div class="text-end d-none d-md-block">
                        <span class="label-estado">Nuevo registro</span>
                        <div>
                            <span class="badge badge-estado badge-estado-activo">
                                <i class="bi bi-person-circle me-1"></i>Cliente potencial
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- ERRORES DE VALIDACIÓN GENERALES -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-smart-danger alert-dismissible fade show" role="alert">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>
                                    <strong>Hay errores en el formulario.</strong>
                                    <ul class="mb-0 mt-1 small">
                                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    </ul>
                                </div>
                                <button type="button" class="btn-close ms-2"
                                        data-bs-dismiss="alert" aria-label="Cerrar"></button>
                            </div>
                        </div>
                    }

                    <form asp-action="Create" method="post" id="clienteForm" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- INFORMACIÓN BÁSICA -->
                        <div class="seccion-form mb-4">
                            <div class="seccion-titulo">
                                <i class="bi bi-card-checklist me-2"></i>Información Básica
                            </div>
                            <div class="mb-3">
                                <label asp-for="Nit" class="form-label form-label-client">
                                    <i class="bi bi-credit-card me-1"></i>NIT *
                                </label>
                                <input asp-for="Nit"
                                       class="form-control clients-input form-control-client"
                                       placeholder="Ej: 12345678-9"
                                       required
                                       pattern="[0-9]+(-[0-9kK])?"
                                       title="Formato: 12345678-9"
                                       id="nitInput" />
                                <span asp-validation-for="Nit" class="text-danger small d-block mt-1"></span>
                                <div class="form-text form-text-client">
                                    <i class="bi bi-info-circle me-1"></i>
                                    El guion se ajusta automáticamente al escribir.
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN PERSONAL -->
                        <div class="seccion-form mb-4">
                            <div class="seccion-titulo">
                                <i class="bi bi-person-lines-fill me-2"></i>Información Personal
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Nombres" class="form-label form-label-client">
                                        <i class="bi bi-person me-1"></i>Nombres *
                                    </label>
                                    <input asp-for="Nombres"
                                           class="form-control clients-input form-control-client"
                                           placeholder="Nombres del cliente"
                                           required
                                           minlength="2"
                                           maxlength="100"
                                           pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                                           title="Solo letras y espacios" />
                                    <span asp-validation-for="Nombres" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Apellidos" class="form-label form-label-client">
                                        <i class="bi bi-person me-1"></i>Apellidos *
                                    </label>
                                    <input asp-for="Apellidos"
                                           class="form-control clients-input form-control-client"
                                           placeholder="Apellidos del cliente"
                                           required
                                           minlength="2"
                                           maxlength="100"
                                           pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+"
                                           title="Solo letras y espacios" />
                                    <span asp-validation-for="Apellidos" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN DE CONTACTO -->
                        <div class="seccion-form mb-4">
                            <div class="seccion-titulo">
                                <i class="bi bi-telephone me-2"></i>Información de Contacto
                            </div>
                            <div class="mb-3">
                                <label asp-for="Correo" class="form-label form-label-client">
                                    <i class="bi bi-envelope me-1"></i>Correo Electrónico
                                </label>
                                <input asp-for="Correo"
                                       class="form-control clients-input form-control-client"
                                       type="email"
                                       placeholder="cliente@correo.com"
                                       maxlength="150" />
                                <span asp-validation-for="Correo" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- DIRECCIÓN -->
                        <div class="seccion-form mb-4">
                            <div class="seccion-titulo">
                                <i class="bi bi-geo-alt me-2"></i>Dirección
                            </div>
                            <div class="mb-3">
                                <label asp-for="Direccion" class="form-label form-label-client">
                                    <i class="bi bi-house me-1"></i>Dirección Completa
                                </label>
                                <textarea asp-for="Direccion"
                                          class="form-control clients-input form-control-client"
                                          rows="3"
                                          maxlength="250"
                                          placeholder="Dirección completa del cliente"
                                          id="Direccion"></textarea>
                                <span asp-validation-for="Direccion" class="text-danger small d-block mt-1"></span>
                                <div class="form-text form-text-client">
                                    <span id="direccionContador">0</span>/250 caracteres
                                </div>
                            </div>
                        </div>

                        <!-- BOTONES -->
                        <div class="d-flex justify-content-between align-items-center pt-3 cliente-edit-footer">
                            <a asp-action="Index"
                               class="btn btn-outline-clientes cliente-btn-cancel"
                               title="Volver al listado de clientes">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>

                            <div class="d-flex gap-2">
                                <button type="reset"
                                        class="btn cliente-btn-reset"
                                        id="btnLimpiar"
                                        title="Limpiar todos los campos">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Limpiar
                                </button>

                                <button type="submit"
                                        class="btn btn-clientes-primary cliente-btn-submit"
                                        id="btnSubmit"
                                        title="Crear cliente">
                                    <i class="bi bi-person-plus me-1"></i>Crear Cliente
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA -->
            <div class="card cliente-info-card mt-4">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Información Importante
                    </h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>NIT:</strong> Verifica el NIT antes de guardar; se usará para facturación.
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope-open me-1"></i>
                            <strong>Correo:</strong> Facilita el envío de comprobantes y comunicación.
                        </li>
                        <li>
                            <i class="bi bi-person-check me-1"></i>
                            <strong>Registro correcto:</strong> Un cliente bien registrado agiliza tus procesos de venta.
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('clienteForm');
            const submitBtn = document.getElementById('btnSubmit');
            const limpiarBtn = document.getElementById('btnLimpiar');
            const originalBtnText = submitBtn ? submitBtn.innerHTML : '';

            const direccionTextarea = document.getElementById('Direccion');
            const contador = document.getElementById('direccionContador');

            // Contador dirección
            if (direccionTextarea && contador) {
                const updateCount = () => {
                    const len = direccionTextarea.value.length;
                    contador.textContent = len;

                    contador.classList.remove('text-warning', 'text-danger');

                    if (len > 240 && len < 250) {
                        contador.classList.add('text-warning');
                    }
                    if (len >= 250) {
                        contador.classList.add('text-danger');
                    }
                };

                direccionTextarea.addEventListener('input', updateCount);
                updateCount();
            }

            // NIT auto-formato
            const nitInput = document.getElementById('nitInput');
            if (nitInput) {
                nitInput.addEventListener('input', function () {
                    let value = this.value.replace(/[^0-9kK-]/g, '').toUpperCase();

                    if (value.length > 8 && !value.includes('-')) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }

                    this.value = value;
                });

                nitInput.addEventListener('blur', function () {
                    let value = this.value.replace(/[^0-9kK]/g, '').toUpperCase();
                    if (value.length >= 9) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }
                    this.value = value;
                });

                form.addEventListener('submit', function () {
                    let value = nitInput.value.replace(/[^0-9kK]/g, '').toUpperCase();
                    if (value.length >= 9) {
                        value = value.slice(0, 8) + '-' + value.slice(8);
                    }
                    nitInput.value = value;
                });
            }

            // Validación visual
            const inputs = document.querySelectorAll('#clienteForm input, #clienteForm textarea');
            inputs.forEach(input => {
                input.addEventListener('blur', function () {
                    this.classList.remove('is-valid', 'is-invalid');
                    if (this.checkValidity()) {
                        this.classList.add('is-valid');
                    } else if (this.value.trim() !== '') {
                        this.classList.add('is-invalid');
                    }
                });

                input.addEventListener('input', function () {
                    if (this.value.trim() !== '') {
                        this.classList.remove('is-invalid');
                    }
                });
            });

            // Confirmación antes de limpiar
            if (limpiarBtn) {
                limpiarBtn.addEventListener('click', function (e) {
                    const hasData = Array.from(inputs).some(i => i.value.trim() !== '');
                    if (hasData) {
                        if (!confirm('¿Estás seguro de que deseas limpiar todos los campos?')) {
                            e.preventDefault();
                            return;
                        }
                    }

                    // Limpia estados visuales
                    inputs.forEach(i => i.classList.remove('is-valid', 'is-invalid'));
                    if (contador) contador.textContent = '0';

                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                    }
                });
            }

            // Submit seguro
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();

                    inputs.forEach(input => {
                        input.classList.remove('is-valid', 'is-invalid');
                        if (!input.checkValidity()) {
                            input.classList.add('is-invalid');
                        }
                    });

                    return;
                }

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Procesando...';

                    setTimeout(() => {
                        if (submitBtn.disabled) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnText;
                        }
                    }, 10000);
                }
            });

            // Restaurar botón si la página viene con errores del servidor
            if (!@ViewData.ModelState.IsValid.ToString().ToLower()) {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                }
            }

            // Focus inicial
            const firstInput = document.querySelector('#clienteForm input[type="text"], #clienteForm input[name="Nit"]');
            if (firstInput) firstInput.focus();
        });

        // Función global opcional
        function restaurarBotonSubmit() {
            const submitBtn = document.getElementById('btnSubmit');
            if (submitBtn && submitBtn.disabled) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-person-plus me-1"></i>Crear Cliente';
            }
        }
    </script>
}

<style>
    :root {
        /* Paleta menta (alineada a la de usuarios) */
        --clients-primary: #062926;
        --clients-secondary: #12C6A1;
        --clients-accent: #5EF2C1;
        --clients-bg: #f5f6fa;
        --clients-card: #ffffff;
        --clients-text: #111827;
        --clients-muted: #6b7280;
        --clients-radius: 0.75rem;
        --clients-border-soft: #e5e7eb;
        --clients-danger: #b91c1c;
        --clients-warning: #ffc107;
    }

    /* Fondo claro y tipografía principal */
    .cliente-edit-theme {
        min-height: 100vh;
        background: var(--clients-bg);
        color: var(--clients-text);
    }

    /* Card principal en blanco */
    .cliente-edit-card {
        background: var(--clients-card);
        border-radius: var(--clients-radius);
        border: 1px solid var(--clients-border-soft);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    /* Header con gradiente menta */
    .cliente-edit-header {
        background: linear-gradient(90deg, var(--clients-primary), var(--clients-secondary));
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.18);
        color: #fff;
    }

    .cliente-edit-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--clients-accent);
        font-size: 1.4rem;
        box-shadow: none;
    }

    .cliente-edit-subtitle {
        color: rgba(241, 245, 249, 0.9);
        font-size: 0.82rem;
    }

    .label-estado {
        font-size: 0.72rem;
        color: rgba(241, 245, 249, 0.9);
    }

    .badge-estado {
        padding: 0.2rem 0.65rem;
        font-size: 0.72rem;
        border-radius: 999px;
        border: 1px solid transparent;
    }

    .badge-estado-activo {
        background: #ecfdf5;
        color: #064e3b;
        border-color: #bbf7d0;
    }

    /* Secciones */
    .seccion-form {
        padding: 1rem 0.2rem 0.2rem;
        border-bottom: 1px solid var(--clients-border-soft);
    }

    .seccion-titulo {
        font-size: 0.95rem;
        color: var(--clients-text);
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: .4rem;
        margin-bottom: 0.6rem;
        padding-bottom: 0.55rem;
        border-bottom: 2px solid rgba(18, 198, 161, 0.18);
        text-transform: none;
        letter-spacing: 0;
    }

    /* Labels */
    .form-label-client {
        font-size: 0.9rem;
        color: #374151;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

        .form-label-client i {
            color: var(--clients-secondary);
        }

    /* Inputs claros tipo usuarios */
    .form-control-client,
    .clients-input {
        background: #ffffff;
        border-radius: var(--clients-radius);
        border: 1px solid #d1d5db;
        color: var(--clients-text);
        font-size: 0.94rem;
        padding: 0.55rem 0.85rem;
        transition: all 0.25s ease;
    }

        .form-control-client::placeholder,
        .clients-input::placeholder,
        textarea.form-control-client::placeholder {
            color: #9ca3af;
            opacity: 1;
        }

        .form-control-client:focus,
        .clients-input:focus,
        textarea.form-control-client:focus {
            background: #ffffff;
            color: var(--clients-text);
            border-color: var(--clients-secondary);
            box-shadow: 0 0 0 0.16rem rgba(18, 198, 161, 0.15);
        }

    textarea.form-control-client {
        resize: vertical;
    }

    .form-text-client {
        color: var(--clients-muted);
        font-size: 0.78rem;
    }

    /* Footer */
    .cliente-edit-footer {
        border-top: 1px solid var(--clients-border-soft);
        margin-top: 0.3rem;
    }

    /* Botones */
    .btn-clientes-primary {
        background: var(--clients-secondary);
        color: #020814 !important;
        border: 1px solid var(--clients-secondary);
        border-radius: var(--clients-radius);
        padding: 0.48rem 1.3rem;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.18);
        transition: all 0.25s ease;
    }

        .btn-clientes-primary:hover {
            background: var(--clients-primary);
            border-color: var(--clients-primary);
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.22);
        }

    .btn-outline-clientes {
        border-radius: var(--clients-radius);
        border: 1px solid var(--clients-secondary);
        color: var(--clients-secondary) !important;
        padding: 0.45rem 1rem;
        font-weight: 600;
        background-color: transparent;
        font-size: 0.86rem;
        transition: all 0.25s ease;
    }

        .btn-outline-clientes:hover {
            background-color: rgba(18, 198, 161, 0.12);
            color: #064e3b !important;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
            transform: translateY(-1px);
        }

    .cliente-btn-reset {
        border-radius: var(--clients-radius);
        border: 1px solid rgba(255, 193, 7, 0.9);
        color: var(--clients-warning) !important;
        background-color: transparent;
        padding: 0.45rem 1rem;
        font-size: 0.84rem;
        font-weight: 600;
        transition: all 0.25s ease;
    }

        .cliente-btn-reset:hover {
            background-color: rgba(255, 193, 7, 0.14);
            color: #7a5a00 !important;
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.25);
            transform: translateY(-1px);
        }

    .cliente-btn-cancel {
        padding: 0.45rem 1rem;
    }

    .cliente-btn-submit {
        padding: 0.48rem 1.3rem;
    }

    /* Tarjeta info (clara) */
    .cliente-info-card {
        background: #ffffff;
        border-radius: var(--clients-radius);
        border: 1px solid var(--clients-border-soft);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
        color: var(--clients-text);
    }

        .cliente-info-card h6 {
            color: var(--clients-primary);
            font-weight: 700;
            font-size: 0.95rem;
        }

        .cliente-info-card ul li {
            color: var(--clients-muted);
            font-size: 0.85rem;
        }

        .cliente-info-card i {
            color: var(--clients-secondary);
        }

        .cliente-info-card strong {
            color: var(--clients-text);
        }

    /* Alertas */
    .alert-smart-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: var(--clients-danger);
        font-size: 0.86rem;
        border-radius: var(--clients-radius);
    }

    @@media (max-width: 768px) {
        .cliente-edit-card

    {
        margin-top: 0.5rem;
    }

    .cliente-edit-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    }
</style>
