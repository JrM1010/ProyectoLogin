@{
    ViewData["Title"] = "Ajuste de Inventario";
}

<div class="container-fluid py-4 ajustes-page">
    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center">
            <div class="ajustes-icon-main me-3">
                <i class="bi bi-sliders fs-3"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 fw-bold text-white">Ajuste Manual de Inventario</h1>
                <p class="mb-0 text-muted-small">
                    Busca un producto, aplica ajustes de entrada o salida y revisa el historial reciente.
                </p>
            </div>
        </div>

        <button type="button"
                class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 shadow-sm"
                id="btnLimpiarTodo">
            <i class="bi bi-arrow-clockwise"></i>
            Limpiar Todo
        </button>
    </div>

    <!-- TOAST NOTIFICACIONES -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="toastNotificacion" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <!-- CARD PRINCIPAL -->
    <div class="card ajustes-main-card shadow-sm border-0">
        <!-- ENCABEZADO CARD -->
        <div class="card-header ajustes-main-header border-0 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="ajustes-icon-soft">
                    <i class="bi bi-funnel"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-semibold text-white">Gestión de Ajustes</h5>
                    <small class="text-muted-small">
                        Localiza el producto, define el tipo de ajuste, la cantidad y el motivo.
                    </small>
                </div>
            </div>
        </div>

        <div class="card-body px-4 pb-4 pt-3">
            <!-- BUSCADOR DE PRODUCTO -->
            <div class="row mb-4">
                <div class="col-lg-8">
                    <div class="form-group position-relative">
                        <label for="buscarProducto" class="form-label fw-semibold text-label">
                            <i class="bi bi-search me-1"></i> Buscar producto
                        </label>
                        <div class="input-group input-group-dark">
                            <span class="input-group-text">
                                <i class="bi bi-upc-scan"></i>
                            </span>
                            <input type="text"
                                   class="form-control input-dark"
                                   id="buscarProducto"
                                   placeholder="Código de barras, nombre o referencia..."
                                   autocomplete="off" />
                            <button class="btn btn-primary-custom" type="button" id="btnBuscar">
                                <i class="bi bi-search me-1"></i>Buscar
                            </button>
                        </div>
                        <div class="form-text text-muted-small">
                            Escribe al menos 2 caracteres para ver sugerencias de productos.
                        </div>

                        <!-- LISTA SUGERENCIAS -->
                        <ul id="sugerenciasProductos"
                            class="list-group sugerencias-dropdown shadow-sm"
                            style="display:none;">
                        </ul>
                    </div>
                </div>
            </div>

            <!-- INFO PRODUCTO -->
            <div id="productoInfo" class="card producto-card border-0 mb-4" style="display:none;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle text-accent"></i>
                            <h6 class="mb-0 fw-semibold text-white">Información del producto</h6>
                        </div>
                        <span class="badge bg-success rounded-pill" id="infoEstado">Disponible</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label small text-label">Nombre</label>
                            <div class="fw-semibold text-white" id="infoNombre">-</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-label">Código</label>
                            <div class="fw-semibold text-muted-small" id="infoCodigo">-</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-label">Categoría</label>
                            <div class="fw-semibold text-muted-small" id="infoCategoria">-</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-label">Marca</label>
                            <div class="fw-semibold text-muted-small" id="infoMarca">-</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-label">Stock actual</label>
                            <div class="fw-bold fs-5 text-accent" id="infoStock">0</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FORMULARIO DE AJUSTE -->
            <div id="formAjuste" style="display:none;">
                <form id="formAjusteStock" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="idProducto" name="IdProducto" />

                    <div class="card ajuste-card border-0">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-pencil-square text-accent"></i>
                                <h6 class="mb-0 fw-semibold text-white">Detalles del ajuste</h6>
                            </div>

                            <div class="row g-3">
                                <!-- TIPO -->
                                <div class="col-md-3">
                                    <label for="tipoAjuste" class="form-label fw-semibold text-label">
                                        <i class="bi bi-arrow-left-right me-1"></i>Tipo de ajuste *
                                    </label>
                                    <select class="form-select input-dark" id="tipoAjuste" name="TipoAjuste" required>
                                        <option value="">Seleccionar...</option>
                                        <option value="entrada">Entrada (+)</option>
                                        <option value="salida">Salida (-)</option>
                                    </select>
                                    <div class="invalid-feedback">Selecciona el tipo de ajuste.</div>
                                </div>

                                <!-- CANTIDAD -->
                                <div class="col-md-3">
                                    <label for="cantidad" class="form-label fw-semibold text-label">
                                        <i class="bi bi-hash me-1"></i>Cantidad *
                                    </label>
                                    <div class="input-group">
                                        <button type="button" class="btn btn-outline-soft" id="btnMenos">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="number"
                                               class="form-control text-center input-dark"
                                               id="cantidad"
                                               name="Cantidad"
                                               min="1"
                                               value="1"
                                               required />
                                        <button type="button" class="btn btn-outline-soft" id="btnMas">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                    <div class="invalid-feedback">La cantidad debe ser mayor a 0.</div>
                                </div>

                                <!-- MOTIVO -->
                                <div class="col-md-6">
                                    <label for="motivo" class="form-label fw-semibold text-label">
                                        <i class="bi bi-chat-text me-1"></i>Motivo del ajuste *
                                    </label>
                                    <input type="text"
                                           class="form-control input-dark"
                                           id="motivo"
                                           name="Motivo"
                                           placeholder="Ej: Ajuste por conteo físico, devolución, merma, etc."
                                           required />
                                    <div class="invalid-feedback">Ingresa el motivo del ajuste.</div>
                                </div>
                            </div>

                            <!-- BOTONES -->
                            <div class="row mt-4">
                                <div class="col-12 d-flex flex-wrap gap-2">
                                    <button type="submit"
                                            class="btn btn-success-custom rounded-pill d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle"></i>
                                        Aplicar Ajuste
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-soft rounded-pill d-flex align-items-center gap-2"
                                            id="btnLimpiar">
                                        <i class="bi bi-broom"></i>
                                        Limpiar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- HISTORIAL AJUSTES -->
            <div id="historialAjustes" class="mt-4" style="display:none;">
                <div class="card historial-card border-0">
                    <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 pb-2">
                        <i class="bi bi-clock-history text-accent"></i>
                        <h6 class="mb-0 fw-semibold text-white">Últimos ajustes del producto</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0 ajustes-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th class="text-center">Cantidad</th>
                                        <th>Tipo</th>
                                        <th class="text-start">Referencia</th>
                                        <th class="text-start">Observación</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyHistorial"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div> <!-- /card-body -->
    </div> <!-- /card -->
</div>

@section Scripts {
    <script>
        (function () {
            // Variables globales
            let productoActual = null;
            let sugerenciaSeleccionada = -1;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // 🔹 Toast
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                const config = {
                    success: { bg: 'bg-success', icon: 'bi-check-circle' },
                    warning: { bg: 'bg-warning', icon: 'bi-exclamation-triangle' },
                    danger: { bg: 'bg-danger', icon: 'bi-x-circle' },
                    info: { bg: 'bg-info', icon: 'bi-info-circle' }
                };

                const { bg, icon } = config[tipo] || config.success;

                toast.className = `toast align-items-center text-white ${bg} border-0`;
                toastIcon.className = `bi ${icon} me-2`;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            // 🔹 Debounce para sugerencias
            function debounce(fn, ms) {
                let timeout;
                return (...args) => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => fn(...args), ms);
                };
            }

            async function buscarSugerencias(termino) {
                const lista = document.getElementById('sugerenciasProductos');

                if (termino.length < 2) {
                    lista.style.display = 'none';
                    return;
                }

                try {
                    const response = await fetch(`/Utilidades/SugerirProductos?term=${encodeURIComponent(termino)}`);
                    const data = await response.json();

                    lista.innerHTML = '';

                    if (data.success && data.productos && data.productos.length > 0) {
                        data.productos.forEach(producto => {
                            const li = document.createElement('li');
                            li.className = 'list-group-item list-group-item-action sugerencia-item';
                            li.innerHTML = `
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold text-white">${producto.nombre}</div>
                                        <small class="text-muted-small">${producto.codigo}</small>
                                    </div>
                                    <span class="badge bg-accent-soft">${producto.stock} en stock</span>
                                </div>
                            `;
                            li.addEventListener('click', () => {
                                document.getElementById('buscarProducto').value = producto.nombre;
                                lista.style.display = 'none';
                                buscarProductoPorId(producto.id);
                            });
                            lista.appendChild(li);
                        });
                        lista.style.display = 'block';
                        sugerenciaSeleccionada = -1;
                    } else {
                        lista.style.display = 'none';
                    }
                } catch (error) {
                    console.error('Error buscando sugerencias:', error);
                    lista.style.display = 'none';
                }
            }

            // 🔹 Navegación con teclado en sugerencias
            document.getElementById('buscarProducto').addEventListener('keydown', function (e) {
                const sugerencias = document.querySelectorAll('#sugerenciasProductos li');
                if (!sugerencias.length) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    sugerenciaSeleccionada = (sugerenciaSeleccionada + 1) % sugerencias.length;
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    sugerenciaSeleccionada = (sugerenciaSeleccionada - 1 + sugerencias.length) % sugerencias.length;
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (sugerenciaSeleccionada >= 0) {
                        sugerencias[sugerenciaSeleccionada].click();
                    } else {
                        buscarProducto();
                    }
                    return;
                } else {
                    return;
                }

                sugerencias.forEach((sug, index) => {
                    sug.classList.toggle('active', index === sugerenciaSeleccionada);
                });
            });

            // 🔹 Buscar producto manual
            async function buscarProducto() {
                const term = document.getElementById('buscarProducto').value.trim();
                if (!term) {
                    mostrarToast('Por favor ingrese un término de búsqueda', 'warning');
                    return;
                }

                try {
                    const response = await fetch(`/Utilidades/BuscarProducto?term=${encodeURIComponent(term)}`);
                    const data = await response.json();

                    if (data.success) {
                        mostrarProducto(data.producto);
                        productoActual = data.producto;
                    } else {
                        mostrarToast(data.message || 'Producto no encontrado', 'warning');
                        ocultarProducto();
                    }
                } catch (error) {
                    console.error('Error buscando producto:', error);
                    mostrarToast('Error al buscar el producto', 'danger');
                }
            }

            // 🔹 Buscar producto por ID (desde sugerencias)
            async function buscarProductoPorId(idProducto) {
                try {
                    const response = await fetch(`/Utilidades/BuscarProducto?term=${idProducto}`);
                    const data = await response.json();

                    if (data.success) {
                        mostrarProducto(data.producto);
                        productoActual = data.producto;
                    } else {
                        mostrarToast(data.message || 'Producto no encontrado', 'warning');
                        ocultarProducto();
                    }
                } catch (error) {
                    console.error('Error buscando producto por ID:', error);
                    mostrarToast('Error al obtener el producto', 'danger');
                }
            }

            // 🔹 Mostrar / ocultar producto
            function mostrarProducto(producto) {
                document.getElementById('infoNombre').textContent = producto.nombre;
                document.getElementById('infoCodigo').textContent = producto.codigoBarras || '-';
                document.getElementById('infoCategoria').textContent = producto.categoria || '-';
                document.getElementById('infoMarca').textContent = producto.marca || '-';
                document.getElementById('infoStock').textContent = producto.stockActual;
                document.getElementById('idProducto').value = producto.id;

                document.getElementById('productoInfo').style.display = 'block';
                document.getElementById('formAjuste').style.display = 'block';

                cargarHistorial(producto.id);
            }

            function ocultarProducto() {
                document.getElementById('productoInfo').style.display = 'none';
                document.getElementById('formAjuste').style.display = 'none';
                document.getElementById('historialAjustes').style.display = 'none';
                productoActual = null;
            }

            // 🔹 Controles cantidad
            document.getElementById('btnMas').addEventListener('click', () => {
                const input = document.getElementById('cantidad');
                let val = parseInt(input.value) || 0;
                input.value = val + 1;
            });

            document.getElementById('btnMenos').addEventListener('click', () => {
                const input = document.getElementById('cantidad');
                let val = parseInt(input.value) || 0;
                if (val > 1) {
                    input.value = val - 1;
                } else {
                    mostrarToast('La cantidad no puede ser menor que 1', 'warning');
                }
            });

            document.getElementById('cantidad').addEventListener('input', function () {
                let val = parseInt(this.value) || 0;
                if (val < 1) {
                    this.value = 1;
                    mostrarToast('La cantidad no puede ser menor que 1', 'warning');
                }
            });

            // 🔹 Aplicar ajuste
            document.getElementById('formAjusteStock').addEventListener('submit', async function (e) {
                e.preventDefault();

                if (!productoActual) {
                    mostrarToast('Primero debe buscar un producto', 'warning');
                    return;
                }

                const form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    mostrarToast('Por favor complete todos los campos requeridos', 'warning');
                    return;
                }

                const cantidad = parseInt(document.getElementById('cantidad').value);
                const tipoAjuste = document.getElementById('tipoAjuste').value;
                const motivo = document.getElementById('motivo').value.trim();

                if (tipoAjuste === 'salida' && cantidad > productoActual.stockActual) {
                    mostrarToast(`No puede retirar ${cantidad} unidades. Stock disponible: ${productoActual.stockActual}`, 'danger');
                    return;
                }

                const formData = {
                    IdProducto: document.getElementById('idProducto').value,
                    Cantidad: cantidad,
                    TipoAjuste: tipoAjuste,
                    Motivo: motivo
                };

                const btnSubmit = form.querySelector('button[type="submit"]');
                const originalText = btnSubmit.innerHTML;

                try {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Procesando...';

                    const response = await fetch('/Utilidades/AjustarStock', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(formData)
                    });

                    const data = await response.json();

                    if (data.success) {
                        mostrarToast(data.message, 'success');
                        productoActual.stockActual = data.nuevoStock;
                        document.getElementById('infoStock').textContent = data.nuevoStock;
                        limpiarFormulario();
                        buscarProductoPorId(formData.IdProducto); // recarga info + historial
                    } else {
                        mostrarToast(data.message, 'danger');
                    }
                } catch (error) {
                    console.error('Error aplicando ajuste:', error);
                    mostrarToast('Error al procesar el ajuste', 'danger');
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalText;
                }
            });

            // 🔹 Cargar historial
            async function cargarHistorial(idProducto) {
                try {
                    const response = await fetch(`/Utilidades/ObtenerHistorial?idProducto=${idProducto}`);
                    const data = await response.json();

                    const tbody = document.getElementById('tbodyHistorial');
                    tbody.innerHTML = '';

                    if (data.success && data.movimientos && data.movimientos.length > 0) {
                        data.movimientos.forEach(mov => {
                            const tipoClass = mov.tipo === 'Entrada' ? 'text-success' : 'text-danger';
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                <td>${mov.fecha}</td>
                                <td class="text-center">
                                    <span class="badge bg-dark-soft ${tipoClass} fw-semibold">${mov.cantidad}</span>
                                </td>
                                <td class="${tipoClass} fw-semibold">${mov.tipo}</td>
                                <td class="text-start text-muted-small">${mov.referencia || '-'}</td>
                                <td class="text-start text-muted-small">${mov.observacion || '-'}</td>
                            `;
                            tbody.appendChild(row);
                        });
                        document.getElementById('historialAjustes').style.display = 'block';
                    } else {
                        document.getElementById('historialAjustes').style.display = 'none';
                    }
                } catch (error) {
                    console.error('Error cargando historial:', error);
                    document.getElementById('historialAjustes').style.display = 'none';
                }
            }

            // 🔹 Limpiar formulario
            function limpiarFormulario() {
                document.getElementById('buscarProducto').value = '';
                document.getElementById('motivo').value = '';
                document.getElementById('tipoAjuste').value = '';
                document.getElementById('idProducto').value = '';
                document.getElementById('cantidad').value = '1';
                document.getElementById('sugerenciasProductos').style.display = 'none';

                const form = document.getElementById('formAjusteStock');
                form.classList.remove('was-validated');

                ocultarProducto();
            }

            // 🔹 Inicializar eventos
            function inicializar() {
                const searchInput = document.getElementById('buscarProducto');
                const debouncedBuscar = debounce(buscarSugerencias, 300);

                searchInput.addEventListener('input', e => debouncedBuscar(e.target.value));
                document.getElementById('btnBuscar').addEventListener('click', buscarProducto);

                searchInput.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        buscarProducto();
                    }
                });

                document.addEventListener('click', function (e) {
                    const lista = document.getElementById('sugerenciasProductos');
                    if (lista.style.display === 'block' &&
                        !lista.contains(e.target) &&
                        e.target !== searchInput) {
                        lista.style.display = 'none';
                    }
                });

                document.getElementById('btnLimpiar').addEventListener('click', limpiarFormulario);
                document.getElementById('btnLimpiarTodo').addEventListener('click', limpiarFormulario);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', inicializar);
            } else {
                inicializar();
            }
        })();
    </script>
}

@section Styles {
    <style>
        :root {
            --primary-blue: #3036A6;
            --secondary-blue: #5F6AF5;
            --accent-blue: #8F9CFF;
            --dark-bg: #161B3A;
            --alt-bg: #1F2650;
            --light-text: #F7F8FF;
            --muted-text: #C3C7F5;
            --border-soft: rgba(143, 156, 255, 0.32);
            --card-bg: #1E2546;
            --card-bg-soft: #242C54;
        }

        .ajustes-page {
            color: var(--light-text);
        }

        .text-muted-small {
            color: var(--muted-text) !important;
            font-size: 0.85rem;
        }

        .text-label {
            color: var(--muted-text);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .text-accent {
            color: var(--accent-blue) !important;
        }

        .ajustes-icon-main {
            width: 52px;
            height: 52px;
            border-radius: 999px;
            background: radial-gradient(circle at 20% 0, var(--secondary-blue), transparent), rgba(22, 27, 74, 0.98);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);
        }

        .ajustes-icon-soft {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            background: rgba(95, 106, 245, 0.18);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            font-size: 0.85rem;
        }

        .ajustes-main-card {
            background: linear-gradient(145deg, #181E40, #1E2546);
            border-radius: 1.1rem;
            border: 1px solid var(--border-soft);
        }

        .ajustes-main-header {
            padding: 1rem 1.5rem 0.4rem 1.5rem;
            background: transparent;
        }

        .producto-card,
        .ajuste-card,
        .historial-card {
            background-color: var(--card-bg);
            border-radius: 0.9rem;
            border: 1px solid rgba(143, 156, 255, 0.24);
        }

        .input-group-dark .input-group-text {
            background-color: #181E40;
            border-color: rgba(143, 156, 255, 0.35);
            color: var(--muted-text);
