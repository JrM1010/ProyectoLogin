@{
    ViewData["Title"] = "Ajuste de Inventario";
}

<div class="container-fluid clients-theme">
    <!-- HEADER (estilo copiado de Clientes) -->
    <div class="clients-header">
        <div class="clients-header-title">
            <div class="clients-header-icon">
                <i class="bi bi-sliders"></i>
            </div>
            <div>
                <h2>Ajuste Manual de Inventario</h2>
                <p>Busca un producto, aplica ajustes de entrada o salida y revisa el historial reciente</p>
            </div>
        </div>
        <div class="clients-header-actions d-flex gap-2">
            <button type="button"
                    class="btn btn-clients-outline"
                    id="btnLimpiarTodo" title="Limpiar todo">
                <i class="bi bi-arrow-clockwise"></i> Limpiar Todo
            </button>
        </div>
    </div>

    <!-- TOAST NOTIFICACIONES (sin cambios funcionales) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="toastNotificacion" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>

    <!-- BUSCADOR (tarjeta igual a Clientes) -->
    <div class="clients-search-card">
        <div class="row g-3 align-items-end">
            <div class="col-lg-8">
                <label for="buscarProducto" class="clients-search-label">Buscar producto</label>

                <!-- ⬇️ Wrapper relativo para anclar el dropdown -->
                <div class="clients-search-wrapper position-relative">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-upc-scan"></i>
                        </span>
                        <input type="text"
                               class="form-control clients-search-input"
                               id="buscarProducto"
                               placeholder="Código de barras, nombre o referencia..."
                               autocomplete="off" />
                        <button class="btn btn-clients-search" type="button" id="btnBuscar">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>

                    <!-- LISTA SUGERENCIAS (ids/clases intactos para el JS) -->
                    <ul id="sugerenciasProductos"
                        class="list-group sugerencias-dropdown shadow-sm"
                        role="listbox"
                        style="display:none;"></ul>
                </div>

                <small class="text-muted d-block mt-1">Escribe al menos 2 caracteres para ver sugerencias.</small>
            </div>
        </div>
    </div>

    <!-- INFO PRODUCTO -->
    <div id="productoInfo" class="clients-card mb-3" style="display:none;">
        <div class="clients-card-header active">
            <i class="bi bi-info-circle fs-5"></i>
            <h5 class="mb-0">Información del producto</h5>
            <span class="clients-header-badge ms-auto" id="infoEstado">Disponible</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="clients-search-label">Nombre</div>
                    <div class="fw-semibold" id="infoNombre">-</div>
                </div>
                <div class="col-md-2">
                    <div class="clients-search-label">Código</div>
                    <div class="text-muted fw-semibold" id="infoCodigo">-</div>
                </div>
                <div class="col-md-2">
                    <div class="clients-search-label">Categoría</div>
                    <div class="text-muted fw-semibold" id="infoCategoria">-</div>
                </div>
                <div class="col-md-2">
                    <div class="clients-search-label">Marca</div>
                    <div class="text-muted fw-semibold" id="infoMarca">-</div>
                </div>
                <div class="col-md-3">
                    <div class="clients-search-label">Stock actual</div>
                    <div class="fs-5 fw-bold text-success" id="infoStock">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FORMULARIO DE AJUSTE (estructura e IDs intactos) -->
    <div id="formAjuste" style="display:none;">
        <form id="formAjusteStock" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="idProducto" name="IdProducto" />

            <div class="clients-card">
                <div class="clients-card-header active">
                    <i class="bi bi-pencil-square fs-5"></i>
                    <h5 class="mb-0">Detalles del ajuste</h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <!-- TIPO -->
                        <div class="col-md-3">
                            <label for="tipoAjuste" class="clients-search-label">Tipo de ajuste *</label>
                            <select class="form-select clients-search-input" id="tipoAjuste" name="TipoAjuste" required>
                                <option value="">Seleccionar...</option>
                                <option value="entrada">Entrada (+)</option>
                                <option value="salida">Salida (-)</option>
                            </select>
                            <div class="invalid-feedback">Selecciona el tipo de ajuste.</div>
                        </div>

                        <!-- CANTIDAD -->
                        <div class="col-md-3">
                            <label for="cantidad" class="clients-search-label">Cantidad *</label>
                            <div class="input-group">
                                <button type="button" class="btn clients-action-btn" id="btnMenos" title="Quitar 1">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <input type="number"
                                       class="form-control text-center clients-search-input"
                                       id="cantidad"
                                       name="Cantidad"
                                       min="1"
                                       value="1"
                                       required />
                                <button type="button" class="btn clients-action-btn" id="btnMas" title="Agregar 1">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback">La cantidad debe ser mayor a 0.</div>
                        </div>

                        <!-- MOTIVO -->
                        <div class="col-md-6">
                            <label for="motivo" class="clients-search-label">Motivo del ajuste *</label>
                            <input type="text"
                                   class="form-control clients-search-input"
                                   id="motivo"
                                   name="Motivo"
                                   placeholder="Ej: Ajuste por conteo físico, devolución, merma, etc."
                                   required />
                            <div class="invalid-feedback">Ingresa el motivo del ajuste.</div>
                        </div>
                    </div>

                    <!-- BOTONES -->
                    <div class="row mt-4">
                        <div class="col-12 d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-clients-primary d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle"></i> Aplicar Ajuste
                            </button>
                            <button type="button" class="btn btn-clients-outline d-flex align-items-center gap-2" id="btnLimpiar">
                                <i class="bi bi-broom"></i> Limpiar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- HISTORIAL AJUSTES -->
    <div id="historialAjustes" class="mt-4" style="display:none;">
        <div class="clients-card">
            <div class="clients-card-header active">
                <i class="bi bi-clock-history fs-5"></i>
                <h5 class="mb-0">Últimos ajustes del producto</h5>
            </div>
            <div class="card-body p-0">
                <div class="clients-table-wrap">
                    <table class="clients-table ajustes-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Fecha</th>
                                <th class="text-center">Cantidad</th>
                                <th>Tipo</th>
                                <th class="text-start">Referencia</th>
                                <th class="text-start">Observación</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyHistorial"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Variables globales
            let productoActual = null;
            let sugerenciaSeleccionada = -1;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // 🔹 Toast
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                const config = {
                    success: { bg: 'bg-success', icon: 'bi-check-circle' },
                    warning: { bg: 'bg-warning', icon: 'bi-exclamation-triangle' },
                    danger: { bg: 'bg-danger', icon: 'bi-x-circle' },
                    info: { bg: 'bg-info', icon: 'bi-info-circle' }
                };

                const { bg, icon } = config[tipo] || config.success;

                toast.className = `toast align-items-center text-white ${bg} border-0`;
                toastIcon.className = `bi ${icon} me-2`;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            // 🔹 Debounce
            function debounce(fn, ms) {
                let timeout;
                return (...args) => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => fn(...args), ms);
                };
            }

            async function buscarSugerencias(termino) {
                const lista = document.getElementById('sugerenciasProductos');

                if (termino.length < 2) {
                    lista.style.display = 'none';
                    return;
                }

                try {
                    const response = await fetch(`/Utilidades/SugerirProductos?term=${encodeURIComponent(termino)}`);
                    const data = await response.json();

                    lista.innerHTML = '';

                    if (data.success && data.productos && data.productos.length > 0) {
                        data.productos.forEach(producto => {
                            const li = document.createElement('li');
                            li.className = 'list-group-item list-group-item-action sugerencia-item';
                            li.innerHTML = `
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">${producto.nombre}</div>
                                        <small class="text-muted">${producto.codigo}</small>
                                    </div>
                                    <span class="badge bg-accent-soft">${producto.stock} en stock</span>
                                </div>
                            `;
                            li.addEventListener('click', () => {
                                document.getElementById('buscarProducto').value = producto.nombre;
                                lista.style.display = 'none';
                                buscarProductoPorId(producto.id);
                            });
                            lista.appendChild(li);
                        });
                        lista.style.display = 'block';
                        sugerenciaSeleccionada = -1;
                    } else {
                        lista.style.display = 'none';
                    }
                } catch (error) {
                    console.error('Error buscando sugerencias:', error);
                    lista.style.display = 'none';
                }
            }

            // Teclado en sugerencias
            document.getElementById('buscarProducto').addEventListener('keydown', function (e) {
                const sugerencias = document.querySelectorAll('#sugerenciasProductos li');
                if (!sugerencias.length) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    sugerenciaSeleccionada = (sugerenciaSeleccionada + 1) % sugerencias.length;
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    sugerenciaSeleccionada = (sugerenciaSeleccionada - 1 + sugerencias.length) % sugerencias.length;
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (sugerenciaSeleccionada >= 0) {
                        sugerencias[sugerenciaSeleccionada].click();
                    } else {
                        buscarProducto();
                    }
                    return;
                } else {
                    return;
                }

                sugerencias.forEach((sug, index) => {
                    sug.classList.toggle('active', index === sugerenciaSeleccionada);
                });
            });

            // Buscar producto manual
            async function buscarProducto() {
                const term = document.getElementById('buscarProducto').value.trim();
                if (!term) {
                    mostrarToast('Por favor ingrese un término de búsqueda', 'warning');
                    return;
                }

                try {
                    const response = await fetch(`/Utilidades/BuscarProducto?term=${encodeURIComponent(term)}`);
                    const data = await response.json();

                    if (data.success) {
                        mostrarProducto(data.producto);
                        productoActual = data.producto;
                    } else {
                        mostrarToast(data.message || 'Producto no encontrado', 'warning');
                        ocultarProducto();
                    }
                } catch (error) {
                    console.error('Error buscando producto:', error);
                    mostrarToast('Error al buscar el producto', 'danger');
                }
            }

            // Buscar por ID (desde sugerencias)
            async function buscarProductoPorId(idProducto) {
                try {
                    const response = await fetch(`/Utilidades/BuscarProducto?term=${idProducto}`);
                    const data = await response.json();

                    if (data.success) {
                        mostrarProducto(data.producto);
                        productoActual = data.producto;
                    } else {
                        mostrarToast(data.message || 'Producto no encontrado', 'warning');
                        ocultarProducto();
                    }
                } catch (error) {
                    console.error('Error buscando producto por ID:', error);
                    mostrarToast('Error al obtener el producto', 'danger');
                }
            }

            // Mostrar / ocultar producto
            function mostrarProducto(producto) {
                document.getElementById('infoNombre').textContent = producto.nombre;
                document.getElementById('infoCodigo').textContent = producto.codigoBarras || '-';
                document.getElementById('infoCategoria').textContent = producto.categoria || '-';
                document.getElementById('infoMarca').textContent = producto.marca || '-';
                document.getElementById('infoStock').textContent = producto.stockActual;
                document.getElementById('idProducto').value = producto.id;

                document.getElementById('productoInfo').style.display = 'block';
                document.getElementById('formAjuste').style.display = 'block';

                cargarHistorial(producto.id);
            }

            function ocultarProducto() {
                document.getElementById('productoInfo').style.display = 'none';
                document.getElementById('formAjuste').style.display = 'none';
                document.getElementById('historialAjustes').style.display = 'none';
                productoActual = null;
            }

            // Controles cantidad
            document.getElementById('btnMas').addEventListener('click', () => {
                const input = document.getElementById('cantidad');
                let val = parseInt(input.value) || 0;
                input.value = val + 1;
            });

            document.getElementById('btnMenos').addEventListener('click', () => {
                const input = document.getElementById('cantidad');
                let val = parseInt(input.value) || 0;
                if (val > 1) {
                    input.value = val - 1;
                } else {
                    mostrarToast('La cantidad no puede ser menor que 1', 'warning');
                }
            });

            document.getElementById('cantidad').addEventListener('input', function () {
                let val = parseInt(this.value) || 0;
                if (val < 1) {
                    this.value = 1;
                    mostrarToast('La cantidad no puede ser menor que 1', 'warning');
                }
            });

            // Aplicar ajuste
            document.getElementById('formAjusteStock').addEventListener('submit', async function (e) {
                e.preventDefault();

                if (!productoActual) {
                    mostrarToast('Primero debe buscar un producto', 'warning');
                    return;
                }

                const form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    mostrarToast('Por favor complete todos los campos requeridos', 'warning');
                    return;
                }

                const cantidad = parseInt(document.getElementById('cantidad').value);
                const tipoAjuste = document.getElementById('tipoAjuste').value;
                const motivo = document.getElementById('motivo').value.trim();

                if (tipoAjuste === 'salida' && cantidad > productoActual.stockActual) {
                    mostrarToast(`No puede retirar ${cantidad} unidades. Stock disponible: ${productoActual.stockActual}`, 'danger');
                    return;
                }

                const formData = {
                    IdProducto: document.getElementById('idProducto').value,
                    Cantidad: cantidad,
                    TipoAjuste: tipoAjuste,
                    Motivo: motivo
                };

                const btnSubmit = form.querySelector('button[type="submit"]');
                const originalText = btnSubmit.innerHTML;

                try {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Procesando...';

                    const response = await fetch('/Utilidades/AjustarStock', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(formData)
                    });

                    const data = await response.json();

                    if (data.success) {
                        mostrarToast(data.message, 'success');
                        productoActual.stockActual = data.nuevoStock;
                        document.getElementById('infoStock').textContent = data.nuevoStock;
                        limpiarFormulario();
                        buscarProductoPorId(formData.IdProducto); // recarga info + historial
                    } else {
                        mostrarToast(data.message, 'danger');
                    }
                } catch (error) {
                    console.error('Error aplicando ajuste:', error);
                    mostrarToast('Error al procesar el ajuste', 'danger');
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalText;
                }
            });

            // Cargar historial
            async function cargarHistorial(idProducto) {
                try {
                    const response = await fetch(`/Utilidades/ObtenerHistorial?idProducto=${idProducto}`);
                    const data = await response.json();

                    const tbody = document.getElementById('tbodyHistorial');
                    tbody.innerHTML = '';

                    if (data.success && data.movimientos && data.movimientos.length > 0) {
                        data.movimientos.forEach(mov => {
                            const tipoClass = mov.tipo === 'Entrada' ? 'text-success' : 'text-danger';
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                <td class="ps-3">${mov.fecha}</td>
                                <td class="text-center">
                                    <span class="badge badge-soft ${tipoClass} fw-semibold">${mov.cantidad}</span>
                                </td>
                                <td class="fw-semibold ${tipoClass}">${mov.tipo}</td>
                                <td class="text-start text-muted">${mov.referencia || '-'}</td>
                                <td class="text-start text-muted">${mov.observacion || '-'}</td>
                            `;
                            tbody.appendChild(row);
                        });
                        document.getElementById('historialAjustes').style.display = 'block';
                    } else {
                        document.getElementById('historialAjustes').style.display = 'none';
                    }
                } catch (error) {
                    console.error('Error cargando historial:', error);
                    document.getElementById('historialAjustes').style.display = 'none';
                }
            }

            // Limpiar formulario
            function limpiarFormulario() {
                document.getElementById('buscarProducto').value = '';
                document.getElementById('motivo').value = '';
                document.getElementById('tipoAjuste').value = '';
                document.getElementById('idProducto').value = '';
                document.getElementById('cantidad').value = '1';
                document.getElementById('sugerenciasProductos').style.display = 'none';

                const form = document.getElementById('formAjusteStock');
                form.classList.remove('was-validated');

                ocultarProducto();
            }

            // Inicializar
            function inicializar() {
                const searchInput = document.getElementById('buscarProducto');
                const debouncedBuscar = debounce(buscarSugerencias, 300);

                searchInput.addEventListener('input', e => debouncedBuscar(e.target.value));
                document.getElementById('btnBuscar').addEventListener('click', buscarProducto);

                searchInput.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        buscarProducto();
                    }
                });

                document.addEventListener('click', function (e) {
                    const lista = document.getElementById('sugerenciasProductos');
                    if (lista.style.display === 'block' &&
                        !lista.contains(e.target) &&
                        e.target !== searchInput) {
                        lista.style.display = 'none';
                    }
                });

                document.getElementById('btnLimpiar').addEventListener('click', limpiarFormulario);
                document.getElementById('btnLimpiarTodo').addEventListener('click', limpiarFormulario);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', inicializar);
            } else {
                inicializar();
            }
        })();
    </script>
}

@section Styles {
    <style>
        :root {
            /* Paleta tomada del Index de Clientes */
            --clients-primary: #062926;
            --clients-secondary: #12C6A1;
            --clients-accent: #5EF2C1;
            --clients-bg: #f5f6fa;
            --clients-card: #ffffff;
            --clients-text: #111827;
            --clients-muted: #6b7280;
            --clients-radius: .75rem;
            --clients-border-soft: #e5e7eb;
        }

        /* CONTENEDOR GENERAL */
        .clients-theme {
            background: var(--clients-bg);
            padding: 1.5rem 0 2rem;
            color: var(--clients-text);
        }

        /* HEADER */
        .clients-header {
            background: linear-gradient(90deg,var(--clients-primary),var(--clients-secondary));
            border-radius: var(--clients-radius);
            border: 1px solid rgba(255,255,255,.16);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1rem;
            box-shadow: 0 6px 18px rgba(15,23,42,.18);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #fff;
        }

        .clients-header-title { display: flex; align-items: center; gap: .7rem; }

        .clients-header-icon {
            width: 40px; height: 40px; border-radius: 50%;
            background: rgba(0,0,0,.22);
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 1.4rem; color: var(--clients-accent);
        }

        .clients-header h2 { margin: 0; font-size: 1.25rem; font-weight: 700; letter-spacing: .02em; color: #fff; }
        .clients-header p { margin: .1rem 0 0; font-size: .85rem; color: rgba(241,245,249,.9); }

        .btn-clients-outline{
            border:1px solid var(--clients-accent);
            background:transparent; color:#fff; border-radius:var(--clients-radius);
            font-weight:500; display:inline-flex; align-items:center; gap:.35rem;
            transition:all .25s ease; text-decoration:none; padding:.5rem 1rem;
        }
        .btn-clients-outline:hover{
            background:rgba(94,242,193,.16); color:#fff;
            box-shadow:0 4px 10px rgba(15,23,42,.25); transform:translateY(-1px);
        }

        .btn-clients-primary{
            background:#0ea5a0; color:#020814; border:none; border-radius:var(--clients-radius);
            font-weight:700; display:inline-flex; align-items:center; gap:.35rem;
            transition:all .25s ease; text-decoration:none; padding:.55rem 1.15rem;
        }
        .btn-clients-primary:hover{
            background:#12C6A1; color:#020814;
            box-shadow:0 4px 12px rgba(15,23,42,.25); transform:translateY(-1px);
        }

        /* BUSCADOR */
        .clients-search-card{
            background:var(--clients-card);
            border:1px solid var(--clients-border-soft);
            border-radius:var(--clients-radius);
            padding:1rem 1.1rem; margin-bottom:1.1rem;
            box-shadow:0 2px 8px rgba(15,23,42,.04);
        }
        .clients-search-label{ font-size:.82rem; color:var(--clients-muted); margin-bottom:.15rem; display:block; }
        .clients-search-input{
            background:#fff; border-radius:var(--clients-radius);
            border:1px solid var(--clients-border-soft);
            color:var(--clients-text); padding:.6rem .85rem; min-width:240px; font-size:.88rem;
            transition:all .22s ease;
        }
        .clients-search-input::placeholder{ color:#9ca3af; }
        .clients-search-input:focus{
            outline:none; border-color:var(--clients-secondary);
            box-shadow:0 0 0 .16rem rgba(18,198,161,.18); background:#fff;
        }
        .btn-clients-search{
            border-radius:var(--clients-radius); padding:.6rem 1.15rem; font-size:.85rem;
            background:var(--clients-secondary); border:1px solid var(--clients-secondary);
            color:#020814; display:inline-flex; align-items:center; gap:.35rem; transition:.25s;
        }
        .btn-clients-search:hover{
            background:var(--clients-primary); border-color:var(--clients-primary); color:#fff;
            box-shadow:0 4px 10px rgba(15,23,42,.18); transform:translateY(-1px);
        }

        /* ⬇️ Nuevo: wrapper relativo para anclar el dropdown al input */
        .clients-search-wrapper{ position: relative; display: block; }

        /* TARJETAS */
        .clients-card{
            background:var(--clients-card);
            border:1px solid var(--clients-border-soft);
            border-radius:var(--clients-radius);
            overflow:hidden; margin-bottom:1.1rem;
            box-shadow:0 4px 14px rgba(15,23,42,.06);
            transition:all .22s ease;
        }
        .clients-card:hover{ box-shadow:0 7px 20px rgba(15,23,42,.10); transform:translateY(-1px); }

        .clients-card-header{
            display:flex; align-items:center; gap:.65rem;
            padding:.85rem 1.15rem; border-bottom:1px solid rgba(15,23,42,.06);
            color:#fff; background:linear-gradient(90deg,var(--clients-primary),var(--clients-secondary));
        }
        .clients-card-header h5{ margin:0; font-size:.98rem; font-weight:700; color:#fff; }
        .clients-card-header i{ font-size:1.1rem; color:#bbf7d0; }

        .clients-header-badge{
            margin-left:auto; padding:.22rem .75rem; border-radius:999px; font-size:.72rem; font-weight:600;
            display:inline-flex; align-items:center; gap:.25rem;
            background:rgba(15,23,42,.12); border:1px solid rgba(226,232,240,.5); color:#f9fafb;
        }

        /* TABLAS */
        .clients-table-wrap{ width:100%; overflow-x:auto; }
        .clients-table{
            width:100%; border-collapse:collapse; margin-bottom:0;
            font-size:.85rem; color:var(--clients-text); background:transparent;
        }
        .clients-table thead th{
            background:#e5f9f3; font-weight:600; font-size:.78rem;
            border-bottom:1px solid var(--clients-border-soft); white-space:nowrap;
            text-transform:uppercase; letter-spacing:.03em; color:var(--clients-muted);
            padding:.7rem .9rem;
        }
        .clients-table tbody td{
            padding:.7rem .9rem; border-bottom:1px solid var(--clients-border-soft);
            vertical-align:middle; color:var(--clients-text);
        }
        .clients-table tbody tr:nth-child(even){ background:#f9fafb; }
        .clients-table tbody tr:hover{ background:#ecfdf5; }

        /* Chips / badges */
        .badge-soft{
            padding:.22rem .7rem; border-radius:999px; font-size:.72rem; font-weight:600;
            border:1px solid var(--clients-secondary); background:#ecfdf5; color:var(--clients-primary);
        }
        .badge.bg-accent-soft{ background:#ecfdf5; color:var(--clients-primary); border:1px solid var(--clients-secondary); }

        /* ⬇️ Dropdown de sugerencias: ahora anclado al wrapper (debajo del input) */
        .sugerencias-dropdown{
            position:absolute;
            top: calc(100% + 6px);     /* pequeño espacio bajo el input */
            left:0;
            right:0;                   /* ocupa el ancho del wrapper */
            width:auto;                /* evita desbordes por padding */
            max-height:260px;
            overflow-y:auto;
            z-index:2000;
            background:#fff;
            border:1px solid var(--clients-border-soft);
            border-radius:.65rem;
        }
        .sugerencia-item{ background:#fff; color:var(--clients-text); }
        .sugerencia-item:hover, .sugerencia-item.active{ background:#ecfdf5; }

        /* Botón +/- reutiliza estilo compacto de acciones clientes */
        .clients-action-btn{
            width:2.2rem; height:2.2rem; border-radius:.7rem; border:1px solid var(--clients-border-soft);
            background:#f3f4f6; color:var(--clients-muted);
            display:inline-flex; align-items:center; justify-content:center; transition:.2s;
        }
        .clients-action-btn:hover{ background:#ecfdf5; color:#0f766e; transform:translateY(-1px); }

        /* Toast transición */
        .toast{ animation: slideInDown .3s ease-out; }
        @@keyframes slideInDown{
            from{ transform: translate3d(0,-100%,0); opacity:0; }
            to{ transform: translate3d(0,0,0); opacity:1; }
        }

        @@media (max-width:768px){
            .clients-header{ flex-direction:column; align-items:flex-start; padding:.9rem 1rem; }
            .clients-header h2{ font-size:1.1rem; }
            .clients-header p{ font-size:.8rem; }
            .clients-header-actions{ width:100%; display:flex; flex-wrap:wrap; gap:.45rem; }
            .clients-header-actions .btn{ flex:1 1 auto; justify-content:center; }
            .clients-search-card{ padding:.8rem .9rem; }
            .clients-search-input{ width:100%; min-width:0; }
            .clients-card-header{ padding:.75rem .9rem; }
        }


        /* --- Override específico para el botón "Limpiar" del formulario --- */
        #btnLimpiar {
            background: #ecfdf5; /* fondo menta suave */
            color: var(--clients-primary); /* texto oscuro menta */
            border: 1px solid var(--clients-secondary); /* borde acorde a la paleta */
        }

            #btnLimpiar:hover {
                background: var(--clients-secondary); /* menta vibrante al hover */
                color: #020814; /* contraste de texto */
                border-color: var(--clients-secondary);
                box-shadow: 0 4px 10px rgba(18,198,161,.30);
            }

    </style>
}
