@{
    ViewData["Title"] = "Inicio del Sistema";
    string usuario = ViewData["nombreUsuario"]?.ToString();
}

<div class="container mt-5 text-center">
    <h2 class="text-primary mb-4">Bienvenido, @usuario</h2>
    <p class="text-muted">Selecciona un módulo para comenzar:</p>

    <div class="row justify-content-center g-4">
        <div class="col-md-3">
            <a asp-action="Gestion" class="btn btn-outline-primary btn-lg w-100 shadow-sm">
                <i class="bi bi-gear"></i> Gestión
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="Movimientos" class="btn btn-outline-success btn-lg w-100 shadow-sm">
                <i class="bi bi-arrows-repeat"></i> Movimientos
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-info btn-lg w-100 shadow-sm">
                <i class="bi bi-bar-chart"></i> Reportes
            </a>
        </div>
    </div>

    <div class="mt-5">
        <form asp-action="CerrarSesion" method="post">
            <button type="submit" class="btn btn-danger btn-sm shadow-sm">
                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
            </button>
        </form>
    </div>
</div>
