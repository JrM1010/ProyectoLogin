@{
    ViewData["Title"] = "Panel Principal";
    var ventas = ViewData["UltimasVentas"] as List<ProyectoLogin.Models.ModelosVentas.Venta>;
    var compras = ViewData["UltimasCompras"] as List<ProyectoLogin.Models.ModelosCompras.Compra>;
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">
        <i class="bi bi-speedometer2"></i> Bienvenido, @ViewData["NombreUsuario"]
    </h2>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body text-center">
                    <h5><i class="bi bi-box-seam"></i> Productos</h5>
                    <h2>@ViewData["TotalProductos"]</h2>
                    <p class="small mb-0">Registrados</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white">
                <div class="card-body text-center">
                    <h5><i class="bi bi-people"></i> Clientes</h5>
                    <h2>@ViewData["TotalClientes"]</h2>
                    <p class="small mb-0">Activos</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning text-white">
                <div class="card-body text-center">
                    <h5><i class="bi bi-person-badge"></i> Empleados</h5>
                    <h2>@ViewData["TotalUsuarios"]</h2>
                    <p class="small mb-0">Registrados</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-info text-white">
                <div class="card-body text-center">
                    <h5><i class="bi bi-building"></i> Proveedores</h5>
                    <h2>@ViewData["TotalProveedores"]</h2>
                    <p class="small mb-0">Activos</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-cart-check"></i> Últimas 5 Ventas
                </div>
                <div class="card-body">
                    @if (ventas != null && ventas.Any())
                    {
                        <table class="table table-sm table-striped align-middle">
                            <thead class="table-primary">
                                <tr>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in ventas)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrEmpty(v.Cliente?.Nombres) ? "C/F" : v.Cliente.Nombres)</td>
                                        <td>@v.FechaVenta.ToString("dd/MM/yyyy")</td>
                                        <td>Q@(v.Total.ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No hay ventas recientes.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-basket"></i> Últimas 5 Compras
                </div>
                <div class="card-body">
                    @if (compras != null && compras.Any())
                    {
                        <table class="table table-sm table-striped align-middle">
                            <thead class="table-success">
                                <tr>
                                    <th>Proveedor</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in compras)
                                {
                                    <tr>
                                        <td>@c.Proveedor?.Nombre</td>
                                        <td>@c.FechaCompra.ToString("dd/MM/yyyy")</td>
                                        <td>Q@(c.Total.ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No hay compras recientes.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
