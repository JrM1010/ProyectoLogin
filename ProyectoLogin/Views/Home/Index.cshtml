@{
    ViewData["Title"] = "Panel Principal";
    var ventas = ViewData["UltimasVentas"] as List<ProyectoLogin.Models.ModelosVentas.Venta>;
    var compras = ViewData["UltimasCompras"] as List<ProyectoLogin.Models.ModelosCompras.Compra>;
}

<style>
    :root {
        --dash-primary: #1C1973;
        --dash-secondary: #514BF2;
        --dash-accent: #8B88F2;
        --dash-bg: #F7F8FF;
        --dash-surface: #ffffff;
        --dash-text: #1F2335;
        --dash-muted: #6b7280;
        --dash-border: #E5E7EB;
        --dash-success: #23d19c;
        --dash-warning: #f6c23e;
        --dash-danger: #ff6b6b;
    }

    body {
        background: var(--dash-bg);
    }

    /* Header */
    .dash-title {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-weight: 700;
        color: var(--dash-primary);
    }

    .dash-sub {
        color: var(--dash-muted);
        font-size: .95rem;
    }

    /* KPI cards */
    .kpi-card {
        border: 0;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--dash-secondary), var(--dash-accent));
        color: #fff;
        box-shadow: 0 12px 30px rgba(81,75,242,.25);
        transition: transform .15s ease, box-shadow .15s ease;
        position: relative;
        overflow: hidden;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(81,75,242,.32);
        }

        .kpi-card .kpi-body {
            padding: 1.15rem 1.1rem;
            text-align: center;
        }

    .kpi-icon {
        width: 42px;
        height: 42px;
        display: inline-grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(255,255,255,.16);
        margin-bottom: .35rem;
        font-size: 1.2rem;
    }

    .kpi-title {
        font-size: .95rem;
        font-weight: 600;
        opacity: .95;
    }

    .kpi-number {
        font-size: 1.9rem;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: .2px;
    }

    .kpi-note {
        font-size: .8rem;
        opacity: .9;
    }

    /* Variantes sutiles por tarjeta */
    .kpi-green {
        background: linear-gradient(135deg, #1aa37a, #49d5ae);
    }

    .kpi-amber {
        background: linear-gradient(135deg, #f59e0b, #f6c23e);
    }

    .kpi-cyan {
        background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    }

    /* Cards con tablas */
    .card.soft {
        border: 1px solid var(--dash-border);
        border-radius: 14px;
        overflow: hidden;
        background: var(--dash-surface);
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
    }

    .card-header.gradient-primary {
        background: linear-gradient(90deg, var(--dash-secondary), var(--dash-accent));
        color: #fff;
        font-weight: 700;
        border: 0;
    }

    .card-header.gradient-success {
        background: linear-gradient(90deg, #1aa37a, #49d5ae);
        color: #fff;
        font-weight: 700;
        border: 0;
    }

    .card-body {
        padding: .9rem 1rem;
    }

    /* Tablas */
    .table thead th {
        background: #f3f4f6;
        color: #334155;
        font-weight: 700;
        font-size: .85rem;
        border-bottom: 1px solid var(--dash-border);
    }

    .table td {
        vertical-align: middle;
        font-size: .92rem;
    }

    .table tbody tr:hover {
        background: #f9fafb;
    }

    .col-total {
        text-align: right;
        font-weight: 700;
        color: #16a34a;
    }

    /* Empty state */
    .empty {
        display: flex;
        align-items: center;
        gap: .6rem;
        color: var(--dash-muted);
        font-size: .95rem;
        background: #f9fafb;
        border: 1px dashed var(--dash-border);
        padding: .8rem 1rem;
        border-radius: 10px;
    }

    /* Separador sutil */
    .divider {
        height: 1px;
        background: var(--dash-border);
        margin: 1.2rem 0;
        opacity: .8;
    }
</style>

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-3">
        <div>
            <h2 class="dash-title">
                <i class="bi bi-speedometer2"></i> Bienvenido, @ViewData["NombreUsuario"]
            </h2>
            <div class="dash-sub">Resumen general del sistema</div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card kpi-card">
                <div class="kpi-body">
                    <div class="kpi-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="kpi-title">Productos</div>
                    <div class="kpi-number">@ViewData["TotalProductos"]</div>
                    <div class="kpi-note">Registrados</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card kpi-card kpi-green">
                <div class="kpi-body">
                    <div class="kpi-icon"><i class="bi bi-people"></i></div>
                    <div class="kpi-title">Clientes</div>
                    <div class="kpi-number">@ViewData["TotalClientes"]</div>
                    <div class="kpi-note">Activos</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card kpi-card kpi-amber">
                <div class="kpi-body">
                    <div class="kpi-icon"><i class="bi bi-person-badge"></i></div>
                    <div class="kpi-title">Empleados</div>
                    <div class="kpi-number">@ViewData["TotalUsuarios"]</div>
                    <div class="kpi-note">Registrados</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card kpi-card kpi-cyan">
                <div class="kpi-body">
                    <div class="kpi-icon"><i class="bi bi-building"></i></div>
                    <div class="kpi-title">Proveedores</div>
                    <div class="kpi-number">@ViewData["TotalProveedores"]</div>
                    <div class="kpi-note">Activos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="divider"></div>

    <!-- Listas: Últimas ventas / compras -->
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card soft">
                <div class="card-header gradient-primary">
                    <i class="bi bi-cart-check me-1"></i> Últimas 5 Ventas
                </div>
                <div class="card-body">
                    @if (ventas != null && ventas.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Fecha</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in ventas)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrEmpty(v.Cliente?.Nombres) ? "C/F" : v.Cliente.Nombres)</td>
                                            <td>@v.FechaVenta.ToString("dd/MM/yyyy")</td>
                                            <td class="col-total">Q@v.Total.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty"><i class="bi bi-info-circle"></i> No hay ventas recientes.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card soft">
                <div class="card-header gradient-success">
                    <i class="bi bi-basket me-1"></i> Últimas 5 Compras
                </div>
                <div class="card-body">
                    @if (compras != null && compras.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Proveedor</th>
                                        <th>Fecha</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in compras)
                                    {
                                        <tr>
                                            <td>@c.Proveedor?.Nombre</td>
                                            <td>@c.FechaCompra.ToString("dd/MM/yyyy")</td>
                                            <td class="col-total">Q@c.Total.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty"><i class="bi bi-info-circle"></i> No hay compras recientes.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
