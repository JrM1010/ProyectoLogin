@model ProyectoLogin.Models.ModelosCompras.Compra
@{
    ViewData["Title"] = "Registrar Compra";
    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var unidades = ViewBag.Unidades as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedorSeleccionado = ViewBag.ProveedorSeleccionado as int?;
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">🛒 Registrar Compra</h2>
        <p class="text-muted">Complete la información del proveedor y los productos adquiridos.</p>
    </div>

    <!-- 🔹 Selección de proveedor -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <label for="proveedorSelect" class="form-label fw-semibold">Proveedor</label>
            <select id="proveedorSelect" name="idProveedor" class="form-select">
                <option value="">-- Seleccione proveedor --</option>
                @foreach (var p in proveedores)
                {
                    <option value="@p.IdProveedor" selected="@(proveedorSeleccionado == p.IdProveedor ? "selected" : null)">
                        @p.Nombre
                    </option>
                }
            </select>
        </div>
    </div>

    <!-- 🔹 Formulario principal -->
    <form asp-action="Create" method="post" onsubmit="return bloquearBotonGuardar(this)">
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdProveedor" id="IdProveedorHidden" value="@(proveedorSeleccionado ?? 0)" />

        <!-- 🔹 Mostrar código de compra -->
        @if (ViewBag.NumeroDocumento != null)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <label class="form-label fw-semibold">Código de compra</label>
                    <input type="text" name="NumeroDocumento" value="@ViewBag.NumeroDocumento" class="form-control bg-light" readonly />
                </div>
            </div>
        }

        <!-- 🔸 Tabla de detalles -->
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Detalles de la compra</h5>
                <button type="button" id="btnAgregar" class="btn btn-light btn-sm fw-semibold">
                    + Agregar producto
                </button>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0" id="tablaDetalles">
                        <thead class="table-light text-center">
                            <tr>
                                <th>Producto</th>
                                <th>Unidad</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario (Q)</th>
                                <th>Precio Venta (Q)</th>
                                <th>Descuento (%)</th>
                                <th>Subtotal (Q)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="detallesBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Template oculto -->
            <template id="filaTemplate">
                <tr>
                    <td>
                        <select class="form-select productoSelect" required>
                            <option value="">--Seleccione--</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-select unidadSelect" required>
                            <option value="">--Seleccione--</option>
                        </select>
                    </td>
                    <td><input type="number" class="form-control cantidadInput" min="1" step="1" value="1" required /></td>
                    <td><input type="number" step="0.01" class="form-control precioInput" required /></td>
                    <td><input type="text" class="form-control precioVentaInput text-end bg-light" readonly /></td>
                    <td>
                        <input type="text" class="form-control descuentoDisplay text-end bg-light" readonly />
                        <input type="hidden" class="descuentoHidden" />
                    </td>
                    <td><input type="text" class="form-control subtotalInput text-end bg-light" readonly /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm btnQuitar" title="Quitar producto">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            </template>
        </div>

        <!-- 🔸 Totales -->
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-5 col-lg-4">
                        <div class="mb-3">
                            <label for="subtotal" class="form-label fw-semibold">Subtotal</label>
                            <input type="text" id="subtotal" name="Subtotal" class="form-control text-end bg-light" readonly />
                        </div>
                        <div class="mb-3">
                            <label for="iva" class="form-label fw-semibold">IVA (12%)</label>
                            <input type="text" id="iva" name="IVA" class="form-control text-end bg-light" readonly />
                        </div>
                        <div>
                            <label for="total" class="form-label fw-bold">Total</label>
                            <input type="text" id="total" name="Total" class="form-control text-end fw-bold fs-5 text-success bg-light" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🔸 Botones -->
        <div class="text-end mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary me-2 px-4">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-success px-4">
                <i class="bi bi-save"></i> Guardar Compra
            </button>
        </div>
    </form>
</div>




<script id="__dataJson__" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new {
        Productos = productos,
                Unidades = unidades
        }))
</script>



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            // ---- Datos serializados desde el servidor ----
            let productos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(productos));
            let unidadesGlobales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unidades));
            const paqueteGlobal = unidadesGlobales.find(u => (u.Nombre || "").toString().toLowerCase() === "paquete");
            const paqueteExists = !!paqueteGlobal;

            // ---- Helpers ----
            const getTablaBody = () => document.getElementById("detallesBody");
            const getFilaTemplate = () => document.getElementById("filaTemplate");
            const getProveedorSelect = () => document.getElementById("proveedorSelect");

            // ---- Funciones ----
            function crearFila(index) {
                const filaTemplate = getFilaTemplate();
                const clone = filaTemplate.content.cloneNode(true);
                const productoSelect = clone.querySelector(".productoSelect");

                productos.forEach(p => {
                    const opt = document.createElement("option");
                    opt.value = p.IdProducto;
                    opt.textContent = p.Nombre;
                    productoSelect.appendChild(opt);
                });

                clone.querySelectorAll("input, select").forEach(el => {
                    if (el.classList.contains("productoSelect")) el.name = `detalles[${index}].IdProducto`;
                    if (el.classList.contains("unidadSelect")) el.name = `detalles[${index}].IdUnidad`;
                    if (el.classList.contains("cantidadInput")) el.name = `detalles[${index}].Cantidad`;
                    if (el.classList.contains("precioInput")) el.name = `detalles[${index}].PrecioUnitario`;
                    if (el.classList.contains("precioVentaInput")) el.name = `detalles[${index}].PrecioVenta`;
                    if (el.classList.contains("descuentoHidden")) el.name = `detalles[${index}].Descuento`;
                });

                return clone;
            }

            function reindexar() {
                const tablaBody = getTablaBody();
                if (!tablaBody) return;
                tablaBody.querySelectorAll("tr").forEach((fila, i) => {
                    fila.querySelectorAll("input, select").forEach(el => {
                        if (el.name) el.name = el.name.replace(/detalles\[\d+\]/, `detalles[${i}]`);
                    });
                });
            }

            function formatear(valor) {
                return valor.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function recalcularTotales() {
                const tablaBody = getTablaBody();
                if (!tablaBody) return;
                const margen = 0.25;
                let subtotal = 0;

                tablaBody.querySelectorAll("tr").forEach(fila => {
                    const precio = parseFloat(fila.querySelector(".precioInput")?.value) || 0;
                    const cantidad = parseFloat(fila.querySelector(".cantidadInput")?.value) || 0;
                    const unidadOption = fila.querySelector(".unidadSelect")?.selectedOptions[0];
                    const factor = parseFloat(unidadOption?.dataset.factor) || 1;
                    const unidadTexto = unidadOption?.textContent?.toLowerCase() || "";
                    let descuentoPct = 0;
                    if (unidadTexto.includes("caja")) descuentoPct = 10;
                    if (unidadTexto.includes("paquete")) descuentoPct = 5;

                    const precioConDescuento = precio * factor * (1 - (descuentoPct / 100));
                    const subtotalFila = cantidad * precioConDescuento;
                    const precioVenta = precioConDescuento * (1 + margen);

                    fila.querySelector(".descuentoDisplay").value = descuentoPct.toFixed(0) + "%";
                    fila.querySelector(".descuentoHidden").value = (descuentoPct / 100).toFixed(2);
                    fila.querySelector(".precioVentaInput").value = formatear(precioVenta);
                    fila.querySelector(".subtotalInput").value = formatear(subtotalFila);

                    subtotal += subtotalFila;
                });

                const iva = subtotal * 0.12;
                const total = subtotal + iva;

                document.getElementById("subtotal").value = formatear(subtotal);
                document.getElementById("iva").value = formatear(iva);
                document.getElementById("total").value = formatear(total);
            }

            // ---- 1) Agregar fila ----
            document.addEventListener("click", (e) => {
                const btn = e.target.closest("#btnAgregar, .btn-add-product");
                if (!btn) return;
                e.preventDefault();

                const tablaBody = getTablaBody();
                if (!tablaBody) return;

                const index = tablaBody.querySelectorAll("tr").length;
                const nuevo = crearFila(index);
                tablaBody.appendChild(nuevo);

                const ultimaFila = tablaBody.lastElementChild;
                ultimaFila.querySelector(".productoSelect")?.focus();
            });

            // ---- 2) Quitar fila ----
            document.addEventListener("click", (e) => {
                const btnQuitar = e.target.closest(".btnQuitar");
                if (!btnQuitar) return;
                e.preventDefault();
                btnQuitar.closest("tr").remove();
                reindexar();
                recalcularTotales();
            });

            // ---- 3) Producto -> cargar unidades ----
            document.addEventListener("change", (e) => {
                const sel = e.target;
                if (!sel.classList.contains("productoSelect")) return;

                const productoId = parseInt(sel.value);
                const producto = productos.find(p => p.IdProducto === productoId);
                const unidadSelect = sel.closest("tr").querySelector(".unidadSelect");
                unidadSelect.innerHTML = '<option value="">--Seleccione--</option>';

                const unidades = (producto?.Unidades?.length) ? producto.Unidades : unidadesGlobales;
                unidades.forEach(u => {
                    const opt = document.createElement("option");
                    const factor = (u.FactorConversion ?? u.EquivalenciaEnUnidades ?? 1);
                    opt.value = u.IdUnidad ?? "";
                    opt.textContent = `${u.Nombre}${factor > 1 ? ` (x${factor})` : ""}`;
                    opt.dataset.factor = factor;
                    unidadSelect.appendChild(opt);
                });

                if (!paqueteExists) {
                    const opt = document.createElement("option");
                    opt.value = "__PAQUETE_MISSING__";
                    opt.textContent = "Paquete (x6)";
                    opt.dataset.factor = 6;
                    unidadSelect.appendChild(opt);
                }
            });

            // ---- 4) Recalcular ----
            document.addEventListener("input", (e) => {
                if (e.target.classList.contains("cantidadInput")) {
                    e.target.value = Math.floor(e.target.value);
                }
                if (["precioInput", "cantidadInput"].some(c => e.target.classList.contains(c))) {
                    recalcularTotales();
                }
            });

            document.addEventListener("change", (e) => {
                if (e.target.classList.contains("unidadSelect")) {
                    recalcularTotales();
                }
            });

            // ---- 5) Validación submit ----
            document.querySelector("form[asp-action='Create']")?.addEventListener("submit", (e) => {
                const tablaBody = getTablaBody();
                if (!tablaBody) return;

                tablaBody.querySelectorAll("tr").forEach(fila => {
                    const idProd = fila.querySelector(".productoSelect")?.value;
                    const cantidad = parseFloat(fila.querySelector(".cantidadInput")?.value) || 0;
                    const precio = parseFloat(fila.querySelector(".precioInput")?.value) || 0;
                    if (!idProd || cantidad <= 0 || precio <= 0) fila.remove();
                });

                reindexar();

                if (tablaBody.children.length === 0) {
                    e.preventDefault();
                    alert("Debe agregar al menos un producto válido antes de guardar la compra.");
                    return;
                }
            });

            // ---- 6) Evitar doble envío ----
            window.bloquearBotonGuardar = function(form) {
                const boton = form.querySelector("button[type='submit']");
                if (boton) {
                    boton.disabled = true;
                    boton.innerText = "Guardando...";
                }
                return true;
            };

            // ---- 7) AJAX select proveedor (recarga dinámica sin refrescar la vista completa) ----
            document.addEventListener("change", async (e) => {
                const sel = e.target;
                if (!sel.matches("#proveedorSelect")) return;

                const id = sel.value;
                if (!id) return;

                sel.disabled = true;
                sel.classList.add("opacity-50");

                try {
                    const url = `/Compras/Create?idProveedor=${id}`;
                    const response = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                    if (!response.ok) throw new Error("Error al cargar datos del proveedor");

                    const html = await response.text();
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, "text/html");

                    // Reemplazamos solo el contenido dentro del .container
                    const nuevaContainer = doc.querySelector(".container");
                    if (nuevaContainer) {
                        document.querySelector(".container").innerHTML = nuevaContainer.innerHTML;
                    }

                    // Extraer datos JSON embebidos en la nueva respuesta
                    const scriptJSON = doc.querySelector("#__dataJson__");
                    if (scriptJSON) {
                        const data = JSON.parse(scriptJSON.textContent);
                        productos = data.Productos || [];
                        unidadesGlobales = data.Unidades || [];
                    }

                } catch (err) {
                    console.error("Error al actualizar el proveedor:", err);
                    alert("Error al actualizar los productos del proveedor seleccionado.");
                } finally {
                    sel.disabled = false;
                    sel.classList.remove("opacity-50");
                }
            });

        });
    </script>
}

