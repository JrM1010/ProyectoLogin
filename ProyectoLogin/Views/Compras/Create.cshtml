@model ProyectoLogin.Models.ModelosCompras.Compra
@{
    ViewData["Title"] = "Registrar Compra";

    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var unidades = ViewBag.Unidades as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic> ?? new List<dynamic>();
    int proveedorSeleccionado = ViewBag.ProveedorSeleccionado is int v ? v : 0;
}

@section Styles {
    <style>
        :root {
            --c-primary: #3036A6;
            --c-primary-light: #5F6AF5;
            --c-primary-soft: #8F9CFF;
            --c-dark-1: #161B3A;
            --c-dark-2: #1F2650;
            --c-dark-3: #1E2546;
            --c-dark-4: #242C54;
            --c-bg-soft: #F7F8FF;
            --c-border-soft: #3C4AA5;
            --c-accent-success: #23d19c;
            --c-accent-warning: #f6c23e;
            --c-accent-danger: #ff6b6b;
            --c-text-main: #F7F8FF;
            --c-text-muted: #C3C7F5;
            --c-radius: 0.75rem;
            --c-shadow-soft: 0 10px 25px rgba(0, 0, 0, 0.35);
        }

        .compras-wrapper {
            max-width: 1200px;
        }

        .compras-header {
            padding: 1.75rem 2rem 1.25rem;
            border-radius: var(--c-radius);
            background: radial-gradient(circle at top left, rgba(95, 106, 245, 0.12), transparent), radial-gradient(circle at top right, rgba(35, 209, 156, 0.06), transparent), var(--c-dark-2);
            border: 1px solid rgba(143, 156, 255, 0.25);
            box-shadow: var(--c-shadow-soft);
        }

            .compras-header h2 {
                color: var(--c-primary-soft);
                margin-bottom: 0.25rem;
            }

            .compras-header p {
                color: var(--c-text-muted);
                margin-bottom: 0;
            }

        .card-compras {
            background: linear-gradient(to bottom, rgba(36,44,84,.98), rgba(22,27,58,.98));
            border-radius: var(--c-radius);
            border: 1px solid rgba(63,74,165,.45);
            box-shadow: var(--c-shadow-soft);
            color: var(--c-text-main);
        }

            .card-compras .form-label {
                color: var(--c-primary-soft);
                font-weight: 600;
            }

        .compras-select, .compras-input {
            background-color: var(--c-dark-3);
            border-color: var(--c-border-soft);
            color: var(--c-text-main);
            border-radius: .5rem;
        }

            .compras-select::placeholder, .compras-input::placeholder {
                color: rgba(195,199,245,.5);
            }

            .compras-select:focus, .compras-input:focus {
                background-color: var(--c-dark-3);
                color: var(--c-text-main);
                border-color: var(--c-primary-light);
                box-shadow: 0 0 0 .15rem rgba(95,106,245,.35);
            }

        .compras-help {
            color: var(--c-text-muted);
            font-size: .8rem;
        }

        #cardCodigoCompra {
            background: var(--c-dark-1);
            border-color: rgba(143,156,255,.35);
        }

            #cardCodigoCompra .form-label {
                color: var(--c-primary-soft);
            }

            #cardCodigoCompra input {
                background-color: var(--c-dark-3);
                color: var(--c-primary-soft);
                font-weight: 600;
                letter-spacing: .06em;
                text-align: center;
                border-color: rgba(143,156,255,.4);
            }

        .table-compras thead {
            background: linear-gradient(to right, var(--c-dark-2), var(--c-dark-3));
            color: var(--c-primary-soft);
            border-bottom: 1px solid rgba(95,106,245,.5);
        }

            .table-compras thead th {
                font-weight: 600;
                font-size: .8rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                border: none;
            }

        .table-compras tbody tr {
            background-color: var(--c-dark-1);
            color: var(--c-text-main);
            transition: all .18s ease;
        }

            .table-compras tbody tr:nth-child(even) {
                background-color: var(--c-dark-3);
            }

            .table-compras tbody tr:hover {
                background-color: var(--c-dark-4);
                transform: translateY(-1px);
            }

        .table-compras td, .table-compras th {
            border-color: rgba(60,74,165,.28) !important;
        }

        .precioVentaSinIvaInput, .precioVentaConIvaInput {
            background-color: var(--c-dark-3) !important;
            color: var(--c-primary-soft) !important;
            border-color: rgba(95,106,245,.35) !important;
            font-size: .78rem;
        }

        .descuentoInput {
            border-color: rgba(246,194,62,.65);
        }

        .btn-add-product {
            border-radius: 999px;
        }

            .btn-add-product i {
                margin-right: .25rem;
            }

        .card-totales {
            background: radial-gradient(circle at top, rgba(95,106,245,.14), transparent), var(--c-dark-1);
            border-radius: var(--c-radius);
            border: 1px solid rgba(95,106,245,.35);
            box-shadow: var(--c-shadow-soft);
            color: var(--c-text-main);
        }

            .card-totales label {
                color: var(--c-primary-soft);
            }

        #subtotal, #iva {
            background-color: var(--c-dark-3);
            color: var(--c-text-main);
            border-color: rgba(143,156,255,.25);
        }

        #total {
            background-color: var(--c-dark-3);
            color: var(--c-accent-success);
            border-color: var(--c-accent-success);
            font-weight: 700;
        }

        .btn-outline-secondary {
            border-radius: 999px;
            border-color: rgba(143,156,255,.35);
            color: var(--c-primary-soft);
        }

            .btn-outline-secondary:hover {
                background-color: var(--c-dark-3);
                color: var(--c-primary-soft);
            }

        .btn-success {
            background: linear-gradient(to right, var(--c-accent-success), #20b887);
            border: none;
            border-radius: 999px;
            font-weight: 600;
            box-shadow: 0 6px 16px rgba(35,209,156,.35);
            color: #0b132b;
        }

            .btn-success:hover {
                background: linear-gradient(to right, #20b887, var(--c-accent-success));
                box-shadow: 0 8px 20px rgba(35,209,156,.45);
                transform: translateY(-1px);
            }

        .btn-outline-danger.btn-sm {
            border-radius: 999px;
            border-color: rgba(255,107,107,.65);
            color: var(--c-accent-danger);
        }

            .btn-outline-danger.btn-sm:hover {
                background-color: rgba(255,107,107,.12);
                color: var(--c-accent-danger);
            }

        .text-muted {
            color: var(--c-text-muted) !important;
        }

        @@media (max-width:768px) {
            .compras-header {
                padding: 1.25rem 1.25rem 1rem;
            }

            .card-compras, .card-totales {
                padding: 1rem;
            }

            .table-compras th, .table-compras td {
                font-size: .75rem;
                padding: .35rem .4rem;
            }
        }
    </style>

    <!-- ===== OVERRIDES CLAROS (misma estética que Index/Edición) ===== -->
    <style>
        :root {
            --c-primary: #062926; /* menta oscuro */
            --c-primary-light: #12C6A1; /* menta vibrante */
            --c-primary-soft: #5EF2C1; /* acento brillante */
            --c-dark-1: #ffffff; /* fondo tarjetas/tablas */
            --c-dark-2: #0A3A34; /* header gradiente inicio */
            --c-dark-3: #ffffff; /* inputs y celdas */
            --c-dark-4: #ecfdf5; /* hover suave */
            --c-bg-soft: #f5f6fa;
            --c-border-soft: #e5e7eb;
            --c-accent-success: #16a34a;
            --c-accent-warning: #eab308;
            --c-accent-danger: #ef4444;
            --c-text-main: #111827;
            --c-text-muted: #6b7280;
        }

        /* Header superior */
        .compras-header {
            background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
            color: #fff !important;
            border: 1px solid rgba(255,255,255,.18) !important;
            box-shadow: 0 6px 18px rgba(15,23,42,.18) !important;
        }

            .compras-header h2, .compras-header p {
                color: #fff !important;
            }

            .compras-header .text-primary {
                color: var(--c-primary-soft) !important;
            }

        /* Tarjeta base */
        .card-compras {
            background: #ffffff !important;
            border: 1px solid var(--c-border-soft) !important;
            color: var(--c-text-main) !important;
            box-shadow: 0 4px 14px rgba(15,23,42,.06) !important;
        }
            /* Encabezado de la tabla de detalles */
            .card-compras .card-header,
            .card-compras .card-header[style] {
                background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
                border-bottom: 1px solid rgba(255,255,255,.2) !important;
                color: #fff !important;
            }

            .card-compras .form-label {
                color: var(--c-primary-light) !important;
            }

        /* Selects/inputs */
        .compras-select, .compras-input {
            background: #fff !important;
            border: 1px solid var(--c-border-soft) !important;
            color: var(--c-text-main) !important;
        }

            .compras-select::placeholder, .compras-input::placeholder {
                color: #9ca3af !important;
            }

            .compras-select:focus, .compras-input:focus {
                border-color: var(--c-primary-light) !important;
                box-shadow: 0 0 0 .16rem rgba(18,198,161,.18) !important;
                background: #fff !important;
                color: var(--c-text-main) !important;
            }

        /* Código de compra */
        #cardCodigoCompra {
            background: #ffffff !important;
            border: 1px solid var(--c-border-soft) !important;
        }

            #cardCodigoCompra input {
                background: #fff !important;
                color: var(--c-primary) !important;
                border: 1px solid var(--c-border-soft) !important;
            }

        /* Tabla */
        .table-compras {
            color: var(--c-text-main) !important;
        }

            .table-compras thead {
                background: #e5f9f3 !important;
                color: var(--c-text-muted) !important;
                border-bottom: 1px solid var(--c-border-soft) !important;
            }

                .table-compras thead th {
                    color: var(--c-text-muted) !important;
                }

            .table-compras tbody tr {
                background: #ffffff !important;
            }

                .table-compras tbody tr:nth-child(even) {
                    background: #f9fafb !important;
                }

                .table-compras tbody tr:hover {
                    background: #ecfdf5 !important;
                }

            .table-compras td, .table-compras th {
                border-color: var(--c-border-soft) !important;
            }

        .precioVentaSinIvaInput, .precioVentaConIvaInput {
            background: #f0fdf9 !important;
            border-color: rgba(18,198,161,.35) !important;
            color: #065f46 !important;
        }

        .descuentoInput {
            border-color: #f59e0b !important;
        }

        /* Tarjeta totales */
        .card-totales {
            background: #ffffff !important;
            border: 1px solid var(--c-border-soft) !important;
            color: var(--c-text-main) !important;
            box-shadow: 0 4px 14px rgba(15,23,42,.06) !important;
        }

            .card-totales label {
                color: var(--c-primary-light) !important;
            }

        #subtotal, #iva, #total {
            background: #fff !important;
            color: var(--c-text-main) !important;
            border: 1px solid var(--c-border-soft) !important;
        }

        #subtotal, #iva {
            color: var(--c-primary-light) !important;
        }

        #total {
            color: var(--c-accent-success) !important;
            font-weight: 700 !important;
        }

        /* Botones */
        .btn-add-product {
            background: #fff !important;
            color: var(--c-primary) !important;
            border: 1px solid var(--c-border-soft) !important;
        }

            .btn-add-product:hover {
                background: #e5f9f3 !important;
                color: var(--c-primary-light) !important;
                border-color: var(--c-primary-light) !important;
                box-shadow: 0 3px 8px rgba(18,198,161,.25) !important;
            }

        .btn-outline-secondary {
            background: #fff !important;
            color: var(--c-primary) !important;
            border: 1px solid var(--c-border-soft) !important;
        }

            .btn-outline-secondary:hover {
                background: #ecfdf5 !important;
                color: var(--c-primary-light) !important;
                border-color: var(--c-primary-light) !important;
                box-shadow: 0 3px 8px rgba(18,198,161,.25) !important;
            }

        .btn-success {
            background: linear-gradient(90deg,var(--c-primary-light),var(--c-primary)) !important;
            color: #ffffff !important;
            box-shadow: 0 6px 16px rgba(18,198,161,.35) !important;
        }

            .btn-success:hover {
                background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
                box-shadow: 0 8px 20px rgba(18,198,161,.45) !important;
            }

        .btn-outline-danger.btn-sm {
            border-color: #ef4444 !important;
            color: #b91c1c !important;
            background: #fff !important;
        }

            .btn-outline-danger.btn-sm:hover {
                background: #fee2e2 !important;
                color: #991b1b !important;
                box-shadow: 0 3px 8px rgba(239,68,68,.25) !important;
            }
    </style>
}

<div class="container compras-wrapper mt-4">
    <!-- Header -->
    <div class="compras-header mb-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
            <h2 class="fw-bold">
                <i class="bi bi-basket2-fill me-2 text-primary"></i>
                Registrar Compra
            </h2>
            <p class="mb-0">Selecciona un proveedor con productos asociados y registra los detalles de la compra.</p>
        </div>
        <div class="text-md-end">
            <span class="badge rounded-pill bg-opacity-10"
                  style="background-color: rgba(95,106,245,.18); color: var(--c-primary-soft);">
                <i class="bi bi-shield-lock me-1"></i> Módulo de Compras
            </span>
        </div>
    </div>

    <!-- Contenedor de alertas -->
    <div id="alertContainer" class="mb-3">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
    </div>

    <!-- Selección de proveedor -->
    <div class="card card-compras mb-4">
        <div class="card-body">
            <label for="proveedorSelect" class="form-label">Proveedor</label>
            <select id="proveedorSelect" name="IdProveedor" class="form-select compras-select">
                <option value="">-- Seleccione proveedor --</option>
                @foreach (var p in proveedores)
                {
                    var seleccionado = proveedorSeleccionado == (int)p.IdProveedor;
                    if (seleccionado)
                    {
                        <option value="@p.IdProveedor" selected="selected">@p.Nombre</option>
                    }
                    else
                    {
                        <option value="@p.IdProveedor">@p.Nombre</option>
                    }
                }
            </select>
            <div class="d-flex align-items-center gap-2 mt-1">
                <i class="bi bi-info-circle text-primary"></i>
                <small class="compras-help">
                    Solo se muestran proveedores que ya tienen productos asociados a su catálogo.
                </small>
            </div>
        </div>
    </div>

    <!-- Formulario principal -->
    <form asp-action="Create" method="post" id="formCompra">
        @Html.AntiForgeryToken()

        <input type="hidden" name="IdProveedor" id="IdProveedorHidden" value="@(proveedorSeleccionado)" />

        @if (ViewBag.NumeroDocumento != null)
        {
            <div id="cardCodigoCompra" class="card card-compras mb-4">
                <div class="card-body">
                    <label class="form-label">Código de compra</label>
                    <input type="text"
                           name="NumeroDocumento"
                           value="@ViewBag.NumeroDocumento"
                           class="form-control compras-input text-center"
                           readonly />
                </div>
            </div>
        }

        <!-- Detalles -->
        <div class="card card-compras">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background: linear-gradient(to right, var(--c-dark-2), var(--c-dark-3)); border-bottom: 1px solid rgba(95,106,245,0.5);">
                <h5 class="mb-0" style="color: var(--c-primary-soft);">
                    <i class="bi bi-list-check me-2"></i> Detalles de la compra
                </h5>
                <button type="button" id="btnAgregar" class="btn btn-light btn-sm fw-semibold btn-add-product">
                    <i class="bi bi-plus-circle"></i> Agregar producto
                </button>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0 table-compras" id="tablaDetalles">
                        <thead class="text-center">
                            <tr>
                                <th>Producto</th>
                                <th>Unidad</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario (Q)</th>
                                <th>Descuento (%)</th>
                                <th>Precio Venta sin IVA (Q)</th>
                                <th>Precio Venta con IVA (Q)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="detallesBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Template fila -->
            <template id="filaTemplate">
                <tr>
                    <td>
                        <select class="form-select compras-select productoSelect" required>
                            <option value="">--Seleccione--</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-select compras-select unidadSelect" required>
                            <option value="">--Seleccione--</option>
                        </select>
                    </td>
                    <td>
                        <input type="number"
                               class="form-control compras-input cantidadInput"
                               min="1"
                               step="1"
                               value="1"
                               required />
                    </td>
                    <td>
                        <input type="number"
                               step="0.01"
                               class="form-control compras-input precioInput"
                               min="0.01"
                               required />
                    </td>
                    <td>
                        <input type="number"
                               class="form-control compras-input descuentoInput text-end"
                               min="0" max="100" step="1" value="0" />
                    </td>
                    <td>
                        <input type="text"
                               class="form-control precioVentaSinIvaInput text-end"
                               readonly />
                    </td>
                    <td>
                        <input type="text"
                               class="form-control precioVentaConIvaInput text-end"
                               readonly />
                    </td>
                    <td class="text-center">
                        <button type="button"
                                class="btn btn-outline-danger btn-sm btnQuitar"
                                title="Quitar producto">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            </template>
        </div>

        <!-- Totales -->
        <div class="card card-totales mt-4">
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-5 col-lg-4">
                        <div class="mb-3">
                            <label for="subtotal" class="form-label fw-semibold">Subtotal</label>
                            <input type="text"
                                   id="subtotal"
                                   name="Subtotal"
                                   class="form-control text-end"
                                   readonly />
                        </div>
                        <div class="mb-3">
                            <label for="iva" class="form-label fw-semibold">IVA (12%)</label>
                            <input type="text"
                                   id="iva"
                                   name="IVA"
                                   class="form-control text-end"
                                   readonly />
                        </div>
                        <div>
                            <label for="total" class="form-label fw-bold">Total</label>
                            <input type="text"
                                   id="total"
                                   name="Total"
                                   class="form-control text-end fw-bold fs-5"
                                   readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="text-end mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary me-2 px-4">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-success px-4" id="btnGuardar">
                <i class="bi bi-save"></i> Guardar Compra
            </button>
        </div>
    </form>
</div>

<script id="__dataJson__" type="application/json">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new
    {
            Productos = productos,
                Unidades = unidades
        }))
</script>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            let productos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(productos));
            let unidadesGlobales = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unidades));

            const alertContainer = document.getElementById("alertContainer");
            const getTablaBody = () => document.getElementById("detallesBody");
            const getFilaTemplate = () => document.getElementById("filaTemplate");
            const proveedorSelect = document.getElementById("proveedorSelect");
            const btnAgregar = document.getElementById("btnAgregar");
            const hiddenProveedor = document.getElementById("IdProveedorHidden");
            const form = document.getElementById("formCompra");
            const btnGuardar = document.getElementById("btnGuardar");

            function showAlert(message, type = "danger") {
                if (!alertContainer) {
                    window.alert(message);
                    return;
                }
                alertContainer.innerHTML = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>`;
                alertContainer.scrollIntoView({ behavior: "smooth", block: "start" });
            }

            function proveedorValidoSeleccionado() {
                return proveedorSelect && proveedorSelect.value;
            }

            function syncHiddenProveedor() {
                if (!hiddenProveedor || !proveedorSelect) return;
                hiddenProveedor.value = proveedorSelect.value || 0;
            }

            if (btnAgregar) {
                btnAgregar.disabled = !proveedorValidoSeleccionado() || productos.length === 0;
            }
            syncHiddenProveedor();

            function crearFila(index) {
                const filaTemplate = getFilaTemplate();
                const clone = filaTemplate.content.cloneNode(true);
                const productoSelect = clone.querySelector(".productoSelect");

                productos.forEach(p => {
                    const opt = document.createElement("option");
                    opt.value = p.IdProducto;
                    opt.textContent = p.Nombre;
                    productoSelect.appendChild(opt);
                });

                clone.querySelectorAll("input, select").forEach(el => {
                    if (el.classList.contains("productoSelect"))
                        el.name = `detalles[${index}].IdProducto`;
                    if (el.classList.contains("unidadSelect"))
                        el.name = `detalles[${index}].IdUnidad`;
                    if (el.classList.contains("cantidadInput"))
                        el.name = `detalles[${index}].Cantidad`;
                    if (el.classList.contains("precioInput"))
                        el.name = `detalles[${index}].PrecioUnitario`;
                    if (el.classList.contains("descuentoInput"))
                        el.name = `detalles[${index}].Descuento`;
                });

                return clone;
            }

            function reindexar() {
                const tablaBody = getTablaBody();
                if (!tablaBody) return;
                tablaBody.querySelectorAll("tr").forEach((fila, i) => {
                    fila.querySelectorAll("input, select").forEach(el => {
                        if (el.name) {
                            el.name = el.name.replace(/detalles\[\d+\]/, `detalles[${i}]`);
                        }
                    });
                });
            }

            function formatear(valor) {
                return valor.toLocaleString("es-GT", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function calcularPreciosVenta(fila) {
                const precio = parseFloat(fila.querySelector(".precioInput")?.value) || 0;
                const descuentoPct = parseFloat(fila.querySelector(".descuentoInput")?.value) || 0;
                const unidadSelect = fila.querySelector(".unidadSelect");
                const unidadOption = unidadSelect?.selectedOptions[0];
                const factor = parseFloat(unidadOption?.dataset.factor) || 1;

                let margenGanancia = 0.25;
                if (unidadOption) {
                    const unidadNombre = unidadOption.textContent.toLowerCase();
                    if (unidadNombre.includes("paquete")) margenGanancia = 0.15;
                    else if (unidadNombre.includes("caja")) margenGanancia = 0.10;
                }

                const descuentoClamped = Math.min(Math.max(descuentoPct, 0), 100);
                const precioConDescuento = precio * (1 - (descuentoClamped / 100));
                const precioBase = precioConDescuento / 1.12;
                const precioVentaSinIVA = (precioBase * factor) * (1 + margenGanancia);
                const precioVentaConIVA = precioVentaSinIVA * 1.12;

                fila.querySelector(".precioVentaSinIvaInput").value = formatear(precioVentaSinIVA);
                fila.querySelector(".precioVentaConIvaInput").value = formatear(precioVentaConIVA);
            }

            function recalcularTotales() {
                const tablaBody = getTablaBody();
                if (!tablaBody) return;

                let subtotal = 0;

                tablaBody.querySelectorAll("tr").forEach(fila => {
                    const precio = parseFloat(fila.querySelector(".precioInput")?.value) || 0;
                    const cantidad = parseFloat(fila.querySelector(".cantidadInput")?.value) || 0;
                    const unidadOption = fila.querySelector(".unidadSelect")?.selectedOptions[0];
                    const factor = parseFloat(unidadOption?.dataset.factor) || 1;

                    let descuentoPct = parseFloat(fila.querySelector(".descuentoInput")?.value) || 0;
                    descuentoPct = Math.min(Math.max(descuentoPct, 0), 100);

                    const precioConDescuento = precio * (1 - (descuentoPct / 100));
                    const precioBase = precioConDescuento / 1.12;

                    const subtotalFila = cantidad * precioBase * factor;
                    subtotal += subtotalFila;

                    calcularPreciosVenta(fila);
                });

                const iva = subtotal * 0.12;
                const total = subtotal + iva;

                document.getElementById("subtotal").value = formatear(subtotal);
                document.getElementById("iva").value = formatear(iva);
                document.getElementById("total").value = formatear(total);
            }

            // Agregar fila
            document.addEventListener("click", (e) => {
                const btn = e.target.closest("#btnAgregar, .btn-add-product");
                if (!btn) return;
                e.preventDefault();

                if (!proveedorValidoSeleccionado() || productos.length === 0) {
                    showAlert("Debes seleccionar un proveedor antes de agregar productos.", "warning");
                    return;
                }

                const tablaBody = getTablaBody();
                if (!tablaBody) return;

                const index = tablaBody.querySelectorAll("tr").length;
                const nuevo = crearFila(index);
                tablaBody.appendChild(nuevo);

                const ultimaFila = tablaBody.lastElementChild;
                ultimaFila.querySelector(".productoSelect")?.focus();
            });

            // Quitar fila
            document.addEventListener("click", (e) => {
                const btnQuitar = e.target.closest(".btnQuitar");
                if (!btnQuitar) return;
                e.preventDefault();
                btnQuitar.closest("tr").remove();
                reindexar();
                recalcularTotales();
            });

            // Cambios en selects
            document.addEventListener("change", (e) => {
                const sel = e.target;

                if (sel.classList.contains("productoSelect")) {
                    const productoId = parseInt(sel.value);
                    const producto = productos.find(p => p.IdProducto === productoId);
                    const unidadSelect = sel.closest("tr").querySelector(".unidadSelect");
                    unidadSelect.innerHTML = '<option value="">--Seleccione--</option>';

                    const unidades = (producto?.Unidades?.length)
                        ? producto.Unidades
                        : unidadesGlobales;

                    unidades.forEach(u => {
                        const opt = document.createElement("option");
                        const factor = u.EquivalenciaEnUnidades || u.FactorConversion || 1;
                        opt.value = u.IdUnidad ?? "";
                        opt.textContent = `${u.Nombre}${factor > 1 ? ` (x${factor})` : ""}`;
                        opt.dataset.factor = factor;
                        unidadSelect.appendChild(opt);
                    });

                    recalcularTotales();
                }

                if (sel.classList.contains("unidadSelect")) {
                    recalcularTotales();
                }
            });

            // Inputs: cantidad/precio/descuento
            document.addEventListener("input", (e) => {
                if (e.target.classList.contains("cantidadInput")) {
                    let val = parseInt(e.target.value) || 0;
                    if (val < 1) val = 1;
                    e.target.value = val;
                }

                if (e.target.classList.contains("descuentoInput")) {
                    let d = parseFloat(e.target.value) || 0;
                    if (d < 0) d = 0;
                    if (d > 100) d = 100;
                    e.target.value = d;
                }

                if (
                    e.target.classList.contains("precioInput") ||
                    e.target.classList.contains("cantidadInput") ||
                    e.target.classList.contains("descuentoInput")
                ) {
                    recalcularTotales();
                }
            });

            // Cambio de proveedor -> recarga server-side
            if (proveedorSelect) {
                proveedorSelect.addEventListener("change", (e) => {
                    const id = e.target.value;
                    const tablaBody = getTablaBody();
                    if (tablaBody) tablaBody.innerHTML = "";
                    recalcularTotales();

                    if (!id) {
                        if (hiddenProveedor) hiddenProveedor.value = 0;
                        if (btnAgregar) btnAgregar.disabled = true;
                        window.location.href = '/Compras/Create';
                        return;
                    }

                    if (hiddenProveedor) hiddenProveedor.value = id;
                    window.location.href = `/Compras/Create?idProveedor=${encodeURIComponent(id)}`;
                });
            }

            // Envío AJAX
            if (form) {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();

                    const tablaBody = getTablaBody();

                    if (!proveedorValidoSeleccionado()) {
                        showAlert("Debe seleccionar un proveedor antes de guardar la compra.", "warning");
                        return;
                    }

                    if (tablaBody) {
                        tablaBody.querySelectorAll("tr").forEach(fila => {
                            const idProd = fila.querySelector(".productoSelect")?.value;
                            const cantidad = parseFloat(fila.querySelector(".cantidadInput")?.value) || 0;
                            const precio = parseFloat(fila.querySelector(".precioInput")?.value) || 0;
                            if (!idProd || cantidad < 1 || precio <= 0) {
                                fila.remove();
                            }
                        });

                        reindexar();

                        if (tablaBody.children.length === 0) {
                            showAlert("Debe agregar al menos un producto válido antes de guardar la compra.", "warning");
                            return;
                        }
                    }

                    await enviarFormularioAjax(form);
                });
            }

            async function enviarFormularioAjax(form) {
                if (!form) return;

                const submitBtn = btnGuardar;
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Guardando...';
                }

                const formData = new FormData(form);

                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                        body: formData
                    });

                    const isJson = response.headers.get("content-type")?.includes("application/json");

                    if (!response.ok) {
                        let msg = "Error al registrar la compra. Intente nuevamente.";
                        if (isJson) {
                            const data = await response.json();
                            if (data?.message) msg = data.message;
                        }
                        showAlert(msg, "danger");
                    } else if (isJson) {
                        const data = await response.json();
                        if (data.success && data.redirectUrl) {
                            window.location.href = data.redirectUrl;
                            return;
                        }
                        if (!data.success) {
                            showAlert(data.message || "Error al registrar la compra.", "danger");
                        }
                    } else {
                        showAlert("Respuesta inesperada del servidor.", "danger");
                    }
                } catch (err) {
                    showAlert("Error de comunicación con el servidor. Intente nuevamente.", "danger");
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-save"></i> Guardar Compra';
                    }
                }
            }

            window.bloquearBotonGuardar = function () { return false; };
        });
    </script>
}
