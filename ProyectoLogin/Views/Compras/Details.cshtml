@model ProyectoLogin.Models.ModelosCompras.Compra
@{
    ViewData["Title"] = "Detalle de Compra";
}

<style>
    :root {
        --c-primary: #3036A6;
        --c-primary-light: #5F6AF5;
        --c-primary-soft: #8F9CFF;
        --c-dark-1: #161B3A;
        --c-dark-2: #1F2650;
        --c-dark-3: #1E2546;
        --c-dark-4: #242C54;
        --c-bg-soft: #F7F8FF;
        --c-border-soft: #3C4AA5;
        --c-accent-success: #23d19c;
        --c-accent-warning: #f6c23e;
        --c-accent-info: #36c9f4;
        --c-accent-danger: #ff6b6b;
        --c-text-main: #F7F8FF;
        --c-text-muted: #C3C7F5;
        --c-radius: 0.75rem;
        --c-shadow-soft: 0 10px 25px rgba(0, 0, 0, 0.35);
    }

    .compras-wrapper {
        max-width: 1200px;
    }

    .compras-header {
        padding: 1.75rem 2rem 1.25rem;
        border-radius: var(--c-radius);
        background: radial-gradient(circle at top left, rgba(95, 106, 245, 0.12), transparent), radial-gradient(circle at top right, rgba(35, 209, 156, 0.06), transparent), var(--c-dark-2);
        border: 1px solid rgba(143, 156, 255, 0.25);
        box-shadow: var(--c-shadow-soft);
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .compras-header h2 {
            color: var(--c-primary-soft);
            margin-bottom: 0.25rem;
        }

        .compras-header p {
            color: var(--c-text-muted);
            margin-bottom: 0;
        }

    .card-detalle {
        background: linear-gradient(to bottom, rgba(36, 44, 84, 0.98), rgba(22, 27, 58, 0.98));
        border-radius: var(--c-radius);
        border: 1px solid rgba(63, 74, 165, 0.45);
        box-shadow: var(--c-shadow-soft);
        color: var(--c-text-main);
    }

        .card-detalle .card-header {
            background: linear-gradient(to right, var(--c-dark-2), var(--c-dark-3));
            border-bottom: 1px solid rgba(95, 106, 245, 0.5);
            color: var(--c-primary-soft);
            border-radius: var(--c-radius) var(--c-radius) 0 0 !important;
        }

    .detalle-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--c-text-muted);
        margin-bottom: 0.1rem;
    }

    .detalle-valor {
        font-size: 0.95rem;
        color: var(--c-text-main);
        font-weight: 500;
    }

    .badge-estado {
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .estado-pendiente {
        background-color: rgba(246, 194, 62, 0.12);
        color: var(--c-accent-warning);
        border: 1px solid rgba(246, 194, 62, 0.4);
    }

    .estado-confirmada {
        background-color: rgba(54, 201, 244, 0.10);
        color: var(--c-accent-info);
        border: 1px solid rgba(54, 201, 244, 0.4);
    }

    .estado-completada {
        background-color: rgba(35, 209, 156, 0.10);
        color: var(--c-accent-success);
        border: 1px solid rgba(35, 209, 156, 0.4);
    }

    .table-detalle {
        margin-bottom: 0;
        font-size: 0.82rem;
        color: var(--c-text-main);
    }

        .table-detalle thead {
            background: linear-gradient(to right, var(--c-dark-2), var(--c-dark-3));
            color: var(--c-primary-soft);
            border-bottom: 1px solid rgba(95, 106, 245, 0.5);
        }

            .table-detalle thead th {
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                border: none;
                white-space: nowrap;
                font-size: 0.75rem;
            }

        .table-detalle tbody tr {
            background-color: var(--c-dark-1);
            transition: all 0.18s ease;
        }

            .table-detalle tbody tr:nth-child(even) {
                background-color: var(--c-dark-3);
            }

            .table-detalle tbody tr:hover {
                background-color: var(--c-dark-4);
                transform: translateY(-1px);
            }

        .table-detalle td, .table-detalle th {
            border-color: rgba(60, 74, 165, 0.25) !important;
            vertical-align: middle;
        }

    .text-muted-soft {
        color: var(--c-text-muted) !important;
    }

    .totales-box {
        margin-top: 1.5rem;
        padding: 1rem 1.25rem;
        border-radius: var(--c-radius);
        background: radial-gradient(circle at top right, rgba(95,106,245,0.16), transparent), rgba(16, 22, 54, 0.98);
        border: 1px solid rgba(95, 106, 245, 0.45);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35);
        color: var(--c-text-main);
    }

        .totales-box p {
            margin-bottom: 0.15rem;
            font-size: 0.9rem;
        }

        .totales-box strong {
            color: var(--c-primary-soft);
        }

        .totales-box .total-label {
            font-size: 1rem;
            color: var(--c-primary-soft);
        }

        .totales-box .total-valor {
            font-size: 1.1rem;
            color: var(--c-accent-success);
            font-weight: 700;
        }

    .btn-outline-light-soft {
        border-radius: 999px;
        border-color: rgba(143, 156, 255, 0.35);
        color: var(--c-primary-soft);
        background-color: transparent;
    }

        .btn-outline-light-soft:hover {
            background-color: var(--c-dark-3);
            color: var(--c-primary-soft);
        }

    @@media (max-width: 768px) {
        .compras-header {
            padding: 1.25rem 1.25rem 1rem;
        }

        .table-detalle th, .table-detalle td {
            font-size: 0.72rem;
            padding: 0.3rem 0.35rem;
        }
    }
</style>

<!-- ======= OVERRIDES “MENTA” (misma estética clara que en Compras Index / Clientes) ======= -->
<style>
    :root {
        --c-primary: #062926; /* menta oscuro */
        --c-primary-light: #12C6A1; /* menta vibrante */
        --c-primary-soft: #5EF2C1; /* acento brillante */
        --c-dark-1: #ffffff; /* fondos claros */
        --c-dark-2: #0A3A34; /* header grad inicio */
        --c-dark-3: #12C6A1; /* header grad fin */
        --c-dark-4: #ecfdf5; /* hover suave */
        --c-bg-soft: #f5f6fa;
        --c-border-soft: #e5e7eb;
        --c-accent-success: #16a34a;
        --c-accent-warning: #eab308;
        --c-accent-info: #06b6d4;
        --c-accent-danger: #ef4444;
        --c-text-main: #111827;
        --c-text-muted: #6b7280;
    }

    .text-primary-soft {
        color: var(--c-primary-light) !important;
    }

    /* HEADER */
    .compras-header {
        background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,.18) !important;
        box-shadow: 0 6px 18px rgba(15,23,42,.18) !important;
    }

        .compras-header h2, .compras-header p {
            color: #fff !important;
        }

        .compras-header .bi-receipt-cutoff {
            color: var(--c-primary-soft) !important;
        }

    /* CARD DETALLE */
    .card-detalle {
        background: #ffffff !important;
        border: 1px solid var(--c-border-soft) !important;
        color: var(--c-text-main) !important;
        box-shadow: 0 4px 14px rgba(15,23,42,.06) !important;
    }

        .card-detalle .card-header {
            background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
            color: #fff !important;
            border-bottom: 1px solid rgba(255,255,255,.2) !important;
        }

    /* TIPOGRAFÍA DETALLES */
    .detalle-label {
        color: var(--c-text-muted) !important;
    }

    .detalle-valor {
        color: var(--c-text-main) !important;
    }

    /* BADGES */
    .estado-pendiente {
        background: #fff7ed !important;
        color: #b45309 !important;
        border-color: #fcd34d !important;
    }

    .estado-confirmada {
        background: #e0f2fe !important;
        color: #0369a1 !important;
        border-color: #93c5fd !important;
    }

    .estado-completada {
        background: #dcfce7 !important;
        color: #166534 !important;
        border-color: #86efac !important;
    }

    /* TABLA */
    .table-detalle {
        color: var(--c-text-main) !important;
    }

        .table-detalle thead {
            background: #e5f9f3 !important;
            color: var(--c-text-muted) !important;
            border-bottom: 1px solid var(--c-border-soft) !important;
        }

            .table-detalle thead th {
                color: var(--c-text-muted) !important;
            }

        .table-detalle tbody tr {
            background: #ffffff !important;
        }

            .table-detalle tbody tr:nth-child(even) {
                background: #f9fafb !important;
            }

            .table-detalle tbody tr:hover {
                background: #ecfdf5 !important;
            }

        .table-detalle td, .table-detalle th {
            border-color: var(--c-border-soft) !important;
        }

    /* TOTALES */
    .totales-box {
        background: #ffffff !important;
        color: var(--c-text-main) !important;
        border: 1px solid var(--c-border-soft) !important;
        box-shadow: 0 4px 14px rgba(15,23,42,.06) !important;
    }

        .totales-box strong {
            color: var(--c-primary-light) !important;
        }

        .totales-box .total-valor {
            color: var(--c-accent-success) !important;
        }

    /* BOTÓN VOLVER */
    .btn-outline-light-soft {
        background: #fff !important;
        color: var(--c-primary) !important;
        border: 1px solid var(--c-border-soft) !important;
    }

        .btn-outline-light-soft:hover {
            background: #ecfdf5 !important;
            color: var(--c-primary-light) !important;
            border-color: var(--c-primary-light) !important;
            box-shadow: 0 3px 8px rgba(18,198,161,.25) !important;
        }

    /* HR */
    .border-secondary {
        border-color: var(--c-border-soft) !important;
    }
</style>

<div class="container compras-wrapper">
    <!-- Header -->
    <div class="compras-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt-cutoff me-2"></i> Detalle de Compra
            </h2>
            <p class="mb-0">Visualice la información completa de la compra, su proveedor y productos asociados.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a class="btn btn-outline-light-soft"
               href='@Url.Action("Index", "Compras", new { estado = Model.Estado })'>
                <i class="bi bi-arrow-left-circle me-1"></i> Volver al listado
            </a>

            @{
                var estadoClass = Model.Estado == "Pendiente"
                ? "estado-pendiente"
                : Model.Estado == "Confirmada"
                ? "estado-confirmada"
                : "estado-completada";
            }
            <span class="badge-estado @estadoClass">
                <i class="bi bi-circle-fill me-1" style="font-size: .55rem;"></i>
                @Model.Estado
            </span>
        </div>
    </div>

    <!-- Card Detalle -->
    <div class="card card-detalle mb-4">
        <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div class="mb-2 mb-md-0">
                <h5 class="mb-0">
                    <i class="bi bi-receipt me-2"></i>
                    Compra #@Model.IdCompra
                    <span class="text-primary-soft">| Doc: @Model.NumeroDocumento</span>
                </h5>
            </div>
            <div class="small text-muted-soft">
                <i class="bi bi-calendar3 me-1"></i>
                @Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="card-body">
            <!-- Info proveedor + compra -->
            <div class="row g-4 mb-3">
                <div class="col-md-6">
                    <div class="mb-2">
                        <div class="detalle-label"><i class="bi bi-building me-1"></i>Proveedor</div>
                        <div class="detalle-valor">@Model.Proveedor?.Nombre</div>
                    </div>
                    <div class="mb-2">
                        <div class="detalle-label"><i class="bi bi-telephone me-1"></i>Teléfono</div>
                        <div class="detalle-valor">@(string.IsNullOrWhiteSpace(Model.Proveedor?.Telefono) ? "—" : Model.Proveedor.Telefono)</div>
                    </div>
                    <div class="mb-2">
                        <div class="detalle-label"><i class="bi bi-envelope me-1"></i>Correo</div>
                        <div class="detalle-valor">@(string.IsNullOrWhiteSpace(Model.Proveedor?.Email) ? "—" : Model.Proveedor.Email)</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-2">
                        <div class="detalle-label"><i class="bi bi-receipt me-1"></i>Número de Documento</div>
                        <div class="detalle-valor">@Model.NumeroDocumento</div>
                    </div>
                    <div class="mb-2">
                        <div class="detalle-label"><i class="bi bi-flag me-1"></i>Estado</div>
                        <div>
                            <span class="badge-estado @estadoClass">
                                <i class="bi bi-circle-fill me-1" style="font-size: .55rem;"></i>
                                @Model.Estado
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Observaciones))
                    {
                        <div class="mt-2">
                            <div class="detalle-label"><i class="bi bi-chat-text me-1"></i>Observaciones</div>
                            <div class="detalle-valor">@Model.Observaciones</div>
                        </div>
                    }
                </div>
            </div>

            <hr class="border-secondary" />

            <!-- Productos -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0" style="color: var(--c-primary-light);">
                    <i class="bi bi-bag-check me-2"></i>Productos Comprados
                </h6>
                @if (Model.Detalles != null && Model.Detalles.Any())
                {
                    <span class="text-muted-soft small">@Model.Detalles.Count() ítem(s)</span>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-detalle align-middle">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Unidad</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Precio Unitario</th>
                            <th class="text-end">Descuento</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Detalles != null && Model.Detalles.Any())
                        {
                            foreach (var item in Model.Detalles)
                            {
                                <tr>
                                    <td class="text-muted-soft">
                                        @(!string.IsNullOrWhiteSpace(item.Producto?.CodigoBarras) ? item.Producto.CodigoBarras : "—")
                                    </td>
                                    <td>@item.Producto?.Nombre</td>
                                    <td>@item.UnidadMedida?.Nombre</td>
                                    <td class="text-end">@("Q" + item.Cantidad.ToString("N2"))</td>
                                    <td class="text-end">@("Q" + item.PrecioUnitario.ToString("N2"))</td>
                                    <td class="text-end">
                                        @(item.Descuento > 0 ? (item.Descuento * 100).ToString("N0") + "%" : "-")
                                    </td>
                                    <td class="text-end">@("Q" + item.Subtotal.ToString("N2"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted-soft py-3">
                                    <i class="bi bi-info-circle me-1"></i>
                                    No hay productos registrados en esta compra.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totales -->
            <div class="d-flex justify-content-end">
                <div class="totales-box">
                    <p class="mb-1">
                        <strong>Subtotal:</strong>
                        <span class="ms-1">@("Q" + Model.Subtotal.ToString("#,##0.00"))</span>
                    </p>
                    <p class="mb-1">
                        <strong>IVA (12%):</strong>
                        <span class="ms-1">@("Q" + Model.IVA.ToString("#,##0.00"))</span>
                    </p>
                    <div class="mt-1">
                        <span class="total-label me-1"><strong>Total:</strong></span>
                        <span class="total-valor">@("Q" + Model.Total.ToString("#,##0.00"))</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
