@model ProyectoLogin.Models.ModelosCompras.Compra

@{
    ViewData["Title"] = "Editar Compra";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Editar Compra - @Model.NumeroDocumento</h1>
        <a href="@Url.Action("Index", new { estado = "Pendiente" })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" id="compraForm">
                <input type="hidden" asp-for="IdCompra" />
                <input type="hidden" asp-for="NumeroDocumento" />
                <input type="hidden" asp-for="IdProveedor" />
                <input type="hidden" asp-for="Subtotal" id="inputSubtotal" />
                <input type="hidden" asp-for="IVA" id="inputIVA" />
                <input type="hidden" asp-for="Total" id="inputTotal" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Proveedor</label>
                        <input type="text" class="form-control" value="@Model.Proveedor?.Nombre" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">N° Documento</label>
                        <input type="text" class="form-control" value="@Model.NumeroDocumento" readonly />
                    </div>
                </div>

                <!-- Detalles de la compra -->
                <div class="mb-3">
                    <h5>Productos</h5>
                    <table class="table table-bordered" id="tabla-detalles">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th width="120">Cantidad</th>
                                <th width="120">Unidad</th>
                                <th width="150">Precio Unitario</th>
                                <th width="150">Subtotal</th>
                                <th width="80">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="detalles-container">
                            <!-- Los detalles se cargarán aquí via JavaScript -->
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end"><strong>Subtotal:</strong></td>
                                <td><span id="subtotal-display">@Model.Subtotal.ToString("C2")</span></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end"><strong>IVA (12%):</strong></td>
                                <td><span id="iva-display">@Model.IVA.ToString("C2")</span></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end"><strong>Total:</strong></td>
                                <td><span id="total-display">@Model.Total.ToString("C2")</span></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="agregarFila()">
                        <i class="fas fa-plus"></i> Agregar Producto
                    </button>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Observaciones" class="form-label"></label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MetodoPago" class="form-label"></label>
                        <input asp-for="MetodoPago" class="form-control" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a href="@Url.Action("Index", new { estado = "Pendiente" })" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let productosDisponibles = @Html.Raw(Json.Serialize(ViewBag.Productos));
        let contadorFilas = 0;

        $(document).ready(function () {
            console.log("JavaScript cargado para edición");
            cargarDetallesExistentes();
            calcularTotales();

            // ✅ Validación antes de enviar el formulario
            $('#compraForm').on('submit', function (e) {
                console.log('Formulario enviándose...');

                const filas = $('#detalles-container tr');
                console.log('Filas detectadas:', filas.length);

                if (filas.length === 0) {
                    e.preventDefault();
                    alert('Debe agregar al menos un producto antes de guardar.');
                    return false;
                }

                // ✅ Reindexar los names correctamente
                filas.each(function (i, fila) {
                    $(fila).find('input, select').each(function () {
                        const name = $(this).attr('name');
                        if (name && name.startsWith('detalles')) {
                            const nuevoName = name.replace(/\[\d+\]/, `[${i}]`);
                            $(this).attr('name', nuevoName);
                        }
                    });
                });

                console.log('Formulario listo para enviar');
                return true;
            });
        });

        // =========================================================
        // FUNCIONES DE CARGA Y MANEJO DE FILAS
        // =========================================================
        function cargarDetallesExistentes() {
            @if (Model.Detalles != null)
            {
                    foreach (var d in Model.Detalles)
                    {
                            <text>
                                agregarFilaExistente(
                                    @d.IdProducto,
                                    '@Html.Raw(d.Producto?.Nombre?.Replace("'", "\\'"))',
                                    @d.Cantidad,
                                    @d.IdUnidad,
                                    @d.PrecioUnitario.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                                    @d.Subtotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
                                );
                            </text>
                    }
            }
        }

        function generarOpcionesProductos(idSeleccionado) {
            let opciones = '<option value="">Seleccionar producto...</option>';
            productosDisponibles.forEach(p => {
                const seleccionado = p.idProducto === idSeleccionado ? 'selected' : '';
                opciones += `<option value="${p.idProducto}" ${seleccionado}>${p.nombre}</option>`;
            });
            return opciones;
        }

        function agregarFilaExistente(idProducto, nombreProducto, cantidad, idUnidad, precioUnitario, subtotal) {
            contadorFilas++;
            const filaId = `fila-${contadorFilas}`;

            const filaHTML = `
                <tr id="${filaId}">
                    <td>
                        <select name="detalles[${contadorFilas}].IdProducto"
                                class="form-control select-producto"
                                onchange="actualizarUnidades(this, ${contadorFilas})" required>
                            ${generarOpcionesProductos(idProducto)}
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${contadorFilas}].Cantidad"
                               class="form-control cantidad" value="${cantidad}" min="1"
                               onchange="calcularSubtotal(${contadorFilas})" required />
                    </td>
                    <td>
                        <select name="detalles[${contadorFilas}].IdUnidad"
                                class="form-control select-unidad" id="unidad-${contadorFilas}"
                                onchange="calcularSubtotal(${contadorFilas})" required>
                            <option value="">Seleccionar unidad...</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${contadorFilas}].PrecioUnitario"
                               class="form-control precio" value="${precioUnitario}"
                               step="0.01" min="0.01"
                               onchange="calcularSubtotal(${contadorFilas})" required />
                    </td>
                    <td>
                        <input type="text" class="form-control subtotal" value="${subtotal}" readonly />
                        <input type="hidden" name="detalles[${contadorFilas}].Subtotal" value="${subtotal}" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="eliminarFila('${filaId}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>`;

            $('#detalles-container').append(filaHTML);

            // Configurar unidades
            setTimeout(() => {
                $(`#${filaId} .select-producto`).val(idProducto);
                actualizarUnidades($(`#${filaId} .select-producto`)[0], contadorFilas);
                setTimeout(() => {
                    $(`#unidad-${contadorFilas}`).val(idUnidad);
                }, 100);
            }, 100);
        }

        function agregarFila() {
            contadorFilas++;
            const filaId = `fila-${contadorFilas}`;
            const filaHTML = `
                <tr id="${filaId}">
                    <td>
                        <select name="detalles[${contadorFilas}].IdProducto"
                                class="form-control select-producto"
                                onchange="actualizarUnidades(this, ${contadorFilas})" required>
                            ${generarOpcionesProductos(0)}
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${contadorFilas}].Cantidad"
                               class="form-control cantidad" value="1" min="1"
                               onchange="calcularSubtotal(${contadorFilas})" required />
                    </td>
                    <td>
                        <select name="detalles[${contadorFilas}].IdUnidad"
                                class="form-control select-unidad" id="unidad-${contadorFilas}"
                                onchange="calcularSubtotal(${contadorFilas})" required>
                            <option value="">Seleccionar unidad...</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${contadorFilas}].PrecioUnitario"
                               class="form-control precio" value="0.00"
                               step="0.01" min="0.01"
                               onchange="calcularSubtotal(${contadorFilas})" required />
                    </td>
                    <td>
                        <input type="text" class="form-control subtotal" value="0.00" readonly />
                        <input type="hidden" name="detalles[${contadorFilas}].Subtotal" value="0" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="eliminarFila('${filaId}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>`;
            $('#detalles-container').append(filaHTML);
        }

        // =========================================================
        // FUNCIONES DE CÁLCULO
        // =========================================================
        function actualizarUnidades(selectElement, index) {
            const productoId = parseInt(selectElement.value);
            const unidadSelect = $(`#unidad-${index}`);
            unidadSelect.empty().append('<option value="">Seleccionar unidad...</option>');

            if (productoId) {
                const producto = productosDisponibles.find(p => p.idProducto === productoId);
                if (producto && producto.unidades) {
                    producto.unidades.forEach(u => {
                        unidadSelect.append(`<option value="${u.idUnidad}">${u.nombre}</option>`);
                    });
                }
            }

            calcularSubtotal(index);
        }

        function calcularSubtotal(index) {
            const fila = $(`#fila-${index}`);
            const cantidad = parseFloat(fila.find('.cantidad').val()) || 0;
            const precio = parseFloat(fila.find('.precio').val()) || 0;
            const unidadTexto = fila.find('.select-unidad option:selected').text().toLowerCase();

            let factor = 1;
            const match = unidadTexto.match(/\(x(\d+)\)/);
            if (match) factor = parseFloat(match[1]);

            let descuento = 0;
            if (unidadTexto.includes('caja')) descuento = 0.10;
            if (unidadTexto.includes('paquete')) descuento = 0.05;

            const precioAjustado = precio * factor * (1 - descuento);
            const subtotal = cantidad * precioAjustado;

            fila.find('.subtotal').val(subtotal.toFixed(2));
            fila.find('input[name*="Subtotal"]').val(subtotal);

            calcularTotales();
        }

        function calcularTotales() {
            let subtotal = 0;
            $('.subtotal').each(function () {
                subtotal += parseFloat($(this).val()) || 0;
            });

            const iva = subtotal * 0.12;
            const total = subtotal + iva;

            $('#subtotal-display').text(subtotal.toLocaleString('es-GT', { style: 'currency', currency: 'GTQ' }));
            $('#iva-display').text(iva.toLocaleString('es-GT', { style: 'currency', currency: 'GTQ' }));
            $('#total-display').text(total.toLocaleString('es-GT', { style: 'currency', currency: 'GTQ' }));

            $('#inputSubtotal').val(subtotal.toFixed(2));
            $('#inputIVA').val(iva.toFixed(2));
            $('#inputTotal').val(total.toFixed(2));
        }

        function eliminarFila(id) {
            $(`#${id}`).remove();
            calcularTotales();
        }
    </script>
}
