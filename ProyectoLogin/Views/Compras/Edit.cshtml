@model ProyectoLogin.Models.ModelosCompras.Compra

@{
    ViewData["Title"] = "Editar Compra";
    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var unidades = ViewBag.Unidades as IEnumerable<dynamic> ?? new List<dynamic>();
}

<style>
    :root {
        --c-primary: #3036A6;
        --c-primary-light: #5F6AF5;
        --c-primary-soft: #8F9CFF;
        --c-dark-1: #161B3A;
        --c-dark-2: #1F2650;
        --c-dark-3: #1E2546;
        --c-dark-4: #242C54;
        --c-bg-soft: #F7F8FF;
        --c-border-soft: #3C4AA5;
        --c-accent-success: #23d19c;
        --c-accent-warning: #f6c23e;
        --c-accent-danger: #ff6b6b;
        --c-text-main: #F7F8FF;
        --c-text-muted: #C3C7F5;
        --c-radius: 0.75rem;
        --c-shadow-soft: 0 10px 25px rgba(0, 0, 0, 0.35);
    }

    .compras-wrapper {
        max-width: 1200px;
    }

    .compras-header {
        padding: 1.75rem 2rem 1.25rem;
        border-radius: var(--c-radius);
        background: radial-gradient(circle at top left, rgba(95, 106, 245, 0.12), transparent), radial-gradient(circle at top right, rgba(35, 209, 156, 0.06), transparent), var(--c-dark-2);
        border: 1px solid rgba(143, 156, 255, 0.25);
        box-shadow: var(--c-shadow-soft);
        margin-bottom: 1.5rem;
    }

        .compras-header h2 {
            color: var(--c-primary-soft);
            margin-bottom: 0.25rem;
        }

        .compras-header p {
            color: var(--c-text-muted);
            margin-bottom: 0;
        }

    .card-compras {
        background: linear-gradient(to bottom, rgba(36, 44, 84, 0.98), rgba(22, 27, 58, 0.98));
        border-radius: var(--c-radius);
        border: 1px solid rgba(63, 74, 165, 0.45);
        box-shadow: var(--c-shadow-soft);
        color: var(--c-text-main);
    }

        .card-compras .card-header {
            background: linear-gradient(to right, var(--c-dark-2), var(--c-dark-3));
            border-bottom: 1px solid rgba(95, 106, 245, 0.5);
            color: var(--c-primary-soft);
            border-radius: var(--c-radius) var(--c-radius) 0 0 !important;
        }

        .card-compras .form-label {
            color: var(--c-primary-soft);
            font-weight: 600;
        }

    .compras-input,
    .compras-select,
    .form-control.bg-light {
        background-color: var(--c-dark-3) !important;
        border-color: var(--c-border-soft) !important;
        color: var(--c-text-main) !important;
        border-radius: .5rem;
    }

        .compras-input::placeholder,
        .compras-select::placeholder,
        textarea::placeholder {
            color: rgba(195,199,245,.5);
        }

        .compras-input:focus,
        .compras-select:focus,
        textarea:focus {
            background-color: var(--c-dark-3) !important;
            color: var(--c-text-main) !important;
            border-color: var(--c-primary-light) !important;
            box-shadow: 0 0 0 .15rem rgba(95,106,245,.35) !important;
        }

    .compras-help {
        color: var(--c-text-muted);
        font-size: .8rem;
    }

    /* Tabla */
    .table-compras {
        margin-bottom: 0;
    }

        .table-compras thead {
            background: linear-gradient(to right, var(--c-dark-2), var(--c-dark-3));
            color: var(--c-primary-soft);
            border-bottom: 1px solid rgba(95,106,245,.5);
        }

            .table-compras thead th {
                font-weight: 600;
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                border: none;
                white-space: nowrap;
            }

        .table-compras tbody tr {
            background-color: var(--c-dark-1);
            color: var(--c-text-main);
            transition: all .18s ease;
        }

            .table-compras tbody tr:nth-child(even) {
                background-color: var(--c-dark-3);
            }

            .table-compras tbody tr:hover {
                background-color: var(--c-dark-4);
                transform: translateY(-1px);
            }

        .table-compras td,
        .table-compras th,
        .table-compras tfoot td {
            border-color: rgba(60,74,165,.28) !important;
        }

        .table-compras .form-control-sm {
            background-color: var(--c-dark-3);
            border-color: var(--c-border-soft);
            color: var(--c-text-main);
            border-radius: .45rem;
            font-size: .78rem;
            padding: .25rem .4rem;
        }

            .table-compras .form-control-sm:focus {
                border-color: var(--c-primary-light);
                box-shadow: 0 0 0 .12rem rgba(95,106,245,.28);
            }

    .precio-venta-sin-iva,
    .precio-venta-con-iva {
        background-color: var(--c-dark-3) !important;
        color: var(--c-primary-soft) !important;
        border-color: rgba(95,106,245,.4) !important;
        font-weight: 500;
    }

    .descuento {
        border-color: rgba(246,194,62,.7) !important;
    }

    .table-compras tfoot td {
        font-size: .85rem;
    }

    .table-compras tfoot .text-primary {
        color: var(--c-primary-soft) !important;
    }

    .table-compras tfoot .text-success {
        color: var(--c-accent-success) !important;
    }

    #subtotal-display, #iva-display {
        color: var(--c-primary-soft);
    }

    #total-display {
        color: var(--c-accent-success);
        font-weight: 700;
    }

    /* Botones */
    .btn-outline-secondary {
        border-radius: 999px;
        border-color: rgba(143,156,255,.35);
        color: var(--c-primary-soft);
    }

        .btn-outline-secondary:hover {
            background-color: var(--c-dark-3);
            color: var(--c-primary-soft);
        }

    .btn-outline-primary {
        border-radius: 999px;
        border-color: var(--c-primary-soft);
        color: var(--c-primary-soft);
    }

        .btn-outline-primary:hover {
            background-color: var(--c-dark-3);
            color: var(--c-primary-soft);
        }

    .btn-outline-danger.btn-sm {
        border-radius: 999px;
        border-color: rgba(255,107,107,.75);
        color: var(--c-accent-danger);
    }

        .btn-outline-danger.btn-sm:hover {
            background-color: rgba(255,107,107,.14);
            color: var(--c-accent-danger);
        }

    .btn-primary.rounded-pill {
        background: linear-gradient(to right, var(--c-primary-light), var(--c-primary));
        border: none;
        box-shadow: 0 6px 16px rgba(95,106,245,.4);
        font-weight: 600;
    }

        .btn-primary.rounded-pill:hover {
            background: linear-gradient(to right, var(--c-primary), var(--c-primary-light));
            box-shadow: 0 8px 20px rgba(95,106,245,.55);
            transform: translateY(-1px);
        }

    .btn-outline-warning.rounded-pill {
        border-color: var(--c-accent-warning);
        color: var(--c-accent-warning);
    }

        .btn-outline-warning.rounded-pill:hover {
            background-color: rgba(246,194,62,.12);
            color: var(--c-accent-warning);
        }

    .text-muted {
        color: var(--c-text-muted) !important;
    }

    @@media (max-width:768px) {
        .compras-header {
            padding: 1.25rem 1.25rem 1rem;
        }

        .table-compras th, .table-compras td {
            font-size: .7rem;
            padding: .25rem .35rem;
        }
    }
</style>

<!-- ======= OVERRIDES “MENTA” (misma estética clara que Index/Detalles) ======= -->
<style>
    :root {
        --c-primary: #062926; /* menta oscuro */
        --c-primary-light: #12C6A1; /* menta vibrante */
        --c-primary-soft: #5EF2C1; /* acento brillante */
        --c-dark-1: #ffffff; /* fondo filas */
        --c-dark-2: #0A3A34; /* header grad inicio */
        --c-dark-3: #ffffff; /* inputs y celdas */
        --c-dark-4: #ecfdf5; /* hover suave */
        --c-bg-soft: #f5f6fa;
        --c-border-soft: #e5e7eb;
        --c-accent-success: #16a34a;
        --c-accent-warning: #eab308;
        --c-accent-danger: #ef4444;
        --c-text-main: #111827;
        --c-text-muted: #6b7280;
    }

    /* HEADER */
    .compras-header {
        background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,.18) !important;
        box-shadow: 0 6px 18px rgba(15,23,42,.18) !important;
    }

        .compras-header h2, .compras-header p {
            color: #fff !important;
        }

        .compras-header .bi-cart-check {
            color: var(--c-primary-soft) !important;
        }

    /* CARD */
    .card-compras {
        background: #ffffff !important;
        border: 1px solid var(--c-border-soft) !important;
        color: var(--c-text-main) !important;
        box-shadow: 0 4px 14px rgba(15,23,42,.06) !important;
    }

        .card-compras .card-header {
            background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
            color: #fff !important;
            border-bottom: 1px solid rgba(255,255,255,.2) !important;
        }

        .card-compras .form-label {
            color: var(--c-primary-light) !important;
        }

    /* INPUTS */
    .compras-input,
    .compras-select,
    .form-control.bg-light {
        background: #fff !important;
        border: 1px solid var(--c-border-soft) !important;
        color: var(--c-text-main) !important;
    }

        .compras-input::placeholder,
        .compras-select::placeholder,
        textarea::placeholder {
            color: #9ca3af !important;
        }

        .compras-input:focus,
        .compras-select:focus,
        textarea:focus {
            border-color: var(--c-primary-light) !important;
            box-shadow: 0 0 0 .16rem rgba(18,198,161,.18) !important;
            background: #fff !important;
            color: var(--c-text-main) !important;
        }

    /* TABLA */
    .table-compras {
        color: var(--c-text-main) !important;
    }

        .table-compras thead {
            background: #e5f9f3 !important;
            color: var(--c-text-muted) !important;
            border-bottom: 1px solid var(--c-border-soft) !important;
        }

            .table-compras thead th {
                color: var(--c-text-muted) !important;
            }

        .table-compras tbody tr {
            background: #ffffff !important;
        }

            .table-compras tbody tr:nth-child(even) {
                background: #f9fafb !important;
            }

            .table-compras tbody tr:hover {
                background: #ecfdf5 !important;
            }

        .table-compras td, .table-compras th, .table-compras tfoot td {
            border-color: var(--c-border-soft) !important;
        }

        .table-compras .form-control-sm {
            background: #fff !important;
            color: var(--c-text-main) !important;
            border: 1px solid var(--c-border-soft) !important;
        }

            .table-compras .form-control-sm:focus {
                border-color: var(--c-primary-light) !important;
                box-shadow: 0 0 0 .12rem rgba(18,198,161,.18) !important;
            }

    .precio-venta-sin-iva,
    .precio-venta-con-iva {
        background: #f0fdf9 !important;
        border-color: rgba(18,198,161,.35) !important;
        color: #065f46 !important;
    }

    .descuento {
        border-color: #f59e0b !important;
    }

    /* FOOTER TOTALES */
    #subtotal-display, #iva-display {
        color: var(--c-primary-light) !important;
    }

    #total-display {
        color: var(--c-accent-success) !important;
    }

    /* BOTONES */
    .btn-outline-secondary {
        background: #fff !important;
        color: var(--c-primary) !important;
        border: 1px solid var(--c-border-soft) !important;
    }

        .btn-outline-secondary:hover {
            background: #ecfdf5 !important;
            color: var(--c-primary-light) !important;
            border-color: var(--c-primary-light) !important;
            box-shadow: 0 3px 8px rgba(18,198,161,.25) !important;
        }

    .btn-outline-primary {
        border-color: var(--c-primary-light) !important;
        color: var(--c-primary-light) !important;
        background: #fff !important;
    }

        .btn-outline-primary:hover {
            background: #e5f9f3 !important;
            color: var(--c-primary) !important;
            border-color: var(--c-primary) !important;
            box-shadow: 0 3px 8px rgba(18,198,161,.25) !important;
        }

    .btn-outline-danger.btn-sm {
        border-color: #ef4444 !important;
        color: #b91c1c !important;
        background: #fff !important;
    }

        .btn-outline-danger.btn-sm:hover {
            background: #fee2e2 !important;
            color: #991b1b !important;
            box-shadow: 0 3px 8px rgba(239,68,68,.25) !important;
        }

    .btn-primary.rounded-pill {
        background: linear-gradient(90deg,var(--c-primary-light),var(--c-primary)) !important;
        box-shadow: 0 6px 16px rgba(18,198,161,.35) !important;
    }

        .btn-primary.rounded-pill:hover {
            background: linear-gradient(90deg,var(--c-primary),var(--c-primary-light)) !important;
            box-shadow: 0 8px 20px rgba(18,198,161,.45) !important;
        }

    /* BADGE “MODO EDICIÓN” (respeta inline, solo refuerza) */
    .badge.bg-opacity-10 {
        backdrop-filter: saturate(140%);
    }
</style>

<div class="container compras-wrapper mt-4">
    <!-- Header -->
    <div class="compras-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cart-check me-2 text-primary"></i> Editar Compra
            </h2>
            <p class="mb-0">Modifique los productos, totales y datos asociados a la compra seleccionada.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="@Url.Action("Index", new { estado = "Pendiente" })"
               class="btn btn-outline-secondary"
               title="Volver al listado de compras">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <span class="badge rounded-pill bg-opacity-10"
                  style="background-color: rgba(95,106,245,.18); color: var(--c-primary-soft);">
                <i class="bi bi-pencil-square me-1"></i> Modo edición
            </span>
        </div>
    </div>

    <!-- Card principal -->
    <div class="card card-compras mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-receipt me-2"></i>
                    Compra: <span class="text-primary-soft">@Model.NumeroDocumento</span>
                </h5>
            </div>
            <div class="small text-muted">
                Proveedor:
                <span class="text-primary-soft fw-semibold">@Model.Proveedor?.Nombre</span>
            </div>
        </div>

        <div class="card-body">
            <form asp-action="Edit" id="compraForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdCompra" />
                <input type="hidden" asp-for="NumeroDocumento" />
                <input type="hidden" asp-for="IdProveedor" />
                <input type="hidden" asp-for="Subtotal" id="inputSubtotal" />
                <input type="hidden" asp-for="IVA" id="inputIVA" />
                <input type="hidden" asp-for="Total" id="inputTotal" />

                <!-- Info básica -->
                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="form-label">
                            <i class="bi bi-truck me-1"></i>Proveedor
                        </label>
                        <input type="text"
                               class="form-control compras-input"
                               value="@Model.Proveedor?.Nombre"
                               readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="bi bi-file-text me-1"></i>N° Documento
                        </label>
                        <input type="text"
                               class="form-control compras-input"
                               value="@Model.NumeroDocumento"
                               readonly />
                    </div>
                </div>

                <!-- Detalles de la compra -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0" style="color: var(--c-primary-soft);">
                            <i class="bi bi-list-check me-2"></i>Productos de la Compra
                        </h5>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                onclick="agregarFila()"
                                title="Agregar nuevo producto">
                            <i class="bi bi-plus-circle me-1"></i>Agregar Producto
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-compras table-bordered align-middle" id="tabla-detalles">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th width="90">Cantidad</th>
                                    <th width="130">Unidad</th>
                                    <th width="130">Precio Unitario</th>
                                    <th width="110">Descuento (%)</th>
                                    <th width="150">Precio Venta sin IVA</th>
                                    <th width="150">Precio Venta con IVA</th>
                                    <th width="70" class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="detalles-container">
                                <!-- Se llena por JS -->
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end fw-bold">Subtotal:</td>
                                    <td colspan="2" class="fw-bold text-primary">
                                        <span id="subtotal-display">@Model.Subtotal.ToString("C2")</span>
                                    </td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="text-end fw-bold">IVA (12%):</td>
                                    <td colspan="2" class="fw-bold text-primary">
                                        <span id="iva-display">@Model.IVA.ToString("C2")</span>
                                    </td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="text-end fw-bold fs-6">Total:</td>
                                    <td colspan="2" class="fw-bold fs-6 text-success">
                                        <span id="total-display">@Model.Total.ToString("C2")</span>
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Información adicional (solo Observaciones) -->
                <div class="row mb-3">
                    <div class="col-12">
                        <label asp-for="Observaciones" class="form-label">
                            <i class="bi bi-chat-text me-1"></i>Observaciones
                        </label>
                        <textarea asp-for="Observaciones"
                                  class="form-control compras-input"
                                  rows="3"
                                  placeholder="Observaciones adicionales..."></textarea>
                    </div>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-between align-items-center pt-3 mt-2"
                     style="border-top: 1px solid rgba(95,106,245,0.25);">
                    <a href="@Url.Action("Index", new { estado = "Pendiente" })"
                       class="btn btn-outline-secondary"
                       title="Cancelar edición">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </a>

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-outline-warning rounded-pill"
                                onclick="limpiarFormulario()"
                                title="Limpiar todos los productos">
                            <i class="bi bi-arrow-clockwise me-1"></i>Limpiar
                        </button>

                        <button type="submit"
                                class="btn btn-primary rounded-pill"
                                title="Guardar cambios de la compra">
                            <i class="bi bi-check2-circle me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let productosDisponibles = @Html.Raw(Json.Serialize(ViewBag.Productos));
        let contadorFilas = 0;
        const margenGanancia = 0.25;
        let subtotalesFilas = {};

        $(document).ready(function () {
            $('#detalles-container').empty();
            subtotalesFilas = {};
            contadorFilas = 0;

            cargarDetallesExistentes();
            calcularTotales();

            $('#compraForm').on('submit', function (e) {
                const filas = $('#detalles-container tr');

                if (filas.length === 0) {
                    e.preventDefault();
                    alert('Debe agregar al menos un producto antes de guardar.');
                    return false;
                }

                // Reindexar names
                filas.each(function (i, fila) {
                    $(fila).find('input, select').each(function () {
                        const name = $(this).attr('name');
                        if (name && name.startsWith('detalles')) {
                            const nuevoName = name.replace(/\[\d+\]/, `[${i}]`);
                            $(this).attr('name', nuevoName);
                        }
                    });
                });

                return true;
            });
        });

        // ======================= CARGA DETALLES EXISTENTES =======================
        function cargarDetallesExistentes() {
            @if (Model.Detalles != null)
            {
                        foreach (var d in Model.Detalles)
                        {
                                    <text>
                                        agregarFilaExistente(
                                            @d.IdProducto,
                                            '@Html.Raw(d.Producto?.Nombre?.Replace("'", "\\'"))',
                                            @d.Cantidad,
                                            @d.IdUnidad,
                                            @d.PrecioUnitario.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
                                            @(d.Descuento * 100),
                                            @d.Subtotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
                                        );
                                    </text>
                        }
            }
        }

        function generarOpcionesProductos(idSeleccionado) {
            let opciones = '<option value="">Seleccionar producto...</option>';
            (productosDisponibles || []).forEach(p => {
                const seleccionado = p.idProducto === idSeleccionado ? 'selected' : '';
                opciones += `<option value="${p.idProducto}" ${seleccionado}>${p.nombre}</option>`;
            });
            return opciones;
        }

        function agregarFilaExistente(idProducto, nombreProducto, cantidad, idUnidad, precioUnitario, descuento, subtotal) {
            contadorFilas++;
            const filaId = `fila-${contadorFilas}`;
            const currentIndex = contadorFilas;

            const filaHTML = `
                <tr id="${filaId}">
                    <td>
                        <select name="detalles[${currentIndex}].IdProducto"
                                class="form-control form-control-sm select-producto"
                                onchange="actualizarUnidades(this, ${currentIndex})" required>
                            ${generarOpcionesProductos(idProducto)}
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${currentIndex}].Cantidad"
                               class="form-control form-control-sm cantidad" value="${cantidad}" min="1"
                               onchange="calcularSubtotal(${currentIndex})" required />
                    </td>
                    <td>
                        <select name="detalles[${currentIndex}].IdUnidad"
                                class="form-control form-control-sm select-unidad" id="unidad-${currentIndex}"
                                onchange="calcularSubtotal(${currentIndex})" required>
                            <option value="">Seleccionar unidad...</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${currentIndex}].PrecioUnitario"
                               class="form-control form-control-sm precio" value="${precioUnitario}"
                               step="1" min="1"
                               onchange="calcularSubtotal(${currentIndex})" required />
                    </td>
                    <td>
                        <input type="number" name="detalles[${currentIndex}].Descuento"
                               class="form-control form-control-sm descuento" value="${descuento}"
                               step="1" min="0" max="100"
                               onchange="calcularSubtotal(${currentIndex})" />
                    </td>
                    <td>
                        <input type="text"
                               class="form-control form-control-sm precio-venta-sin-iva" value="0.00" readonly />
                    </td>
                    <td>
                        <input type="text"
                               class="form-control form-control-sm precio-venta-con-iva" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button"
                                class="btn btn-outline-danger rounded-circle btn-sm"
                                onclick="eliminarFila('${filaId}', ${currentIndex})"
                                title="Eliminar producto">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`;

            $('#detalles-container').append(filaHTML);

            const configurarFila = () => {
                const productoSelect = $(`#${filaId} .select-producto`);
                const unidadSelect = $(`#unidad-${currentIndex}`);

                if (productoSelect.length && unidadSelect.length) {
                    productoSelect.val(idProducto);
                    actualizarUnidades(productoSelect[0], currentIndex);

                    setTimeout(() => {
                        unidadSelect.val(idUnidad);
                        setTimeout(() => {
                            calcularSubtotal(currentIndex);
                        }, 120);
                    }, 80);
                } else {
                    setTimeout(configurarFila, 80);
                }
            };

            configurarFila();
        }

        function agregarFila() {
            contadorFilas++;
            const filaId = `fila-${contadorFilas}`;
            const currentIndex = contadorFilas;

            const filaHTML = `
                <tr id="${filaId}">
                    <td>
                        <select name="detalles[${currentIndex}].IdProducto"
                                class="form-control form-control-sm select-producto"
                                onchange="actualizarUnidades(this, ${currentIndex})" required>
                            ${generarOpcionesProductos(0)}
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${currentIndex}].Cantidad"
                               class="form-control form-control-sm cantidad" value="1" min="1"
                               onchange="calcularSubtotal(${currentIndex})" required />
                    </td>
                    <td>
                        <select name="detalles[${currentIndex}].IdUnidad"
                                class="form-control form-control-sm select-unidad" id="unidad-${currentIndex}"
                                onchange="calcularSubtotal(${currentIndex})" required>
                            <option value="">Seleccionar unidad...</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" name="detalles[${currentIndex}].PrecioUnitario"
                               class="form-control form-control-sm precio" value="0"
                               step="1" min="1"
                               onchange="calcularSubtotal(${currentIndex})" required />
                    </td>
                    <td>
                        <input type="number" name="detalles[${currentIndex}].Descuento"
                               class="form-control form-control-sm descuento" value="0"
                               step="1" min="0" max="100"
                               onchange="calcularSubtotal(${currentIndex})" />
                    </td>
                    <td>
                        <input type="text"
                               class="form-control form-control-sm precio-venta-sin-iva" value="0.00" readonly />
                    </td>
                    <td>
                        <input type="text"
                               class="form-control form-control-sm precio-venta-con-iva" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button"
                                class="btn btn-outline-danger rounded-circle btn-sm"
                                onclick="eliminarFila('${filaId}', ${currentIndex})"
                                title="Eliminar producto">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`;

            $('#detalles-container').append(filaHTML);
        }

        function limpiarFormulario() {
            if (confirm('¿Estás seguro de que deseas limpiar todos los productos de la compra?')) {
                $('#detalles-container').empty();
                subtotalesFilas = {};
                contadorFilas = 0;
                calcularTotales();
            }
        }

        // ======================= CÁLCULOS =======================
        function actualizarUnidades(selectElement, index) {
            const productoId = parseInt(selectElement.value);
            const unidadSelect = $(`#unidad-${index}`);
            unidadSelect.empty().append('<option value="">Seleccionar unidad...</option>');

            if (productoId) {
                const producto = (productosDisponibles || []).find(p => p.idProducto === productoId);
                if (producto && producto.unidades) {
                    producto.unidades.forEach(u => {
                        unidadSelect.append(`<option value="${u.idUnidad}">${u.nombre}</option>`);
                    });
                }
            }

            calcularSubtotal(index);
        }

        function calcularSubtotal(index) {
            const fila = $(`#fila-${index}`);
            if (!fila.length) return;

            const cantidad = parseFloat(fila.find('.cantidad').val()) || 0;
            const precio = parseFloat(fila.find('.precio').val()) || 0;
            const descuentoPct = parseFloat(fila.find('.descuento').val()) || 0;

            const unidadId = fila.find('.select-unidad').val();
            let factor = 1;

            if (unidadId) {
                const productoId = fila.find('.select-producto').val();
                const producto = (productosDisponibles || []).find(p => p.idProducto == productoId);
                if (producto && producto.unidades) {
                    const unidad = producto.unidades.find(u => u.idUnidad == unidadId);
                    if (unidad) { factor = unidad.factorConversion || 1; }
                }
            }

            let descuentoDecimal = descuentoPct;
            if (descuentoPct > 1) descuentoDecimal = descuentoPct / 100;

            const precioConDescuento = precio * (1 - descuentoDecimal);
            const precioBase = precioConDescuento / 1.12;
            const subtotalFila = cantidad * precioBase * factor;

            subtotalesFilas[index] = isNaN(subtotalFila) ? 0 : subtotalFila;

            const margenGanancia = 0.25;
            const precioVentaSinIVA = precioBase * (1 + margenGanancia);
            const precioVentaConIVA = precioVentaSinIVA * 1.12;

            fila.find('.precio-venta-sin-iva').val(precioVentaSinIVA.toFixed(2));
            fila.find('.precio-venta-con-iva').val(precioVentaConIVA.toFixed(2));

            calcularTotales();
        }

        function calcularTotales() {
            let subtotal = 0;
            Object.values(subtotalesFilas).forEach(valor => subtotal += (valor || 0));

            const iva = subtotal * 0.12;
            const total = subtotal + iva;

            $('#subtotal-display').text(subtotal.toLocaleString('es-GT', { style: 'currency', currency: 'GTQ' }));
            $('#iva-display').text(iva.toLocaleString('es-GT', { style: 'currency', currency: 'GTQ' }));
            $('#total-display').text(total.toLocaleString('es-GT', { style: 'currency', currency: 'GTQ' }));

            $('#inputSubtotal').val(subtotal.toFixed(2));
            $('#inputIVA').val(iva.toFixed(2));
            $('#inputTotal').val(total.toFixed(2));
        }

        function eliminarFila(id, index) {
            delete subtotalesFilas[index];
            $(`#${id}`).remove();
            calcularTotales();
        }
    </script>
}
