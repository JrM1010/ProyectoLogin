@model ProyectoLogin.Models.Usuario
@{
    Layout = "_Layout";
    ViewData["Title"] = "Registrar Usuario";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-6 col-lg-8 col-md-10">
            <!-- CARD PRINCIPAL -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-plus fs-4 me-2"></i>
                        <h4 class="mb-0">Registrar Nuevo Usuario</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Inicio" asp-action="Registrarse" method="post" autocomplete="off" id="registroForm">
                        @Html.AntiForgeryToken()

                        <!-- INFORMACIÓN PERSONAL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-success mb-3">
                                    <i class="bi bi-person-badge me-2"></i>Información Personal
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NombreUsuario" class="form-label fw-semibold">Nombre Completo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input class="form-control" type="text" asp-for="NombreUsuario"
                                           placeholder="Ejemplo: Juan Pérez" autocomplete="new-name" />
                                </div>
                                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-semibold">Correo Electrónico</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input class="form-control" type="email" asp-for="Correo"
                                           placeholder="usuario@correo.com" autocomplete="new-email" />
                                </div>
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- SEGURIDAD Y ROL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-success mb-3">
                                    <i class="bi bi-shield-lock me-2"></i>Seguridad y Permisos
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Clave" class="form-label fw-semibold">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-key"></i>
                                    </span>
                                    <input class="form-control" type="password" asp-for="Clave" id="passwordField"
                                           placeholder="Ingrese una contraseña segura" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                        <i class="bi bi-eye" id="passwordIcon"></i>
                                    </button>
                                </div>
                                <!-- Información sobre requisitos de contraseña -->
                                <div class="form-text text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>La contraseña debe cumplir con:
                                    <ul class="mb-0 mt-1 ps-3">
                                        <li>Mínimo 8 caracteres</li>
                                        <li>Al menos una letra mayúscula</li>
                                        <li>Al menos un número</li>
                                        <li>Al menos un carácter especial (!#$%^&*()_+-=[]{}|;:',.<>?)</li>
                                    </ul>
                                </div>
                                <span asp-validation-for="Clave" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IdRol" class="form-label fw-semibold">Rol del Usuario</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <select class="form-control" asp-for="IdRol"
                                            asp-items="@(new SelectList(ViewBag.Roles as IEnumerable<ProyectoLogin.Models.Rol>, "IdRol", "NombreRol"))">
                                        <option value="">-- Seleccione un rol --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="IdRol" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- MENSAJES DE ALERTA -->
                        @if (ViewData["Mensaje"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @ViewData["Mensaje"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Mostrar errores de validación del modelo -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Por favor, corrija los errores en el formulario.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">

                            <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-outline-secondary rounded-pill" title="Volver a la gestión de usuarios">
                                <i class="bi bi-arrow-left me-1"></i>Volver a Usuarios
                            </a>

                            <div class="d-flex gap-2">
                                <button type="reset" class="btn btn-outline-warning rounded-pill" title="Limpiar formulario">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Limpiar
                                </button>

                                <button type="submit" class="btn btn-primary rounded-pill" title="Registrar nuevo usuario" id="submitBtn">
                                    <i class="bi bi-person-plus me-1"></i>Registrar Usuario
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA DE ROLES -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-info-circle me-2"></i>Información sobre Roles
                    </h6>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-2">
                                <i class="bi bi-shield-check text-success me-2 mt-1"></i>
                                <div>
                                    <strong>Administrador</strong>
                                    <p class="text-muted small mb-0">Acceso completo a todas las funcionalidades del sistema</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start mb-2">
                                <i class="bi bi-cart-check text-primary me-2 mt-1"></i>
                                <div>
                                    <strong>Vendedor</strong>
                                    <p class="text-muted small mb-0">Gestión de ventas, clientes e inventario</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('=== SCRIPT CARGADO ===');

            const form = document.getElementById('registroForm');
            const submitBtn = document.getElementById('submitBtn');

            if (form) {
                console.log('Formulario encontrado');

                // ELIMINAR cualquier validación que pueda estar bloqueando el envío
                form.setAttribute('novalidate', 'novalidate');
                form.noValidate = true;

                form.addEventListener('submit', function(e) {
                    console.log('=== FORMULARIO ENVIANDO ===');

                    // VERIFICAR datos
                    const nombre = document.querySelector('[name="NombreUsuario"]').value;
                    const correo = document.querySelector('[name="Correo"]').value;
                    const clave = document.querySelector('[name="Clave"]').value;
                    const rol = document.querySelector('[name="IdRol"]').value;

                    console.log('Datos:', { nombre, correo, clave, rol });

                    if (!nombre || !correo || !clave || !rol) {
                        console.log('ERROR: Campos vacíos');
                        alert('Por favor complete todos los campos');
                        e.preventDefault();
                        return;
                    }

                    console.log('Todos los campos llenos - enviando...');

                    // Cambiar estado del botón
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Registrando...';
                    }

                    // PERMITIR el envío normal del formulario
                    // NO usar e.preventDefault();
                });
            } else {
                console.log('ERROR: Formulario no encontrado');
            }

            // Funcionalidad básica para mostrar/ocultar contraseña
            const togglePassword = document.getElementById('togglePassword');
            const passwordField = document.getElementById('passwordField');
            const passwordIcon = document.getElementById('passwordIcon');

            if (togglePassword && passwordField && passwordIcon) {
                togglePassword.addEventListener('click', function() {
                    const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordField.setAttribute('type', type);
                    passwordIcon.classList.toggle('bi-eye');
                    passwordIcon.classList.toggle('bi-eye-slash');
                });
            }
        });
    </script>
}