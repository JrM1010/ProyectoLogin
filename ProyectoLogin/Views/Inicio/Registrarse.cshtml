@model ProyectoLogin.Models.Usuario
@{
    Layout = "_Layout";
    ViewData["Title"] = "Registrar Usuario";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-6 col-lg-8 col-md-10">
            <!-- CARD PRINCIPAL -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-plus fs-4 me-2"></i>
                        <h4 class="mb-0">Registrar Nuevo Usuario</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Inicio" asp-action="Registrarse" method="post">
                        @Html.AntiForgeryToken()

                        <!-- INFORMACIÓN PERSONAL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-person-badge me-2"></i>Información Personal
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NombreUsuario" class="form-label fw-semibold">Nombre Completo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input class="form-control" type="text" asp-for="NombreUsuario"
                                           placeholder="Ejemplo: Juan Pérez" required />
                                </div>
                                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-semibold">Correo Electrónico</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input class="form-control" type="email" asp-for="Correo"
                                           placeholder="usuario@correo.com" required />
                                </div>
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- SEGURIDAD Y ROL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-shield-lock me-2"></i>Seguridad y Permisos
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Clave" class="form-label fw-semibold">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-key"></i>
                                    </span>
                                    <input class="form-control" type="password" asp-for="Clave"
                                           placeholder="Mínimo 6 caracteres" required />
                                </div>
                                <div class="form-text text-muted">
                                    <i class="bi bi-info-circle me-1"></i>La contraseña debe tener al menos 6 caracteres
                                </div>
                                <span asp-validation-for="Clave" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IdRol" class="form-label fw-semibold">Rol del Usuario</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <select class="form-control" asp-for="IdRol"
                                            asp-items="@(new SelectList(ViewBag.Roles as IEnumerable<ProyectoLogin.Models.Rol>, "IdRol", "NombreRol"))">
                                        <option value="">-- Seleccione un rol --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="IdRol" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- MENSAJES DE ALERTA -->
                        @if (ViewData["Mensaje"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @ViewData["Mensaje"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                           
                            <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-outline-secondary rounded-pill" title="Volver a la gestión de usuarios">
                                <i class="bi bi-arrow-left me-1"></i>Volver a Usuarios
                            </a>

                            <div class="d-flex gap-2">
                                <button type="reset" class="btn btn-outline-warning rounded-pill" title="Limpiar formulario">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Limpiar
                                </button>

                                <button type="submit" class="btn btn-primary rounded-pill" title="Registrar nuevo usuario">
                                    <i class="bi bi-person-plus me-1"></i>Registrar Usuario
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA DE ROLES -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-info-circle me-2"></i>Información sobre Roles
                    </h6>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start mb-2">
                                <i class="bi bi-shield-check text-success me-2 mt-1"></i>
                                <div>
                                    <strong>Administrador</strong>
                                    <p class="text-muted small mb-0">Acceso completo a todas las funcionalidades del sistema</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start mb-2">
                                <i class="bi bi-cart-check text-primary me-2 mt-1"></i>
                                <div>
                                    <strong>Vendedor</strong>
                                    <p class="text-muted small mb-0">Gestión de ventas, clientes e inventario</p>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Focus en el primer campo al cargar
            const firstInput = document.querySelector('input[type="text"]');
            if (firstInput) firstInput.focus();

            // Auto-ocultar alertas después de 5 segundos
            const alert = document.querySelector('.alert');
            if (alert) {
                setTimeout(() => {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                }, 5000);
            }
        });
    </script>
}