@model ProyectoLogin.Models.ViewModel.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Restablecer Contraseña - SmartCell</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-blue: #1C1973;
            --secondary-blue: #514BF2;
            --accent-blue: #8B88F2;
            --dark-bg: #0D0E26;
            --alt-bg: #081C59;
            --light-text: #F0F0F7;
            --border-radius: 0.5rem;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            background: linear-gradient(135deg, var(--dark-bg) 0%, var(--alt-bg) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 1rem;
        }

        .reset-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 100vh;
        }

        .reset-container {
            width: 100%;
            max-width: 500px;
            animation: fadeIn 0.6s ease-out;
        }

        .reset-card {
            background: var(--alt-bg);
            border: 1px solid var(--accent-blue);
            border-radius: var(--border-radius);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .reset-header {
            background: var(--primary-blue);
            color: white;
            text-align: center;
            padding: 2rem 1.5rem;
            border-bottom: 1px solid var(--accent-blue);
        }

        .reset-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            display: block;
        }

        .reset-title {
            font-size: 1.75rem;
            font-weight: 700;
            margin: 0;
        }

        .reset-subtitle {
            font-size: 0.9rem;
            opacity: 0.8;
            margin: 0.5rem 0 0 0;
        }

        .reset-body {
            padding: 2rem 1.5rem;
        }

        .form-label {
            color: var(--light-text);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-control {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid var(--accent-blue);
            border-radius: var(--border-radius);
            color: var(--light-text);
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

            .form-control:focus {
                background-color: rgba(255, 255, 255, 0.15);
                border-color: var(--secondary-blue);
                box-shadow: 0 0 0 0.2rem rgba(81, 75, 242, 0.25);
                color: var(--light-text);
                outline: none;
            }

            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.5);
            }

        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--accent-blue);
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 50%;
            transition: all 0.3s ease;
            z-index: 2;
        }

            .toggle-password:hover {
                background-color: rgba(255, 255, 255, 0.1);
                color: var(--light-text);
            }

        .btn-reset {
            background: var(--secondary-blue);
            border: none;
            border-radius: var(--border-radius);
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-reset:hover:not(:disabled) {
                background: #413BF0;
                transform: translateY(-1px);
            }

            .btn-reset:active {
                transform: translateY(0);
            }

            .btn-reset:disabled {
                background: var(--accent-blue);
                opacity: 0.7;
                transform: none;
                cursor: not-allowed;
            }

        .alert {
            border-radius: var(--border-radius);
            border: none;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.1);
            color: #ff6b6b;
            border: 1px solid rgba(220, 53, 69, 0.3);
        }

        .text-danger {
            color: #ff6b6b !important;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: block;
        }

        .validation-summary-errors {
            background: rgba(220, 53, 69, 0.1);
            color: #ff6b6b;
            border: 1px solid rgba(220, 53, 69, 0.3);
            border-radius: var(--border-radius);
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 1rem;
            }

        .requirements-text {
            color: var(--light-text);
            opacity: 0.8;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            line-height: 1.4;
        }

        .progress {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            height: 6px;
            margin: 0.5rem 0;
        }

        .progress-bar {
            border-radius: 3px;
            transition: all 0.3s ease;
        }

        .bg-danger {
            background-color: #ff6b6b !important;
        }

        .bg-warning {
            background-color: #ffd43b !important;
        }

        .bg-success {
            background-color: #51cf66 !important;
        }

        .strength-text {
            font-size: 0.75rem;
            color: var(--light-text);
            opacity: 0.7;
        }

        .checklist {
            list-style: none;
            padding: 0;
            margin: 1rem 0;
        }

            .checklist li {
                display: flex;
                align-items: center;
                margin-bottom: 0.5rem;
                font-size: 0.875rem;
                color: var(--light-text);
            }

            .checklist i {
                margin-right: 0.5rem;
                font-size: 0.875rem;
            }

        .text-success {
            color: #51cf66 !important;
        }

        .text-danger {
            color: #ff6b6b !important;
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 576px) {
            body {
                padding: 0.5rem;
            }

            .reset-container {
                max-width: 100%;
            }

            .reset-header {
                padding: 1.5rem 1rem;
            }

            .reset-body {
                padding: 1.5rem 1rem;
            }

            .reset-icon {
                font-size: 2rem;
            }

            .reset-title {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="reset-wrapper">
        <div class="reset-container">
            <div class="reset-card">
                <!-- Header -->
                <div class="reset-header">
                    <i class="bi bi-shield-lock reset-icon"></i>
                    <h1 class="reset-title">Nueva Contraseña</h1>
                    <p class="reset-subtitle">Crea una contraseña segura para tu cuenta</p>
                </div>

                <!-- Body -->
                <div class="reset-body">
                    <!-- Mensaje de error -->
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form id="resetForm" asp-action="Recovery" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="resetToken" />

                        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                        <p class="requirements-text">
                            La nueva contraseña debe tener <strong>al menos 7</strong> caracteres e incluir
                            <strong>1 mayúscula</strong>, <strong>1 número</strong> y <strong>1 carácter especial</strong>.
                        </p>

                        <!-- Nueva contraseña -->
                        <div class="mb-3">
                            <label class="form-label">Nueva contraseña</label>
                            <div class="password-container">
                                <input asp-for="NewPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       minlength="7"
                                       pattern="^(?=.*[A-Z])(?=.*\\d)(?=.*[^\\w\\s]).{7,}$"
                                       title="Mínimo 7 caracteres, con al menos 1 mayúscula, 1 número y 1 carácter especial." />
                                <button class="toggle-password" type="button" id="toggleNewPwd" aria-label="Mostrar/Ocultar">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>

                            <!-- Indicador de fuerza -->
                            <div class="progress mt-2">
                                <div id="pwdStrength" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small id="pwdStrengthText" class="strength-text"></small>
                        </div>

                        <!-- Confirmar contraseña -->
                        <div class="mb-4">
                            <label class="form-label">Confirmar contraseña</label>
                            <div class="password-container">
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       minlength="7"
                                       pattern="^(?=.*[A-Z])(?=.*\\d)(?=.*[^\\w\\s]).{7,}$"
                                       title="Debe coincidir con la nueva contraseña." />
                                <button class="toggle-password" type="button" id="toggleConfirmPwd" aria-label="Mostrar/Ocultar">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Checklist -->
                        <ul class="checklist" id="pwdChecklist">
                            <li id="rule-length"><i class="bi bi-x-circle text-danger"></i> Mínimo 7 caracteres</li>
                            <li id="rule-upper"><i class="bi bi-x-circle text-danger"></i> Al menos 1 mayúscula (A-Z)</li>
                            <li id="rule-digit"><i class="bi bi-x-circle text-danger"></i> Al menos 1 número (0-9)</li>
                            <li id="rule-special"><i class="bi bi-x-circle text-danger"></i> Al menos 1 carácter especial</li>
                            <li id="rule-match"><i class="bi bi-x-circle text-danger"></i> Coinciden contraseña y confirmación</li>
                        </ul>

                        <div class="d-grid">
                            <button id="resetButton" type="submit" class="btn btn-reset">
                                <i class="bi bi-check-circle me-2"></i> Guardar nueva contraseña
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            const $form = $('#resetForm');
            const $btn = $('#resetButton');
            const $newPwd = $('#NewPassword');
            const $confirmPwd = $('#ConfirmPassword');
            const $strengthBar = $('#pwdStrength');
            const $strengthText = $('#pwdStrengthText');

            const re = /^(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{7,}$/;

            // Mostrar / ocultar contraseña
            $('#toggleNewPwd').on('click', function () {
                const t = $newPwd.attr('type') === 'password' ? 'text' : 'password';
                $newPwd.attr('type', t);
                $(this).find('i').toggleClass('bi-eye bi-eye-slash');
            });

            $('#toggleConfirmPwd').on('click', function () {
                const t = $confirmPwd.attr('type') === 'password' ? 'text' : 'password';
                $confirmPwd.attr('type', t);
                $(this).find('i').toggleClass('bi-eye bi-eye-slash');
            });

            function setRule(sel, ok) {
                const $li = $(sel);
                const $i = $li.find('i');
                $i.toggleClass('bi-check-circle text-success', ok);
                $i.toggleClass('bi-x-circle text-danger', !ok);
            }

            function scorePassword(pwd) {
                let score = 0;
                if (pwd.length >= 7) score += 25;
                if (/[A-Z]/.test(pwd)) score += 25;
                if (/\d/.test(pwd)) score += 25;
                if (/[^\w\s]/.test(pwd)) score += 25;
                if (pwd.length >= 10) score += 10;
                return Math.min(score, 100);
            }

            function updateStrengthUI(score) {
                $strengthBar.css('width', score + '%').attr('aria-valuenow', score);

                $strengthBar.removeClass('bg-danger bg-warning bg-success');

                if (score < 40) {
                    $strengthBar.addClass('bg-danger');
                    $strengthText.text('Débil');
                } else if (score < 80) {
                    $strengthBar.addClass('bg-warning');
                    $strengthText.text('Media');
                } else {
                    $strengthBar.addClass('bg-success');
                    $strengthText.text('Fuerte');
                }
            }

            function updateChecklist() {
                const v = $newPwd.val() || '';
                const c = $confirmPwd.val() || '';

                const okLen = v.length >= 7;
                const okUpper = /[A-Z]/.test(v);
                const okDigit = /\d/.test(v);
                const okSpecial = /[^\w\s]/.test(v);
                const okMatch = v.length > 0 && v === c;

                setRule('#rule-length', okLen);
                setRule('#rule-upper', okUpper);
                setRule('#rule-digit', okDigit);
                setRule('#rule-special', okSpecial);
                setRule('#rule-match', okMatch);

                // Validación visual
                toggleValidity($newPwd, okLen && okUpper && okDigit && okSpecial);
                toggleValidity($confirmPwd, okMatch);

                // Fuerza de contraseña
                updateStrengthUI(scorePassword(v));

                // Habilitar botón
                const allOk = re.test(v) && okMatch;
                $btn.prop('disabled', !allOk);
            }

            function toggleValidity($input, ok) {
                $input.toggleClass('is-valid', ok);
                $input.toggleClass('is-invalid', !ok && $input.val().length > 0);
            }

            // Eventos
            $newPwd.on('input', updateChecklist);
            $confirmPwd.on('input', updateChecklist);

            // Estado inicial
            updateChecklist();

            $form.on('submit', function () {
                $btn.prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Guardando...');
                return true;
            });

            // Efecto de focus en campos
            $('.form-control').on('focus', function() {
                $(this).css('border-color', 'var(--secondary-blue)');
            }).on('blur', function() {
                $(this).css('border-color', 'var(--accent-blue)');
            });
        })();
    </script>
</body>
</html>