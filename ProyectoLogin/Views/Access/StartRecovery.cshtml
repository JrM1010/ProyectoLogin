@model ProyectoLogin.Models.ViewModel.RecoveryViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Recuperar Contraseña - SmartCell POS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-blue: #1C1973;
            --secondary-blue: #514BF2;
            --accent-blue: #8B88F2;
            --dark-bg: #0D0E26;
            --alt-bg: #081C59;
            --light-text: #F0F0F7;
            --border-radius: 0.5rem;
        }

        html, body {
            height: 100%;
            width: 100%;
        }

        body {
            background: linear-gradient(135deg, var(--dark-bg) 0%, var(--alt-bg) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 1rem;
        }

        .recovery-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 100vh;
        }

        .recovery-container {
            width: 100%;
            max-width: 480px;
            animation: fadeIn 0.6s ease-out;
        }

        .recovery-card {
            background: var(--alt-bg);
            border: 1px solid var(--accent-blue);
            border-radius: var(--border-radius);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .recovery-header {
            background: var(--primary-blue);
            color: white;
            text-align: center;
            padding: 2rem 1.5rem;
            border-bottom: 1px solid var(--accent-blue);
        }

        .recovery-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: block;
        }

        .recovery-title {
            font-size: 1.75rem;
            font-weight: 700;
            margin: 0;
        }

        .recovery-subtitle {
            font-size: 0.9rem;
            opacity: 0.8;
            margin: 0.5rem 0 0 0;
        }

        .recovery-body {
            padding: 2rem 1.5rem;
        }

        .form-label {
            color: var(--light-text);
            font-weight: 600;
            margin-bottom: 0.75rem;
            font-size: 1rem;
        }

        .form-control {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid var(--accent-blue);
            border-radius: var(--border-radius);
            color: var(--light-text);
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

            .form-control:focus {
                background-color: rgba(255, 255, 255, 0.15);
                border-color: var(--secondary-blue);
                box-shadow: 0 0 0 0.2rem rgba(81, 75, 242, 0.25);
                color: var(--light-text);
                outline: none;
            }

            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.5);
            }

        .text-danger {
            color: #ff6b6b !important;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: block;
        }

        .btn-recovery {
            background: var(--secondary-blue);
            border: none;
            border-radius: var(--border-radius);
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-recovery:hover {
                background: #413BF0;
                transform: translateY(-1px);
            }

            .btn-recovery:active {
                transform: translateY(0);
            }

            .btn-recovery:disabled {
                background: var(--accent-blue);
                opacity: 0.7;
                transform: none;
            }

        .btn-back {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid var(--accent-blue);
            border-radius: var(--border-radius);
            color: var(--light-text);
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

            .btn-back:hover {
                background: rgba(255, 255, 255, 0.15);
                color: var(--light-text);
                transform: translateY(-1px);
            }

        .alert {
            border-radius: var(--border-radius);
            border: none;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.1);
            color: #4ade80;
            border: 1px solid rgba(40, 167, 69, 0.3);
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.1);
            color: #ff6b6b;
            border: 1px solid rgba(220, 53, 69, 0.3);
        }

        .alert i {
            margin-right: 0.5rem;
        }

        .btn-close {
            filter: invert(1);
            opacity: 0.8;
        }

            .btn-close:hover {
                opacity: 1;
            }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
            margin-right: 0.5rem;
        }

        .button-group {
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

        .validation-summary-errors {
            background: rgba(220, 53, 69, 0.1);
            border: 1px solid rgba(220, 53, 69, 0.3);
            border-radius: var(--border-radius);
            color: #ff6b6b;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 1rem;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 576px) {
            body {
                padding: 0.5rem;
            }

            .recovery-container {
                max-width: 100%;
            }

            .recovery-header {
                padding: 1.5rem 1rem;
            }

            .recovery-body {
                padding: 1.5rem 1rem;
            }

            .recovery-icon {
                font-size: 2.5rem;
            }

            .recovery-title {
                font-size: 1.5rem;
            }

            .button-group {
                flex-direction: column;
            }

                .button-group .btn {
                    width: 100%;
                }
        }
    </style>
</head>
<body>
    <div class="recovery-wrapper">
        <div class="recovery-container">
            <div class="recovery-card">
                <!-- Header -->
                <div class="recovery-header">
                    <i class="bi bi-shield-lock recovery-icon"></i>
                    <h1 class="recovery-title">Recuperar Contraseña</h1>
                    <p class="recovery-subtitle">Ingresa tu correo para restablecer tu contraseña</p>
                </div>

                <!-- Body -->
                <div class="recovery-body">
                    <!-- Mensajes de alerta -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form id="recoveryForm" action="@Url.Content("~/Access/StartRecovery")" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                        <div class="mb-4">
                            <label for="Email" class="form-label">Correo Electrónico</label>
                            @Html.TextBoxFor(d => d.Email, new {
                            @class = "form-control",
                                                        @type = "email",
                                                        placeholder = "ejemplo@correo.com",
                                                        autocomplete = "email",
                                                        required = "required",
                                                        pattern = @"^[^\s@]+@[^\s@]+\.[^\s@]+$",
                                                        title = "Ingresa un correo válido (ej. usuario@dominio.com)"
                                                        })
                            @Html.ValidationMessageFor(d => d.Email, null, new { @class = "text-danger" })
                        </div>

                        <div class="button-group">
                            <a href="@Url.Action("IniciarSesion", "Inicio")" class="btn btn-back">
                                <i class="bi bi-arrow-left me-2"></i> Volver al Inicio
                            </a>
                            <button id="recoveryButton" type="submit" class="btn btn-recovery">
                                <i class="bi bi-envelope me-2"></i> Recuperar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#recoveryForm').on('submit', function () {
                $('#recoveryButton').prop('disabled', true);
                $('#recoveryButton').html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Enviando...');
                $('.alert').remove();
                return true;
            });

            @if (!ViewData.ModelState.IsValid)
            {
                    <text>
                    $('#recoveryButton').prop('disabled', false);
                    $('#recoveryButton').html('<i class="bi bi-envelope me-2"></i> Recuperar');
                    </text>
            }

            // Auto-eliminar alerts después de 5 segundos
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);

            // Forzar centrado en caso de que persista el problema
            function centerRecovery() {
                const recoveryContainer = document.querySelector('.recovery-container');
                const windowHeight = window.innerHeight;
                const containerHeight = recoveryContainer.offsetHeight;
                const topMargin = (windowHeight - containerHeight) / 2;

                if (topMargin > 0) {
                    recoveryContainer.style.marginTop = topMargin + 'px';
                }
            }

            // Centrar al cargar y al redimensionar
            centerRecovery();
            window.addEventListener('resize', centerRecovery);
        });
    </script>
</body>
</html>