@model ProyectoLogin.Models.Promociones.Kit
@using System.Security.Claims

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Detalles del Kit";
    var gt = new System.Globalization.CultureInfo("es-GT");

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

<div class="container-fluid py-4">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center">
            <div class="bg-gradient-primary rounded-circle p-3 me-3">
                <i class="bi bi-gift text-white fs-4"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 text-gray-800">Detalles del Kit / Promoción</h1>
                <p class="text-muted mb-0">Información completa sobre la promoción seleccionada</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill d-flex align-items-center" title="Volver al listado de kits">
            <i class="bi bi-arrow-left me-2"></i>Volver a la Lista
        </a>
    </div>

    <!-- INFORMACIÓN PRINCIPAL DEL KIT -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-gradient-primary text-white py-3 border-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-tags fs-4 me-3"></i>
                        <h4 class="mb-0 fw-semibold">@Model.Nombre</h4>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.Descripcion))
                    {
                        <div class="alert alert-light border-start border-primary border-4 mb-4">
                            <div class="d-flex">
                                <i class="bi bi-chat-text text-primary me-3 fs-5"></i>
                                <div>
                                    <h5 class="alert-heading text-primary mb-2">Descripción</h5>
                                    <p class="mb-0">@Model.Descripcion</p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- RESUMEN FINANCIERO -->
                    <div class="row mb-4">
                        <div class="col-md-4 mb-3">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body text-center p-4">
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                                        <i class="bi bi-receipt text-primary fs-3"></i>
                                    </div>
                                    <h5 class="text-primary mb-2">Subtotal</h5>
                                    <p class="fs-4 fw-bold text-primary mb-0">@Model.Subtotal.ToString("C2", gt)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body text-center p-4">
                                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                                        <i class="bi bi-percent text-warning fs-3"></i>
                                    </div>
                                    <h5 class="text-warning mb-2">Descuento</h5>
                                    <p class="fs-4 fw-bold text-warning mb-0">@(Model.DescuentoPct * 100)%</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card border-0 bg-gradient-success text-white h-100">
                                <div class="card-body text-center p-4">
                                    <div class="bg-white bg-opacity-20 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                                        <i class="bi bi-currency-dollar fs-3"></i>
                                    </div>
                                    <h5 class="mb-2">Total Final</h5>
                                    <p class="fs-4 fw-bold mb-0">@Model.Total.ToString("C2", gt)</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- INFORMACIÓN ADICIONAL -->
                    <div class="d-flex justify-content-between align-items-center bg-light rounded p-3">
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-calendar me-2"></i>
                            <span>Creado el @Model.FechaCreacion.ToString("dd/MM/yyyy") a las @Model.FechaCreacion.ToString("HH:mm")</span>
                        </div>

                        @if (isAuth && isAdmin)
                        {
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@Model.IdKit"
                                class="btn btn-warning rounded-pill d-flex align-items-center" title="Editar kit">
                                    <i class="bi bi-pencil-square me-2"></i>Editar
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL DE RESUMEN -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3 border-0">
                    <h5 class="mb-0 fw-semibold text-gray-800">
                        <i class="bi bi-info-circle text-primary me-2"></i>Resumen
                    </h5>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-muted">Productos incluidos:</span>
                        <span class="badge bg-primary rounded-pill fs-6">@(Model.Detalles?.Count() ?? 0)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Estado:</span>
                        <span class="badge bg-success rounded-pill">Activo</span>
                    </div>
                </div>
            </div>

            @if (isAuth && isAdmin)
            {
            <!-- ACCIONES RÁPIDAS -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 border-0">
                    <h5 class="mb-0 fw-semibold text-gray-800">
                        <i class="bi bi-lightning text-primary me-2"></i>Acciones Rápidas
                    </h5>
                </div>

                
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.IdKit" class="btn btn-warning d-flex align-items-center justify-content-center">
                                <i class="bi bi-pencil-square me-2"></i>Editar Kit
                            </a>
                        </div>
                    </div>
                
            </div>
            }
        </div>
    </div>

    <!-- PRODUCTOS INCLUIDOS EN EL KIT -->
    @if (Model.Detalles != null && Model.Detalles.Any())
    {
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-light d-flex align-items-center py-3 border-0">
                <i class="bi bi-list-check text-primary me-2 fs-5"></i>
                <h5 class="mb-0 fw-semibold text-gray-800">Productos Incluidos en el Kit</h5>
                <span class="badge bg-primary ms-2 fs-6">@Model.Detalles.Count()</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 fw-semibold text-gray-700">Producto</th>
                                <th class="text-center fw-semibold text-gray-700">Cantidad</th>
                                <th class="text-center fw-semibold text-gray-700">Precio Unitario</th>
                                <th class="text-center fw-semibold text-gray-700">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                var nombreProducto = d.Producto?.Nombre ?? "(Sin nombre)";
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                                <i class="bi bi-box text-primary"></i>
                                            </div>
                                            <div>
                                                <span class="fw-medium">@nombreProducto</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill px-3 py-2">@d.Cantidad</span>
                                    </td>
                                    <td class="text-center fw-semibold text-gray-700">
                                        @d.PrecioUnitarioSnapshot.ToString("C2", gt)
                                    </td>
                                    <td class="text-center fw-bold text-success">
                                        @((d.PrecioUnitarioSnapshot * d.Cantidad).ToString("C2", gt))
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-group-divider">
                            <tr class="table-active">
                                <td colspan="3" class="text-end fw-bold fs-6 ps-4 py-3">Total del Kit:</td>
                                <td class="text-center fw-bold fs-6 text-success py-3">
                                    @Model.Total.ToString("C2", gt)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                    <i class="bi bi-inboxes text-muted fs-1"></i>
                </div>
                <h4 class="text-muted mb-3">No hay productos en este kit</h4>
                <p class="text-muted mb-4">Este kit no contiene productos. Puedes editarlo para agregar productos.</p>
                <a asp-action="Edit" asp-route-id="@Model.IdKit" class="btn btn-primary rounded-pill d-inline-flex align-items-center">
                    <i class="bi bi-pencil-square me-2"></i>Editar Kit
                </a>
            </div>
        </div>
    }
</div>

<style>
    .table td {
        vertical-align: middle;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
    }

    .card {
        border-radius: 0.5rem;
    }

    .badge.rounded-pill {
        padding: 0.5em 0.75em;
    }

    .btn {
        border-radius: 0.375rem;
        transition: all 0.15s ease-in-out;
    }

        .btn:hover {
            transform: translateY(-1px);
        }
</style>