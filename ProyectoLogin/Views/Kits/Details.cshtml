@model ProyectoLogin.Models.Promociones.Kit

@{
    ViewData["Title"] = "Detalles del Kit";
    var gt = new System.Globalization.CultureInfo("es-GT");
}

<div class="container-fluid">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-box-seam text-primary me-2"></i>Detalles del Kit / Promoción
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Volver al listado de kits">
            <i class="bi bi-arrow-left me-1"></i>Volver a la Lista
        </a>
    </div>

    <!-- INFORMACIÓN PRINCIPAL DEL KIT -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white py-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-tags fs-4 me-2"></i>
                <h4 class="mb-0">@Model.Nombre</h4>
            </div>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.Descripcion))
            {
                <div class="alert alert-light border mb-4">
                    <i class="bi bi-chat-text text-primary me-2"></i>
                    @Model.Descripcion
                </div>
            }

            <!-- RESUMEN FINANCIERO -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body text-center">
                            <i class="bi bi-receipt text-primary fs-1 mb-2"></i>
                            <h5 class="text-primary">Subtotal</h5>
                            <p class="fs-4 fw-bold text-primary mb-0">@Model.Subtotal.ToString("C2", gt)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body text-center">
                            <i class="bi bi-percent text-warning fs-1 mb-2"></i>
                            <h5 class="text-warning">Descuento</h5>
                            <p class="fs-4 fw-bold text-warning mb-0">@(Model.DescuentoPct * 100)%</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 bg-success text-white">
                        <div class="card-body text-center">
                            <i class="bi bi-currency-dollar fs-1 mb-2"></i>
                            <h5>Total Final</h5>
                            <p class="fs-4 fw-bold mb-0">@Model.Total.ToString("C2", gt)</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- INFORMACIÓN ADICIONAL -->
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center text-muted">
                        <small>
                            <i class="bi bi-calendar me-1"></i>
                            Creado el @Model.FechaCreacion.ToString("dd/MM/yyyy") a las @Model.FechaCreacion.ToString("HH:mm")
                        </small>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.IdKit"
                               class="btn btn-outline-warning rounded-pill btn-sm" title="Editar kit">
                                <i class="bi bi-pencil-square me-1"></i>Editar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PRODUCTOS INCLUIDOS EN EL KIT -->
    @if (Model.Detalles != null && Model.Detalles.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex align-items-center">
                <i class="bi bi-list-check text-primary me-2"></i>
                <h5 class="mb-0">Productos Incluidos en el Kit</h5>
                <span class="badge bg-primary ms-2">@Model.Detalles.Count()</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-center">Precio Unitario</th>
                                <th class="text-center">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Detalles)
                            {
                                var nombreProducto = d.Producto?.Nombre ?? "(Sin nombre)";
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-box text-muted me-2"></i>
                                            @nombreProducto
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill">@d.Cantidad</span>
                                    </td>
                                    <td class="text-center fw-semibold">
                                        @d.PrecioUnitarioSnapshot.ToString("C2", gt)
                                    </td>
                                    <td class="text-center fw-bold text-success">
                                        @((d.PrecioUnitarioSnapshot * d.Cantidad).ToString("C2", gt))
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-group-divider">
                            <tr class="table-active">
                                <td colspan="3" class="text-end fw-bold fs-6">Total del Kit:</td>
                                <td class="text-center fw-bold fs-6 text-success">
                                    @Model.Total.ToString("C2", gt)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inboxes display-1 text-muted mb-3"></i>
                <h4 class="text-muted mb-3">No hay productos en este kit</h4>
                <p class="text-muted mb-4">Este kit no contiene productos. Puedes editarlo para agregar productos.</p>
                <a asp-action="Edit" asp-route-id="@Model.IdKit" class="btn btn-primary rounded-pill">
                    <i class="bi bi-pencil-square me-1"></i>Editar Kit
                </a>
            </div>
        </div>
    }
</div>

<style>
    .table td {
        vertical-align: middle;
    }

    .card.bg-light {
        background-color: #f8f9fa !important;
    }

    .badge.rounded-pill {
        padding: 0.5em 0.75em;
    }
</style>