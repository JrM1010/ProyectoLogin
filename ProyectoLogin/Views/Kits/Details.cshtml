@model ProyectoLogin.Models.Promociones.Kit
@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Detalles del Kit";
    var gt = new System.Globalization.CultureInfo("es-GT");

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

@section Styles {
    <style>
        :root {
            /* MISMA PALETA QUE DETALLES DE PRODUCTO */
            --inventory-primary: #1C1973;
            --inventory-secondary: #514BF2;
            --inventory-accent: #8B88F2;
            --inventory-bg: #f5f6fa;
            --inventory-card: #ffffff;
            --inventory-text: #212529;
            --inventory-radius: .75rem;
        }

        /* Fondo del módulo (igual a productos) */
        .inventory-theme {
            background: var(--inventory-bg);
            padding: 1.5rem 0 2rem;
        }

        /* Card principal (igual que create-card de productos) */
        .create-card {
            background: var(--inventory-card);
            border: 1px solid #e5e7eb;
            border-radius: var(--inventory-radius);
            box-shadow: 0 6px 20px rgba(15,23,42,.08);
            overflow: hidden;
            margin-bottom: 1.5rem;
            transition: all .25s ease;
        }

            .create-card:hover {
                box-shadow: 0 10px 28px rgba(15,23,42,.12);
                transform: translateY(-1px);
            }

        /* Header con gradiente */
        .create-card-header {
            background: linear-gradient(90deg, var(--inventory-primary), var(--inventory-secondary));
            color: #fff;
            padding: 1.25rem 1.75rem;
            border-bottom: 1px solid rgba(255,255,255,.18);
            display: flex;
            align-items: center;
            gap: .75rem;
        }

            .create-card-header h2 {
                font-size: 1.25rem;
                margin-bottom: .1rem
            }

            .create-card-header small {
                font-size: .85rem;
                opacity: .9
            }

        .create-card-body {
            padding: 1.5rem 1.75rem 1.75rem;
        }

        /* Secciones internas (mismo estilo que productos) */
        .section-container {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: var(--inventory-radius);
            padding: 1.25rem 1.25rem 1.15rem;
            margin-bottom: 1.25rem;
            transition: all .25s ease;
        }

            .section-container:hover {
                box-shadow: 0 4px 14px rgba(15,23,42,.06);
                border-color: var(--inventory-accent);
            }

        .section-title {
            color: #111827;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: .85rem;
            padding-bottom: .6rem;
            border-bottom: 2px solid rgba(81,75,242,.18);
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .section-title i {
                background: var(--inventory-secondary);
                color: #fff;
                width: 1.9rem;
                height: 1.9rem;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: .95rem;
            }

        /* Texto / badges */
        .info-label {
            color: #6b7280;
            font-size: .8rem;
            margin-bottom: .2rem
        }

        .info-value {
            font-weight: 600;
            color: #111827
        }

        .description-box {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: .5rem;
            padding: .85rem 1rem;
            font-size: .9rem;
            color: #111827;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 2rem;
            padding: .25rem .65rem;
            font-weight: 600;
            font-size: .78rem;
        }

        .st-ok {
            background: #ecfdf5;
            color: #166534;
            border: 1px solid #bbf7d0
        }

        .st-bad {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca
        }

        .badge-soft {
            display: inline-flex;
            align-items: center;
            padding: .25rem .6rem;
            border-radius: 999px;
            background: #e5e7eb;
            color: #111827;
            font-size: .78rem;
            font-weight: 500;
        }

        /* Mini resumen financiero en “cards” suaves */
        .mini-card {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: .6rem;
            padding: .75rem .9rem;
            height: 100%;
        }

        .mini-label {
            font-size: .78rem;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .04em
        }

        .mini-value {
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827
        }

        .mini-value-success {
            color: #16a34a;
            font-weight: 800
        }

        /* Tabla (idéntica a productos) */
        .table-responsive {
            border-radius: var(--inventory-radius);
            border: 1px solid #e5e7eb;
            background: #fff
        }

        .table thead th {
            background: #f3f4ff;
            border-bottom: 1px solid #e5e7eb;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #111827;
        }

        .table tbody td {
            font-size: .82rem;
            color: #111827;
            border-color: #e5e7eb
        }

        .table tbody tr:hover {
            background: #eef2ff
        }

        .price-sell, .price-unit {
            color: #16a34a;
            font-weight: 700
        }

        .price-date {
            color: #6b7280;
            font-size: .8rem
        }

        .tfoot-soft td {
            background: #f9fafb;
            border-top: 1px solid #e5e7eb !important;
            font-weight: 700;
            color: #111827;
        }

        /* Barra de acciones inferior (igual a productos) */
        .details-actions-bar {
            border-top: 1px solid #e5e7eb !important;
            padding-top: 1rem;
            margin-top: .5rem
        }

        .btn-create-outline {
            border: 1px solid var(--inventory-accent);
            background: transparent;
            color: var(--inventory-secondary);
            border-radius: var(--inventory-radius);
            font-weight: 500;
            padding: .6rem 1.4rem;
            font-size: .88rem;
            transition: all .25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

            .btn-create-outline:hover {
                background: var(--inventory-accent);
                color: #fff;
                box-shadow: 0 4px 10px rgba(15,23,42,.16);
                transform: translateY(-1px)
            }

        .btn-create-primary {
            background: var(--inventory-secondary);
            border: none;
            border-radius: var(--inventory-radius);
            color: #fff;
            font-weight: 600;
            padding: .6rem 1.4rem;
            font-size: .9rem;
            transition: all .25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

            .btn-create-primary:hover {
                background: var(--inventory-primary);
                box-shadow: 0 4px 12px rgba(15,23,42,.18);
                transform: translateY(-1px)
            }

        @@media (max-width:768px) {
            .create-card-body

        {
            padding: 1.1rem 1.1rem 1.3rem
        }

        .section-container {
            padding: .9rem .85rem
        }

        .section-title {
            font-size: .95rem;
            padding-bottom: .4rem
        }

        .details-actions-bar .d-flex {
            flex-direction: column;
            align-items: stretch !important;
            gap: .6rem
        }

        .btn-create-outline, .btn-create-primary {
            width: 100%;
            justify-content: center
        }

        }
    </style>
}

<div class="container inventory-theme">
    <div class="create-card">
        <!-- Encabezado: igual estilo que “Detalles de producto” -->
        <div class="create-card-header">
            <i class="bi bi-gift fs-3"></i>
            <div>
                <h2 class="mb-0">Detalles del Kit / Promoción</h2>
                <small>Información general y productos incluidos</small>
            </div>
        </div>

        <div class="create-card-body">
            <div class="row g-3">
                <!-- Columna izquierda -->
                <div class="col-lg-6">
                    <!-- Información básica del kit -->
                    <div class="section-container">
                        <h3 class="section-title">
                            <i class="bi bi-card-text"></i>
                            <span>Información básica</span>
                        </h3>

                        <div class="mb-3">
                            <div class="info-label">Nombre del kit</div>
                            <div class="info-value fs-5">@Model.Nombre</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="info-label">Descuento</div>
                                <div class="info-value">
                                    @if (Model.DescuentoPct > 0)
                                    {
                                        <span class="badge-soft"><i class="bi bi-percent me-1"></i>@((Model.DescuentoPct * 100).ToString("0"))%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descuento</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-label">Estado</div>
                                <div class="info-value">
                                    @if (Model.Activo)
                                    {
                                        <span class="status-pill st-ok"><i class="bi bi-check-circle-fill"></i> Activo</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill st-bad"><i class="bi bi-x-circle-fill"></i> Inactivo</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-label">Fecha de creación</div>
                                <div class="info-value">
                                    @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen financiero (alineado al look claro) -->
                    <div class="section-container">
                        <h3 class="section-title">
                            <i class="bi bi-cash-coin"></i>
                            <span>Resumen financiero</span>
                        </h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="mini-card">
                                    <div class="mini-label">Subtotal</div>
                                    <div class="mini-value">@Model.Subtotal.ToString("C2", gt)</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mini-card">
                                    <div class="mini-label">Descuento</div>
                                    <div class="mini-value">@((Model.DescuentoPct * 100).ToString("0"))%</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mini-card">
                                    <div class="mini-label">Total</div>
                                    <div class="mini-value mini-value-success">@Model.Total.ToString("C2", gt)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Descripción -->
                    @if (!string.IsNullOrEmpty(Model.Descripcion))
                    {
                        <div class="section-container">
                            <h3 class="section-title">
                                <i class="bi bi-file-text"></i>
                                <span>Descripción</span>
                            </h3>
                            <div class="description-box">
                                @Model.Descripcion
                            </div>
                        </div>
                    }
                </div>

                <!-- Columna derecha: Productos incluidos -->
                <div class="col-lg-6">
                    <div class="section-container h-100">
                        <h3 class="section-title">
                            <i class="bi bi-list-check"></i>
                            <span>Productos incluidos (@(Model.Detalles?.Count() ?? 0))</span>
                        </h3>

                        @if (Model.Detalles != null && Model.Detalles.Any())
                        {
                            <div class="table-responsive" style="max-height: 460px;">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Producto</th>
                                            <th class="text-center">Cantidad</th>
                                            <th class="text-center">Precio unitario</th>
                                            <th class="text-center">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.Detalles)
                                        {
                                            var nombreProducto = d.Producto?.Nombre ?? "(Sin nombre)";
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@nombreProducto</div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge-soft">@d.Cantidad</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="price-unit">@d.PrecioUnitarioSnapshot.ToString("C2", gt)</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="price-sell">@((d.PrecioUnitarioSnapshot * d.Cantidad).ToString("C2", gt))</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="tfoot-soft">
                                        <tr>
                                            <td colspan="3" class="text-end">Total del kit:</td>
                                            <td class="text-center">@Model.Total.ToString("C2", gt)</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inboxes fs-2 d-block mb-2"></i>
                                No hay productos registrados en este kit.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Acciones (idéntico patrón que productos) -->
            <div class="d-flex justify-content-between align-items-center pt-3 mt-2 details-actions-bar">
                <a asp-action="Index" class="btn-create-outline">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
                <div>
                    @if (isAuth && isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.IdKit" class="btn-create-primary">
                            <i class="bi bi-pencil-square me-1"></i> Editar
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
