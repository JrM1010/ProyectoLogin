@model IEnumerable<ProyectoLogin.Models.Promociones.Kit>

@{
    ViewData["Title"] = "Lista de Kits / Promociones";
    var gt = new System.Globalization.CultureInfo("es-GT");
}

<div class="container-fluid">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-box-seam text-primary me-2"></i>Kits / Promociones
        </h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill" title="Crear nuevo kit o promoción">
            <i class="bi bi-plus-circle me-1"></i>Nuevo Kit / Promoción
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex align-items-center">
                <i class="bi bi-list-check fs-5 me-2"></i>
                <h5 class="mb-0 me-2">Kits / Promociones Creados</h5>
                <span class="badge bg-light text-primary fs-6">@Model.Count()</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th class="text-center">Descuento</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Fecha de creación</th>
                                <th class="text-center" style="width:120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kit in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold text-muted">#@kit.IdKit</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-tags text-primary me-2"></i>
                                            @kit.Nombre
                                        </div>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(kit.Descripcion))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else
                                        {
                                            @kit.Descripcion
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (kit.DescuentoPct > 0)
                                        {
                                            <span class="badge bg-success">
                                                @((kit.DescuentoPct * 100).ToString("0.##"))%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">0%</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold text-success">
                                        @kit.Total.ToString("C2", gt)
                                    </td>
                                    <td class="text-center text-muted">
                                        <small>@kit.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Ver detalles -->
                                            <a asp-action="Details" asp-route-id="@kit.IdKit"
                                               class="btn btn-outline-info rounded-circle btn-sm" title="Ver detalles del kit">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Editar -->
                                            <a asp-action="Edit" asp-route-id="@kit.IdKit"
                                               class="btn btn-outline-warning rounded-circle btn-sm" title="Editar kit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Eliminar -->
                                            <button class="btn btn-outline-danger rounded-circle btn-sm eliminar-btn"
                                                    data-id="@kit.IdKit" data-nombre="@kit.Nombre" title="Eliminar kit">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-box-seam display-1 text-muted mb-3"></i>
                <h4 class="text-muted mb-3">No hay kits registrados</h4>
                <p class="text-muted mb-4">Comienza creando tu primer kit o promoción para ofrecer productos combinados.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill">
                    <i class="bi bi-plus-circle me-1"></i>Crear Primer Kit
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            document.querySelectorAll(".eliminar-btn").forEach(btn => {
                btn.addEventListener("click", async (e) => {
                    const id = e.currentTarget.dataset.id;
                    const nombre = e.currentTarget.dataset.nombre;

                    if (!id) return;

                    if (!confirm(`¿Estás seguro de que deseas eliminar el kit "${nombre}"? Esta acción no se puede deshacer.`)) return;

                    const formData = new FormData();
                    formData.append("__RequestVerificationToken", token);
                    formData.append("id", id);

                    try {
                        // Mostrar indicador de carga
                        e.currentTarget.innerHTML = '<i class="bi bi-hourglass-split"></i>';
                        e.currentTarget.disabled = true;

                        const res = await fetch(`/Kits/Delete`, {
                            method: 'POST',
                            body: formData
                        });

                        if (res.ok) {
                            // Mostrar mensaje de éxito antes de recargar
                            const toast = document.createElement('div');
                            toast.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
                            toast.style.zIndex = '1060';
                            toast.innerHTML = `
                                <i class="bi bi-check-circle-fill me-2"></i>Kit eliminado correctamente
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            `;
                            document.body.appendChild(toast);

                            // Recargar después de un breve delay
                            setTimeout(() => {
                                location.reload();
                            }, 1500);
                        } else {
                            const msg = await res.text();
                            alert("No se pudo eliminar el kit. Por favor, intenta nuevamente.");
                            console.error(msg);

                            // Restaurar botón
                            e.currentTarget.innerHTML = '<i class="bi bi-trash"></i>';
                            e.currentTarget.disabled = false;
                        }
                    } catch (err) {
                        alert("Error al conectar con el servidor. Verifica tu conexión e intenta nuevamente.");
                        console.error(err);

                        // Restaurar botón
                        e.currentTarget.innerHTML = '<i class="bi bi-trash"></i>';
                        e.currentTarget.disabled = false;
                    }
                });
            });
        });
    </script>

    <style>
        .table td {
            vertical-align: middle;
        }

        .btn-sm {
            padding: 0.375rem 0.5rem;
        }

        .card-header {
            border-bottom: none;
        }

        .badge {
            font-size: 0.75rem;
        }
    </style>
}