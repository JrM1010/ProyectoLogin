@model IEnumerable<ProyectoLogin.Models.Promociones.Kit>
@using System.Security.Claims

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Kits / Promociones - SmartCell POS";
    var gt = new System.Globalization.CultureInfo("es-GT");

    // Parámetros de paginación
    var pageNumber = ViewBag.PageNumber ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalItems = ViewBag.TotalItems ?? Model?.Count() ?? 0;
    var totalPages = ViewBag.TotalPages ?? (int)Math.Ceiling((double)totalItems / pageSize);

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;

    var totalActivos = Model?.Count(k => k.Activo) ?? 0;
    var totalConDescuento = Model?.Count(k => k.DescuentoPct > 0) ?? 0;
    var totalValor = Model?.Sum(k => k.Total) ?? 0m;
}

@section Styles {
    <style>
        :root {
            --inventory-primary: #1C1973;
            --inventory-secondary: #514BF2;
            --inventory-accent: #8B88F2;
            --inventory-bg: #f5f6fa;
            --inventory-card: #ffffff;
            --inventory-text: #212529;
            --inventory-radius: .75rem;
            --muted: #6b7280;
            --border-soft: #e5e7eb;
        }

        /* Fondo general */
        .inventory-theme {
            background: var(--inventory-bg);
            padding: 1.5rem 0 2rem;
        }

        /* Header con mismo estilo que Productos */
        .page-header {
            background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
            border: 1px solid rgba(255,255,255,.12);
            border-radius: var(--inventory-radius);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1rem;
            box-shadow: 0 6px 18px rgba(15,23,42,.18);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #fff;
        }

            .page-header h1 {
                font-size: 1.3rem;
                margin: 0;
                display: flex;
                align-items: center;
                gap: .4rem;
                font-weight: 700;
                color: #fff
            }

                .page-header h1 i {
                    font-size: 1.4rem
                }

            .page-header .subtitle {
                color: rgba(249,250,251,.9);
                font-size: .85rem;
                margin-top: .15rem
            }

            .page-header .btn {
                font-size: .86rem;
                border-radius: var(--inventory-radius);
                padding: .5rem 1rem
            }

        .btn-create-outline {
            border: 1px solid var(--inventory-accent);
            background: transparent;
            color: #fff;
            border-radius: var(--inventory-radius);
            font-weight: 500;
            padding: .5rem 1.4rem;
            font-size: .86rem;
            transition: .25s;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            text-decoration: none
        }

            .btn-create-outline:hover {
                background: rgba(139,136,242,.16);
                color: #fff;
                box-shadow: 0 4px 10px rgba(15,23,42,.25);
                transform: translateY(-1px)
            }

        .btn-create-primary {
            background: #fff;
            color: var(--inventory-primary);
            border: none;
            border-radius: var(--inventory-radius);
            font-weight: 600;
            padding: .5rem 1.4rem;
            font-size: .86rem;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: .25s;
            text-decoration: none
        }

            .btn-create-primary:hover {
                background: #f9fafb;
                color: var(--inventory-secondary);
                box-shadow: 0 4px 12px rgba(15,23,42,.25);
                transform: translateY(-1px)
            }

        /* Card genérica (igual Productos) */
        .inventory-card {
            background: var(--inventory-card);
            border: 1px solid var(--border-soft);
            border-radius: var(--inventory-radius);
            overflow: hidden;
            margin-bottom: 1.25rem;
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            transition: .22s;
        }

            .inventory-card:hover {
                box-shadow: 0 7px 20px rgba(15,23,42,.10);
                transform: translateY(-1px)
            }

            .inventory-card .card-head {
                display: flex;
                align-items: center;
                gap: .75rem;
                padding: .85rem 1.15rem;
                border-bottom: 1px solid rgba(0,0,0,.04);
                background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
                color: #fff;
            }

                .inventory-card .card-head .title {
                    margin: 0;
                    font-size: 1rem;
                    font-weight: 700;
                    color: #fff
                }

        .stats-badge {
            margin-left: auto;
            background: rgba(15,23,42,.06);
            border: 1px solid rgba(226,232,240,.45);
            border-radius: 999px;
            padding: .25rem .8rem;
            font-size: .78rem;
            color: #e5e7eb;
            display: inline-flex;
            align-items: center;
            gap: .25rem
        }

        /* Tabla (igual Productos) */
        .table {
            margin-bottom: 0;
            font-size: .85rem;
            color: #111827
        }

            .table thead th {
                background: #f3f4ff;
                font-weight: 600;
                font-size: .78rem;
                border-bottom: 1px solid var(--border-soft);
                white-space: nowrap;
                text-transform: uppercase;
                letter-spacing: .03em;
                color: #6b7280
            }

            .table tbody td {
                vertical-align: middle;
                border-color: var(--border-soft)
            }

        .table-hover tbody tr:hover {
            background: #f9fafb
        }

        /* Botones de acción (igual Productos) */
        .action-btn {
            width: 2.2rem;
            height: 2.2rem;
            border-radius: .7rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 .12rem;
            padding: 0;
            font-size: .9rem;
            transition: .2s;
            border: none
        }

        .btn-info.action-btn {
            background: #eff6ff;
            color: #2563eb
        }

            .btn-info.action-btn i {
                color: #2563eb !important
            }

            .btn-info.action-btn:hover {
                background: #2563eb;
                color: #fff;
                transform: translateY(-1px)
            }

        .btn-warning.action-btn {
            background: #fef3c7;
            color: #92400e
        }

            .btn-warning.action-btn:hover {
                background: #fbbf24;
                color: #111827;
                transform: translateY(-1px)
            }

        .btn-danger.action-btn {
            background: #fee2e2;
            color: #b91c1c
        }

            .btn-danger.action-btn:hover {
                background: #dc2626;
                color: #fff;
                transform: translateY(-1px)
            }

        .btn-success.action-btn {
            background: #dcfce7;
            color: #166534
        }

            .btn-success.action-btn:hover {
                background: #22c55e;
                color: #fff;
                transform: translateY(-1px)
            }

        /* Paginación */
        .pagination .page-link {
            border-radius: 999px !important;
            font-size: .78rem;
            padding: .25rem .6rem
        }

        .pagination .page-item.active .page-link {
            background-color: var(--inventory-secondary);
            border-color: var(--inventory-secondary)
        }

        /* Toast claro */
        .toast-light {
            background: #fff;
            color: #111827;
            border-radius: .75rem;
            border: 1px solid var(--border-soft);
            box-shadow: 0 8px 22px rgba(0,0,0,.08);
            font-size: .85rem
        }

        /* Responsive */
        @@media (max-width:768px) {
            .page-header {
                flex-direction: column;
                align-items: flex-start;
                padding: .9rem 1rem
            }

                .page-header h1 {
                    font-size: 1.1rem
                }

                .page-header .subtitle {
                    font-size: .8rem
                }

                .page-header .d-flex.gap-2 {
                    width: 100%;
                    justify-content: flex-start;
                    flex-wrap: wrap
                }
        }
    </style>
}

<div class="container-fluid py-2 inventory-theme">

    <!-- Encabezado (mismo componente que Productos) -->
    <div class="page-header">
        <div>
            <h1>
                <i class="bi bi-gift"></i>
                Kits / Promociones
            </h1>
            <div class="subtitle">Crea y administra combos y ofertas de tu catálogo</div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Home")" class="btn btn-create-outline">
                <i class="bi bi-arrow-left me-1"></i> Inicio
            </a>
            @if (isAuth && isAdmin)
            {
                <a asp-action="Create" class="btn btn-create-primary">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo
                </a>
            }
        </div>
    </div>

    <!-- Toast (con look & feel claro) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100;">
        <div id="toastNotificacion" class="toast toast-light align-items-center border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Stats en tarjetas blancas (consistente con Productos) -->
        <div class="row g-3 mb-3">
            <div class="col-xl-3 col-md-6">
                <div class="inventory-card p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-uppercase small text-muted">Total kits</div>
                            <div class="fs-5 fw-bold">@totalItems</div>
                        </div>
                        <div class="rounded-3 px-3 py-2" style="background:#f3f4ff;">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="inventory-card p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-uppercase small text-muted">Kits activos</div>
                            <div class="fs-5 fw-bold">@totalActivos</div>
                        </div>
                        <div class="rounded-3 px-3 py-2" style="background:#dcfce7;">
                            <i class="bi bi-check-circle text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="inventory-card p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-uppercase small text-muted">Con descuento</div>
                            <div class="fs-5 fw-bold">@totalConDescuento</div>
                        </div>
                        <div class="rounded-3 px-3 py-2" style="background:#fff7ed;">
                            <i class="bi bi-percent text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="inventory-card p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-uppercase small text-muted">Valor total</div>
                            <div class="fs-5 fw-bold">@(totalValor.ToString("C2", gt))</div>
                        </div>
                        <div class="rounded-3 px-3 py-2" style="background:#e5f9f3;">
                            <i class="bi bi-currency-dollar" style="color:#0f766e;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla principal en tarjeta tipo Productos -->
        <div class="inventory-card">
            <div class="card-head">
                <i class="bi bi-list-check fs-5"></i>
                <h3 class="title mb-0">Kits / Promociones creados</h3>
                <span class="stats-badge"><i class="bi bi-archive"></i>@Model.Count()</span>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <small class="text-white-50 me-1">Ordenar por:</small>
                    <select id="filtroOrden" class="form-select form-select-sm" style="width:auto;">
                        <option value="fecha-desc">Más recientes</option>
                        <option value="fecha-asc">Más antiguos</option>
                        <option value="nombre-asc">Nombre A-Z</option>
                        <option value="nombre-desc">Nombre Z-A</option>
                        <option value="precio-desc">Mayor precio</option>
                        <option value="precio-asc">Menor precio</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th class="col-hide-sm">Descripción</th>
                            <th class="text-center">Descuento</th>
                            <th class="text-center">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Fecha creación</th>
                            <th class="text-center" style="width:150px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kit in Model)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">#@kit.IdKit</td>
                                <td>
                                    <div class="fw-semibold">@kit.Nombre</div>
                                    <small class="text-muted">@(kit.Detalles?.Count() ?? 0) productos</small>
                                </td>
                                <td class="col-hide-sm">
                                    @if (string.IsNullOrEmpty(kit.Descripcion))
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        <span class="text-truncate d-inline-block" style="max-width: 260px;" title="@kit.Descripcion">
                                            @kit.Descripcion
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (kit.DescuentoPct > 0)
                                    {
                                        <span class="badge text-bg-success">
                                            @((kit.DescuentoPct * 100).ToString("0.##"))%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light text-muted">0%</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold text-success">@kit.Total.ToString("C2", gt)</span>
                                </td>
                                <td class="text-center">
                                    @if (kit.Activo)
                                    {
                                        <span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <small>@kit.FechaCreacion.ToString("dd/MM/yyyy")</small><br />
                                    <small class="text-muted">@kit.FechaCreacion.ToString("HH:mm")</small>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex">
                                        <!-- Detalles -->
                                        <a asp-action="Details" asp-route-id="@kit.IdKit" class="btn btn-info action-btn" title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (isAuth && isAdmin)
                                        {
                                            <!-- Editar -->
                                            <a asp-action="Edit" asp-route-id="@kit.IdKit" class="btn btn-warning action-btn" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <!-- Activar / Desactivar -->
                                            <button class="btn @(kit.Activo ? "btn-danger" : "btn-success") action-btn btn-eliminar-kit"
                                                    data-id="@kit.IdKit"
                                                    data-nombre="@kit.Nombre"
                                                    data-activo="@kit.Activo"
                                                    title="@(kit.Activo ? "Desactivar kit" : "Activar kit")">
                                                <i class="bi @(kit.Activo ? "bi-trash" : "bi-arrow-clockwise")"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="p-3 border-top" style="border-color:#e5e7eb!important">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div class="text-muted small">
                            Mostrando @((pageNumber - 1) * pageSize + 1)-@Math.Min(pageNumber * pageSize, totalItems) de @totalItems kits
                        </div>
                        <nav>
                            <ul class="pagination mb-0">
                                <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = pageNumber - 1, pageSize = pageSize })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @{
                                    for (int i = 1; i <= totalPages; i++)
                                    {
                                        if (i == 1 || i == totalPages || (i >= pageNumber - 2 && i <= pageNumber + 2))
                                        {
                                            <li class="page-item @(i == pageNumber ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = pageSize })">@i</a>
                                            </li>
                                        }
                                        else if (i == pageNumber - 3 || i == pageNumber + 3)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                    }
                                }

                                <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = pageNumber + 1, pageSize = pageSize })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Estado vacío con estilo claro -->
        <div class="inventory-card p-5 text-center">
            <div class="mb-3">
                <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                      style="width:88px;height:88px;background:#f3f4ff;">
                    <i class="bi bi-box-seam fs-2" style="color:var(--inventory-secondary)"></i>
                </span>
            </div>
            <h4 class="mb-2">No hay kits registrados</h4>
            <p class="text-muted mb-3">Crea tu primer kit o promoción para ofrecer paquetes atractivos a tus clientes.</p>
            @if (isAuth && isAdmin)
            {
                <a asp-action="Create" class="btn btn-create-primary">
                    <i class="bi bi-plus-circle me-1"></i> Crear Primer Kit
                </a>
            }
        </div>
    }
</div>

@if (isAuth && isAdmin)
{
    <!-- Modal Confirmación (mantiene funcionalidad, look de Productos) -->
    <div class="modal fade" id="modalEliminarKit" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));color:#fff;border-bottom:1px solid rgba(255,255,255,.16);border-radius:var(--inventory-radius) var(--inventory-radius) 0 0;">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle fs-5 me-2"></i>
                        <h5 class="modal-title mb-0">Confirmar acción</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h5 id="modal-eliminar-titulo" class="mb-2">¿Modificar estado del kit?</h5>
                    <p id="modal-eliminar-descripcion" class="text-muted mb-0">Esta acción actualizará la disponibilidad del kit en ventas.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btn-confirmar-eliminar">
                        <i class="bi bi-check-circle me-1"></i>Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Html.AntiForgeryToken()

    <script>
        (function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                const config = {
                    success: { icon: 'bi-check-circle', color: '#16a34a' },
                    warning: { icon: 'bi-exclamation-triangle', color: '#eab308' },
                    danger: { icon: 'bi-x-circle', color: '#dc2626' },
                    info: { icon: 'bi-info-circle', color: '#514BF2' }
                };

                const { icon, color } = config[tipo] || config.success;

                toastIcon.className = `bi ${icon} me-2`;
                toastIcon.style.color = color;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            let kitAEliminar = null;
            let botonEliminar = null;

            document.querySelectorAll(".btn-eliminar-kit").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();

                    const id = this.dataset.id;
                    const nombre = this.dataset.nombre;
                    const activo = this.dataset.activo === 'True';

                    kitAEliminar = { id, nombre, activo };
                    botonEliminar = this;

                    const modalTitulo = document.getElementById('modal-eliminar-titulo');
                    const modalDescripcion = document.getElementById('modal-eliminar-descripcion');
                    const btnConfirmar = document.getElementById('btn-confirmar-eliminar');

                    if (activo) {
                        modalTitulo.textContent = `¿Desactivar kit "${nombre}"?`;
                        modalDescripcion.textContent = "El kit se marcará como inactivo y no estará disponible para nuevas ventas. Esta acción se puede revertir.";
                        btnConfirmar.innerHTML = '<i class="bi bi-check-circle me-2"></i>Sí, desactivar';
                        btnConfirmar.classList.remove('btn-success');
                        btnConfirmar.classList.add('btn-danger');
                    } else {
                        modalTitulo.textContent = `¿Activar kit "${nombre}"?`;
                        modalDescripcion.textContent = "El kit se marcará como activo y estará disponible nuevamente.";
                        btnConfirmar.innerHTML = '<i class="bi bi-check-circle me-2"></i>Sí, activar';
                        btnConfirmar.classList.remove('btn-danger');
                        btnConfirmar.classList.add('btn-success');
                    }

                    const modal = new bootstrap.Modal(document.getElementById('modalEliminarKit'));
                    modal.show();
                });
            });

            document.getElementById('btn-confirmar-eliminar')?.addEventListener('click', async function () {
                if (!kitAEliminar || !botonEliminar) return;

                const { id, nombre, activo } = kitAEliminar;
                const accion = activo ? 'desactivar' : 'activar';
                const btn = this;

                try {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Procesando...';
                    botonEliminar.disabled = true;
                    botonEliminar.innerHTML = '<i class="bi bi-hourglass-split"></i>';

                    const formData = new FormData();
                    formData.append("__RequestVerificationToken", token || '');
                    formData.append("id", id);

                    const res = await fetch('@Url.Action("Delete", "Kits")', {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok) {
                        const result = await res.json();
                        if (result.success) {
                            mostrarToast(
                                activo
                                    ? `Kit "${nombre}" desactivado correctamente`
                                    : `Kit "${nombre}" activado correctamente`,
                                'success'
                            );
                            setTimeout(() => location.reload(), 900);
                        } else {
                            throw new Error(result.message || 'Error en la operación');
                        }
                    } else {
                        throw new Error('Error en la respuesta del servidor');
                    }
                } catch (error) {
                    console.error(error);
                    mostrarToast(`Error al ${accion} el kit. Intenta nuevamente.`, 'danger');

                    btn.disabled = false;
                    btn.innerHTML = activo
                        ? '<i class="bi bi-check-circle me-2"></i>Sí, desactivar'
                        : '<i class="bi bi-check-circle me-2"></i>Sí, activar';

                    botonEliminar.disabled = false;
                    botonEliminar.innerHTML = `<i class="bi ${activo ? 'bi-trash' : 'bi-arrow-clockwise'}"></i>`;
                }

                const modalEl = document.getElementById('modalEliminarKit');
                const modal = bootstrap.Modal.getInstance(modalEl);
                modal.hide();
            });

            // Mantener placeholder del selector de orden (sin cambiar funcionalidad)
            document.getElementById('filtroOrden')?.addEventListener('change', function () {
                console.log('Ordenar por:', this.value);
            });
        })();
    </script>
}
