@model IEnumerable<ProyectoLogin.Models.Promociones.Kit>
@using System.Security.Claims

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Lista de Kits / Promociones";
    var gt = new System.Globalization.CultureInfo("es-GT");

    // Parámetros de paginación (deberías recibirlos del controlador)
    var pageNumber = ViewBag.PageNumber ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalItems = ViewBag.TotalItems ?? Model?.Count() ?? 0;
    var totalPages = ViewBag.TotalPages ?? (int)Math.Ceiling((double)totalItems / pageSize);


    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

<div class="container-fluid py-4">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center">
            <div class="bg-gradient-primary rounded-circle p-3 me-3">
                <i class="bi bi-box-seam text-white fs-4"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 text-gray-800">Kits / Promociones</h1>
                <p class="text-muted mb-0">Gestiona tus promociones y kits de productos</p>
            </div>
        </div>
        @if (isAuth && isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary rounded-pill d-flex align-items-center" title="Crear nuevo kit o promoción">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Kit / Promoción
            </a>
        }
    </div>

    <!-- TOAST PARA NOTIFICACIONES -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="toastNotificacion" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
    @if (isAuth && isAdmin){
    <!-- MODAL DE CONFIRMACIÓN PARA ELIMINAR -->
    <div class="modal fade" id="modalEliminarKit" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle fs-4 me-2"></i>
                        <h5 class="modal-title mb-0">Confirmar eliminación</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="text-center mb-3">
                        <i class="bi bi-trash display-4 text-danger mb-3"></i>
                        <h4 class="text-gray-800 mb-2" id="modal-eliminar-titulo">¿Eliminar kit?</h4>
                        <p class="text-muted" id="modal-eliminar-descripcion">Esta acción desactivará el kit y no se podrá utilizar en nuevas ventas.</p>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" id="btn-confirmar-eliminar">
                        <i class="bi bi-check-circle me-2"></i>Sí, eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
    }
    @if (Model != null && Model.Any())
    {
        <!-- ESTADÍSTICAS RÁPIDAS -->
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-primary shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    Total Kits
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@totalItems</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-box-seam fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Kits Activos
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @Model.Count(k => k.Activo)
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-check-circle fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-warning shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                    Con Descuento
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @Model.Count(k => k.DescuentoPct > 0)
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-percent fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    Valor Total
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">
                                    @Model.Sum(k => k.Total).ToString("C2", gt)
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-currency-dollar fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLA DE KITS -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light d-flex align-items-center py-3 border-0">
                <i class="bi bi-list-check text-primary me-2 fs-5"></i>
                <h5 class="mb-0 fw-semibold text-gray-800 me-3">Kits / Promociones Creados</h5>
                <span class="badge bg-primary rounded-pill fs-6">@Model.Count()</span>

                <!-- FILTROS RÁPIDOS -->
                <div class="ms-auto d-flex gap-2">
                    <select class="form-select form-select-sm" style="width: auto;" id="filtroOrden">
                        <option value="fecha-desc">Más recientes</option>
                        <option value="fecha-asc">Más antiguos</option>
                        <option value="nombre-asc">Nombre A-Z</option>
                        <option value="nombre-desc">Nombre Z-A</option>
                        <option value="precio-desc">Mayor precio</option>
                        <option value="precio-asc">Menor precio</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 fw-semibold text-gray-700">ID</th>
                                <th class="fw-semibold text-gray-700">Nombre</th>
                                <th class="fw-semibold text-gray-700">Descripción</th>
                                <th class="text-center fw-semibold text-gray-700">Descuento</th>
                                <th class="text-center fw-semibold text-gray-700">Total</th>
                                <th class="text-center fw-semibold text-gray-700">Estado</th>
                                <th class="text-center fw-semibold text-gray-700">Fecha de creación</th>
                                <th class="text-center fw-semibold text-gray-700" style="width:140px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kit in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">#@kit.IdKit</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                                <i class="bi bi-tags text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-medium">@kit.Nombre</div>
                                                <small class="text-muted">@(kit.Detalles?.Count() ?? 0) productos</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(kit.Descripcion))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else
                                        {
                                            <span class="text-truncate d-inline-block" style="max-width: 200px;"
                                                  title="@kit.Descripcion">
                                                @kit.Descripcion
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (kit.DescuentoPct > 0)
                                        {
                                            <span class="badge bg-success rounded-pill">
                                                @((kit.DescuentoPct * 100).ToString("0.##"))%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">0%</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold text-success">
                                        @kit.Total.ToString("C2", gt)
                                    </td>
                                    <td class="text-center">
                                        @if (kit.Activo)
                                        {
                                            <span class="badge bg-success rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center text-muted">
                                        <small>@kit.FechaCreacion.ToString("dd/MM/yyyy")</small>
                                        <br>
                                        <small class="text-muted">@kit.FechaCreacion.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Ver detalles -->
                                            <a asp-action="Details" asp-route-id="@kit.IdKit"
                                               class="btn btn-outline-info rounded-circle btn-sm"
                                               title="Ver detalles del kit">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (isAuth && isAdmin)
                                            {
                                                <!-- Editar -->
                                                <a asp-action="Edit" asp-route-id="@kit.IdKit"
                                                class="btn btn-outline-warning rounded-circle btn-sm"
                                                title="Editar kit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                            }@if (isAuth && isAdmin){
                                            <!-- Eliminar -->
                                            <button class="btn btn-outline-danger rounded-circle btn-sm btn-eliminar-kit"
                                                    data-id="@kit.IdKit"
                                                    data-nombre="@kit.Nombre"
                                                    data-activo="@kit.Activo"
                                                    title="@(kit.Activo ? "Desactivar kit" : "Activar kit")">
                                                <i class="bi @(kit.Activo ? "bi-trash" : "bi-arrow-clockwise")"></i>
                                            </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN -->
                @if (totalPages > 1)
                {
                    <div class="card-footer border-0 bg-light">
                        <nav aria-label="Paginación de kits">
                            <ul class="pagination justify-content-center mb-0">
                                <!-- Botón Anterior -->
                                <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = pageNumber - 1, pageSize = pageSize })" aria-label="Anterior">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Números de página -->
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    if (i == 1 || i == totalPages || (i >= pageNumber - 2 && i <= pageNumber + 2))
                                    {
                                        <li class="page-item @(i == pageNumber ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = pageSize })">@i</a>
                                        </li>
                                    }
                                    else if (i == pageNumber - 3 || i == pageNumber + 3)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                <!-- Botón Siguiente -->
                                <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = pageNumber + 1, pageSize = pageSize })" aria-label="Siguiente">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>

                        <!-- Información de paginación -->
                        <div class="text-center text-muted mt-2">
                            <small>
                                Mostrando @((pageNumber - 1) * pageSize + 1)-@Math.Min(pageNumber * pageSize, totalItems)
                                de @totalItems kits
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                    <i class="bi bi-box-seam text-muted fs-1"></i>
                </div>
                <h4 class="text-muted mb-3">No hay kits registrados</h4>
                <p class="text-muted mb-4">Comienza creando tu primer kit o promoción para ofrecer productos combinados.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill d-inline-flex align-items-center">
                    <i class="bi bi-plus-circle me-2"></i>Crear Primer Kit
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()

    <script>
        (function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // 🔹 Sistema de notificaciones Toast
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                // Configurar color y icono según tipo
                const config = {
                    success: { bg: 'bg-success', icon: 'bi-check-circle' },
                    warning: { bg: 'bg-warning', icon: 'bi-exclamation-triangle' },
                    danger: { bg: 'bg-danger', icon: 'bi-x-circle' },
                    info: { bg: 'bg-info', icon: 'bi-info-circle' }
                };

                const { bg, icon } = config[tipo] || config.success;

                toast.className = `toast align-items-center text-white ${bg} border-0`;
                toastIcon.className = `bi ${icon} me-2`;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            // 🔹 Variables para el modal de eliminación
            let kitAEliminar = null;
            let botonEliminar = null;

            // 🔹 Configurar eventos de eliminación
            document.querySelectorAll(".btn-eliminar-kit").forEach(btn => {
                btn.addEventListener("click", function(e) {
                    e.preventDefault();

                    const id = this.dataset.id;
                    const nombre = this.dataset.nombre;
                    const activo = this.dataset.activo === 'True';

                    kitAEliminar = { id, nombre, activo };
                    botonEliminar = this;

                    // Configurar modal según si está activo o inactivo
                    const modalTitulo = document.getElementById('modal-eliminar-titulo');
                    const modalDescripcion = document.getElementById('modal-eliminar-descripcion');
                    const btnConfirmar = document.getElementById('btn-confirmar-eliminar');

                    if (activo) {
                        modalTitulo.textContent = `¿Desactivar kit "${nombre}"?`;
                        modalDescripcion.textContent = "El kit se marcará como inactivo y no estará disponible para nuevas ventas. Esta acción se puede revertir.";
                        btnConfirmar.innerHTML = '<i class="bi bi-check-circle me-2"></i>Sí, desactivar';
                    } else {
                        modalTitulo.textContent = `¿Activar kit "${nombre}"?`;
                        modalDescripcion.textContent = "El kit se marcará como activo y estará disponible para ventas.";
                        btnConfirmar.innerHTML = '<i class="bi bi-check-circle me-2"></i>Sí, activar';
                    }

                    // Mostrar modal
                    const modal = new bootstrap.Modal(document.getElementById('modalEliminarKit'));
                    modal.show();
                });
            });

            // 🔹 Confirmar eliminación/activación
            document.getElementById('btn-confirmar-eliminar').addEventListener('click', async function() {
                if (!kitAEliminar || !botonEliminar) return;

                const { id, nombre, activo } = kitAEliminar;
                const accion = activo ? 'desactivar' : 'activar';

                try {
                    // Mostrar estado de carga
                    this.disabled = true;
                    this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Procesando...';
                    botonEliminar.disabled = true;
                    botonEliminar.innerHTML = '<i class="bi bi-hourglass-split"></i>';

                    const formData = new FormData();
                    formData.append("__RequestVerificationToken", token);
                    formData.append("id", id);

                    const res = await fetch('@Url.Action("Delete", "Kits")', {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok) {
                        const result = await res.json();
                        if (result.success) {
                            mostrarToast(
                                activo ? `Kit "${nombre}" desactivado correctamente` : `Kit "${nombre}" activado correctamente`,
                                'success'
                            );

                            // Actualizar interfaz después de un breve delay
                            setTimeout(() => {
                                location.reload();
                            }, 1500);
                        } else {
                            throw new Error(result.message || 'Error en la operación');
                        }
                    } else {
                        throw new Error('Error en la respuesta del servidor');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    mostrarToast(
                        `Error al ${accion} el kit. Por favor, intenta nuevamente.`,
                        'danger'
                    );

                    // Restaurar botones
                    this.disabled = false;
                    this.innerHTML = activo ?
                        '<i class="bi bi-check-circle me-2"></i>Sí, desactivar' :
                        '<i class="bi bi-check-circle me-2"></i>Sí, activar';
                    botonEliminar.disabled = false;
                    botonEliminar.innerHTML = `<i class="bi ${activo ? 'bi-trash' : 'bi-arrow-clockwise'}"></i>`;
                }

                // Cerrar modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('modalEliminarKit'));
                modal.hide();
            });

            // 🔹 Filtros rápidos (simulados - deberías implementar la lógica real)
            document.getElementById('filtroEstado')?.addEventListener('change', function() {
                // Aquí iría la lógica para filtrar por estado
                console.log('Filtrar por estado:', this.value);
            });

            document.getElementById('filtroOrden')?.addEventListener('change', function() {
                // Aquí iría la lógica para ordenar
                console.log('Ordenar por:', this.value);
            });

        })();
    </script>

    <style>
        .table td, .table th {
            vertical-align: middle;
        }

        .btn-sm {
            padding: 0.375rem 0.5rem;
            transition: all 0.15s ease-in-out;
        }

            .btn-sm:hover {
                transform: translateY(-1px);
            }

        .card-header {
            border-bottom: none;
        }

        .badge {
            font-size: 0.75rem;
        }

        .page-item.active .page-link {
            background-color: #4e73df;
            border-color: #4e73df;
        }

        .page-link {
            color: #4e73df;
        }

            .page-link:hover {
                color: #2e59d9;
            }

        .border-left-primary {
            border-left: 0.25rem solid #4e73df !important;
        }

        .border-left-success {
            border-left: 0.25rem solid #1cc88a !important;
        }

        .border-left-warning {
            border-left: 0.25rem solid #f6c23e !important;
        }

        .border-left-info {
            border-left: 0.25rem solid #36b9cc !important;
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        }
    </style>
}