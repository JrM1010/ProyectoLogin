@{
    ViewData["Title"] = "Crear Kit / Promoción";
    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic> ?? null; // opcional
}

<h2 class="mb-3">Crear Kit / Promoción</h2>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form id="formFake">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre del kit</label>
                    <input id="nombre" class="form-control" placeholder="Ej. Pack Auriculares + Cargador" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Descuento (%)</label>
                    <div class="input-group">
                        <input id="descuentoPct" class="form-control" type="number" min="0" max="100" step="0.01" value="2" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">Por defecto 2% — puedes cambiarlo (valor entre 0 y 100).</div>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción (opcional)</label>
                    <textarea id="descripcion" class="form-control" rows="2" placeholder="Descripción breve o condiciones de la promoción"></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">
                <strong>Agregar productos al kit</strong>
            </div>
            <div class="card-body position-relative">
                <!-- position-relative para que suggestions se superponga aquí -->
                <!-- BARRA DE BÚSQUEDA PREDICTIVA -->
                <div class="mb-3">
                    <label class="form-label">Buscar producto (nombre o código)</label>
                    <div class="input-group">
                        <input id="searchProducto" type="search" class="form-control" placeholder="Escribe nombre o código..." autocomplete="off" />
                        <button id="btnBuscarNow" class="btn btn-outline-secondary" type="button">Buscar</button>
                    </div>

                    @* Proveedor opcional para filtrar *@
                    @if (proveedores != null)
                    {
                        <div class="mt-2">
                            <label class="form-label small">Proveedor (opcional)</label>
                            <select id="filterProveedor" class="form-select" style="max-width:320px;">
                                <option value="">— Todos los proveedores —</option>
                                @foreach (var pv in proveedores)
                                {
                                    <option value="@pv.IdProveedor">@pv.Nombre</option>
                                }
                            </select>
                        </div>
                    }

                    @* Suggestions: posicionadas dentro del card-body para superponerse al contenido *@
                    <div id="suggestions" class="list-group position-absolute shadow-sm" style="z-index:1050; display:none; max-height:220px; overflow:auto; left:0; right:0;"></div>
                </div>

                <hr />

                <div class="table-responsive">
                    <table id="tablaItems" class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th style="width:100px">Cantidad</th>
                                <th style="width:160px">Precio unitario (Q)</th>
                                <th style="width:160px">Subtotal (Q)</th>
                                <th style="width:80px">Acción</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">Subtotal:</td>
                                <td id="subtotalCell">Q0.00</td>
                                <td></td>
                            </tr>
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">Descuento:</td>
                                <td id="descuentoCell">Q0.00</td>
                                <td></td>
                            </tr>
                            <tr class="table-success fw-bold">
                                <td colspan="3" class="text-end">Total:</td>
                                <td id="totalCell">Q0.00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button id="calcularServer" class="btn btn-outline-secondary">Calcular con precios actuales</button>
                    <button id="limpiarItems" class="btn btn-outline-warning">Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card sticky-top" style="top:20px">
            <div class="card-body">
                <h5 class="card-title">Resumen</h5>
                <p class="mb-1"><strong>Items agregados:</strong> <span id="countItems">0</span></p>
                <hr />
                <p class="mb-1">Subtotal: <strong id="resSubtotal">Q0.00</strong></p>
                <p class="mb-1">Descuento (<span id="resDescuentoPct">2%</span>): <strong id="resDescuento">Q0.00</strong></p>
                <p class="mb-3">Total: <strong id="resTotal">Q0.00</strong></p>

                <div class="d-grid">
                    <button id="guardarKit" class="btn btn-success btn-lg">Guardar Kit / Promoción</button>
                </div>

                <small class="form-text text-muted mt-2">
                    Al guardar, se almacenan los precios actuales de cada producto (snapshot). El cálculo final será verificado en el servidor.
                </small>

                <div id="alertArea" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@* Modal para confirmar cantidad al seleccionar sugerencia *@
<div class="modal fade" id="modalCantidad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cantidad</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="modalProductoNombre" class="mb-2 fw-semibold"></p>
                <div class="mb-2">
                    <label class="form-label small">Cantidad</label>
                    <input id="modalCantidadInput" type="number" class="form-control" min="1" value="1" />
                </div>
                <div id="modalPrecio" class="small text-muted"></div>
            </div>
            <div class="modal-footer">
                <button id="modalCancelar" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="modalAgregar" type="button" class="btn btn-primary">Agregar al kit</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Estado local ---
        const items = []; // { idProducto, nombre, cantidad, precio }
        const formatMoney = (v) => new Intl.NumberFormat('es-GT', { style: 'currency', currency: 'GTQ' }).format(v);

        // Antiforgery
        const antiTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const antiToken = antiTokenInput ? antiTokenInput.value : '';

        // Elementos
        const searchInput = document.getElementById('searchProducto');
        const suggestionsBox = document.getElementById('suggestions');
        const btnBuscarNow = document.getElementById('btnBuscarNow');
        const filterProveedor = document.getElementById('filterProveedor'); // puede ser null
        const tablaBody = document.querySelector('#tablaItems tbody');

        const subtotalCell = document.getElementById('subtotalCell');
        const descuentoCell = document.getElementById('descuentoCell');
        const totalCell = document.getElementById('totalCell');

        const resSubtotal = document.getElementById('resSubtotal');
        const resDescuento = document.getElementById('resDescuento');
        const resTotal = document.getElementById('resTotal');
        const resDescuentoPct = document.getElementById('resDescuentoPct');
        const countItems = document.getElementById('countItems');

        const descuentoInput = document.getElementById('descuentoPct');
        const calcularServerBtn = document.getElementById('calcularServer');
        const limpiarBtn = document.getElementById('limpiarItems');
        const guardarBtn = document.getElementById('guardarKit');
        const alertArea = document.getElementById('alertArea');

        // Modal elements (Bootstrap 5 expected)
        const modalCantidadEl = document.getElementById('modalCantidad');
        let modalBootstrap = null;
        let modalCurrentItem = null; // guardará { id, text, precio }

        const modalProductoNombre = document.getElementById('modalProductoNombre');
        const modalCantidadInput = document.getElementById('modalCantidadInput');
        const modalPrecio = document.getElementById('modalPrecio');
        const modalAgregar = document.getElementById('modalAgregar');

        // URL de búsqueda
        const buscarUrl = '@Url.Action("BuscarProducto", "Ventas")';

        // Suggestions state
        let activeSuggestion = -1;
        let currentSuggestions = [];

        // Debounce helper
        function debounce(fn, ms) {
            let t;
            return (...args) => {
                clearTimeout(t);
                t = setTimeout(() => fn(...args), ms);
            };
        }

        function mostrarAlerta(msg, tipo = 'info', timeout = 5000) {
            alertArea.innerHTML = `<div class="alert alert-${tipo}">${msg}</div>`;
            if (timeout > 0) setTimeout(() => { alertArea.innerHTML = ''; }, timeout);
        }

        // RENDER items table
        function renderItems() {
            tablaBody.innerHTML = '';
            items.forEach((it, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${it.nombre}</td>
                    <td>
                        <input data-idx="${idx}" class="form-control form-control-sm qtyInput" type="number" min="1" value="${it.cantidad}" style="width:80px" />
                    </td>
                    <td>${formatMoney(it.precio)}</td>
                    <td>${formatMoney(it.precio * it.cantidad)}</td>
                    <td><button data-idx="${idx}" class="btn btn-sm btn-outline-danger del">Eliminar</button></td>
                `;
                tablaBody.appendChild(tr);
            });

            // eventos
            document.querySelectorAll('.del').forEach(btn => btn.addEventListener('click', e => {
                const idx = parseInt(e.currentTarget.dataset.idx);
                items.splice(idx, 1);
                actualizarUI();
            }));

            document.querySelectorAll('.qtyInput').forEach(inp => inp.addEventListener('change', e => {
                const idx = parseInt(e.currentTarget.dataset.idx);
                const v = parseInt(e.currentTarget.value) || 1;
                items[idx].cantidad = Math.max(1, v);
                actualizarUI();
            }));
        }

        function calcularLocales() {
            let subtotal = items.reduce((s, i) => s + (i.precio * i.cantidad), 0);
            let descuentoPct = parseFloat(descuentoInput.value) || 0;
            if (descuentoPct > 1 && descuentoPct <= 100) descuentoPct = descuentoPct / 100;
            if (descuentoPct < 0) descuentoPct = 0;
            if (descuentoPct > 1) descuentoPct = 1;

            const descuento = subtotal * descuentoPct;
            const total = subtotal - descuento;

            subtotalCell.innerText = formatMoney(subtotal);
            descuentoCell.innerText = formatMoney(descuento);
            totalCell.innerText = formatMoney(total);

            resSubtotal.innerText = formatMoney(subtotal);
            resDescuento.innerText = formatMoney(descuento);
            resTotal.innerText = formatMoney(total);
            resDescuentoPct.innerText = ((parseFloat(descuentoInput.value) || 0)) + '%';
            countItems.innerText = items.length;

            // Desactivar guardar si total 0
            guardarBtn.disabled = (total <= 0 || subtotal <= 0);
        }

        function actualizarUI() {
            renderItems();
            calcularLocales();
        }

        // --- Predictive search ---
        async function fetchSuggestions(term) {
            if (!term || term.trim().length < 1) {
                hideSuggestions();
                return;
            }

            const prov = filterProveedor ? filterProveedor.value : '';
            let q = term;
            if (prov) q = `${term} provider:${prov}`;

            try {
                const url = buscarUrl + '?term=' + encodeURIComponent(q);
                const res = await fetch(url, { credentials: 'same-origin' });
                if (!res.ok) return hideSuggestions();

                const json = await res.json();
                const list = Array.isArray(json) ? json : (json.results || []);
                renderSuggestions(list);
            } catch (ex) {
                console.error('Error fetching suggestions', ex);
                hideSuggestions();
            }
        }

        function renderSuggestions(list) {
            const shown = (list && list.length) ? list.slice(0, 3) : [];
            currentSuggestions = shown;
            activeSuggestion = -1;

            if (!shown.length) {
                hideSuggestions();
                return;
            }

            suggestionsBox.innerHTML = '';
            shown.forEach((it, idx) => {
                const precio = (typeof it.precio !== 'undefined') ? formatMoney(it.precio) : 'Q0.00';
                const stock = (typeof it.stock !== 'undefined') ? it.stock : 'N/A';

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-start';
                btn.dataset.index = idx;
                btn.dataset.id = it.id;
                btn.dataset.precio = it.precio ?? 0;
                btn.innerHTML = `<div class="me-auto text-start"><div class="fw-semibold">${it.text}</div><div class="small text-muted">Stock: ${stock}</div></div><div class="text-end">${precio}</div>`;

                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    openCantidadModal(it);
                });

                suggestionsBox.appendChild(btn);
            });

            // posicionar suggestions dentro del card-body, justo debajo del input
            const containerRect = searchInput.getBoundingClientRect();
            const parentRect = searchInput.closest('.card-body').getBoundingClientRect();

            // left relativo al card-body
            suggestionsBox.style.left = (containerRect.left - parentRect.left) + 'px';
            suggestionsBox.style.top = (containerRect.bottom - parentRect.top + 6) + 'px'; // 6 px gap
            suggestionsBox.style.width = containerRect.width + 'px';
            suggestionsBox.style.display = 'block';
        }

        function hideSuggestions() {
            suggestionsBox.style.display = 'none';
            suggestionsBox.innerHTML = '';
            currentSuggestions = [];
            activeSuggestion = -1;
        }

        // Abrir modal para confirmar cantidad antes de agregar
        function openCantidadModal(item) {
            modalCurrentItem = item;
            modalProductoNombre.textContent = item.text;
            modalPrecio.textContent = 'Precio unitario: ' + (typeof item.precio !== 'undefined' ? formatMoney(item.precio) : 'Q0.00');
            modalCantidadInput.value = 1;
            // mostrar bootstrap modal
            if (!modalBootstrap) modalBootstrap = new bootstrap.Modal(modalCantidadEl, { keyboard: true });
            modalBootstrap.show();
        }

        // Agregar desde modal
        modalAgregar.addEventListener('click', () => {
            const cant = Math.max(1, parseInt(modalCantidadInput.value) || 1);
            const item = modalCurrentItem;
            if (!item) {
                mostrarAlerta('No se seleccionó producto.', 'warning');
                return;
            }
            const precio = parseFloat(item.precio) || 0;
            if (precio <= 0) {
                mostrarAlerta('El producto seleccionado no tiene precio de venta activo.', 'warning', 5000);
                modalBootstrap.hide();
                return;
            }

            const existente = items.find(i => i.idProducto == item.id);
            if (existente) {
                existente.cantidad += cant;
            } else {
                items.push({
                    idProducto: item.id,
                    nombre: item.text,
                    cantidad: cant,
                    precio
                });
            }

            actualizarUI();
            modalBootstrap.hide();
            hideSuggestions();
            searchInput.value = '';
            modalCurrentItem = null;
        });

        // Keyboard navigation for suggestions
        searchInput.addEventListener('keydown', (e) => {
            const children = Array.from(suggestionsBox.children);
            if (!children.length || suggestionsBox.style.display === 'none') {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    btnBuscarNow.click();
                }
                return;
            }

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeSuggestion = Math.min(activeSuggestion + 1, children.length - 1);
                updateActiveSuggestion(children);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeSuggestion = Math.max(activeSuggestion - 1, 0);
                updateActiveSuggestion(children);
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (activeSuggestion >= 0 && children[activeSuggestion]) {
                    children[activeSuggestion].click();
                }
            } else if (e.key === 'Escape') {
                hideSuggestions();
            }
        });

        function updateActiveSuggestion(children) {
            children.forEach((c, i) => c.classList.toggle('active', i === activeSuggestion));
            if (children[activeSuggestion]) children[activeSuggestion].scrollIntoView({ block: 'nearest' });
        }

        // Debounced fetch
        const debouncedFetch = debounce((q) => fetchSuggestions(q), 300);

        searchInput.addEventListener('input', (e) => {
            const q = e.target.value;
            if (!q || q.trim().length === 0) {
                hideSuggestions();
                return;
            }
            debouncedFetch(q);
        });

        // botón Buscar ahora
        btnBuscarNow.addEventListener('click', (e) => {
            const q = searchInput.value;
            if (!q || q.trim().length === 0) return mostrarAlerta('Escribe algo para buscar.', 'warning');
            fetchSuggestions(q);
        });

        // Si cambia proveedor, forzamos nueva búsqueda si hay texto
        if (filterProveedor) {
            filterProveedor.addEventListener('change', () => {
                const q = searchInput.value;
                if (q && q.trim().length > 0) fetchSuggestions(q);
            });
        }

        // limpiar items
        limpiarBtn.addEventListener('click', (e) => {
            e.preventDefault();
            items.length = 0;
            actualizarUI();
        });

        // calcular con servidor
        calcularServerBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            if (items.length === 0) {
                mostrarAlerta('Agrega productos al kit antes de calcular.', 'warning');
                return;
            }

            const payload = {
                Items: items.map(i => ({ IdProducto: i.idProducto, Cantidad: i.cantidad })),
                DescuentoPct: parseFloat(descuentoInput.value) || 0
            };

            try {
                calcularServerBtn.disabled = true;
                calcularServerBtn.innerText = 'Calculando...';

                const resp = await fetch('@Url.Action("CalcularPrecio", "Kits")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiToken
                    },
                    body: JSON.stringify(payload)
                });

                if (!resp.ok) {
                    const err = await resp.json().catch(()=>null);
                    mostrarAlerta(err?.message || 'Error en cálculo desde el servidor.', 'danger');
                    return;
                }

                const data = await resp.json();
                if (data.success) {
                    if (typeof data.subtotal === 'number') {
                        resSubtotal.innerText = formatMoney(data.subtotal);
                        resDescuento.innerText = formatMoney(data.descuento);
                        resTotal.innerText = formatMoney(data.total);

                        subtotalCell.innerText = formatMoney(data.subtotal);
                        descuentoCell.innerText = formatMoney(data.descuento);
                        totalCell.innerText = formatMoney(data.total);
                    }

                    if (data.detalles && Array.isArray(data.detalles)) {
                        data.detalles.forEach(d => {
                            const item = items.find(i => i.idProducto === d.IdProducto);
                            if (item) item.precio = parseFloat(d.PrecioUnitario) || item.precio;
                            if (d.PrecioUnitario === 0) {
                                mostrarAlerta('Atención: uno o más productos no tienen precio activo en el servidor. Revisa antes de guardar.', 'warning', 5000);
                            }
                        });
                        actualizarUI();
                    } else {
                        actualizarUI();
                    }

                    mostrarAlerta('Cálculo realizado con precios actuales (servidor).', 'success', 3000);
                } else {
                    mostrarAlerta('No se pudo calcular en servidor.', 'danger');
                }
            } catch (ex) {
                console.error(ex);
                mostrarAlerta('Error de comunicación con el servidor.', 'danger');
            } finally {
                calcularServerBtn.disabled = false;
                calcularServerBtn.innerText = 'Calcular con precios actuales';
            }
        });

        // Guardar kit
        guardarBtn.addEventListener('click', async (e) => {
            e.preventDefault();

            const nombre = document.getElementById('nombre').value.trim();
            const descripcion = document.getElementById('descripcion').value.trim();
            let descuentoRaw = parseFloat(descuentoInput.value);
            if (isNaN(descuentoRaw)) descuentoRaw = 0;

            if (!nombre) {
                mostrarAlerta('El nombre del kit es obligatorio.', 'warning');
                return;
            }
            if (items.length === 0) {
                mostrarAlerta('Agrega al menos un producto al kit.', 'warning');
                return;
            }

            const itemConPrecioCero = items.find(i => !i.precio || i.precio <= 0);
            if (itemConPrecioCero) {
                mostrarAlerta(`El producto "${itemConPrecioCero.nombre}" no tiene precio válido. Asigna precio antes de guardar.`, 'warning');
                return;
            }

            const subtotal = items.reduce((s, i) => s + (i.precio * i.cantidad), 0);
            if (subtotal <= 0) {
                mostrarAlerta('El subtotal debe ser mayor a Q0.00 para poder guardar.', 'warning');
                return;
            }

            if (descuentoRaw < 0 || descuentoRaw > 100) {
                mostrarAlerta('El descuento debe estar entre 0% y 100%.', 'warning');
                return;
            }

            let descuentoPct = descuentoRaw;
            if (descuentoPct > 1 && descuentoPct <= 100) descuentoPct = descuentoPct / 100;
            if (descuentoPct < 0) descuentoPct = 0;
            if (descuentoPct > 1) descuentoPct = 1;

            const payload = {
                Nombre: nombre,
                Descripcion: descripcion,
                DescuentoPct: descuentoPct,
                Items: items.map(i => ({ IdProducto: i.idProducto, Cantidad: i.cantidad }))
            };

            try {
                guardarBtn.disabled = true;
                guardarBtn.innerText = 'Guardando...';

                const resp = await fetch('@Url.Action("Create", "Kits")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiToken
                    },
                    body: JSON.stringify(payload)
                });

                const data = await resp.json().catch(()=>({}));

                if (resp.ok && data.success) {
                    mostrarAlerta('Kit guardado correctamente.', 'success', 3000);
                    setTimeout(() => {
                        window.location.href = '/Kits/Details/' + data.idKit;
                    }, 700);
                } else {
                    const msg = data?.message || 'Error guardando kit en el servidor.';
                    mostrarAlerta(msg, 'danger', 3000);
                    guardarBtn.disabled = false;
                    guardarBtn.innerText = 'Guardar Kit / Promoción';
                }
            } catch (ex) {
                console.error(ex);
                mostrarAlerta('Error al comunicarse con el servidor.', 'danger', 5000);
                guardarBtn.disabled = false;
                guardarBtn.innerText = 'Guardar Kit / Promoción';
            }
        });

        // click fuera cierra suggestions
        document.addEventListener('click', (e) => {
            if (!suggestionsBox.contains(e.target) && e.target !== searchInput) {
                hideSuggestions();
            }
        });

        // Inicializar modal bootstrap si está disponible
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof bootstrap !== 'undefined') {
                modalBootstrap = new bootstrap.Modal(modalCantidadEl, { keyboard: true });
            }
        });

        // Inicializar UI
        actualizarUI();
    </script>
}
