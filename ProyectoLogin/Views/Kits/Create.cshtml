@{
    ViewData["Title"] = "Crear Kit / Promoción";
    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic> ?? null; // opcional
}

<h2 class="mb-3">Crear Kit / Promoción</h2>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form id="formFake">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre del kit</label>
                    <input id="nombre" class="form-control" placeholder="Ej. Pack Auriculares + Cargador" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Descuento (%)</label>
                    <div class="input-group">
                        <input id="descuentoPct" class="form-control" type="number" min="0" max="100" step="0.01" value="2" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">Por defecto 2% — puedes cambiarlo (valor entre 0 y 100).</div>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción (opcional)</label>
                    <textarea id="descripcion" class="form-control" rows="2" placeholder="Descripción breve o condiciones de la promoción"></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">
                <strong>Agregar productos al kit</strong>
            </div>
            <div class="card-body position-relative">
                <div class="mb-3">
                    <label class="form-label">Buscar producto (nombre o código)</label>
                    <div class="input-group">
                        <input id="searchProducto" type="search" class="form-control" placeholder="Escribe nombre o código..." autocomplete="off" />
                        <button id="btnBuscarNow" class="btn btn-outline-secondary" type="button">Buscar</button>
                    </div>

                    @if (proveedores != null)
                    {
                        <div class="mt-2">
                            <label class="form-label small">Proveedor (opcional)</label>
                            <select id="filterProveedor" class="form-select" style="max-width:320px;">
                                <option value="">— Todos los proveedores —</option>
                                @foreach (var pv in proveedores)
                                {
                                    <option value="@pv.IdProveedor">@pv.Nombre</option>
                                }
                            </select>
                        </div>
                    }

                    <div id="suggestions" class="list-group position-absolute shadow-sm"
                         style="z-index:1050; display:none; max-height:220px; overflow:auto; left:0; right:0;"></div>
                </div>

                <hr />

                <div class="table-responsive">
                    <table id="tablaItems" class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th style="width:100px">Cantidad</th>
                                <th style="width:160px">Precio unitario (Q)</th>
                                <th style="width:160px">Subtotal (Q)</th>
                                <th style="width:80px">Acción</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">Subtotal:</td>
                                <td id="subtotalCell">Q0.00</td>
                                <td></td>
                            </tr>
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">Descuento:</td>
                                <td id="descuentoCell">Q0.00</td>
                                <td></td>
                            </tr>
                            <tr class="table-success fw-bold">
                                <td colspan="3" class="text-end">Total:</td>
                                <td id="totalCell">Q0.00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button id="calcularServer" class="btn btn-outline-secondary">Calcular con precios actuales</button>
                    <button id="limpiarItems" class="btn btn-outline-warning">Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card sticky-top" style="top:20px">
            <div class="card-body">
                <h5 class="card-title">Resumen</h5>
                <p class="mb-1"><strong>Items agregados:</strong> <span id="countItems">0</span></p>
                <hr />
                <p class="mb-1">Subtotal: <strong id="resSubtotal">Q0.00</strong></p>
                <p class="mb-1">Descuento (<span id="resDescuentoPct">2%</span>): <strong id="resDescuento">Q0.00</strong></p>
                <p class="mb-3">Total: <strong id="resTotal">Q0.00</strong></p>

                <div class="d-grid">
                    <button id="guardarKit" class="btn btn-success btn-lg">Guardar Kit / Promoción</button>
                </div>

                <small class="form-text text-muted mt-2">
                    Al guardar, se almacenan los precios actuales de cada producto (snapshot). El cálculo final será verificado en el servidor.
                </small>

                <div id="alertArea" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const items = [];
        const formatMoney = v => new Intl.NumberFormat('es-GT', { style: 'currency', currency: 'GTQ' }).format(v);

        const antiToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const searchInput = document.getElementById('searchProducto');
        const suggestionsBox = document.getElementById('suggestions');
        const btnBuscarNow = document.getElementById('btnBuscarNow');
        const filterProveedor = document.getElementById('filterProveedor');
        const tablaBody = document.querySelector('#tablaItems tbody');
        const subtotalCell = document.getElementById('subtotalCell');
        const descuentoCell = document.getElementById('descuentoCell');
        const totalCell = document.getElementById('totalCell');
        const resSubtotal = document.getElementById('resSubtotal');
        const resDescuento = document.getElementById('resDescuento');
        const resTotal = document.getElementById('resTotal');
        const resDescuentoPct = document.getElementById('resDescuentoPct');
        const countItems = document.getElementById('countItems');
        const descuentoInput = document.getElementById('descuentoPct');
        const calcularServerBtn = document.getElementById('calcularServer');
        const limpiarBtn = document.getElementById('limpiarItems');
        const guardarBtn = document.getElementById('guardarKit');
        const alertArea = document.getElementById('alertArea');
        const buscarUrl = '@Url.Action("BuscarProducto", "Ventas")';

        function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }
        function mostrarAlerta(msg, tipo = 'info', timeout = 4000) {
            alertArea.innerHTML = `<div class="alert alert-${tipo}">${msg}</div>`;
            if (timeout) setTimeout(() => alertArea.innerHTML = '', timeout);
        }

        function renderItems() {
            tablaBody.innerHTML = '';
            items.forEach((it, idx) => {
                tablaBody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td>${it.nombre}</td>
                    <td><input data-idx="${idx}" class="form-control form-control-sm qtyInput" type="number" min="1" value="${it.cantidad}" style="width:80px" /></td>
                    <td>${formatMoney(it.precio)}</td>
                    <td>${formatMoney(it.precio * it.cantidad)}</td>
                    <td><button data-idx="${idx}" class="btn btn-sm btn-outline-danger del">Eliminar</button></td>
                </tr>`);
            });
            document.querySelectorAll('.del').forEach(btn => btn.onclick = e => { items.splice(e.target.dataset.idx, 1); actualizarUI(); });
            document.querySelectorAll('.qtyInput').forEach(inp => inp.onchange = e => { const i = items[e.target.dataset.idx]; i.cantidad = Math.max(1, +e.target.value); actualizarUI(); });
        }

        function calcularLocales() {
            const subtotal = items.reduce((s, i) => s + i.precio * i.cantidad, 0);
            let pct = parseFloat(descuentoInput.value) || 0;
            if (pct > 1 && pct <= 100) pct /= 100;
            pct = Math.min(Math.max(pct, 0), 1);
            const desc = subtotal * pct, total = subtotal - desc;
            subtotalCell.textContent = formatMoney(subtotal);
            descuentoCell.textContent = formatMoney(desc);
            totalCell.textContent = formatMoney(total);
            resSubtotal.textContent = formatMoney(subtotal);
            resDescuento.textContent = formatMoney(desc);
            resTotal.textContent = formatMoney(total);
            resDescuentoPct.textContent = ((parseFloat(descuentoInput.value) || 0)) + '%';
            countItems.textContent = items.length;
            guardarBtn.disabled = total <= 0;
        }

        function actualizarUI() { renderItems(); calcularLocales(); }

        async function fetchSuggestions(term) {
            if (!term.trim()) return hideSuggestions();
            const prov = filterProveedor ? filterProveedor.value : '';
            try {
                const url = buscarUrl + '?term=' + encodeURIComponent(prov ? term + ' provider:' + prov : term);
                const res = await fetch(url);
                if (!res.ok) return hideSuggestions();
                const data = await res.json();
                renderSuggestions(Array.isArray(data) ? data : (data.results || []));
            } catch { hideSuggestions(); }
        }
        function renderSuggestions(list) {
            const shown = list.slice(0, 5);
            if (!shown.length) return hideSuggestions();
            suggestionsBox.innerHTML = '';
            shown.forEach(it => {
                const precio = formatMoney(it.precio || 0), stock = it.stock ?? 'N/A';
                const btn = document.createElement('button');
                btn.className = 'list-group-item list-group-item-action d-flex justify-content-between';
                btn.innerHTML = `<div><div class="fw-semibold">${it.text}</div><div class="small text-muted">Stock: ${stock}</div></div><div>${precio}</div>`;
                btn.onclick = () => {
                    const precioNum = parseFloat(it.precio) || 0;
                    if (precioNum <= 0) return mostrarAlerta('El producto no tiene precio válido.', 'warning');
                    const ex = items.find(x => x.idProducto == it.id);
                    if (ex) ex.cantidad += 1; else items.push({ idProducto: it.id, nombre: it.text, cantidad: 1, precio: precioNum });
                    actualizarUI(); hideSuggestions(); searchInput.value = '';
                };
                suggestionsBox.appendChild(btn);
            });
            suggestionsBox.style.display = 'block';
        }
        function hideSuggestions() { suggestionsBox.style.display = 'none'; suggestionsBox.innerHTML = ''; }

        const debouncedFetch = debounce(fetchSuggestions, 150);
        searchInput.oninput = e => debouncedFetch(e.target.value);
        btnBuscarNow.onclick = () => fetchSuggestions(searchInput.value);
        if (filterProveedor) filterProveedor.onchange = () => { if (searchInput.value.trim()) fetchSuggestions(searchInput.value); };
        document.addEventListener('click', e => { if (!suggestionsBox.contains(e.target) && e.target !== searchInput) hideSuggestions(); });
        limpiarBtn.onclick = e => { e.preventDefault(); items.length = 0; actualizarUI(); };
        descuentoInput.oninput = calcularLocales;

        document.addEventListener('DOMContentLoaded', actualizarUI);

        // ✅ NUEVO BLOQUE: guardar kit correctamente
        guardarBtn.addEventListener('click', async (e) => {
            e.preventDefault();

            const nombre = (document.getElementById('nombre')?.value || '').trim();
            const descripcion = (document.getElementById('descripcion')?.value || '').trim();
            const descuentoPct = parseFloat(descuentoInput.value) || 0;

            if (!nombre) {
                mostrarAlerta('Ingrese un nombre para el kit.', 'warning');
                document.getElementById('nombre').focus();
                return;
            }
            if (items.length === 0) {
                mostrarAlerta('Agrega al menos un producto antes de guardar.', 'warning');
                return;
            }

            const payload = {
                Nombre: nombre,
                Descripcion: descripcion,
                DescuentoPct: descuentoPct,
                Items: items.map(i => ({ IdProducto: i.idProducto, Cantidad: i.cantidad }))
            };

            guardarBtn.disabled = true;
            const prev = guardarBtn.innerHTML;
            guardarBtn.innerHTML = 'Guardando...';

            try {
                const res = await fetch('@Url.Action("Create", "Kits")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiToken
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json().catch(() => null);
                if (!res.ok || !data) {
                    mostrarAlerta(data?.message || 'Error al guardar el kit.', 'danger');
                    console.error('Error servidor:', data);
                } else if (data.success) {
                    mostrarAlerta('Kit guardado correctamente.', 'success');
                    setTimeout(() => {
                        if (data.idKit) window.location.href = `/Kits/Details/${data.idKit}`;
                        else location.reload();
                    }, 1000);
                } else {
                    mostrarAlerta(data.message || 'No se pudo guardar el kit.', 'warning');
                }
            } catch (err) {
                console.error(err);
                mostrarAlerta('Error al conectar con el servidor.', 'danger');
            } finally {
                guardarBtn.disabled = false;
                guardarBtn.innerHTML = prev;
            }
        });
    </script>
}
