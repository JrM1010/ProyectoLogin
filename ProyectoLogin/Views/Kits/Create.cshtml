@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Crear Kit / Promoción";
    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic> ?? null;


    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;

}
@if (isAuth && isAdmin){
<div class="container-fluid py-4">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center">
            <div class="bg-gradient-success rounded-circle p-3 me-3">
                <i class="bi bi-plus-circle text-white fs-4"></i>
            </div>
            <div>
                <h1 class="h3 mb-1 text-gray-800">Crear Kit / Promoción</h1>
                <p class="text-muted mb-0">Crea una nueva promoción o kit de productos</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center rounded-pill" title="Volver al listado de kits">
            <i class="bi bi-arrow-left me-2"></i>Volver a Kits
        </a>
    </div>

    <!-- MODAL DE CONFIRMACIÓN PARA LIMPIAR TODO -->
    <div class="modal fade" id="modalLimpiarTodo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning text-white">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle fs-4 me-2"></i>
                        <h5 class="modal-title mb-0">Confirmar acción</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="text-center mb-3">
                        <i class="bi bi-trash display-4 text-warning mb-3"></i>
                        <h4 class="text-gray-800 mb-2">¿Eliminar todos los productos?</h4>
                        <p class="text-muted">Esta acción eliminará todos los productos del kit y no se puede deshacer.</p>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-warning text-white rounded-pill px-4" id="btn-confirmar-limpiar">
                        <i class="bi bi-check-circle me-2"></i>Sí, limpiar todo
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE CONFIRMACIÓN PARA GUARDAR -->
    <div class="modal fade" id="modalConfirmarGuardar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle fs-4 me-2"></i>
                        <h5 class="modal-title mb-0">Confirmar creación</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="text-center mb-3">
                        <i class="bi bi-plus-circle display-4 text-success mb-3"></i>
                        <h4 class="text-gray-800 mb-2">¿Crear nuevo kit?</h4>
                        <p class="text-muted">Se creará una nueva promoción con los productos y configuración actual.</p>
                        <div class="alert alert-light mt-3">
                            <div class="d-flex justify-content-between">
                                <span>Productos:</span>
                                <strong id="modal-productos-count">0</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Total:</span>
                                <strong id="modal-total">Q0.00</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-success rounded-pill px-4" id="btn-confirmar-guardar">
                        <i class="bi bi-save me-2"></i>Sí, crear kit
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST PARA NOTIFICACIONES -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div id="toastNotificacion" class="toast align-items-center text-white border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi me-2"></i>
                    <span id="toast-message">Operación completada</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <form id="form-crear-kit" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-8">
                <!-- INFORMACIÓN BÁSICA DEL KIT -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-gradient-success text-white py-3 border-0">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-tags fs-5 me-3"></i>
                            <h5 class="mb-0 fw-semibold">Información Básica del Kit</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- 🔹 Nombre -->
                            <div class="col-md-6">
                                <label for="nombre" class="form-label fw-semibold text-gray-700">
                                    <i class="bi bi-fonts text-success me-1"></i>Nombre del Kit *
                                </label>
                                <input id="nombre" name="Nombre" class="form-control" placeholder="Ej. Pack Auriculares + Cargador" required />
                                <div class="invalid-feedback">El nombre del kit es obligatorio y no puede estar vacío.</div>
                                <div class="form-text text-muted">Nombre descriptivo para identificar el kit o promoción</div>
                            </div>

                            <!-- 🔹 Descuento -->
                            <div class="col-md-6">
                                <label for="descuentoPct" class="form-label fw-semibold text-gray-700">
                                    <i class="bi bi-percent text-success me-1"></i>Descuento (opcional)
                                </label>
                                <div class="input-group">
                                    <input id="descuentoPct" class="form-control" type="number" min="0" max="100" step="1" value="0" />
                                    <span class="input-group-text bg-success bg-opacity-10 text-success border-success">%</span>
                                </div>
                                <div class="form-text text-muted">Porcentaje de descuento aplicado al total del kit (0-100%)</div>
                            </div>

                            <!-- 🔹 Descripción -->
                            <div class="col-12">
                                <label for="descripcion" class="form-label fw-semibold text-gray-700">
                                    <i class="bi bi-chat-text text-success me-1"></i>Descripción *
                                </label>
                                <textarea id="descripcion" name="Descripcion" class="form-control" rows="3" required placeholder="Descripción breve o condiciones de la promoción"></textarea>
                                <div class="invalid-feedback">La descripción del kit es obligatoria.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PRODUCTOS DEL KIT -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light d-flex align-items-center py-3 border-0">
                        <i class="bi bi-search text-success me-2 fs-5"></i>
                        <h5 class="mb-0 fw-semibold text-gray-800 me-3">Buscar y Agregar Productos</h5>
                        <div class="position-relative ms-auto" style="width:320px;">
                            <input type="text" id="searchProducto" class="form-control rounded-pill" placeholder="Buscar producto..." autocomplete="off" />
                            <ul id="suggestions" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050; display: none; max-height: 250px; overflow-y: auto; border-radius: 0.5rem;"></ul>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (proveedores != null)
                        {
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-gray-700">
                                        <i class="bi bi-building text-success me-1"></i>Filtrar por Proveedor
                                    </label>
                                    <select id="filterProveedor" class="form-select">
                                        <option value="">— Todos los proveedores —</option>
                                        @foreach (var pv in proveedores)
                                        {
                                            <option value="@pv.IdProveedor">@pv.Nombre</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div class="table-responsive">
                            <table id="tablaItems" class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4 fw-semibold text-gray-700">Producto</th>
                                        <th class="text-center fw-semibold text-gray-700" style="width:120px;">Cantidad</th>
                                        <th class="text-center fw-semibold text-gray-700" style="width:140px;">Precio Unitario</th>
                                        <th class="text-center fw-semibold text-gray-700" style="width:140px;">Subtotal</th>
                                        <th class="text-center fw-semibold text-gray-700" style="width:100px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-productos">
                                    <!-- Los productos se agregarán dinámicamente aquí -->
                                </tbody>
                                <tfoot class="table-group-divider">
                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end ps-4">Subtotal:</td>
                                        <td id="subtotalCell" class="text-center text-success">Q0.00</td>
                                        <td></td>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end ps-4">Descuento:</td>
                                        <td id="descuentoCell" class="text-center text-warning">Q0.00</td>
                                        <td></td>
                                    </tr>
                                    <tr class="table-success fw-bold">
                                        <td colspan="3" class="text-end ps-4">Total:</td>
                                        <td id="totalCell" class="text-center text-success">Q0.00</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex gap-2 mt-3">
                            <button type="button" id="btn-limpiar-todo" class="btn btn-outline-warning d-flex align-items-center">
                                <i class="bi bi-trash me-2"></i>Limpiar Todo
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PANEL LATERAL -->
            <div class="col-lg-4">
                <!-- RESUMEN DEL KIT -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light py-3 border-0">
                        <h5 class="mb-0 fw-semibold text-gray-800">
                            <i class="bi bi-clipboard-check text-success me-2"></i>Resumen del Kit
                        </h5>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <span class="text-muted">Productos agregados:</span>
                            <span id="countItems" class="badge bg-success rounded-pill fs-6">0</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <span class="text-muted">Subtotal:</span>
                            <span id="resSubtotal" class="fw-bold text-success">Q0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                            <span class="text-muted">Descuento:</span>
                            <span id="resDescuentoPct" class="fw-bold text-success">0%</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted fw-semibold">Total final:</span>
                            <span id="resTotal" class="fw-bold fs-5 text-success">Q0.00</span>
                        </div>
                    </div>
                </div>

                <!-- ACCIONES RÁPIDAS -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light py-3 border-0">
                        <h5 class="mb-0 fw-semibold text-gray-800">
                            <i class="bi bi-lightning text-success me-2"></i>Acciones Rápidas
                        </h5>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <button type="button" id="btn-guardar-lateral" class="btn btn-success text-white d-flex align-items-center justify-content-center" disabled>
                                <i class="bi bi-plus-circle me-2"></i>Crear Kit
                            </button>
                            <button type="button" id="btn-limpiar-rapido" class="btn btn-outline-secondary d-flex align-items-center justify-content-center">
                                <i class="bi bi-trash me-2"></i>Limpiar Todo
                            </button>
                            <a asp-action="Index" class="btn btn-outline-danger d-flex align-items-center justify-content-center">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                        </div>

                        <div class="alert alert-info mt-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <small>Al guardar, se almacenan los precios actuales de cada producto. El cálculo final será verificado en el servidor.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
}
<style>
    .table td, .table th {
        vertical-align: middle;
    }

    .btn-eliminar {
        padding: .25rem .5rem;
        transition: all 0.15s ease-in-out;
    }

        .btn-eliminar:hover {
            transform: scale(1.1);
        }

    /* Estilos del buscador predictivo */
    #suggestions {
        max-height: 250px;
        overflow-y: auto;
        z-index: 1050;
        border-radius: 0.5rem;
        border: 1px solid #dee2e6;
    }

        #suggestions li {
            cursor: pointer;
            border-radius: 0;
            border-left: none;
            border-right: none;
            border-bottom: 1px solid #dee2e6;
            transition: all 0.15s ease-in-out;
        }

            #suggestions li:first-child {
                border-top: none;
                border-top-left-radius: 0.5rem;
                border-top-right-radius: 0.5rem;
            }

            #suggestions li:last-child {
                border-bottom: none;
                border-bottom-left-radius: 0.5rem;
                border-bottom-right-radius: 0.5rem;
            }

            #suggestions li:hover {
                background-color: #d1f2eb;
                border-color: #a3e4d7;
            }

    .card-header {
        border-bottom: none;
    }

    .badge {
        font-size: 0.75rem;
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
    }

    .card {
        border-radius: 0.5rem;
    }

    .btn {
        border-radius: 0.375rem;
        transition: all 0.15s ease-in-out;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .form-control:focus {
        border-color: #1cc88a;
        box-shadow: 0 0 0 0.2rem rgba(28, 200, 138, 0.25);
    }

    /* Animaciones personalizadas */
    @@keyframes slideInDown {
        from

    {
        transform: translate3d(0, -100%, 0);
        opacity: 0;
    }

    to {
        transform: translate3d(0, 0, 0);
        opacity: 1;
    }

    }

    .toast {
        animation: slideInDown 0.3s ease-out;
    }
</style>

@section Scripts {
    <script>
        (function () {
            // Variables globales
            const items = [];
            const createUrl = '@Url.Action("Create", "Kits")';
            const indexUrl = '@Url.Action("Index", "Kits")';
            const buscarUrl = '@Url.Action("BuscarProducto", "Ventas")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const parseNumber = v => isNaN(parseFloat(v)) ? 0 : parseFloat(v);
            const formatMoney = v => 'Q' + parseNumber(v).toFixed(2);

            // 🔹 Sistema de notificaciones Toast
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                // Configurar color y icono según tipo
                const config = {
                    success: { bg: 'bg-success', icon: 'bi-check-circle' },
                    warning: { bg: 'bg-warning', icon: 'bi-exclamation-triangle' },
                    danger: { bg: 'bg-danger', icon: 'bi-x-circle' },
                    info: { bg: 'bg-info', icon: 'bi-info-circle' }
                };

                const { bg, icon } = config[tipo] || config.success;

                toast.className = `toast align-items-center text-white ${bg} border-0`;
                toastIcon.className = `bi ${icon} me-2`;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            // 🔹 Calcular totales
            function calcularTotales() {
                const subtotal = items.reduce((sum, item) => sum + (item.precio * item.cantidad), 0);
                let descuentoPct = parseFloat(document.getElementById('descuentoPct').value) || 0;

                // Convertir porcentaje si es mayor a 1
                if (descuentoPct > 1 && descuentoPct <= 100) {
                    descuentoPct /= 100;
                }

                descuentoPct = Math.min(Math.max(descuentoPct, 0), 1);
                const descuento = subtotal * descuentoPct;
                const total = subtotal - descuento;

                // Actualizar tabla
                document.getElementById('subtotalCell').textContent = formatMoney(subtotal);
                document.getElementById('descuentoCell').textContent = formatMoney(descuento);
                document.getElementById('totalCell').textContent = formatMoney(total);

                // Actualizar panel lateral
                document.getElementById('countItems').textContent = items.length;
                document.getElementById('resSubtotal').textContent = formatMoney(subtotal);
                document.getElementById('resDescuentoPct').textContent = ((parseFloat(document.getElementById('descuentoPct').value) || 0)) + '%';
                document.getElementById('resTotal').textContent = formatMoney(total);

                // Actualizar modal de confirmación
                document.getElementById('modal-productos-count').textContent = items.length;
                document.getElementById('modal-total').textContent = formatMoney(total);

                // Habilitar/deshabilitar botón de guardar
                const btnGuardar = document.getElementById('btn-guardar-lateral');
                btnGuardar.disabled = items.length === 0 || total <= 0;
            }

            // 🔹 Renderizar items en la tabla
            function renderItems() {
                const tbody = document.getElementById('tbody-productos');
                tbody.innerHTML = '';

                items.forEach((item, index) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 rounded p-2 me-3">
                                    <i class="bi bi-box text-success"></i>
                                </div>
                                <div>
                                    <span class="fw-medium">${item.nombre}</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <input class="form-control form-control-sm cantidad text-center" type="number" min="1" value="${item.cantidad}" data-index="${index}" />
                        </td>
                        <td class="text-center fw-semibold text-gray-700">${formatMoney(item.precio)}</td>
                        <td class="text-center fw-bold text-success">${formatMoney(item.precio * item.cantidad)}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-danger rounded-circle btn-eliminar" data-index="${index}" title="Eliminar producto">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                // Asignar eventos a los elementos recién creados
                document.querySelectorAll('.cantidad').forEach(input => {
                    input.addEventListener('change', function() {
                        const index = parseInt(this.dataset.index);
                        const newCantidad = Math.max(1, parseInt(this.value) || 1);
                        items[index].cantidad = newCantidad;
                        calcularTotales();
                        renderItems(); // Re-render para actualizar subtotales
                    });
                });

                document.querySelectorAll('.btn-eliminar').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const index = parseInt(this.dataset.index);
                        const productoNombre = items[index].nombre;
                        items.splice(index, 1);
                        calcularTotales();
                        renderItems();
                        mostrarToast(`"${productoNombre}" eliminado del kit`, 'info');
                    });
                });
            }

            // 🔹 Buscar productos
            function debounce(fn, ms) {
                let timeout;
                return (...args) => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => fn(...args), ms);
                };
            }

            async function buscarProductos(termino) {
                if (!termino.trim()) {
                    document.getElementById('suggestions').style.display = 'none';
                    return;
                }

                const proveedorId = document.getElementById('filterProveedor')?.value || '';

                try {
                    let url = `${buscarUrl}?term=${encodeURIComponent(termino)}`;
                    if (proveedorId) {
                        url += `&proveedorId=${proveedorId}`;
                    }

                    const response = await fetch(url);
                    if (!response.ok) throw new Error('Error en la búsqueda');

                    const data = await response.json();
                    mostrarSugerencias(Array.isArray(data) ? data : (data.results || []));
                } catch (error) {
                    console.error('Error buscando productos:', error);
                    document.getElementById('suggestions').style.display = 'none';
                }
            }

            function mostrarSugerencias(productos) {
                const suggestionsBox = document.getElementById('suggestions');
                suggestionsBox.innerHTML = '';

                if (!productos.length) {
                    suggestionsBox.style.display = 'none';
                    return;
                }

                const productosMostrar = productos.slice(0, 5);

                productosMostrar.forEach(producto => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    li.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <div class="fw-semibold">${producto.text}</div>
                                <div class="small text-muted">
                                    <i class="bi bi-box me-1"></i>Stock: ${producto.stock ?? 'N/A'}
                                    ${producto.tipo === 'kit' ? '<span class="badge bg-info ms-2">KIT</span>' : ''}
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-success">${formatMoney(producto.precio || 0)}</div>
                                <div class="small text-muted">Agregar</div>
                            </div>
                        </div>
                    `;

                    li.addEventListener('click', () => {
                        const precioNum = parseFloat(producto.precio) || 0;
                        if (precioNum <= 0) {
                            mostrarToast('El producto no tiene precio válido.', 'warning');
                            return;
                        }

                        // Verificar si el producto ya existe
                        const productoExistente = items.find(item => item.idProducto === producto.id);
                        if (productoExistente) {
                            productoExistente.cantidad += 1;
                            mostrarToast(`Cantidad aumentada para "${producto.text}"`, 'info');
                        } else {
                            items.push({
                                idProducto: producto.id,
                                nombre: producto.text,
                                cantidad: 1,
                                precio: precioNum
                            });
                            mostrarToast(`"${producto.text}" agregado al kit`, 'success');
                        }

                        calcularTotales();
                        renderItems();
                        document.getElementById('suggestions').style.display = 'none';
                        document.getElementById('searchProducto').value = '';
                    });

                    suggestionsBox.appendChild(li);
                });

                suggestionsBox.style.display = 'block';
            }

            // 🔹 FUNCIÓN LIMPIAR TODO CON MODAL
            function mostrarModalLimpiar() {
                if (items.length === 0) {
                    mostrarToast('El kit ya está vacío', 'info');
                    return;
                }

                const modal = new bootstrap.Modal(document.getElementById('modalLimpiarTodo'));
                modal.show();
            }

            function limpiarTodo() {
                items.length = 0;
                calcularTotales();
                renderItems();
                mostrarToast('Todos los productos han sido eliminados del kit', 'success');

                // Cerrar modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('modalLimpiarTodo'));
                modal.hide();
            }

            // 🔹 VALIDAR FORMULARIO
            function validarFormulario() {
                const nombreInput = document.getElementById('nombre');
                const descripcionInput = document.getElementById('descripcion');

                let valido = true;

                // Resetear estados de validación
                [nombreInput, descripcionInput].forEach(el => {
                    el.classList.remove('is-invalid', 'is-valid');
                });

                // Validar campos obligatorios
                if (!nombreInput.value.trim()) {
                    nombreInput.classList.add('is-invalid');
                    valido = false;
                } else {
                    nombreInput.classList.add('is-valid');
                }

                if (!descripcionInput.value.trim()) {
                    descripcionInput.classList.add('is-invalid');
                    valido = false;
                } else {
                    descripcionInput.classList.add('is-valid');
                }

                // Validar productos
                if (items.length === 0) {
                    mostrarToast('Agrega al menos un producto al kit.', 'warning');
                    valido = false;
                }

                return valido;
            }

            // 🔹 MODAL PARA GUARDAR CAMBIOS
            function mostrarModalGuardar() {
                if (!validarFormulario()) {
                    return;
                }

                const modal = new bootstrap.Modal(document.getElementById('modalConfirmarGuardar'));
                modal.show();
            }

            // 🔹 Función para guardar cambios
            async function guardarCambios() {
                const nombreInput = document.getElementById('nombre');
                const descripcionInput = document.getElementById('descripcion');
                let descuentoPctInput = parseFloat(document.getElementById('descuentoPct').value) || 0;

                // Convertir porcentaje si es necesario
                if (descuentoPctInput > 1 && descuentoPctInput <= 100) {
                    descuentoPctInput /= 100;
                }

                const payload = {
                    Nombre: nombreInput.value.trim(),
                    Descripcion: descripcionInput.value.trim(),
                    DescuentoPct: descuentoPctInput,
                    Items: items.map(item => ({
                        IdProducto: item.idProducto,
                        Cantidad: item.cantidad
                    }))
                };

                const btnGuardar = document.getElementById('btn-guardar-lateral');
                const originalText = btnGuardar.innerHTML;

                try {
                    btnGuardar.disabled = true;
                    btnGuardar.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Creando...';

                    const response = await fetch(createUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();

                    if (data.success) {
                        mostrarToast('Kit creado correctamente. Redirigiendo...', 'success');
                        setTimeout(() => {
                            if (data.idKit) {
                                window.location.href = `@Url.Action("Details", "Kits")/${data.idKit}`;
                            } else {
                                window.location.href = indexUrl;
                            }
                        }, 1500);
                    } else {
                        mostrarToast(data.message || 'No se pudo crear el kit.', 'danger');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    mostrarToast('Error al conectar con el servidor.', 'danger');
                } finally {
                    btnGuardar.disabled = false;
                    btnGuardar.innerHTML = originalText;

                    // Cerrar modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('modalConfirmarGuardar'));
                    if (modal) modal.hide();
                }
            }

            // 🔹 INICIALIZACIÓN
            function inicializar() {
                // Eventos de búsqueda
                const searchInput = document.getElementById('searchProducto');
                const debouncedBuscar = debounce(buscarProductos, 300);

                searchInput.addEventListener('input', (e) => debouncedBuscar(e.target.value));

                // Ocultar sugerencias al hacer clic fuera
                document.addEventListener('click', (e) => {
                    const suggestionsBox = document.getElementById('suggestions');
                    if (suggestionsBox && !suggestionsBox.contains(e.target) && e.target !== searchInput) {
                        suggestionsBox.style.display = 'none';
                    }
                });

                // Evento de filtro de proveedor
                const filterProveedor = document.getElementById('filterProveedor');
                if (filterProveedor) {
                    filterProveedor.addEventListener('change', () => {
                        if (searchInput.value.trim()) {
                            buscarProductos(searchInput.value);
                        }
                    });
                }

                // Eventos de los botones
                document.getElementById('btn-limpiar-todo').addEventListener('click', mostrarModalLimpiar);
                document.getElementById('btn-limpiar-rapido').addEventListener('click', mostrarModalLimpiar);
                document.getElementById('btn-confirmar-limpiar').addEventListener('click', limpiarTodo);

                document.getElementById('btn-guardar-lateral').addEventListener('click', mostrarModalGuardar);
                document.getElementById('btn-confirmar-guardar').addEventListener('click', guardarCambios);

                // Evento de descuento
                document.getElementById('descuentoPct').addEventListener('input', calcularTotales);
                document.getElementById('descuentoPct').addEventListener('blur', function() {
                    if (this.value.trim() === '' || isNaN(parseFloat(this.value))) {
                        this.value = 0;
                        calcularTotales();
                    }
                });

                // Quitar error visual al escribir
                document.querySelectorAll('#nombre, #descripcion').forEach(el => {
                    el.addEventListener('input', function() {
                        this.classList.remove('is-invalid');
                        if (this.value.trim()) {
                            this.classList.add('is-valid');
                        }
                    });
                });

                // Inicializar cálculos
                calcularTotales();
            }

            // Ejecutar inicialización cuando el DOM esté listo
            document.addEventListener('DOMContentLoaded', inicializar);
        })();
    </script>
}