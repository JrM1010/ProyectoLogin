@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Crear Kit / Promoción";
    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic> ?? null;

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}
@if (isAuth && isAdmin)
{
    <div class="container-fluid kits-create-theme py-4">
        <!-- HEADER PRINCIPAL -->
        <div class="kits-header mb-5">
            <div class="kits-header-left">
                <div class="kits-header-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <div>
                    <h1>Crear Kit / Promoción</h1>
                    <p>Crea una nueva promoción agrupando productos con precios y descuentos personalizados.</p>
                </div>
            </div>
            <a asp-action="Index"
               class="btn-kits-outline d-flex align-items-center"
               title="Volver al listado de kits">
                <i class="bi bi-arrow-left me-2"></i>Volver a Kits
            </a>
        </div>

        <!-- MODAL LIMPIAR TODO -->
        <div class="modal fade" id="modalLimpiarTodo" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-kits">
                    <div class="modal-header modal-kits-warning">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle fs-4 me-2"></i>
                            <h5 class="modal-title mb-0">Confirmar acción</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body py-4">
                        <div class="text-center mb-3">
                            <i class="bi bi-trash display-5 text-warning mb-3"></i>
                            <h4 class="mb-2">¿Eliminar todos los productos?</h4>
                            <p class="text-muted mb-0">
                                Esta acción eliminará todos los productos del kit y no se puede deshacer.
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer border-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-2"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-warning text-white rounded-pill px-4" id="btn-confirmar-limpiar">
                            <i class="bi bi-check-circle me-2"></i>Sí, limpiar todo
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL CONFIRMAR GUARDAR -->
        <div class="modal fade" id="modalConfirmarGuardar" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-kits">
                    <div class="modal-header modal-kits-success">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle fs-4 me-2"></i>
                            <h5 class="modal-title mb-0">Confirmar creación</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body py-4">
                        <div class="text-center mb-3">
                            <i class="bi bi-plus-circle display-5 text-success mb-3"></i>
                            <h4 class="mb-2">¿Crear nuevo kit?</h4>

                            <div class="kits-modal-summary">
                                <div class="d-flex justify-content-between">
                                    <span>Productos:</span>
                                    <strong id="modal-productos-count">0</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Total:</span>
                                    <strong id="modal-total">Q0.00</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-2"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-success rounded-pill px-4" id="btn-confirmar-guardar">
                            <i class="bi bi-save me-2"></i>Sí, crear kit
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOAST NOTIFICACIONES -->
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100;">
            <div id="toastNotificacion" class="toast toast-kits align-items-center border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi me-2"></i>
                        <span id="toast-message">Operación completada</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>

        <!-- FORM -->
        <form id="form-crear-kit" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="row">
                <!-- COLUMNA IZQUIERDA -->
                <div class="col-lg-8">
                    <!-- INFORMACIÓN BÁSICA -->
                    <div class="kits-card mb-4">
                        <div class="kits-card-header-gradient">
                            <i class="bi bi-tags fs-5 me-2"></i>
                            <h5 class="mb-0">Información básica del kit</h5>
                        </div>
                        <div class="kits-card-body">
                            <div class="row g-3">
                                <!-- Nombre -->
                                <div class="col-md-6">
                                    <label for="nombre" class="form-label kits-label">
                                        <i class="bi bi-fonts me-1"></i>Nombre del Kit *
                                    </label>
                                    <input id="nombre"
                                           name="Nombre"
                                           class="form-control kits-input"
                                           placeholder="Ej. Pack Auriculares + Cargador"
                                           required />
                                    <div class="invalid-feedback">El nombre del kit es obligatorio.</div>
                                    <div class="kits-help-text">
                                        Nombre descriptivo para identificar el kit o promoción.
                                    </div>
                                </div>

                                <!-- Descuento -->
                                <div class="col-md-6">
                                    <label for="descuentoPct" class="form-label kits-label">
                                        <i class="bi bi-percent me-1"></i>Descuento (opcional)
                                    </label>
                                    <div class="input-group">
                                        <input id="descuentoPct"
                                               class="form-control kits-input"
                                               type="number"
                                               min="0" max="100" step="1" value="0" />
                                        <span class="input-group-text kits-input-addon">%</span>
                                    </div>
                                    <div class="kits-help-text">
                                        Porcentaje de descuento aplicado al total del kit (0-100%).
                                    </div>
                                </div>

                                <!-- Descripción -->
                                <div class="col-12">
                                    <label for="descripcion" class="form-label kits-label">
                                        <i class="bi bi-chat-text me-1"></i>Descripción *
                                    </label>
                                    <textarea id="descripcion"
                                          name="Descripcion"
                                          class="form-control kits-input"
                                          rows="3"
                                          required
                                          placeholder="Descripción breve o condiciones de la promoción"></textarea>
                                    <div class="invalid-feedback">La descripción del kit es obligatoria.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PRODUCTOS DEL KIT -->
                    <div class="kits-card mb-4">
                        <div class="kits-card-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-search fs-5 text-kits-accent"></i>
                                <h5 class="mb-0">Buscar y agregar productos</h5>
                            </div>
                            <div class="kits-search-wrapper ms-auto">
                                <input type="text"
                                       id="searchProducto"
                                       class="form-control kits-input rounded-pill"
                                       placeholder="Buscar producto para agregar..."
                                       autocomplete="off" />
                                <ul id="suggestions"
                                    class="list-group position-absolute w-100 shadow-lg kits-suggestions"
                                    style="display:none;"></ul>
                            </div>
                        </div>

                        <div class="kits-card-body p-0">
                            @if (proveedores != null)
                            {
                                <div class="px-3 pt-3">
                                    <label class="form-label kits-label">
                                        <i class="bi bi-building me-1"></i>Filtrar por proveedor
                                    </label>
                                    <select id="filterProveedor" class="form-select kits-input">
                                        <option value="">— Todos los proveedores —</option>
                                        @foreach (var pv in proveedores)
                                        {
                                            <option value="@pv.IdProveedor">@pv.Nombre</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="table-responsive mt-3">
                                <table id="tablaItems" class="table kits-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">Producto</th>
                                            <th class="text-center" style="width:120px;">Cantidad</th>
                                            <th class="text-center" style="width:140px;">Precio Unitario</th>
                                            <th class="text-center" style="width:140px;">Subtotal</th>
                                            <th class="text-center" style="width:100px;">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody-productos">
                                        <!-- productos dinámicos -->
                                    </tbody>
                                    <tfoot class="kits-tfoot">
                                        <tr>
                                            <td colspan="3" class="text-end">Subtotal:</td>
                                            <td id="subtotalCell" class="text-center">Q0.00</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end">Descuento:</td>
                                            <td id="descuentoCell" class="text-center">Q0.00</td>
                                            <td></td>
                                        </tr>
                                        <tr class="kits-total-row">
                                            <td colspan="3" class="text-end">Total:</td>
                                            <td id="totalCell" class="text-center">Q0.00</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="d-flex gap-2 mt-3 px-3 pb-3">
                                <button type="button"
                                        id="btn-limpiar-todo"
                                        class="btn-kits-outline-alt d-flex align-items-center justify-content-center">
                                    <i class="bi bi-trash me-2"></i>Limpiar todo
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- COLUMNA DERECHA -->
                <div class="col-lg-4">
                    <!-- RESUMEN -->
                    <div class="kits-card mb-4">
                        <div class="kits-card-header">
                            <i class="bi bi-clipboard-check me-2 text-kits-accent"></i>
                            <h5 class="mb-0">Resumen del kit</h5>
                        </div>
                        <div class="kits-card-body">
                            <div class="kits-resumen-row">
                                <span>Productos agregados</span>
                                <span id="countItems" class="badge kits-badge">0</span>
                            </div>
                            <div class="kits-resumen-row">
                                <span>Subtotal</span>
                                <span id="resSubtotal" class="kits-resumen-value">Q0.00</span>
                            </div>
                            <div class="kits-resumen-row">
                                <span>Descuento</span>
                                <span id="resDescuentoPct" class="kits-resumen-value">0%</span>
                            </div>
                            <div class="kits-resumen-row kits-resumen-total">
                                <span>Total final</span>
                                <span id="resTotal" class="kits-resumen-total-value">Q0.00</span>
                            </div>
                        </div>
                    </div>

                    <!-- ACCIONES -->
                    <div class="kits-card">
                        <div class="kits-card-header">
                            <i class="bi bi-lightning-charge me-2 text-kits-accent"></i>
                            <h5 class="mb-0">Acciones rápidas</h5>
                        </div>
                        <div class="kits-card-body">
                            <div class="d-grid gap-2">
                                <button type="button"
                                        id="btn-guardar-lateral"
                                        class="btn-kits-primary d-flex align-items-center justify-content-center"
                                        disabled>
                                    <i class="bi bi-plus-circle me-2"></i>Crear kit
                                </button>
                                <button type="button"
                                        id="btn-limpiar-rapido"
                                        class="btn-kits-outline-alt d-flex align-items-center justify-content-center">
                                    <i class="bi bi-trash me-2"></i>Limpiar todo
                                </button>
                                <a asp-action="Index"
                                   class="btn-kits-cancel d-flex align-items-center justify-content-center">
                                    <i class="bi bi-x-circle me-2"></i>Cancelar
                                </a>
                            </div>
                            <p class="kits-hint mt-3 mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Al guardar se almacenan los precios actuales de cada producto. El cálculo final se valida en el servidor.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
}
<style>
    /* ===== Paleta clara (alineada con Edit Kits / Productos) ===== */
    :root {
        --inventory-primary: #1C1973;
        --inventory-secondary: #514BF2;
        --inventory-accent: #8B88F2;
        --inventory-bg: #f5f6fa;
        --inventory-card: #ffffff;
        --inventory-text: #111827;
        --inventory-muted: #6b7280;
        --inventory-success: #16a34a;
        --inventory-warning: #f59e0b;
        --inventory-danger: #dc2626;
        --border-soft: #e5e7eb;
        --radius: .85rem;
    }

    /* ===== Contenedor & Header ===== */
    .kits-create-theme {
        background: var(--inventory-bg);
        color: var(--inventory-text);
    }

    .kits-header {
        background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
        border: 1px solid rgba(255,255,255,.14);
        border-radius: var(--radius);
        padding: 1.1rem 1.4rem;
        box-shadow: 0 8px 24px rgba(15,23,42,.18);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        color: #fff;
    }

    .kits-header-left {
        display: flex;
        align-items: center;
        gap: 1rem
    }

    .kits-header-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: radial-gradient(circle,var(--inventory-secondary),var(--inventory-primary));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 6px 16px rgba(0,0,0,.25);
    }

    .kits-header h1 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800
    }

    .kits-header p {
        margin: 0;
        font-size: .9rem;
        color: rgba(255,255,255,.9)
    }

    .btn-kits-outline {
        border: 1px solid var(--inventory-accent);
        color: #fff;
        background: transparent;
        border-radius: 999px;
        font-weight: 600;
        padding: .5rem 1.1rem;
        font-size: .9rem;
        transition: .22s;
        text-decoration: none
    }

        .btn-kits-outline:hover {
            background: rgba(139,136,242,.18);
            transform: translateY(-1px)
        }

    /* ===== Cards ===== */
    .kits-card {
        background: var(--inventory-card);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius);
        box-shadow: 0 6px 18px rgba(15,23,42,.06);
        overflow: hidden;
        transition: .22s;
    }

        .kits-card:hover {
            box-shadow: 0 10px 24px rgba(15,23,42,.1);
            transform: translateY(-1px)
        }

    .kits-card-header-gradient {
        padding: .9rem 1.2rem;
        display: flex;
        align-items: center;
        gap: .5rem;
        background: linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,.16);
        font-weight: 700;
    }

    .kits-card-header {
        padding: .8rem 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        background: #fff;
        border-bottom: 1px solid var(--border-soft);
        color: var(--inventory-text);
    }

    .kits-card-body {
        padding: 1rem 1.2rem;
        background: var(--inventory-card);
        color: var(--inventory-text)
    }

    /* ===== Inputs ===== */
    .kits-label {
        color: var(--inventory-muted);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .06em
    }

    .kits-input {
        background: #fff;
        border: 1px solid var(--border-soft);
        color: var(--inventory-text);
        border-radius: .55rem;
        font-size: .95rem;
    }

        .kits-input:focus {
            border-color: var(--inventory-secondary);
            box-shadow: 0 0 0 .18rem rgba(81,75,242,.18);
        }

        .kits-input::placeholder {
            color: #9ca3af
        }

    .kits-input-addon {
        background: #f3f4ff;
        border-color: var(--border-soft);
        color: var(--inventory-primary);
        font-weight: 700;
    }

    .kits-help-text {
        color: #6b7280;
        font-size: .8rem
    }

    /* ===== Buscador ===== */
    .kits-search-wrapper {
        position: relative;
        width: 320px;
        max-width: 100%
    }

        .kits-search-wrapper .kits-input {
            padding-left: 2.4rem;
            background: #fff;
            border: 1px solid var(--border-soft);
            box-shadow: 0 4px 10px rgba(0,0,0,.04);
        }

        .kits-search-wrapper::before {
            content: "\f52a";
            font-family: "bootstrap-icons";
            position: absolute;
            left: .9rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: .95rem;
            color: var(--inventory-secondary);
            opacity: .9;
            pointer-events: none;
        }

    .kits-suggestions {
        top: 100%;
        left: 0;
        margin-top: .25rem;
        background: #fff;
        border-radius: .7rem;
        border: 1px solid var(--border-soft);
        max-height: 260px;
        overflow-y: auto;
        box-shadow: 0 10px 22px rgba(0,0,0,.08);
        z-index: 1100;
    }

        .kits-suggestions .list-group-item {
            background: #fff;
            color: var(--inventory-text);
            border: none;
            border-bottom: 1px solid var(--border-soft);
            font-size: .9rem;
            cursor: pointer;
            padding: .55rem .75rem;
        }

            .kits-suggestions .list-group-item:last-child {
                border-bottom: none
            }

            .kits-suggestions .list-group-item:hover {
                background: #f9fafb
            }

    /* ===== Tabla ===== */
    .kits-card-body.p-0 {
        background: #fff
    }

    .kits-table {
        color: var(--inventory-text) !important;
        border-collapse: separate;
        border-spacing: 0
    }

        .kits-table > :not(caption) > * > * {
            background: transparent !important;
            color: var(--inventory-text)
        }

        .kits-table thead {
            background: #f3f4ff !important
        }

            .kits-table thead th {
                border-bottom: 1px solid var(--border-soft) !important;
                color: #6b7280 !important;
                font-size: .74rem;
                text-transform: uppercase;
                letter-spacing: .05em;
                padding: .65rem .7rem;
                white-space: nowrap;
            }

        .kits-table tbody tr {
            transition: .18s
        }

            .kits-table tbody tr:hover {
                background: #f9fafb !important
            }

        .kits-table td {
            border-bottom: 1px solid var(--border-soft) !important;
            padding: .6rem .7rem;
            font-size: .92rem
        }

    .kits-tfoot td {
        border-top: 1px solid var(--border-soft) !important;
        font-size: .9rem;
        color: #6b7280 !important;
        background: #fff !important;
    }

    .kits-total-row td {
        background: #f8fafc !important;
        color: var(--inventory-success) !important;
        font-weight: 800;
        font-size: 1rem;
    }

    .kits-table input.cantidad {
        background: #fff !important;
        border: 1px solid var(--border-soft) !important;
        color: var(--inventory-text) !important;
        border-radius: .45rem;
        font-size: .9rem;
    }

    .kits-pill-icon {
        width: 34px;
        height: 34px;
        border-radius: .7rem;
        background: #f3f4ff;
        color: var(--inventory-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: .55rem;
    }

    /* ===== Resumen lateral ===== */
    .kits-resumen-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .4rem 0;
        border-bottom: 1px solid var(--border-soft)
    }

        .kits-resumen-row:last-child {
            border-bottom: none
        }

    .kits-badge {
        background: #eef2ff;
        color: var(--inventory-secondary);
        border-radius: 999px;
        padding: .2rem .6rem;
        font-size: .78rem
    }

    .kits-resumen-value {
        font-weight: 600
    }

    .kits-resumen-total {
        margin-top: .5rem;
        padding-top: .5rem;
        border-top: 1px solid var(--border-soft)
    }

    .kits-resumen-total-value {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--inventory-success)
    }

    /* ===== Botones secundarios ===== */
    .btn-kits-primary {
        background: #fff;
        color: var(--inventory-primary);
        border: 1px solid var(--border-soft);
        border-radius: 999px;
        font-weight: 700;
        padding: .55rem 1.1rem;
        transition: .2s
    }

        .btn-kits-primary:hover {
            background: #f9fafb;
            color: var(--inventory-secondary);
            box-shadow: 0 6px 16px rgba(15,23,42,.12);
            transform: translateY(-1px)
        }

    .btn-kits-outline-alt {
        background: transparent;
        border: 1px solid var(--border-soft);
        color: #6b7280;
        border-radius: 999px;
        font-weight: 600;
    }

        .btn-kits-outline-alt:hover {
            background: #f9fafb;
            color: #111827
        }

    .btn-kits-cancel {
        background: transparent;
        border: 1px solid #fecaca;
        color: #dc2626;
        border-radius: 999px;
        font-weight: 600;
    }

        .btn-kits-cancel:hover {
            background: #fee2e2;
            color: #7f1d1d
        }

    /* ===== Toast (ligero) ===== */
    .toast-kits {
        background: #fff;
        color: #111827;
        border-radius: .8rem;
        border: 1px solid var(--border-soft);
        box-shadow: 0 10px 24px rgba(0,0,0,.08);
        font-size: .88rem
    }

        .toast-kits .btn-close-white {
            filter: none
        }

    .toast {
        animation: kits-slide-in .25s ease-out
    }
    @@keyframes kits-slide-in {
        from

    {
        transform: translate3d(100%,-20%,0);
        opacity: 0
    }

    to {
        transform: translate3d(0,0,0);
        opacity: 1
    }

    }

    /* ===== Modales (ligeros) ===== */
    .modal-kits {
        background: #fff;
        color: var(--inventory-text);
        border-radius: var(--radius);
        border: 1px solid var(--border-soft);
        box-shadow: 0 16px 40px rgba(15,23,42,.22)
    }

    .modal-kits-warning {
        background: linear-gradient(90deg,#b45309,#f59e0b);
        color: #fff;
        border-top-left-radius: var(--radius);
        border-top-right-radius: var(--radius);
        border-bottom: none;
    }

    .modal-kits-success {
        background: linear-gradient(90deg,#15803d,#22c55e);
        color: #fff;
        border-top-left-radius: var(--radius);
        border-top-right-radius: var(--radius);
        border-bottom: none;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 767.98px) {
        .kits-header

    {
        flex-direction: column;
        align-items: flex-start
    }

    .kits-search-wrapper {
        width: 100%
    }

    }
</style>

@section Scripts {
    <script>
        (function () {
            const items = [];
            const createUrl = '@Url.Action("Create", "Kits")';
            const indexUrl = '@Url.Action("Index", "Kits")';
            const buscarUrl = '@Url.Action("BuscarProducto", "Ventas")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const parseNumber = v => isNaN(parseFloat(v)) ? 0 : parseFloat(v);
            const formatMoney = v => 'Q' + parseNumber(v).toFixed(2);

            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                const config = {
                    success: { icon: 'bi-check-circle', color: '#16a34a' },
                    warning: { icon: 'bi-exclamation-triangle', color: '#f59e0b' },
                    danger: { icon: 'bi-x-circle', color: '#dc2626' },
                    info: { icon: 'bi-info-circle', color: '#514BF2' }
                };

                const { icon, color } = config[tipo] || config.success;

                toast.className = 'toast toast-kits align-items-center border-0';
                toastIcon.className = `bi ${icon} me-2`;
                toastIcon.style.color = color;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            function calcularTotales() {
                const subtotal = items.reduce((sum, item) => sum + (item.precio * item.cantidad), 0);
                let descuentoPct = parseFloat(document.getElementById('descuentoPct').value) || 0;

                if (descuentoPct > 1 && descuentoPct <= 100) {
                    descuentoPct /= 100;
                }
                descuentoPct = Math.min(Math.max(descuentoPct, 0), 1);

                const descuento = subtotal * descuentoPct;
                const total = subtotal - descuento;

                document.getElementById('subtotalCell').textContent = formatMoney(subtotal);
                document.getElementById('descuentoCell').textContent = formatMoney(descuento);
                document.getElementById('totalCell').textContent = formatMoney(total);

                document.getElementById('countItems').textContent = items.length;
                document.getElementById('resSubtotal').textContent = formatMoney(subtotal);
                document.getElementById('resDescuentoPct').textContent = ((parseFloat(document.getElementById('descuentoPct').value) || 0)) + '%';
                document.getElementById('resTotal').textContent = formatMoney(total);

                document.getElementById('modal-productos-count').textContent = items.length;
                document.getElementById('modal-total').textContent = formatMoney(total);

                const btnGuardar = document.getElementById('btn-guardar-lateral');
                btnGuardar.disabled = items.length === 0 || total <= 0;
            }

            function renderItems() {
                const tbody = document.getElementById('tbody-productos');
                tbody.innerHTML = '';

                items.forEach((item, index) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="kits-pill-icon">
                                    <i class="bi bi-box"></i>
                                </div>
                                <div>
                                    <span class="kits-product-name">${item.nombre}</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <input class="form-control form-control-sm cantidad text-center"
                                   type="number" min="1" value="${item.cantidad}" data-index="${index}" />
                        </td>
                        <td class="text-center kits-price-cell">${formatMoney(item.precio)}</td>
                        <td class="text-center kits-subtotal-cell">${formatMoney(item.precio * item.cantidad)}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-danger rounded-circle btn-eliminar"
                                    data-index="${index}" title="Eliminar producto">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>`;
                    tbody.appendChild(tr);
                });

                document.querySelectorAll('.cantidad').forEach(input => {
                    input.addEventListener('change', function () {
                        const index = parseInt(this.dataset.index);
                        const newCantidad = Math.max(1, parseInt(this.value) || 1);
                        items[index].cantidad = newCantidad;
                        calcularTotales();
                        renderItems();
                    });
                });

                document.querySelectorAll('.btn-eliminar').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const index = parseInt(this.dataset.index);
                        const nombre = items[index].nombre;
                        items.splice(index, 1);
                        calcularTotales();
                        renderItems();
                        mostrarToast(`"${nombre}" eliminado del kit`, 'info');
                    });
                });
            }

            function debounce(fn, ms) {
                let t;
                return (...args) => {
                    clearTimeout(t);
                    t = setTimeout(() => fn(...args), ms);
                };
            }

            async function buscarProductos(termino) {
                if (!termino.trim()) {
                    document.getElementById('suggestions').style.display = 'none';
                    return;
                }

                const proveedorId = document.getElementById('filterProveedor')?.value || '';
                try {
                    let url = `${buscarUrl}?term=${encodeURIComponent(termino)}`;
                    if (proveedorId) url += `&proveedorId=${proveedorId}`;

                    const res = await fetch(url);
                    if (!res.ok) throw new Error('Error en la búsqueda');
                    const data = await res.json();
                    mostrarSugerencias(Array.isArray(data) ? data : (data.results || []));
                } catch (e) {
                    console.error(e);
                    document.getElementById('suggestions').style.display = 'none';
                }
            }

            function mostrarSugerencias(productos) {
                const box = document.getElementById('suggestions');
                box.innerHTML = '';

                if (!productos.length) {
                    box.style.display = 'none';
                    return;
                }

                productos.slice(0, 10).forEach(p => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    li.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <div class="fw-semibold">${p.text}</div>
                                <div class="small text-muted">
                                    <i class="bi bi-box me-1"></i>Stock: ${p.stock ?? 'N/D'}
                                    ${p.tipo === 'kit' ? '<span class="badge bg-info ms-2">KIT</span>' : ''}
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-success">${formatMoney(p.precio || 0)}</div>
                                <div class="small text-muted">Agregar</div>
                            </div>
                        </div>`;

                    li.addEventListener('click', () => {
                        const precio = parseFloat(p.precio) || 0;
                        if (precio <= 0) {
                            mostrarToast('El producto no tiene un precio válido.', 'warning');
                            return;
                        }

                        const existente = items.find(i => i.idProducto === p.id);
                        if (existente) {
                            existente.cantidad += 1;
                            mostrarToast(`Cantidad aumentada para "${p.text}"`, 'info');
                        } else {
                            items.push({
                                idProducto: p.id,
                                nombre: p.text,
                                cantidad: 1,
                                precio
                            });
                            mostrarToast(`"${p.text}" agregado al kit`, 'success');
                        }

                        calcularTotales();
                        renderItems();
                        box.style.display = 'none';
                        document.getElementById('searchProducto').value = '';
                    });

                    box.appendChild(li);
                });

                box.style.display = 'block';
            }

            function mostrarModalLimpiar() {
                if (!items.length) {
                    mostrarToast('El kit ya está vacío.', 'info');
                    return;
                }
                const modal = new bootstrap.Modal(document.getElementById('modalLimpiarTodo'));
                modal.show();
            }

            function limpiarTodo() {
                items.length = 0;
                calcularTotales();
                renderItems();
                mostrarToast('Todos los productos han sido eliminados del kit.', 'success');
                const modal = bootstrap.Modal.getInstance(document.getElementById('modalLimpiarTodo'));
                modal?.hide();
            }

            function validarFormulario() {
                const nombre = document.getElementById('nombre');
                const descripcion = document.getElementById('descripcion');
                let valido = true;

                [nombre, descripcion].forEach(el => el.classList.remove('is-invalid', 'is-valid'));

                if (!nombre.value.trim()) {
                    nombre.classList.add('is-invalid'); valido = false;
                } else nombre.classList.add('is-valid');

                if (!descripcion.value.trim()) {
                    descripcion.classList.add('is-invalid'); valido = false;
                } else descripcion.classList.add('is-valid');

                if (!items.length) {
                    mostrarToast('Agrega al menos un producto al kit.', 'warning');
                    valido = false;
                }

                return valido;
            }

            function mostrarModalGuardar() {
                if (!validarFormulario()) return;
                const modal = new bootstrap.Modal(document.getElementById('modalConfirmarGuardar'));
                modal.show();
            }

            async function guardarCambios() {
                const nombre = document.getElementById('nombre').value.trim();
                const descripcion = document.getElementById('descripcion').value.trim();
                let descuentoPct = parseFloat(document.getElementById('descuentoPct').value) || 0;
                if (descuentoPct > 1 && descuentoPct <= 100) descuentoPct /= 100;

                const payload = {
                    Nombre: nombre,
                    Descripcion: descripcion,
                    DescuentoPct: descuentoPct,
                    Items: items.map(i => ({ IdProducto: i.idProducto, Cantidad: i.cantidad }))
                };

                const btn = document.getElementById('btn-guardar-lateral');
                const original = btn.innerHTML;

                try {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Creando...';

                    const res = await fetch(createUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(payload)
                    });

                    const data = await res.json();

                    if (data.success) {
                        mostrarToast('Kit creado correctamente. Redirigiendo...', 'success');
                        setTimeout(() => {
                            if (data.idKit) {
                                window.location.href = '@Url.Action("Details", "Kits")/' + data.idKit;
                            } else {
                                window.location.href = indexUrl;
                            }
                        }, 1200);
                    } else {
                        mostrarToast(data.message || 'No se pudo crear el kit.', 'danger');
                    }
                } catch (e) {
                    console.error(e);
                    mostrarToast('Error al conectar con el servidor.', 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = original;
                    const modal = bootstrap.Modal.getInstance(document.getElementById('modalConfirmarGuardar'));
                    modal?.hide();
                }
            }

            function inicializar() {
                const searchInput = document.getElementById('searchProducto');
                const debouncedBuscar = debounce(buscarProductos, 300);
                searchInput.addEventListener('input', e => debouncedBuscar(e.target.value));

                document.addEventListener('click', e => {
                    const box = document.getElementById('suggestions');
                    if (box && !box.contains(e.target) && e.target !== searchInput) {
                        box.style.display = 'none';
                    }
                });

                const filterProveedor = document.getElementById('filterProveedor');
                if (filterProveedor) {
                    filterProveedor.addEventListener('change', () => {
                        if (searchInput.value.trim()) buscarProductos(searchInput.value);
                    });
                }

                document.getElementById('btn-limpiar-todo').addEventListener('click', mostrarModalLimpiar);
                document.getElementById('btn-limpiar-rapido').addEventListener('click', mostrarModalLimpiar);
                document.getElementById('btn-confirmar-limpiar').addEventListener('click', limpiarTodo);

                document.getElementById('btn-guardar-lateral').addEventListener('click', mostrarModalGuardar);
                document.getElementById('btn-confirmar-guardar').addEventListener('click', guardarCambios);

                document.getElementById('descuentoPct').addEventListener('input', calcularTotales);
                document.getElementById('descuentoPct').addEventListener('blur', function () {
                    if (this.value.trim() === '' || isNaN(parseFloat(this.value))) {
                        this.value = 0;
                        calcularTotales();
                    }
                });

                ['nombre', 'descripcion'].forEach(id => {
                    const el = document.getElementById(id);
                    el.addEventListener('input', function () {
                        this.classList.remove('is-invalid');
                        if (this.value.trim()) this.classList.add('is-valid');
                    });
                });

                calcularTotales();
            }

            document.addEventListener('DOMContentLoaded', inicializar);
        })();
    </script>
}
