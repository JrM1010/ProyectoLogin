@{
    ViewData["Title"] = "Crear Kit / Promoción";
    var productos = ViewBag.Productos as IEnumerable<dynamic> ?? new List<dynamic>();
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic> ?? null;
}

<div class="container-fluid">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-plus-circle text-primary me-2"></i>Crear Kit / Promoción
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Volver al listado de kits">
            <i class="bi bi-arrow-left me-1"></i>Volver a Kits
        </a>
    </div>

    <!-- INFORMACIÓN BÁSICA DEL KIT -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white py-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-tags fs-4 me-2"></i>
                <h5 class="mb-0">Información Básica del Kit</h5>
            </div>
        </div>
        <div class="card-body">
            <form id="formFake">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-primary">
                            <i class="bi bi-tag me-1"></i>Nombre del Kit *
                        </label>
                        <input id="nombre" class="form-control" placeholder="Ej. Pack Auriculares + Cargador" required />
                        <div class="form-text text-muted">Nombre descriptivo para identificar el kit o promoción</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-primary">
                            <i class="bi bi-percent me-1"></i>Descuento (%)
                        </label>
                        <div class="input-group">
                            <input id="descuentoPct" class="form-control" type="number" min="0" max="100" step="1" value="2" />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                        <div class="form-text text-muted">Porcentaje de descuento aplicado al total del kit (0-100%)</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold text-primary">
                            <i class="bi bi-chat-text me-1"></i>Descripción (opcional)
                        </label>
                        <textarea id="descripcion" class="form-control" rows="2" placeholder="Descripción breve o condiciones de la promoción"></textarea>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <!-- PANEL IZQUIERDO: PRODUCTOS -->
        <div class="col-lg-7">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex align-items-center">
                    <i class="bi bi-search text-primary me-2"></i>
                    <h6 class="mb-0">Buscar y Agregar Productos</h6>
                </div>
                <div class="card-body position-relative">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-primary">Buscar producto</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-search"></i>
                            </span>
                            <input id="searchProducto" type="search" class="form-control" placeholder="Escribe nombre o código del producto..." autocomplete="off" />
                            <button id="btnBuscarNow" class="btn btn-outline-primary rounded-end" type="button" title="Buscar productos">
                                <i class="bi bi-search me-1"></i>Buscar
                            </button>
                        </div>

                        @if (proveedores != null)
                        {
                            <div class="mt-3">
                                <label class="form-label small fw-semibold">Filtrar por Proveedor</label>
                                <select id="filterProveedor" class="form-select" style="max-width:320px;">
                                    <option value="">— Todos los proveedores —</option>
                                    @foreach (var pv in proveedores)
                                    {
                                        <option value="@pv.IdProveedor">@pv.Nombre</option>
                                    }
                                </select>
                            </div>
                        }

                        <div id="suggestions" class="list-group position-absolute shadow-sm"
                             style="z-index:1050; display:none; max-height:220px; overflow:auto; left:0; right:0;"></div>
                    </div>

                    <hr />

                    <!-- TABLA DE PRODUCTOS AGREGADOS -->
                    <div class="table-responsive">
                        <table id="tablaItems" class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th style="width:100px">Cantidad</th>
                                    <th style="width:140px">Precio Unitario</th>
                                    <th style="width:140px">Subtotal</th>
                                    <th style="width:80px" class="text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot class="table-group-divider">
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Subtotal:</td>
                                    <td id="subtotalCell" class="text-primary">Q0.00</td>
                                    <td></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Descuento:</td>
                                    <td id="descuentoCell" class="text-warning">Q0.00</td>
                                    <td></td>
                                </tr>
                                <tr class="table-success fw-bold">
                                    <td colspan="3" class="text-end">Total:</td>
                                    <td id="totalCell" class="text-success">Q0.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="d-flex gap-2 mt-3">
                        <button id="calcularServer" class="btn btn-outline-primary rounded-pill" title="Recalcular con precios actuales">
                            <i class="bi bi-calculator me-1"></i>Recalcular Precios
                        </button>
                        <button id="limpiarItems" class="btn btn-outline-warning rounded-pill" title="Limpiar todos los productos">
                            <i class="bi bi-trash me-1"></i>Limpiar Todo
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL DERECHO: RESUMEN -->
        <div class="col-lg-5">
            <div class="card shadow-sm sticky-top" style="top:20px">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Resumen del Kit
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-semibold">Productos agregados:</span>
                        <span class="badge bg-primary rounded-pill fs-6" id="countItems">0</span>
                    </div>

                    <hr />

                    <div class="mb-2 d-flex justify-content-between">
                        <span>Subtotal:</span>
                        <strong id="resSubtotal" class="text-primary">Q0.00</strong>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span>Descuento (<span id="resDescuentoPct">2%</span>):</span>
                        <strong id="resDescuento" class="text-warning">Q0.00</strong>
                    </div>
                    <div class="mb-3 d-flex justify-content-between fs-5">
                        <span class="fw-bold">Total:</span>
                        <strong id="resTotal" class="text-success">Q0.00</strong>
                    </div>

                    <div class="d-grid">
                        <button id="guardarKit" class="btn btn-success rounded-pill btn-lg" title="Guardar kit/promoción">
                            <i class="bi bi-check2-circle me-1"></i>Guardar Kit / Promoción
                        </button>
                    </div>

                    <div class="alert alert-info mt-3 mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        <small>Al guardar, se almacenan los precios actuales de cada producto. El cálculo final será verificado en el servidor.</small>
                    </div>

                    <div id="alertArea" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const items = [];
        const formatMoney = v => new Intl.NumberFormat('es-GT', { style: 'currency', currency: 'GTQ' }).format(v);

        const antiToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const searchInput = document.getElementById('searchProducto');
        const suggestionsBox = document.getElementById('suggestions');
        const btnBuscarNow = document.getElementById('btnBuscarNow');
        const filterProveedor = document.getElementById('filterProveedor');
        const tablaBody = document.querySelector('#tablaItems tbody');
        const subtotalCell = document.getElementById('subtotalCell');
        const descuentoCell = document.getElementById('descuentoCell');
        const totalCell = document.getElementById('totalCell');
        const resSubtotal = document.getElementById('resSubtotal');
        const resDescuento = document.getElementById('resDescuento');
        const resTotal = document.getElementById('resTotal');
        const resDescuentoPct = document.getElementById('resDescuentoPct');
        const countItems = document.getElementById('countItems');
        const descuentoInput = document.getElementById('descuentoPct');
        const calcularServerBtn = document.getElementById('calcularServer');
        const limpiarBtn = document.getElementById('limpiarItems');
        const guardarBtn = document.getElementById('guardarKit');
        const alertArea = document.getElementById('alertArea');
        const buscarUrl = '@Url.Action("BuscarProducto", "Ventas")';

        function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }

        function mostrarAlerta(msg, tipo = 'info', timeout = 4000) {
            const icon = tipo === 'success' ? 'check-circle' : tipo === 'warning' ? 'exclamation-triangle' : tipo === 'danger' ? 'x-circle' : 'info-circle';
            alertArea.innerHTML = `<div class="alert alert-${tipo} alert-dismissible fade show">
                <i class="bi bi-${icon} me-2"></i>${msg}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
            if (timeout) setTimeout(() => alertArea.innerHTML = '', timeout);
        }

        function renderItems() {
            tablaBody.innerHTML = '';
            items.forEach((it, idx) => {
                tablaBody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-box text-muted me-2"></i>
                            ${it.nombre}
                        </div>
                    </td>
                    <td>
                        <input data-idx="${idx}" class="form-control form-control-sm qtyInput" type="number" min="1" value="${it.cantidad}" style="width:80px" />
                    </td>
                    <td class="fw-semibold">${formatMoney(it.precio)}</td>
                    <td class="fw-bold text-primary">${formatMoney(it.precio * it.cantidad)}</td>
                    <td class="text-center">
                        <button data-idx="${idx}" class="btn btn-sm btn-outline-danger rounded-circle del" title="Eliminar producto">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`);
            });
            document.querySelectorAll('.del').forEach(btn => btn.onclick = e => {
                items.splice(e.target.closest('button').dataset.idx, 1);
                actualizarUI();
            });
            document.querySelectorAll('.qtyInput').forEach(inp => inp.onchange = e => {
                const i = items[e.target.dataset.idx];
                i.cantidad = Math.max(1, +e.target.value);
                actualizarUI();
            });
        }

        function calcularLocales() {
            const subtotal = items.reduce((s, i) => s + i.precio * i.cantidad, 0);
            let pct = parseFloat(descuentoInput.value) || 0;
            if (pct > 1 && pct <= 100) pct /= 100;
            pct = Math.min(Math.max(pct, 0), 1);
            const desc = subtotal * pct, total = subtotal - desc;

            subtotalCell.textContent = formatMoney(subtotal);
            descuentoCell.textContent = formatMoney(desc);
            totalCell.textContent = formatMoney(total);
            resSubtotal.textContent = formatMoney(subtotal);
            resDescuento.textContent = formatMoney(desc);
            resTotal.textContent = formatMoney(total);
            resDescuentoPct.textContent = ((parseFloat(descuentoInput.value) || 0)) + '%';
            countItems.textContent = items.length;
            guardarBtn.disabled = total <= 0;
        }

        function actualizarUI() { renderItems(); calcularLocales(); }

        async function fetchSuggestions(term) {
            if (!term.trim()) return hideSuggestions();
            const prov = filterProveedor ? filterProveedor.value : '';
            try {
                const url = buscarUrl + '?term=' + encodeURIComponent(prov ? term + ' provider:' + prov : term);
                const res = await fetch(url);
                if (!res.ok) return hideSuggestions();
                const data = await res.json();
                renderSuggestions(Array.isArray(data) ? data : (data.results || []));
            } catch { hideSuggestions(); }
        }

        function renderSuggestions(list) {
            const shown = list.slice(0, 5);
            if (!shown.length) return hideSuggestions();
            suggestionsBox.innerHTML = '';
            shown.forEach(it => {
                const precio = formatMoney(it.precio || 0), stock = it.stock ?? 'N/A';
                const btn = document.createElement('button');
                btn.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                btn.innerHTML = `
                    <div class="flex-grow-1">
                        <div class="fw-semibold">${it.text}</div>
                        <div class="small text-muted">
                            <i class="bi bi-box me-1"></i>Stock: ${stock}
                            ${it.tipo === 'kit' ? '<span class="badge bg-info ms-2">KIT</span>' : ''}
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-primary">${precio}</div>
                        <div class="small text-muted">Agregar</div>
                    </div>`;
                btn.onclick = () => {
                    const precioNum = parseFloat(it.precio) || 0;
                    if (precioNum <= 0) return mostrarAlerta('El producto no tiene precio válido.', 'warning');
                    const ex = items.find(x => x.idProducto == it.id);
                    if (ex) {
                        ex.cantidad += 1;
                        mostrarAlerta(`Cantidad aumentada para "${it.text}"`, 'info', 2000);
                    } else {
                        items.push({ idProducto: it.id, nombre: it.text, cantidad: 1, precio: precioNum });
                        mostrarAlerta(`"${it.text}" agregado al kit`, 'success', 2000);
                    }
                    actualizarUI();
                    hideSuggestions();
                    searchInput.value = '';
                };
                suggestionsBox.appendChild(btn);
            });
            suggestionsBox.style.display = 'block';
        }

        function hideSuggestions() { suggestionsBox.style.display = 'none'; suggestionsBox.innerHTML = ''; }

        const debouncedFetch = debounce(fetchSuggestions, 150);
        searchInput.oninput = e => debouncedFetch(e.target.value);
        btnBuscarNow.onclick = () => fetchSuggestions(searchInput.value);
        if (filterProveedor) filterProveedor.onchange = () => { if (searchInput.value.trim()) fetchSuggestions(searchInput.value); };
        document.addEventListener('click', e => { if (!suggestionsBox.contains(e.target) && e.target !== searchInput) hideSuggestions(); });

        limpiarBtn.onclick = e => {
            e.preventDefault();
            if (items.length > 0 && confirm('¿Estás seguro de que deseas eliminar todos los productos del kit?')) {
                items.length = 0;
                actualizarUI();
                mostrarAlerta('Todos los productos han sido eliminados', 'info');
            }
        };

        descuentoInput.oninput = calcularLocales;

        document.addEventListener('DOMContentLoaded', actualizarUI);

        // GUARDAR KIT
        guardarBtn.addEventListener('click', async (e) => {
            e.preventDefault();

            const nombre = (document.getElementById('nombre')?.value || '').trim();
            const descripcion = (document.getElementById('descripcion')?.value || '').trim();
            const descuentoPct = parseFloat(descuentoInput.value) || 0;

            if (!nombre) {
                mostrarAlerta('Ingrese un nombre para el kit.', 'warning');
                document.getElementById('nombre').focus();
                return;
            }
            if (items.length === 0) {
                mostrarAlerta('Agrega al menos un producto antes de guardar.', 'warning');
                return;
            }

            const payload = {
                Nombre: nombre,
                Descripcion: descripcion,
                DescuentoPct: descuentoPct,
                Items: items.map(i => ({ IdProducto: i.idProducto, Cantidad: i.cantidad }))
            };

            guardarBtn.disabled = true;
            const prev = guardarBtn.innerHTML;
            guardarBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Guardando...';

            try {
                const res = await fetch('@Url.Action("Create", "Kits")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiToken
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json().catch(() => null);
                if (!res.ok || !data) {
                    mostrarAlerta(data?.message || 'Error al guardar el kit.', 'danger');
                    console.error('Error servidor:', data);
                } else if (data.success) {
                    mostrarAlerta('<strong>¡Kit guardado correctamente!</strong> Redirigiendo...', 'success');
                    setTimeout(() => {
                        if (data.idKit) window.location.href = `/Kits/Details/${data.idKit}`;
                        else window.location.href = '/Kits';
                    }, 1500);
                } else {
                    mostrarAlerta(data.message || 'No se pudo guardar el kit.', 'warning');
                }
            } catch (err) {
                console.error(err);
                mostrarAlerta('Error al conectar con el servidor.', 'danger');
            } finally {
                guardarBtn.disabled = false;
                guardarBtn.innerHTML = prev;
            }
        });
    </script>

    <style>
        .table td {
            vertical-align: middle;
        }

        .btn-sm {
            padding: 0.375rem 0.5rem;
        }

        .sticky-top {
            z-index: 1020;
        }

        #suggestions {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
        }
    </style>
}