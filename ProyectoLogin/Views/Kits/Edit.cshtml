@model ProyectoLogin.Models.Promociones.Kit
@using System.Security.Claims

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Editar Kit / Promoción";

    var productos = (ViewBag.Productos as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var detalles = Model?.Detalles ?? Enumerable.Empty<dynamic>();
    var gt = new System.Globalization.CultureInfo("es-GT");

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

@if (isAuth && isAdmin)
{
    <div class="container-fluid kits-edit-theme py-4">
        <!-- HEADER (mismo look que Productos) -->
        <div class="page-header">
            <div>
                <h1>
                    <i class="bi bi-pencil-square"></i>
                    Editar Kit / Promoción
                </h1>
                <div class="subtitle">Actualiza los datos, productos y condiciones del kit</div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-create-outline">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Kits
                </a>
            </div>
        </div>

        <!-- MODAL LIMPIAR TODO -->
        <div class="modal fade" id="modalLimpiarTodo" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content inventory-modal">
                    <div class="modal-header inventory-modal-head warning">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle fs-5 me-2"></i>
                            <h5 class="modal-title mb-0">Confirmar acción</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body py-4">
                        <div class="text-center mb-2">
                            <i class="bi bi-trash display-6 text-warning mb-2"></i>
                            <h5 class="mb-2">¿Eliminar todos los productos del kit?</h5>
                            <p class="text-muted mb-0">Esta acción eliminará todos los ítems del kit. No se puede deshacer.</p>
                        </div>
                    </div>
                    <div class="modal-footer border-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-2"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-warning text-white rounded-pill px-4" id="btn-confirmar-limpiar">
                            <i class="bi bi-check-circle me-2"></i>Sí, limpiar todo
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL CONFIRMAR GUARDAR -->
        <div class="modal fade" id="modalConfirmarGuardar" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content inventory-modal">
                    <div class="modal-header inventory-modal-head success">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle fs-5 me-2"></i>
                            <h5 class="modal-title mb-0">Confirmar guardado</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body py-4">
                        <div class="text-center mb-2">
                            <i class="bi bi-cloud-check display-6 text-success mb-2"></i>
                            <h5 class="mb-2">¿Guardar cambios del kit?</h5>
                            <p class="text-muted mb-0">Se actualizará la información con los productos y valores actuales.</p>
                        </div>
                    </div>
                    <div class="modal-footer border-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-2"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-success rounded-pill px-4" id="btn-confirmar-guardar">
                            <i class="bi bi-save me-2"></i>Sí, guardar cambios
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOAST (estilo claro coherente con Productos) -->
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100;">
            <div id="toastNotificacion" class="toast toast-light align-items-center border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi me-2"></i>
                        <span id="toast-message">Operación completada</span>
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>

        <!-- FORM -->
        <form id="form-edit-kit" method="post" onsubmit="return false;" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="IdKit" value="@(Model?.IdKit ?? 0)" />

            <div class="row">
                <!-- IZQUIERDA -->
                <div class="col-lg-8">
                    <!-- INFO BÁSICA -->
                    <div class="inventory-card mb-3">
                        <div class="card-head">
                            <i class="bi bi-tags fs-5"></i>
                            <h5 class="title mb-0">Información básica del kit</h5>
                        </div>
                        <div class="p-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="Nombre" class="form-label text-muted fw-semibold small text-uppercase">Nombre del Kit *</label>
                                    <input id="Nombre"
                                           class="form-control inv-input"
                                           placeholder="Ej. Pack Audífonos + Cargador"
                                           value="@(Model?.Nombre ?? String.Empty)"
                                           required />
                                    <div class="invalid-feedback">El nombre del kit es obligatorio.</div>
                                </div>

                                <div class="col-md-6">
                                    <label for="DescuentoPct" class="form-label text-muted fw-semibold small text-uppercase">Descuento (opcional)</label>
                                    <div class="input-group">
                                        <input id="DescuentoPct" type="number" min="0" max="100" step="1"
                                               value="@(((Model?.DescuentoPct ?? 0m) * 100).ToString("0"))"
                                               class="form-control inv-input" />
                                        <span class="input-group-text inv-addon">%</span>
                                    </div>
                                    <div class="form-text text-muted">Ingresa el porcentaje (ej.: 10 para 10%).</div>
                                </div>

                                <div class="col-12">
                                    <label for="Descripcion" class="form-label text-muted fw-semibold small text-uppercase">Descripción *</label>
                                    <textarea id="Descripcion"
                                              class="form-control inv-input"
                                              rows="3"
                                              required>@(Model?.Descripcion ?? String.Empty)</textarea>
                                    <div class="invalid-feedback">La descripción del kit es obligatoria.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PRODUCTOS DEL KIT -->
                    <div class="inventory-card mb-3">
                        <div class="card-head d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-search fs-5"></i>
                                <h5 class="title mb-0">Productos del kit</h5>
                            </div>
                            <div class="kits-search-wrapper">
                                <input type="text"
                                       id="busquedaProducto"
                                       class="form-control inv-input rounded-pill"
                                       placeholder="Buscar producto para agregar..."
                                       autocomplete="off" />
                                <ul id="sugerenciasProductos"
                                    class="list-group position-absolute w-100 shadow-sm inv-suggestions"
                                    style="display:none;"></ul>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 kits-table" id="tabla-items">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Producto</th>
                                        <th class="text-center" style="width:120px;">Cantidad</th>
                                        <th class="text-center" style="width:140px;">Precio unit.</th>
                                        <th class="text-center" style="width:140px;">Subtotal</th>
                                        <th class="text-center" style="width:80px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-productos">
                                    @foreach (var d in detalles)
                                    {
                                        var idProd = (int?)(d?.IdProducto) ?? 0;
                                        var nombreProd = (string?)(d?.Producto?.Nombre) ?? (d?.Nombre ?? $"Producto {idProd}");
                                        var cantidad = (int?)(d?.Cantidad) ?? 1;
                                        var precioSnap = (decimal?)(d?.PrecioUnitarioSnapshot) ?? 0m;
                                        <tr data-idproducto="@idProd">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="kits-pill-icon">
                                                        <i class="bi bi-box"></i>
                                                    </div>
                                                    <div>
                                                        <span class="kits-product-name">@nombreProd</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <input class="form-control form-control-sm text-center cantidad inv-input-sm"
                                                       type="number" min="1" value="@cantidad" />
                                            </td>
                                            <td class="text-center precio-unitario">
                                                @precioSnap.ToString("F2")
                                            </td>
                                            <td class="text-center subtotal">
                                                @((precioSnap * cantidad).ToString("F2"))
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-danger rounded-circle btn-eliminar"
                                                        title="Eliminar producto del kit">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end text-muted">Subtotal:</td>
                                        <td id="txt-subtotal" class="text-center fw-semibold">0.00</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end text-muted">Descuento:</td>
                                        <td id="txt-descuento" class="text-center fw-semibold">0.00</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">Total:</td>
                                        <td id="txt-total" class="text-center fw-bold text-success">0.00</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div id="alertArea" class="mt-3"></div>
                </div>

                <!-- DERECHA -->
                <div class="col-lg-4">
                    <!-- Resumen -->
                    <div class="inventory-card mb-3">
                        <div class="card-head">
                            <i class="bi bi-clipboard-check fs-5"></i>
                            <h5 class="title mb-0">Resumen del kit</h5>
                        </div>
                        <div class="p-3">
                            <div class="resumen-row">
                                <span class="text-muted">Productos en el kit</span>
                                <span id="resumen-cantidad" class="badge bg-primary-subtle text-primary-emphasis">@detalles.Count()</span>
                            </div>
                            <div class="resumen-row">
                                <span class="text-muted">Subtotal</span>
                                <span id="resumen-subtotal" class="fw-semibold">0.00</span>
                            </div>
                            <div class="resumen-row">
                                <span class="text-muted">Descuento aplicado</span>
                                <span id="resumen-descuento" class="fw-semibold">0%</span>
                            </div>
                            <div class="resumen-row border-top pt-2 mt-1">
                                <span class="fw-semibold">Total final</span>
                                <span id="resumen-total" class="fw-bold text-success">0.00</span>
                            </div>
                        </div>
                    </div>

                    <!-- Acciones -->
                    <div class="inventory-card">
                        <div class="card-head">
                            <i class="bi bi-lightning-charge fs-5"></i>
                            <h5 class="title mb-0">Acciones rápidas</h5>
                        </div>
                        <div class="p-3">
                            <div class="d-grid gap-2">
                                <button id="btn-guardar-lateral" class="btn btn-create-primary d-flex align-items-center justify-content-center">
                                    <i class="bi bi-save me-2"></i>Guardar cambios
                                </button>
                                <button type="button" id="btn-limpiar-todo" class="btn btn-outline-secondary d-flex align-items-center justify-content-center">
                                    <i class="bi bi-trash me-2"></i>Limpiar todo
                                </button>
                                <a asp-action="Index" class="btn btn-outline-danger d-flex align-items-center justify-content-center">
                                    <i class="bi bi-x-circle me-2"></i>Cancelar edición
                                </a>
                            </div>
                            <p class="small text-muted mt-3 mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Los cambios solo se guardan cuando confirmes en el modal.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
}
else
{
    <div class="container py-5 text-center">
        <h4>Acceso restringido</h4>
        <p>Solo los usuarios con rol <strong>Administrador</strong> pueden editar kits.</p>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>
}

@section Styles {
    <style>
        :root{
            /* Paleta del Index Productos */
            --inventory-primary:#1C1973;
            --inventory-secondary:#514BF2;
            --inventory-accent:#8B88F2;
            --inventory-bg:#f5f6fa;
            --inventory-card:#ffffff;
            --inventory-text:#212529;
            --inventory-radius:.75rem;
            --muted:#6b7280;
            --border-soft:#e5e7eb;
        }

        /* Layout base */
        .kits-edit-theme{ background:var(--inventory-bg); }
        .page-header{
            background:linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
            border:1px solid rgba(255,255,255,.12);
            border-radius:var(--inventory-radius);
            padding:1.1rem 1.4rem;margin-bottom:1rem;
            box-shadow:0 6px 18px rgba(15,23,42,.18);
            display:flex;align-items:center;justify-content:space-between;gap:1rem;color:#fff;
        }
        .page-header h1{font-size:1.25rem;margin:0;display:flex;align-items:center;gap:.4rem;font-weight:700}
        .page-header h1 i{font-size:1.3rem}
        .page-header .subtitle{color:rgba(249,250,251,.9);font-size:.85rem;margin-top:.15rem}
        .btn-create-outline{
            border:1px solid var(--inventory-accent);background:transparent;color:#fff;border-radius:var(--inventory-radius);
            font-weight:500;padding:.5rem 1.2rem;font-size:.86rem;transition:.25s;display:inline-flex;align-items:center;gap:.35rem;text-decoration:none
        }
        .btn-create-outline:hover{background:rgba(139,136,242,.16);color:#fff;box-shadow:0 4px 10px rgba(15,23,42,.25);transform:translateY(-1px)}
        .btn-create-primary{
            background:#fff;color:var(--inventory-primary);border:none;border-radius:var(--inventory-radius);
            font-weight:600;padding:.55rem 1.2rem;font-size:.9rem;display:inline-flex;align-items:center;gap:.35rem;transition:.25s;text-decoration:none
        }
        .btn-create-primary:hover{background:#f9fafb;color:var(--inventory-secondary);box-shadow:0 4px 12px rgba(15,23,42,.25);transform:translateY(-1px)}

        /* Cards */
        .inventory-card{
            background:var(--inventory-card);border:1px solid var(--border-soft);border-radius:var(--inventory-radius);
            overflow:hidden;box-shadow:0 4px 14px rgba(15,23,42,.06);transition:.22s;
        }
        .inventory-card:hover{box-shadow:0 7px 20px rgba(15,23,42,.1);transform:translateY(-1px)}
        .card-head{
            display:flex;align-items:center;gap:.6rem;padding:.8rem 1.1rem;
            background:linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary));
            border-bottom:1px solid rgba(255,255,255,.16);color:#fff;
        }
        .card-head .title{margin:0;font-size:1rem;font-weight:700}

        /* Inputs */
        .inv-input{ background:#fff;border:1px solid var(--border-soft);color:var(--inventory-text); }
        .inv-input:focus{ border-color:var(--inventory-secondary); box-shadow:0 0 0 .16rem rgba(81,75,242,.15); }
        .inv-input-sm{ background:#fff;border:1px solid var(--border-soft); }
        .inv-input-sm:focus{ border-color:var(--inventory-secondary); box-shadow:0 0 0 .16rem rgba(81,75,242,.15); }
        .inv-addon{ background:#f3f4ff;border-color:var(--border-soft);color:var(--inventory-primary);font-weight:600 }

        /* Sugerencias */
        .kits-search-wrapper{ position:relative;width:300px;max-width:100%;}
        .inv-suggestions{
            top:100%;left:0;margin-top:.25rem;background:#fff;border-radius:.6rem;border:1px solid var(--border-soft);
            max-height:260px;overflow-y:auto;box-shadow:0 6px 18px rgba(15,23,42,.12);z-index:1100;
        }
        .inv-suggestions .list-group-item{border:none;border-bottom:1px solid var(--border-soft);cursor:pointer;padding:.5rem .75rem;}
        .inv-suggestions .list-group-item:last-child{border-bottom:none}
        .inv-suggestions .list-group-item:hover{background:#f9fafb}

        /* Tabla (igual a Productos) */
        .table thead th{
            background:#f3f4ff;font-weight:600;font-size:.78rem;border-bottom:1px solid var(--border-soft);
            white-space:nowrap;text-transform:uppercase;letter-spacing:.03em;color:#6b7280;
        }
        .table tbody td{vertical-align:middle;border-color:var(--border-soft)}
        .table-hover tbody tr:hover{background:#f9fafb}
        .kits-pill-icon{
            width:32px;height:32px;border-radius:.7rem;background:#f3f4ff;color:var(--inventory-secondary);
            display:flex;align-items:center;justify-content:center;margin-right:.5rem;
        }

        /* Resumen */
        .resumen-row{display:flex;justify-content:space-between;align-items:center;padding:.35rem 0;border-bottom:1px solid var(--border-soft);font-size:.9rem}
        .resumen-row:last-child{border-bottom:none}

        /* Toast claro */
        .toast-light{
            background:#fff;color:#111827;border-radius:.75rem;border:1px solid var(--border-soft);
            box-shadow:0 8px 22px rgba(0,0,0,.08);font-size:.85rem
        }

        /* Modales */
        .inventory-modal{ background:#fff;border-radius:var(--inventory-radius);border:1px solid var(--border-soft);box-shadow:0 12px 36px rgba(15,23,42,.18) }
        .inventory-modal-head{ background:linear-gradient(90deg,var(--inventory-primary),var(--inventory-secondary)); color:#fff; border-bottom:1px solid rgba(255,255,255,.16); }
        .inventory-modal-head.warning{ background:linear-gradient(90deg,#b45309,#f59e0b); }
        .inventory-modal-head.success{ background:linear-gradient(90deg,#15803d,#22c55e); }

        /* Responsive */
        @@media (max-width:768px){
            .page-header{flex-direction:column;align-items:flex-start;padding:.9rem 1rem}
            .page-header h1{font-size:1.1rem}
            .page-header .subtitle{font-size:.8rem}
            .page-header .d-flex.gap-2{width:100%;justify-content:flex-start;flex-wrap:wrap}
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            const editUrl = '@Url.Action("Edit", "Kits")';
            const indexUrl = '@Url.Action("Index", "Kits")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const alertArea = document.getElementById('alertArea');
            const parseNumber = v => isNaN(parseFloat(v)) ? 0 : parseFloat(v);

            // Toast estilizado (mantiene ids/clases)
            function mostrarToast(mensaje, tipo = 'success') {
                const toast = document.getElementById('toastNotificacion');
                const toastMessage = document.getElementById('toast-message');
                const toastIcon = toast.querySelector('.bi');

                const config = {
                    success: { icon: 'bi-check-circle', color: '#16a34a' },
                    warning: { icon: 'bi-exclamation-triangle', color: '#eab308' },
                    danger: { icon: 'bi-x-circle', color: '#dc2626' },
                    info: { icon: 'bi-info-circle', color: '#514BF2' }
                };

                const { icon, color } = config[tipo] || config.success;
                toastIcon.className = `bi ${icon} me-2`;
                toastIcon.style.color = color;
                toastMessage.textContent = mensaje;

                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            function recalcRow(tr) {
                const cantidad = parseNumber(tr.querySelector('.cantidad').value);
                const precio = parseNumber(tr.querySelector('.precio-unitario').textContent);
                const subtotal = cantidad * precio;
                tr.querySelector('.subtotal').textContent = subtotal.toFixed(2);
                return subtotal;
            }

            function recalcUI() {
                let subtotal = 0;
                document.querySelectorAll('#tabla-items tbody tr').forEach(tr => subtotal += recalcRow(tr));

                const descuentoInput = document.getElementById('DescuentoPct');
                const descuentoPctInput = parseNumber(descuentoInput?.value || 0);
                const descuentoPct = descuentoPctInput > 1 ? (descuentoPctInput / 100) : descuentoPctInput;
                const descuento = subtotal * descuentoPct;
                const total = subtotal - descuento;

                document.getElementById('txt-subtotal').textContent = subtotal.toFixed(2);
                document.getElementById('txt-descuento').textContent = descuento.toFixed(2);
                document.getElementById('txt-total').textContent = total.toFixed(2);

                const filas = document.querySelectorAll('#tabla-items tbody tr').length;
                document.getElementById('resumen-cantidad').textContent = filas;
                document.getElementById('resumen-subtotal').textContent = subtotal.toFixed(2);
                document.getElementById('resumen-descuento').textContent = (descuentoPct * 100).toFixed(0) + '%';
                document.getElementById('resumen-total').textContent = total.toFixed(2);
            }

            function attachRowEvents(tr) {
                const cantidadInput = tr.querySelector('.cantidad');
                const btnEliminar = tr.querySelector('.btn-eliminar');

                cantidadInput?.addEventListener('change', () => {
                    if (parseInt(cantidadInput.value) < 1) cantidadInput.value = 1;
                    recalcRow(tr);
                    recalcUI();
                });

                btnEliminar?.addEventListener('click', (e) => {
                    e.preventDefault();
                    tr.remove();
                    recalcUI();
                    mostrarToast('Producto eliminado del kit', 'info');
                });
            }

            document.querySelectorAll('#tabla-items tbody tr').forEach(attachRowEvents);
            recalcUI();

            const productosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ((IEnumerable<dynamic>)ViewBag.Productos).Select(p => new {
                    idProducto = p.IdProducto,
                    nombre = p.Nombre,
                    precioVenta = p.PrecioVenta
                })
            ));

            const inputBusqueda = document.getElementById('busquedaProducto');
            const listaSugerencias = document.getElementById('sugerenciasProductos');

            if (inputBusqueda && listaSugerencias) {
                inputBusqueda.addEventListener('input', function () {
                    const query = this.value.trim().toLowerCase();
                    listaSugerencias.innerHTML = '';

                    if (!query || !productosData || productosData.length === 0) {
                        listaSugerencias.style.display = 'none';
                        return;
                    }

                    const coincidencias = productosData
                        .filter(p => p.nombre && p.nombre.toLowerCase().includes(query))
                        .slice(0, 10);

                    if (coincidencias.length === 0) {
                        listaSugerencias.style.display = 'none';
                        return;
                    }

                    coincidencias.forEach(p => {
                        const li = document.createElement('li');
                        li.className = 'list-group-item list-group-item-action';
                        li.innerHTML = `
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-semibold">${p.nombre}</div>
                                <div class="text-primary fw-bold">${(p.precioVenta || 0).toFixed(2)}</div>
                            </div>`;
                        li.addEventListener('click', () => {
                            agregarProducto(p.idProducto, p.nombre, p.precioVenta);
                            listaSugerencias.style.display = 'none';
                            inputBusqueda.value = '';
                        });
                        listaSugerencias.appendChild(li);
                    });

                    listaSugerencias.style.display = 'block';
                });

                document.addEventListener('click', (e) => {
                    if (!listaSugerencias.contains(e.target) && e.target !== inputBusqueda) {
                        listaSugerencias.style.display = 'none';
                    }
                });
            }

            function agregarProducto(id, nombre, precio) {
                const tbody = document.getElementById('tbody-productos');
                const existe = tbody.querySelector(`tr[data-idproducto="${id}"]`);

                if (existe) {
                    const inputCant = existe.querySelector('.cantidad');
                    inputCant.value = parseInt(inputCant.value || 1) + 1;
                    recalcRow(existe);
                    recalcUI();
                    mostrarToast(`Cantidad aumentada para "${nombre}"`, 'info');
                    return;
                }

                const tr = document.createElement('tr');
                tr.dataset.idproducto = id;
                tr.innerHTML = `
                    <td class="ps-4">
                        <div class="d-flex align-items-center">
                            <div class="kits-pill-icon"><i class="bi bi-box"></i></div>
                            <div><span class="kits-product-name">${nombre}</span></div>
                        </div>
                    </td>
                    <td>
                        <input class="form-control form-control-sm text-center cantidad inv-input-sm" type="number" min="1" value="1" />
                    </td>
                    <td class="text-center precio-unitario">${(precio || 0).toFixed(2)}</td>
                    <td class="text-center subtotal">${(precio || 0).toFixed(2)}</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-danger rounded-circle btn-eliminar" title="Eliminar producto del kit">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>`;
                tbody.appendChild(tr);
                attachRowEvents(tr);
                recalcUI();
                mostrarToast(`"${nombre}" agregado al kit`, 'success');
            }

            function mostrarModalLimpiar() {
                const filas = document.querySelectorAll('#tabla-items tbody tr');
                if (filas.length === 0) { mostrarToast('El kit ya está vacío.', 'info'); return; }
                const modal = new bootstrap.Modal(document.getElementById('modalLimpiarTodo'));
                modal.show();
            }

            function limpiarTodo() {
                const tbody = document.getElementById('tbody-productos');
                tbody.innerHTML = '';
                recalcUI();
                mostrarToast('Todos los productos han sido eliminados del kit.', 'success');
                const modal = bootstrap.Modal.getInstance(document.getElementById('modalLimpiarTodo'));
                modal.hide();
            }

            document.getElementById('btn-limpiar-todo')?.addEventListener('click', mostrarModalLimpiar);
            document.getElementById('btn-confirmar-limpiar')?.addEventListener('click', limpiarTodo);

            function mostrarModalGuardar() {
                const nombreInput = document.getElementById('Nombre');
                const descripcionInput = document.getElementById('Descripcion');
                [nombreInput, descripcionInput].forEach(el => el.classList.remove('is-invalid'));

                let valido = true;
                if (!nombreInput.value.trim()) { nombreInput.classList.add('is-invalid'); valido = false; }
                if (!descripcionInput.value.trim()) { descripcionInput.classList.add('is-invalid'); valido = false; }

                const items = document.querySelectorAll('#tabla-items tbody tr');
                if (items.length === 0) { mostrarToast('Agrega al menos un producto al kit.', 'warning'); valido = false; }

                if (!valido) { mostrarToast('Revisa los campos obligatorios antes de guardar.', 'warning'); return; }

                const modal = new bootstrap.Modal(document.getElementById('modalConfirmarGuardar'));
                modal.show();
            }
            document.getElementById('btn-guardar-lateral')?.addEventListener('click', mostrarModalGuardar);

            async function guardarCambios() {
                const nombreInput = document.getElementById('Nombre');
                const descripcionInput = document.getElementById('Descripcion');
                const idKit = parseInt(document.getElementById('IdKit').value) || 0;

                const items = [];
                document.querySelectorAll('#tabla-items tbody tr').forEach(tr => {
                    const idProducto = parseInt(tr.dataset.idproducto) || 0;
                    const cantidad = parseInt(tr.querySelector('.cantidad').value) || 1;
                    if (idProducto > 0) items.push({ IdProducto: idProducto, Cantidad: cantidad });
                });

                const descuentoPctInput = parseNumber(document.getElementById('DescuentoPct').value) || 0;
                const descuentoPct = descuentoPctInput > 1 ? (descuentoPctInput / 100) : descuentoPctInput;

                const payload = {
                    IdKit: idKit,
                    Nombre: nombreInput.value.trim(),
                    Descripcion: descripcionInput.value.trim(),
                    DescuentoPct: descuentoPct,
                    Activo: true,
                    Items: items
                };

                const btnGuardar = document.getElementById('btn-guardar-lateral');
                const originalText = btnGuardar.innerHTML;

                try {
                    btnGuardar.disabled = true;
                    btnGuardar.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Guardando...';

                    const res = await fetch(editUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(payload),
                        credentials: 'same-origin'
                    });

                    if (!res.ok) {
                        mostrarToast('Error al guardar los cambios.', 'danger');
                    } else {
                        const data = await res.json();
                        if (data.success) {
                            mostrarToast('Kit actualizado correctamente. Redirigiendo...', 'success');
                            setTimeout(() => window.location.href = indexUrl, 1000);
                        } else {
                            mostrarToast(data.message || 'No se pudo guardar el kit.', 'danger');
                        }
                    }
                } catch (e) {
                    console.error(e);
                    mostrarToast('Error al conectar con el servidor.', 'danger');
                } finally {
                    btnGuardar.disabled = false;
                    btnGuardar.innerHTML = originalText;
                    const modal = bootstrap.Modal.getInstance(document.getElementById('modalConfirmarGuardar'));
                    modal?.hide();
                }
            }
            document.getElementById('btn-confirmar-guardar')?.addEventListener('click', guardarCambios);

            const descuentoInput = document.getElementById('DescuentoPct');
            descuentoInput?.addEventListener('input', recalcUI);
            descuentoInput?.addEventListener('blur', () => {
                if (descuentoInput.value.trim() === '' || isNaN(parseFloat(descuentoInput.value))) {
                    descuentoInput.value = 0; recalcUI();
                }
            });

            ['Nombre', 'Descripcion'].forEach(id => {
                const el = document.getElementById(id);
                el?.addEventListener('input', () => el.classList.remove('is-invalid'));
            });
        })();
    </script>
}
