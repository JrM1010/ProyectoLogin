@model IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoCore>
@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Inventario - Productos";

    var precios = ViewBag.Precios as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoPrecio>
                  ?? Enumerable.Empty<ProyectoLogin.Models.ModelosProducts.ProductoPrecio>();

    // Dejar solo el precio activo más reciente por producto
    var precioDict = precios
        .Where(x => x.Activo)
        .GroupBy(x => x.IdProducto)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(p => p.FechaInicio).FirstOrDefault());

    var activos = ViewBag.Activos as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoCore>
                  ?? Enumerable.Empty<ProyectoLogin.Models.ModelosProducts.ProductoCore>();
    var inactivos = ViewBag.Inactivos as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoCore>
                   ?? Enumerable.Empty<ProyectoLogin.Models.ModelosProducts.ProductoCore>();

    var totalActivos = ViewBag.TotalActivos ?? 0;
    var totalInactivos = ViewBag.TotalInactivos ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
    var pageActivos = ViewBag.PageActivos ?? 1;
    var pageInactivos = ViewBag.PageInactivos ?? 1;
    var totalPagesActivos = ViewBag.TotalPagesActivos ?? 1;
    var totalPagesInactivos = ViewBag.TotalPagesInactivos ?? 1;

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}

@section Styles {
    <style>
        :root {
            --inventory-primary: #1C1973;
            --inventory-secondary: #514BF2;
            --inventory-accent: #8B88F2;
            --inventory-bg: #f5f6fa;
            --inventory-card: #ffffff;
            --inventory-text: #212529;
            --inventory-radius: 0.75rem;
            --muted: #6b7280;
            --border-soft: #e5e7eb;
        }

        /* Fondo general del módulo */
        .inventory-theme {
            background: var(--inventory-bg);
            padding: 1.5rem 0 2rem;
        }

        /* HEADER PRINCIPAL - gradiente "Inventario de Productos" */
        .page-header {
            background: linear-gradient(90deg, var(--inventory-primary), var(--inventory-secondary));
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: var(--inventory-radius);
            padding: 1.1rem 1.4rem;
            margin-bottom: 1rem;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.18);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            color: #ffffff;
        }

            .page-header h1 {
                font-size: 1.3rem;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 0.4rem;
                font-weight: 700;
                color: #ffffff;
            }

                .page-header h1 i {
                    font-size: 1.4rem;
                }

            .page-header .subtitle {
                color: rgba(249, 250, 251, 0.9);
                font-size: 0.85rem;
                margin-top: 0.15rem;
            }

            .page-header .btn {
                font-size: 0.86rem;
                border-radius: var(--inventory-radius);
                padding: 0.5rem 1rem;
            }

        /* Botones coherentes con Create/Edit */
        .btn-create-outline {
            border: 1px solid var(--inventory-accent);
            background: transparent;
            color: #ffffff;
            border-radius: var(--inventory-radius);
            font-weight: 500;
            padding: 0.5rem 1.4rem;
            font-size: 0.86rem;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            text-decoration: none;
        }

            .btn-create-outline:hover {
                background: rgba(139, 136, 242, 0.16);
                color: #ffffff;
                box-shadow: 0 4px 10px rgba(15, 23, 42, 0.25);
                transform: translateY(-1px);
            }

        .btn-create-primary {
            background: #ffffff;
            color: var(--inventory-primary);
            border: none;
            border-radius: var(--inventory-radius);
            font-weight: 600;
            padding: 0.5rem 1.4rem;
            font-size: 0.86rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: all 0.25s ease;
            text-decoration: none;
        }

            .btn-create-primary:hover {
                background: #f9fafb;
                color: var(--inventory-secondary);
                box-shadow: 0 4px 12px rgba(15, 23, 42, 0.25);
                transform: translateY(-1px);
            }

        /* TARJETA DE BÚSQUEDA */
        .search-card {
            background: var(--inventory-card);
            border: 1px solid var(--border-soft);
            border-radius: var(--inventory-radius);
            padding: 0.9rem 1.1rem;
            margin-bottom: 1.1rem;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        }

        /* === NUEVO: barra de búsqueda con el mismo estilo/tamaño que Proveedores === */
        .inv-search-inline {
            display: flex;
            align-items: center;
            gap: .6rem;
            flex-wrap: wrap;
        }

        .inv-search-label {
            font-size: .8rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 0;
        }

        .inv-input-group {
            display: flex;
            align-items: stretch;
            gap: 0;
            flex: 1 1 540px; /* ancho similar al de proveedores */
            min-width: 280px;
        }

        .inv-input-icon {
            background: #fff;
            border: 1px solid var(--border-soft);
            border-right: 0;
            border-radius: .6rem 0 0 .6rem;
            width: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--inventory-primary);
        }

        .inv-input-search {
            background: #fff;
            border: 1px solid var(--border-soft);
            border-left: 0;
            border-right: 0;
            border-radius: 0;
            padding: .55rem .85rem;
            font-size: .9rem;
            color: var(--inventory-text);
            flex: 1;
        }

            .inv-input-search::placeholder {
                color: #9ca3af;
            }

            .inv-input-search:focus {
                outline: none;
                border-color: var(--inventory-secondary);
                box-shadow: 0 0 0 .16rem rgba(81,75,242,.15);
            }

        .inv-btn-search {
            border-radius: 0 .6rem .6rem 0;
            padding: .5rem 1.3rem;
            font-size: .86rem;
            border: 1px solid var(--inventory-accent);
            background: transparent;
            color: var(--inventory-primary);
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            transition: all .25s ease;
        }

            .inv-btn-search:hover {
                background: var(--inventory-accent);
                color: #101232;
                box-shadow: 0 4px 10px rgba(15,23,42,.16);
                transform: translateY(-1px);
            }

        /* TARJETAS DE TABLAS (Activos / Inactivos) */
        .inventory-card {
            background: var(--inventory-card);
            border: 1px solid var(--border-soft);
            border-radius: var(--inventory-radius);
            overflow: hidden;
            margin-bottom: 1.25rem;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
            transition: all 0.22s ease;
        }

            .inventory-card:hover {
                box-shadow: 0 7px 20px rgba(15, 23, 42, 0.10);
                transform: translateY(-1px);
            }

            /* HEAD "Productos activos" / "Productos inactivos" con gradiente */
            .inventory-card .card-head {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.85rem 1.15rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.06);
                background: linear-gradient(90deg, var(--inventory-primary), var(--inventory-secondary));
                color: #ffffff;
            }

                .inventory-card .card-head .title {
                    margin: 0;
                    font-size: 1rem;
                    font-weight: 700;
                    color: #ffffff;
                }

                .inventory-card .card-head i {
                    color: #bbf7d0;
                }

            .inventory-card:last-of-type .card-head i {
                color: #e5e7eb;
            }

        .stats-badge {
            margin-left: auto;
            background: rgba(15, 23, 42, 0.16);
            border: 1px solid rgba(226, 232, 240, 0.45);
            border-radius: 999px;
            padding: 0.25rem 0.8rem;
            font-size: 0.78rem;
            color: #e5e7eb;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        /* TABLAS */
        .table-responsive {
            padding: 0;
        }

        .table {
            margin-bottom: 0;
            font-size: 0.85rem;
            color: #111827;
        }

            .table thead th {
                background: #f3f4ff;
                font-weight: 600;
                font-size: 0.78rem;
                border-bottom: 1px solid var(--border-soft);
                white-space: nowrap;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                color: #6b7280;
            }

            .table tbody td {
                vertical-align: middle;
                border-color: var(--border-soft);
            }

        .table-hover tbody tr:hover {
            background-color: #f9fafb;
        }

        .table .badge {
            font-weight: 500;
            border-radius: 999px;
            font-size: 0.72rem;
            padding: 0.22rem 0.55rem;
        }

        /* STOCK */
        .row-low {
            background: #fef2f2;
        }

            .row-low td:first-child {
                position: relative;
            }

                .row-low td:first-child:before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 3px;
                    background: #ef4444;
                    border-top-left-radius: 0.35rem;
                    border-bottom-left-radius: 0.35rem;
                }

        .txt-stock-ok {
            color: #16a34a;
            font-weight: 600;
        }

        .txt-stock-low {
            color: #dc2626;
            font-weight: 600;
        }

        /* BOTONES DE ACCIÓN */
        .action-btn {
            width: 2.2rem;
            height: 2.2rem;
            border-radius: 0.7rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 0.12rem;
            padding: 0;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            border: none;
        }

        .btn-info.action-btn {
            background: #eff6ff;
            color: #2563eb;
        }

            .btn-info.action-btn i {
                color: #2563eb !important;
            }

            .btn-info.action-btn:hover {
                background: #2563eb;
                color: #ffffff;
                transform: translateY(-1px);
            }

        .btn-warning.action-btn {
            background: #fef3c7;
            color: #92400e;
        }

            .btn-warning.action-btn:hover {
                background: #fbbf24;
                color: #111827;
                transform: translateY(-1px);
            }

        .btn-danger.action-btn {
            background: #fee2e2;
            color: #b91c1c;
        }

            .btn-danger.action-btn:hover {
                background: #dc2626;
                color: #ffffff;
                transform: translateY(-1px);
            }

        .btn-success.action-btn {
            background: #dcfce7;
            color: #166534;
        }

            .btn-success.action-btn:hover {
                background: #22c55e;
                color: #ffffff;
                transform: translateY(-1px);
            }

        /* PAGINACIÓN */
        .pagination .page-link {
            border-radius: 999px !important;
            font-size: 0.78rem;
            padding: 0.25rem 0.6rem;
        }

        .pagination .page-item.active .page-link {
            background-color: var(--inventory-secondary);
            border-color: var(--inventory-secondary);
        }

        /* MODAL CONFIRMACIÓN */
        #confirmToggleModal .modal-content {
            background: #ffffff;
            border-radius: var(--inventory-radius);
            border: 1px solid var(--border-soft);
            box-shadow: 0 10px 40px rgba(15, 23, 42, 0.18);
        }

        #confirmToggleModal .modal-header {
            background: linear-gradient(90deg, var(--inventory-primary), var(--inventory-secondary));
            border-bottom: 1px solid rgba(255, 255, 255, 0.16);
            color: #ffffff;
            border-radius: var(--inventory-radius) var(--inventory-radius) 0 0;
        }

        #confirmToggleModal .modal-title {
            font-size: 0.98rem;
            font-weight: 600;
        }

        #confirmToggleModal .btn-outline-secondary {
            border-radius: var(--inventory-radius);
            font-size: 0.82rem;
        }

        #confirmToggleModal .btn-primary {
            background: var(--inventory-secondary);
            border-radius: var(--inventory-radius);
            font-size: 0.82rem;
            border: none;
        }

            #confirmToggleModal .btn-primary:hover {
                background: var(--inventory-primary);
            }

        /* RESPONSIVE */
        .col-hide-sm { /* columnas que se ocultan en móvil */
        }

        @@media (max-width: 768px) {
            .page-header {
                flex-direction: column;
                align-items: flex-start;
                padding: 0.9rem 1rem;
            }

                .page-header h1 {
                    font-size: 1.1rem;
                }

                .page-header .subtitle {
                    font-size: 0.8rem;
                }

                .page-header .d-flex.gap-2 {
                    width: 100%;
                    justify-content: flex-start;
                    flex-wrap: wrap;
                }

            .search-card {
                padding: 0.8rem 0.9rem;
            }
            /* barra búsqueda a ancho completo en móvil */
            .inv-input-group {
                flex: 1 1 100%;
            }

            .inventory-card .card-head {
                padding: 0.75rem 0.9rem;
            }

            .col-hide-sm {
                display: none;
            }

            .action-btn {
                width: 2rem;
                height: 2rem;
                border-radius: 0.6rem;
            }
        }
    </style>
}

<div class="container-fluid py-2 inventory-theme">

    <!-- Encabezado -->
    <div class="page-header">
        <div>
            <h1>
                <i class="bi bi-box-seam"></i>
                Inventario de Productos
            </h1>
            <div class="subtitle">Administra y controla tu catálogo</div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Home")" class="btn btn-create-outline">
                <i class="bi bi-arrow-left me-1"></i> Inicio
            </a>
            @if (isAuth && isAdmin)
            {
                <a class="btn btn-create-primary" asp-action="Create">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo
                </a>
            }
        </div>
    </div>

    <!-- Búsqueda: mismo estilo/tamaño que Proveedores -->
    <div class="search-card">
        <form method="get" asp-action="Index" class="inv-search-inline">
            <div class="inv-search-label">Buscar producto</div>

            <div class="inv-input-group">
                <span class="inv-input-icon"><i class="bi bi-search"></i></span>

                <input type="text"
                       class="inv-input-search"
                       name="q"
                       value="@(ViewData["q"] ?? "")"
                       placeholder="Buscar por nombre o código..." />

                <input type="hidden" name="pageActivos" value="1" />
                <input type="hidden" name="pageInactivos" value="1" />

                <button class="inv-btn-search" type="submit">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </form>
    </div>

    <!-- Activos -->
    <div class="inventory-card">
        <div class="card-head">
            <i class="bi bi-check2-circle fs-5"></i>
            <h3 class="title">Productos activos</h3>
            <span class="stats-badge">
                <i class="bi bi-box"></i>@totalActivos
            </span>
        </div>

        <div class="table-responsive">
            @if (!activos.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-box fs-2 d-block mb-2"></i>
                    No hay productos activos
                </div>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="col-hide-sm">Código</th>
                            <th class="col-hide-sm">Categoría</th>
                            <th class="col-hide-sm">Marca</th>
                            <th class="text-center">Stock</th>
                            <th class="col-hide-sm text-center">Stock mín.</th>
                            <th class="text-center">Precio</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in activos)
                        {
                            precioDict.TryGetValue(p.IdProducto, out var precio);
                            var stockActual = p.Inventario?.StockActual ?? 0;
                            var stockMin = p.Inventario?.StockMinimo ?? 0;
                            var isLow = (p.Inventario != null) && (stockActual <= stockMin);

                            <tr class="@(isLow ? "row-low" : "")">
                                <td>
                                    <div class="fw-semibold">@p.Nombre</div>
                                    @if (isLow)
                                    {
                                        <small class="text-danger d-inline-flex align-items-center">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Stock bajo
                                        </small>
                                    }
                                </td>
                                <td class="col-hide-sm">
                                    <span class="badge text-bg-secondary">
                                        @(string.IsNullOrWhiteSpace(p.CodigoBarras) ? "Sin código" : p.CodigoBarras)
                                    </span>
                                </td>
                                <td class="col-hide-sm">
                                    <span class="badge text-bg-info">@p.Categoria?.Nombre</span>
                                </td>
                                <td class="col-hide-sm">
                                    <span class="badge text-bg-warning text-dark">@p.Marca?.Nombre</span>
                                </td>
                                <td class="text-center">
                                    <span class="@(isLow ? "txt-stock-low" : "txt-stock-ok")">@stockActual</span>
                                </td>
                                <td class="col-hide-sm text-center text-muted">@stockMin</td>
                                <td class="text-center">
                                    @if (precio != null)
                                    {
                                        <span class="fw-bold text-success">Q @precio.PrecioVenta.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light text-muted">Sin precio</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex">
                                        <a href="@Url.Action("Details", new { id = p.IdProducto })"
                                           class="btn btn-info action-btn"
                                           title="Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (isAuth && isAdmin)
                                        {
                                            <a href="@Url.Action("Edit", new { id = p.IdProducto })"
                                               class="btn btn-warning action-btn"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleActivo" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="btn btn-danger action-btn btn-confirm-toggle"
                                                        data-product-name="@p.Nombre"
                                                        data-action="desactivar"
                                                        title="Desactivar">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Paginación activos -->
        @if (totalPagesActivos > 1)
        {
            <div class="p-3 border-top" style="border-color:#e5e7eb!important">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                    <div class="text-muted small">
                        Página @pageActivos de @totalPagesActivos • Mostrando @activos.Count() de @totalActivos
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            @if (pageActivos > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = pageActivos - 1, pageInactivos = pageInactivos, pageSize = pageSize })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
                            }

                            @{
                                int startPage = Math.Max(1, pageActivos - 2);
                                int endPage = Math.Min(totalPagesActivos, pageActivos + 2);

                                if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = 1, pageInactivos = pageInactivos, pageSize = pageSize })">1</a>
                                    </li>
                                    ;
                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    }
                                }
                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == pageActivos ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = i, pageInactivos = pageInactivos, pageSize = pageSize })">@i</a>
                                    </li>
                                }
                                if (endPage < totalPagesActivos)
                                {
                                    if (endPage < totalPagesActivos - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = totalPagesActivos, pageInactivos = pageInactivos, pageSize = pageSize })">@totalPagesActivos</a>
                                    </li>
                                }
                            }

                            @if (pageActivos < totalPagesActivos)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = pageActivos + 1, pageInactivos = pageInactivos, pageSize = pageSize })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-right"></i></span></li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>

    <!-- Inactivos (solo admin) -->
    @if (isAuth && isAdmin && totalInactivos > 0)
    {
        <div class="inventory-card">
            <div class="card-head">
                <i class="bi bi-archive fs-5"></i>
                <h3 class="title">Productos inactivos</h3>
                <span class="stats-badge">
                    <i class="bi bi-archive"></i>@totalInactivos
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="col-hide-sm">Código</th>
                            <th class="col-hide-sm">Categoría</th>
                            <th class="col-hide-sm">Marca</th>
                            <th class="text-center">Stock</th>
                            <th class="col-hide-sm text-center">Stock mín.</th>
                            <th class="text-center">Precio</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in inactivos)
                        {
                            precioDict.TryGetValue(p.IdProducto, out var precio);
                            var stockActual = p.Inventario?.StockActual ?? 0;
                            var stockMin = p.Inventario?.StockMinimo ?? 0;
                            var isLow = (p.Inventario != null) && (stockActual <= stockMin);

                            <tr class="@(isLow ? "row-low" : "") text-muted">
                                <td>
                                    <div class="fw-semibold">@p.Nombre</div>
                                    @if (isLow)
                                    {
                                        <small class="text-danger d-inline-flex align-items-center">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Stock bajo
                                        </small>
                                    }
                                </td>
                                <td class="col-hide-sm">
                                    <span class="badge text-bg-secondary">
                                        @(string.IsNullOrWhiteSpace(p.CodigoBarras) ? "Sin código" : p.CodigoBarras)
                                    </span>
                                </td>
                                <td class="col-hide-sm">
                                    <span class="badge text-bg-info">@p.Categoria?.Nombre</span>
                                </td>
                                <td class="col-hide-sm">
                                    <span class="badge text-bg-warning text-dark">@p.Marca?.Nombre</span>
                                </td>
                                <td class="text-center">@stockActual</td>
                                <td class="col-hide-sm text-center">@stockMin</td>
                                <td class="text-center">
                                    @if (precio != null)
                                    {
                                        <span>Q @precio.PrecioVenta.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light text-muted">Sin precio</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex">
                                        <a href="@Url.Action("Details", new { id = p.IdProducto })"
                                           class="btn btn-info action-btn"
                                           title="Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="ToggleActivo" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="btn btn-success action-btn btn-confirm-toggle"
                                                    data-product-name="@p.Nombre"
                                                    data-action="activar"
                                                    title="Activar">
                                                <i class="bi bi-check2-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPagesInactivos > 1)
            {
                <div class="p-3 border-top" style="border-color:#e5e7eb!important">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div class="text-muted small">
                            Página @pageInactivos de @totalPagesInactivos • Mostrando @inactivos.Count() de @totalInactivos
                        </div>
                        <nav>
                            <ul class="pagination mb-0">
                                @if (pageInactivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = pageActivos, pageInactivos = pageInactivos - 1, pageSize = pageSize })">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
                                }

                                @{
                                    int startPageI = Math.Max(1, pageInactivos - 2);
                                    int endPageI = Math.Min(totalPagesInactivos, pageInactivos + 2);

                                    if (startPageI > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = pageActivos, pageInactivos = 1, pageSize = pageSize })">1</a>
                                        </li>
                                        ;
                                        if (startPageI > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                    }
                                    for (int i = startPageI; i <= endPageI; i++)
                                    {
                                        <li class="page-item @(i == pageInactivos ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = pageActivos, pageInactivos = i, pageSize = pageSize })">@i</a>
                                        </li>
                                    }
                                    if (endPageI < totalPagesInactivos)
                                    {
                                        if (endPageI < totalPagesInactivos - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = pageActivos, pageInactivos = totalPagesInactivos, pageSize = pageSize })">@totalPagesInactivos</a>
                                        </li>
                                    }
                                }

                                @if (pageInactivos < totalPagesInactivos)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], pageActivos = pageActivos, pageInactivos = pageInactivos + 1, pageSize = pageSize })">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-right"></i></span></li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal confirmación Toggle Activo -->
<div class="modal fade" id="confirmToggleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmToggleTitle">Confirmar acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="confirmToggleText" class="mb-0">¿Deseas continuar?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmToggle">Sí, continuar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modalEl = document.getElementById('confirmToggleModal');
            const bsModal = modalEl ? new bootstrap.Modal(modalEl) : null;
            let formToSubmit = null;

            document.querySelectorAll('.btn-confirm-toggle').forEach(btn => {
                btn.addEventListener('click', e => {
                    e.preventDefault();
                    formToSubmit = btn.closest('form');
                    const name = btn.getAttribute('data-product-name') || 'este producto';
                    const action = btn.getAttribute('data-action') || 'actualizar';

                    document.getElementById('confirmToggleTitle').textContent =
                        (action === 'desactivar' ? 'Desactivar' : 'Activar') + ' producto';

                    document.getElementById('confirmToggleText').innerHTML =
                        `¿Seguro que deseas <strong>${action}</strong> <strong>${name}</strong>?`;

                    if (bsModal) {
                        bsModal.show();
                    } else if (confirm(`¿Confirmar ${action} de ${name}?`)) {
                        formToSubmit.submit();
                    }
                });
            });

            document.getElementById('btnConfirmToggle')?.addEventListener('click', () => {
                if (formToSubmit) formToSubmit.submit();
                if (bsModal) bsModal.hide();
            });
        });
    </script>
}
