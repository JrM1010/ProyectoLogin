@model IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoCore>

@{
    ViewData["Title"] = "Productos";

    var precios = ViewBag.Precios as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoPrecio>
                  ?? Enumerable.Empty<ProyectoLogin.Models.ModelosProducts.ProductoPrecio>();

    // 🔹 Filtrar y agrupar por producto: dejar solo el precio activo más reciente
    var precioDict = precios
        .Where(x => x.Activo)
        .GroupBy(x => x.IdProducto)
        .ToDictionary(
            g => g.Key,
            g => g.OrderByDescending(p => p.FechaInicio).FirstOrDefault()
        );

    // Usar las listas paginadas del ViewBag
    var activos = ViewBag.Activos as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoCore>
                  ?? Enumerable.Empty<ProyectoLogin.Models.ModelosProducts.ProductoCore>();
    var inactivos = ViewBag.Inactivos as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoCore>
                   ?? Enumerable.Empty<ProyectoLogin.Models.ModelosProducts.ProductoCore>();

    // Variables de paginación
    var totalActivos = ViewBag.TotalActivos ?? 0;
    var totalInactivos = ViewBag.TotalInactivos ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
    var pageActivos = ViewBag.PageActivos ?? 1;
    var pageInactivos = ViewBag.PageInactivos ?? 1;
    var totalPagesActivos = ViewBag.TotalPagesActivos ?? 1;
    var totalPagesInactivos = ViewBag.TotalPagesInactivos ?? 1;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-boxes text-primary me-2"></i>Gestión de Inventario
        </h2>
        <div>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark me-2">
                <i class="bi bi-arrow-left me-1"></i>Inicio
            </a>
            <a class="btn btn-success rounded-pill" asp-action="Create">
                <i class="bi bi-plus-circle me-1"></i>Nuevo Producto
            </a>
        </div>
    </div>

    <!-- Barra de búsqueda -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label">Buscar producto:</label>
                </div>
                <div class="col-auto">
                    <input type="text" name="q" value="@(ViewData["q"] ?? "")" class="form-control"
                           style="width: 300px" placeholder="Nombre o código del producto..." />
                </div>
                <div class="col-auto">
                    <input type="hidden" name="pageActivos" value="1" />
                    <input type="hidden" name="pageInactivos" value="1" />
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- PRODUCTOS ACTIVOS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white d-flex align-items-center">
            <i class="bi bi-box-seam fs-5 me-2"></i>
            <h5 class="mb-0 me-2">Productos Activos</h5>
            <span class="badge bg-light text-success fs-6">@totalActivos</span>
        </div>
        <div class="card-body p-0">
            @if (!activos.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-box fs-1 mb-2"></i>
                    <p class="mb-0">No hay productos activos</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Código</th>
                                <th>Categoría</th>
                                <th>Marca</th>
                                <th class="text-center">Stock Actual</th>
                                <th class="text-center">Stock Mínimo</th>
                                <th class="text-center">Precio Venta</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in activos)
                            {
                                precioDict.TryGetValue(p.IdProducto, out var precio);
                                var stockActual = p.Inventario?.StockActual ?? 0;
                                var stockMin = p.Inventario?.StockMinimo ?? 0;
                                var isLow = (p.Inventario != null) && (stockActual <= stockMin);

                                <tr class="@(isLow ? "table-warning" : "")">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-box text-primary me-2"></i>
                                            <div>
                                                <div class="fw-semibold">@p.Nombre</div>
                                                @if (isLow)
                                                {
                                                    <small class="text-danger">
                                                        <i class="bi bi-exclamation-triangle"></i> Stock bajo
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(p.CodigoBarras) ? "Sin código" : p.CodigoBarras)</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@p.Categoria?.Nombre</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@p.Marca?.Nombre</span>
                                    </td>
                                    <td class="text-center fw-bold @(isLow ? "text-danger" : "text-success")">
                                        @stockActual
                                    </td>
                                    <td class="text-center text-muted">
                                        @stockMin
                                    </td>
                                    <td class="text-center">
                                        @if (precio != null)
                                        {
                                            <span class="fw-bold text-success">Q @precio.PrecioVenta.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">Sin precio</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Detalles -->
                                            <a href="@Url.Action("Details", new { id = p.IdProducto })"
                                               class="btn btn-outline-info rounded-circle btn-sm" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Editar -->
                                            <a href="@Url.Action("Edit", new { id = p.IdProducto })"
                                               class="btn btn-outline-warning rounded-circle btn-sm" title="Editar producto">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Desactivar -->
                                            <form asp-action="ToggleActivo" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger rounded-circle btn-sm"
                                                        title="Desactivar producto"
                                                        onclick="return confirm('¿Estás seguro de desactivar el producto @p.Nombre?')">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN PRODUCTOS ACTIVOS - DISEÑO DISIMULADO -->
                @if (totalPagesActivos > 1)
                {
                    <div class="p-3 border-top bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-muted small">
                                Página @pageActivos de @totalPagesActivos • 
                                Mostrando @activos.Count() de @totalActivos productos
                            </div>
                            <div class="pagination-container">
                                <ul class="pagination pagination-sm mb-0">
                                    <!-- Flecha anterior -->
                                    @if (pageActivos > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               href="@Url.Action("Index", new { 
                                                   q = ViewData["q"], 
                                                   pageActivos = pageActivos - 1, 
                                                   pageInactivos = pageInactivos, 
                                                   pageSize = pageSize 
                                               })">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                        </li>
                                    }

                                    <!-- Números de página - máximo 5 páginas visibles -->
                                    @{
                                        int startPage = Math.Max(1, pageActivos - 2);
                                        int endPage = Math.Min(totalPagesActivos, pageActivos + 2);
                                        
                                        if (startPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" 
                                                   href="@Url.Action("Index", new { 
                                                       q = ViewData["q"], 
                                                       pageActivos = 1, 
                                                       pageInactivos = pageInactivos, 
                                                       pageSize = pageSize 
                                                   })">1</a>
                                            </li>
                                            if (startPage > 2)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }

                                        for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == pageActivos ? "active" : "")">
                                                <a class="page-link"
                                                   href="@Url.Action("Index", new { 
                                                       q = ViewData["q"], 
                                                       pageActivos = i, 
                                                       pageInactivos = pageInactivos, 
                                                       pageSize = pageSize 
                                                   })">@i</a>
                                            </li>
                                        }

                                        if (endPage < totalPagesActivos)
                                        {
                                            if (endPage < totalPagesActivos - 1)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            <li class="page-item">
                                                <a class="page-link" 
                                                   href="@Url.Action("Index", new { 
                                                       q = ViewData["q"], 
                                                       pageActivos = totalPagesActivos, 
                                                       pageInactivos = pageInactivos, 
                                                       pageSize = pageSize 
                                                   })">@totalPagesActivos</a>
                                            </li>
                                        }
                                    }

                                    <!-- Flecha siguiente -->
                                    @if (pageActivos < totalPagesActivos)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               href="@Url.Action("Index", new { 
                                                   q = ViewData["q"], 
                                                   pageActivos = pageActivos + 1, 
                                                   pageInactivos = pageInactivos, 
                                                   pageSize = pageSize 
                                               })">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- PRODUCTOS INACTIVOS - SOLO SE MUESTRA SI HAY AL MENOS UNO -->
    @if (totalInactivos > 0)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white d-flex align-items-center">
                <i class="bi bi-box-x fs-5 me-2"></i>
                <h5 class="mb-0 me-2">Productos Inactivos</h5>
                <span class="badge bg-light text-secondary fs-6">@totalInactivos</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Código</th>
                                <th>Categoría</th>
                                <th>Marca</th>
                                <th class="text-center">Stock Actual</th>
                                <th class="text-center">Stock Mínimo</th>
                                <th class="text-center">Precio Venta</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in inactivos)
                            {
                                precioDict.TryGetValue(p.IdProducto, out var precio);
                                var stockActual = p.Inventario?.StockActual ?? 0;
                                var stockMin = p.Inventario?.StockMinimo ?? 0;
                                var isLow = (p.Inventario != null) && (stockActual <= stockMin);

                                <tr class="text-muted">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-box me-2"></i>
                                            <div>
                                                <div class="fw-semibold">@p.Nombre</div>
                                                @if (isLow)
                                                {
                                                    <small class="text-danger">
                                                        <i class="bi bi-exclamation-triangle"></i> Stock bajo
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-muted">@(string.IsNullOrWhiteSpace(p.CodigoBarras) ? "Sin código" : p.CodigoBarras)</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-muted">@p.Categoria?.Nombre</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-muted">@p.Marca?.Nombre</span>
                                    </td>
                                    <td class="text-center @(isLow ? "text-danger fw-bold" : "")">
                                        @stockActual
                                    </td>
                                    <td class="text-center">
                                        @stockMin
                                    </td>
                                    <td class="text-center">
                                        @if (precio != null)
                                        {
                                            <span class="text-muted">Q @precio.PrecioVenta.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">Sin precio</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Detalles -->
                                            <a href="@Url.Action("Details", new { id = p.IdProducto })"
                                               class="btn btn-outline-info rounded-circle btn-sm" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Activar -->
                                            <form asp-action="ToggleActivo" asp-route-id="@p.IdProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success rounded-circle btn-sm"
                                                        title="Activar producto"
                                                        onclick="return confirm('¿Estás seguro de activar el producto @p.Nombre?')">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN PRODUCTOS INACTIVOS - DISEÑO DISIMULADO -->
                @if (totalPagesInactivos > 1)
                {
                    <div class="p-3 border-top bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-muted small">
                                Página @pageInactivos de @totalPagesInactivos • 
                                Mostrando @inactivos.Count() de @totalInactivos productos
                            </div>
                            <div class="pagination-container">
                                <ul class="pagination pagination-sm mb-0">
                                    <!-- Flecha anterior -->
                                    @if (pageInactivos > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               href="@Url.Action("Index", new { 
                                                   q = ViewData["q"], 
                                                   pageActivos = pageActivos, 
                                                   pageInactivos = pageInactivos - 1, 
                                                   pageSize = pageSize 
                                               })">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                        </li>
                                    }

                                    <!-- Números de página - máximo 5 páginas visibles -->
                                    @{
                                        int startPageInactivos = Math.Max(1, pageInactivos - 2);
                                        int endPageInactivos = Math.Min(totalPagesInactivos, pageInactivos + 2);
                                        
                                        if (startPageInactivos > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" 
                                                   href="@Url.Action("Index", new { 
                                                       q = ViewData["q"], 
                                                       pageActivos = pageActivos, 
                                                       pageInactivos = 1, 
                                                       pageSize = pageSize 
                                                   })">1</a>
                                            </li>
                                            if (startPageInactivos > 2)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }

                                        for (int i = startPageInactivos; i <= endPageInactivos; i++)
                                        {
                                            <li class="page-item @(i == pageInactivos ? "active" : "")">
                                                <a class="page-link"
                                                   href="@Url.Action("Index", new { 
                                                       q = ViewData["q"], 
                                                       pageActivos = pageActivos, 
                                                       pageInactivos = i, 
                                                       pageSize = pageSize 
                                                   })">@i</a>
                                            </li>
                                        }

                                        if (endPageInactivos < totalPagesInactivos)
                                        {
                                            if (endPageInactivos < totalPagesInactivos - 1)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            <li class="page-item">
                                                <a class="page-link" 
                                                   href="@Url.Action("Index", new { 
                                                       q = ViewData["q"], 
                                                       pageActivos = pageActivos, 
                                                       pageInactivos = totalPagesInactivos, 
                                                       pageSize = pageSize 
                                                   })">@totalPagesInactivos</a>
                                            </li>
                                        }
                                    }

                                    <!-- Flecha siguiente -->
                                    @if (pageInactivos < totalPagesInactivos)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               href="@Url.Action("Index", new { 
                                                   q = ViewData["q"], 
                                                   pageActivos = pageActivos, 
                                                   pageInactivos = pageInactivos + 1, 
                                                   pageSize = pageSize 
                                               })">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.querySelector('input[name="q"]');
            if (input) input.focus();
        });
    </script>
}

<style>
    .table td {
        vertical-align: middle;
    }

    .btn-sm {
        padding: 0.375rem 0.5rem;
    }

    .card-header {
        border-bottom: none;
    }

    .badge {
        font-size: 0.75em;
    }

    /* Estilos para la paginación disimulada */
    .pagination-container {
        background: transparent;
    }

    .pagination-sm .page-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        border: 1px solid #dee2e6;
        color: #6c757d;
        background: white;
    }

    .pagination-sm .page-item.active .page-link {
        background-color: #6c757d;
        border-color: #6c757d;
        color: white;
    }

    .pagination-sm .page-link:hover {
        background-color: #e9ecef;
        border-color: #dee2e6;
        color: #495057;
    }

    .pagination-sm .page-item.disabled .page-link {
        color: #adb5bd;
        background-color: white;
        border-color: #dee2e6;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }
</style>