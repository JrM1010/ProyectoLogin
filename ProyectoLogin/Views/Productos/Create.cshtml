@model ProyectoLogin.Models.ModelosProducts.ProductoCore
@using System.Security.Claims

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Crear Producto";

    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
    bool isEmpleado = user?.IsInRole("Vendedor") ?? false;
}
@if (isAuth && isAdmin){
<div class="container-fluid px-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-black-50 mb-1">Crear Producto</h2>
            <p class="text-muted mb-0">Complete la información para registrar un nuevo producto en el sistema</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill d-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i>Volver al Listado
        </a>
    </div>

    <!-- Alertas Globales -->
    @if (TempData["SuccessCategoria"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div>@TempData["SuccessCategoria"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorCategoria"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>@TempData["ErrorCategoria"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Formulario Principal -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-success text-white py-3">
            <h5 class="card-title mb-0 d-flex align-items-center">
                <i class="bi bi-box-seam me-2"></i>Información del Producto
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="productForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <!-- Columna Izquierda -->
                    <div class="col-lg-6">
                        <!-- Nombre del Producto -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Nombre del Producto <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ingrese el nombre del producto" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <!-- Categoría -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold">Categoría <span class="text-danger">*</span></label>
                                <button type="button" class="btn btn-link text-decoration-none p-0" data-bs-toggle="modal" data-bs-target="#modalCategoria">
                                    <i class="bi bi-plus-circle me-1"></i>Gestionar Categorías
                                </button>
                            </div>
                            <div class="input-group input-group-lg">
                                <select asp-for="IdCategoria" asp-items="ViewBag.CategoriasSelect" class="form-select" id="IdCategoria">
                                    <option value="">-- Seleccione una categoría --</option>
                                </select>
                            </div>
                            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                        </div>

                        <!-- Marca -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold">Marca <span class="text-danger">*</span></label>
                                <button type="button" class="btn btn-link text-decoration-none p-0" data-bs-toggle="modal" data-bs-target="#modalMarca">
                                    <i class="bi bi-plus-circle me-1"></i>Gestionar Marcas
                                </button>
                            </div>
                            <div class="input-group input-group-lg">
                                <select asp-for="IdMarca" asp-items="ViewBag.MarcasSelect" class="form-select" id="IdMarca">
                                    <option value="">-- Seleccione una marca --</option>
                                </select>
                            </div>
                            <span asp-validation-for="IdMarca" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Columna Derecha -->
                    <div class="col-lg-6">
                        <!-- Proveedor -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Proveedor Principal <span class="text-danger">*</span></label>
                            <select name="idProveedor" class="form-select form-select-lg" id="idProveedor">
                                <option value="">-- Seleccione un proveedor --</option>
                                @foreach (var p in ViewBag.Proveedores)
                                {
                                    <option value="@p.IdProveedor">@p.Nombre</option>
                                }
                            </select>
                            <span class="text-danger small" id="proveedorValidation"></span>
                        </div>

                        <!-- Stock Mínimo -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Stock Mínimo</label>
                            <input name="stockMinimo" type="number" class="form-control form-control-lg" value="1" min="0" />
                            <div class="form-text">El sistema generará alertas cuando el stock alcance este nivel</div>
                        </div>

                        <!-- Código del Producto -->
                        @if (ViewBag.CodigoGenerado != null)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Código del Producto</label>
                                <div class="input-group input-group-lg">
                                    <input type="text" class="form-control" value="@ViewBag.CodigoGenerado" readonly />
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-upc-scan text-muted"></i>
                                    </span>
                                </div>
                                <div class="form-text">Código generado automáticamente</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Descripción -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Especificaciones del Producto <span class="text-danger">*</span></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Ingrese las especificaciones detalladas del producto..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <input type="hidden" asp-for="Activo" value="true" />

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="btnSubmit">
                        <i class="bi bi-check-lg me-2"></i>Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Categorías -->
<div class="modal fade" id="modalCategoria" tabindex="-1" aria-labelledby="modalCategoriaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalCategoriaLabel">
                    <i class="bi bi-tags me-2"></i>Gestión de Categorías
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Alertas Dinámicas Categorías -->
                <div id="alertContainerCategoria"></div>

                <!-- Formulario para Crear/Editar Categoría -->
                <form id="formCategoria">
                    <input type="hidden" id="idCategoria" name="id" value="">
                    <div class="mb-3">
                        <label for="nombreCategoria" class="form-label fw-semibold">Nombre de la Categoría <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nombreCategoria" name="nombre" required placeholder="Ingrese el nombre de la categoría">
                    </div>
                    <div class="mb-3">
                        <label for="descripcionCategoria" class="form-label fw-semibold">Descripción</label>
                        <textarea class="form-control" id="descripcionCategoria" name="descripcion" rows="3" placeholder="Descripción opcional de la categoría"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success" id="btnGuardarCategoria">
                            <i class="bi bi-check-lg me-1"></i>Guardar
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="btnCancelarEdicion" style="display: none;">
                            <i class="bi bi-x-lg me-1"></i>Cancelar Edición
                        </button>
                        <button type="button" class="btn btn-outline-secondary ms-auto" data-bs-dismiss="modal">
                            <i class="bi bi-door-closed me-1"></i>Cerrar
                        </button>
                    </div>
                </form>

                <hr class="my-4">

                <!-- Lista de Categorías Existentes -->
                <h6 class="fw-semibold mb-3">Categorías Existentes</h6>
                <div class="table-responsive" style="max-height: 300px;">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyCategorias">
                            @foreach (var categoria in ViewBag.CategoriasLista)
                            {
                                <tr data-id="@categoria.IdCategoria">
                                    <td class="fw-semibold">@categoria.Nombre</td>
                                    <td class="text-muted">@(categoria.Descripcion ?? "Sin descripción")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-primary"
                                                    onclick="editarCategoria(@categoria.IdCategoria, '@categoria.Nombre', '@categoria.Descripcion')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger"
                                                    onclick="eliminarCategoria(@categoria.IdCategoria, '@categoria.Nombre')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Marcas -->
<div class="modal fade" id="modalMarca" tabindex="-1" aria-labelledby="modalMarcaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalMarcaLabel">
                    <i class="bi bi-bookmark-star me-2"></i>Gestión de Marcas
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Alertas Dinámicas Marcas -->
                <div id="alertContainerMarca"></div>

                <!-- Formulario para Crear/Editar Marca -->
                <form id="formMarca">
                    <input type="hidden" id="idMarca" name="id" value="">
                    <div class="mb-3">
                        <label for="nombreMarca" class="form-label fw-semibold">Nombre de la Marca <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nombreMarca" name="nombre" required placeholder="Ingrese el nombre de la marca">
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success" id="btnGuardarMarca">
                            <i class="bi bi-check-lg me-1"></i>Guardar
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="btnCancelarEdicionMarca" style="display: none;">
                            <i class="bi bi-x-lg me-1"></i>Cancelar Edición
                        </button>
                        <button type="button" class="btn btn-outline-secondary ms-auto" data-bs-dismiss="modal">
                            <i class="bi bi-door-closed me-1"></i>Cerrar
                        </button>
                    </div>
                </form>

                <hr class="my-4">

                <!-- Lista de Marcas Existentes -->
                <h6 class="fw-semibold mb-3">Marcas Existentes</h6>
                <div class="table-responsive" style="max-height: 300px;">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyMarcas">
                            @foreach (var marca in ViewBag.MarcasLista)
                            {
                                <tr data-id="@marca.IdMarca">
                                    <td class="fw-semibold">@marca.Nombre</td>
                                    <td>
                                        <span class="badge bg-@(marca.Activo ? "success" : "secondary")">
                                            @(marca.Activo ? "Activa" : "Inactiva")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-primary"
                                                    onclick="editarMarca(@marca.IdMarca, '@marca.Nombre')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger"
                                                    onclick="eliminarMarca(@marca.IdMarca, '@marca.Nombre')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
}
<style>
    .is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }

    .field-validation-error {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .text-danger {
        font-weight: 500;
    }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Auto ocultar alertas
        setTimeout(() => {
            document.querySelectorAll('.alert').forEach(a => {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(a);
                bsAlert.close();
            });
        }, 5000);

        // --- VALIDACIONES DEL FORMULARIO PRINCIPAL ---
        document.getElementById('productForm').addEventListener('submit', function(e) {
            let isValid = true;
            const submitBtn = document.getElementById('btnSubmit');

            // Deshabilitar botón para evitar múltiples envíos
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Validando...';

            // Validar nombre
            const nombre = document.getElementById('Nombre').value.trim();
            if (!nombre) {
                mostrarError('Nombre', 'El nombre del producto es obligatorio.');
                isValid = false;
            }

            // Validar categoría
            const categoria = document.getElementById('IdCategoria').value;
            if (!categoria) {
                mostrarError('IdCategoria', 'Debe seleccionar una categoría.');
                isValid = false;
            }

            // Validar marca
            const marca = document.getElementById('IdMarca').value;
            if (!marca) {
                mostrarError('IdMarca', 'Debe seleccionar una marca.');
                isValid = false;
            }

            // Validar proveedor
            const proveedor = document.getElementById('idProveedor').value;
            if (!proveedor) {
                document.getElementById('proveedorValidation').textContent = 'Debe seleccionar un proveedor.';
                isValid = false;
            } else {
                document.getElementById('proveedorValidation').textContent = '';
            }

            // Validar descripción
            const descripcion = document.getElementById('Descripcion').value.trim();
            if (!descripcion) {
                mostrarError('Descripcion', 'Las especificaciones del producto son obligatorias.');
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault();
                // Restaurar botón
                setTimeout(() => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Guardar Producto';
                }, 1000);

                // Scroll al primer error
                const firstError = document.querySelector('.text-danger');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

        function mostrarError(campoId, mensaje) {
            const campo = document.getElementById(campoId);
            const errorSpan = campo.nextElementSibling || campo.parentElement.nextElementSibling;

            if (errorSpan && errorSpan.classList.contains('text-danger')) {
                errorSpan.textContent = mensaje;
            }

            // Resaltar campo con error
            campo.classList.add('is-invalid');
        }

        // Remover estilos de error cuando el usuario empiece a escribir/seleccionar
        document.querySelectorAll('#Nombre, #Descripcion, #IdCategoria, #IdMarca, #idProveedor').forEach(campo => {
            campo.addEventListener('input', function() {
                this.classList.remove('is-invalid');
                const errorSpan = this.nextElementSibling || this.parentElement.nextElementSibling;
                if (errorSpan && errorSpan.classList.contains('text-danger')) {
                    errorSpan.textContent = '';
                }
                if (this.id === 'idProveedor') {
                    document.getElementById('proveedorValidation').textContent = '';
                }
            });
        });

        // --- FUNCIONALIDAD DINÁMICA DE CATEGORÍAS ---
        document.getElementById('formCategoria').addEventListener('submit', function(e) {
            e.preventDefault();
            guardarCategoria();
        });

        function guardarCategoria() {
            const formData = new FormData(document.getElementById('formCategoria'));
            const idCategoria = document.getElementById('idCategoria').value;
            const url = idCategoria ? '/Productos/EditarCategoria' : '/Productos/CrearCategoria';
            const btn = document.getElementById('btnGuardarCategoria');

            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Guardando...';

            fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    mostrarAlertaCategoria(data.message, 'success');
                    resetFormCategoria();
                    cargarCategorias();
                    actualizarSelectCategorias(data.categorias);
                } else {
                    mostrarAlertaCategoria(data.message, 'danger');
                }
            })
            .catch(error => {
                mostrarAlertaCategoria('Error al guardar la categoría', 'danger');
                console.error('Error:', error);
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = idCategoria ?
                    '<i class="bi bi-arrow-clockwise me-1"></i>Actualizar' :
                    '<i class="bi bi-check-lg me-1"></i>Guardar';
            });
        }

        function cargarCategorias() {
            fetch('/Productos/ObtenerCategorias')
            .then(response => response.json())
            .then(categorias => {
                const tbody = document.getElementById('tbodyCategorias');
                tbody.innerHTML = '';

                categorias.forEach(categoria => {
                    const tr = document.createElement('tr');
                    tr.setAttribute('data-id', categoria.idCategoria);
                    tr.innerHTML = `
                        <td class="fw-semibold">${categoria.nombre}</td>
                        <td class="text-muted">${categoria.descripcion || 'Sin descripción'}</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary"
                                        onclick="editarCategoria(${categoria.idCategoria}, '${categoria.nombre}', '${categoria.descripcion || ''}')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger"
                                        onclick="eliminarCategoria(${categoria.idCategoria}, '${categoria.nombre}')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            })
            .catch(error => console.error('Error:', error));
        }

        function actualizarSelectCategorias(categorias) {
            const select = document.getElementById('IdCategoria');
            select.innerHTML = '<option value="">-- Seleccione una categoría --</option>';

            categorias.forEach(categoria => {
                const option = document.createElement('option');
                option.value = categoria.idCategoria;
                option.textContent = categoria.nombre;
                select.appendChild(option);
            });
        }

        function editarCategoria(id, nombre, descripcion) {
            document.getElementById('idCategoria').value = id;
            document.getElementById('nombreCategoria').value = nombre;
            document.getElementById('descripcionCategoria').value = descripcion || '';

            const btn = document.getElementById('btnGuardarCategoria');
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Actualizar';
            btn.classList.replace('btn-success', 'btn-warning');
            document.getElementById('btnCancelarEdicion').style.display = 'block';
        }

        function eliminarCategoria(id, nombre) {
            if (confirm(`¿Está seguro de que desea eliminar la categoría "${nombre}"?`)) {
                const formData = new FormData();
                formData.append('id', id);

                fetch('/Productos/EliminarCategoria', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        mostrarAlertaCategoria(data.message, 'success');
                        cargarCategorias();
                        actualizarSelectCategorias(data.categorias);
                    } else {
                        mostrarAlertaCategoria(data.message, 'danger');
                    }
                })
                .catch(error => {
                    mostrarAlertaCategoria('Error al eliminar la categoría', 'danger');
                    console.error('Error:', error);
                });
            }
        }

        function resetFormCategoria() {
            document.getElementById('formCategoria').reset();
            document.getElementById('idCategoria').value = '';
            const btn = document.getElementById('btnGuardarCategoria');
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar';
            btn.classList.replace('btn-warning', 'btn-success');
            document.getElementById('btnCancelarEdicion').style.display = 'none';
        }

        function mostrarAlertaCategoria(mensaje, tipo) {
            const alertContainer = document.getElementById('alertContainerCategoria');
            const alert = document.createElement('div');
            alert.className = `alert alert-${tipo} alert-dismissible fade show`;
            alert.innerHTML = `
                <i class="bi bi-${tipo === 'success' ? 'check-circle' : 'exclamation-triangle'}-fill me-2"></i>
                ${mensaje}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            alertContainer.appendChild(alert);

            setTimeout(() => {
                if (alert.parentNode) {
                    alert.remove();
                }
            }, 5000);
        }

        // --- FUNCIONALIDAD DINÁMICA DE MARCAS ---
        document.getElementById('formMarca').addEventListener('submit', function(e) {
            e.preventDefault();
            guardarMarca();
        });

        function guardarMarca() {
            const formData = new FormData(document.getElementById('formMarca'));
            const idMarca = document.getElementById('idMarca').value;
            const url = idMarca ? '/Productos/EditarMarca' : '/Productos/CrearMarca';
            const btn = document.getElementById('btnGuardarMarca');

            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Guardando...';

            fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    mostrarAlertaMarca(data.message, 'success');
                    resetFormMarca();
                    cargarMarcas();
                    actualizarSelectMarcas(data.marcas);
                } else {
                    mostrarAlertaMarca(data.message, 'danger');
                }
            })
            .catch(error => {
                mostrarAlertaMarca('Error al guardar la marca', 'danger');
                console.error('Error:', error);
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = idMarca ?
                    '<i class="bi bi-arrow-clockwise me-1"></i>Actualizar' :
                    '<i class="bi bi-check-lg me-1"></i>Guardar';
            });
        }

        function cargarMarcas() {
            fetch('/Productos/ObtenerMarcas')
            .then(response => response.json())
            .then(marcas => {
                const tbody = document.getElementById('tbodyMarcas');
                tbody.innerHTML = '';

                marcas.forEach(marca => {
                    const tr = document.createElement('tr');
                    tr.setAttribute('data-id', marca.idMarca);
                    tr.innerHTML = `
                        <td class="fw-semibold">${marca.nombre}</td>
                        <td>
                            <span class="badge bg-${marca.activo ? 'success' : 'secondary'}">
                                ${marca.activo ? 'Activa' : 'Inactiva'}
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary"
                                        onclick="editarMarca(${marca.idMarca}, '${marca.nombre}')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger"
                                        onclick="eliminarMarca(${marca.idMarca}, '${marca.nombre}')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            })
            .catch(error => console.error('Error:', error));
        }

        function actualizarSelectMarcas(marcas) {
            const select = document.getElementById('IdMarca');
            select.innerHTML = '<option value="">-- Seleccione una marca --</option>';

            marcas.forEach(marca => {
                const option = document.createElement('option');
                option.value = marca.idMarca;
                option.textContent = marca.nombre;
                select.appendChild(option);
            });
        }

        function editarMarca(id, nombre) {
            document.getElementById('idMarca').value = id;
            document.getElementById('nombreMarca').value = nombre;

            const btn = document.getElementById('btnGuardarMarca');
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Actualizar';
            btn.classList.replace('btn-success', 'btn-warning');
            document.getElementById('btnCancelarEdicionMarca').style.display = 'block';
        }

        function eliminarMarca(id, nombre) {
            if (confirm(`¿Está seguro de que desea eliminar la marca "${nombre}"?`)) {
                const formData = new FormData();
                formData.append('id', id);

                fetch('/Productos/EliminarMarca', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        mostrarAlertaMarca(data.message, 'success');
                        cargarMarcas();
                        actualizarSelectMarcas(data.marcas);
                    } else {
                        mostrarAlertaMarca(data.message, 'danger');
                    }
                })
                .catch(error => {
                    mostrarAlertaMarca('Error al eliminar la marca', 'danger');
                    console.error('Error:', error);
                });
            }
        }

        function resetFormMarca() {
            document.getElementById('formMarca').reset();
            document.getElementById('idMarca').value = '';
            const btn = document.getElementById('btnGuardarMarca');
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar';
            btn.classList.replace('btn-warning', 'btn-success');
            document.getElementById('btnCancelarEdicionMarca').style.display = 'none';
        }

        function mostrarAlertaMarca(mensaje, tipo) {
            const alertContainer = document.getElementById('alertContainerMarca');
            const alert = document.createElement('div');
            alert.className = `alert alert-${tipo} alert-dismissible fade show`;
            alert.innerHTML = `
                <i class="bi bi-${tipo === 'success' ? 'check-circle' : 'exclamation-triangle'}-fill me-2"></i>
                ${mensaje}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            alertContainer.appendChild(alert);

            setTimeout(() => {
                if (alert.parentNode) {
                    alert.remove();
                }
            }, 5000);
        }

        // Botones de cancelar edición
        document.getElementById('btnCancelarEdicion').addEventListener('click', resetFormCategoria);
        document.getElementById('btnCancelarEdicionMarca').addEventListener('click', resetFormMarca);
    </script>
}