@model ProyectoLogin.Models.ModelosProducts.ProductoCore
@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Detalles del Producto";
    var precios = ViewBag.Precios as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoPrecio>;
    var user = HttpContextAccessor.HttpContext?.User;
    bool isAuth = user?.Identity?.IsAuthenticated ?? false;
    bool isAdmin = user?.IsInRole("Administrador") ?? false;
}

@section Styles {
    <style>
        :root {
            --inventory-primary: #1C1973;
            --inventory-secondary: #514BF2;
            --inventory-accent: #8B88F2;
            --inventory-bg: #f5f6fa;
            --inventory-card: #ffffff;
            --inventory-text: #212529;
            --inventory-radius: 0.75rem;
        }

        /* Fondo del módulo (igual que Create / Edit) */
        .inventory-theme {
            background: var(--inventory-bg);
            padding: 1.5rem 0 2rem;
        }

        /* Card principal (mismo estilo que create-card) */
        .create-card {
            background: var(--inventory-card);
            border: 1px solid #e5e7eb;
            border-radius: var(--inventory-radius);
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.08);
            overflow: hidden;
            margin-bottom: 1.5rem;
            transition: all 0.25s ease;
        }

            .create-card:hover {
                box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
                transform: translateY(-1px);
            }

        /* Encabezado detalles con el mismo gradiente */
        .create-card-header {
            background: linear-gradient(90deg, var(--inventory-primary), var(--inventory-secondary));
            color: #ffffff;
            padding: 1.25rem 1.75rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.18);
        }

        .details-head {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

            .details-head h2 {
                font-size: 1.25rem;
                margin-bottom: 0.1rem;
            }

            .details-head small {
                font-size: 0.85rem;
                opacity: 0.9;
            }

        .create-card-body {
            padding: 1.5rem 1.75rem 1.75rem;
        }

        /* Secciones internas: alineadas a Create/Edit */
        .section-container {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: var(--inventory-radius);
            padding: 1.25rem 1.25rem 1.15rem;
            margin-bottom: 1.25rem;
            transition: all 0.25s ease;
        }

            .section-container:hover {
                box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
                border-color: var(--inventory-accent);
            }

        .section-title {
            color: #111827;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 0.85rem;
            padding-bottom: 0.6rem;
            border-bottom: 2px solid rgba(81, 75, 242, 0.18);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .section-title i {
                background: var(--inventory-secondary);
                color: white;
                width: 1.9rem;
                height: 1.9rem;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.95rem;
            }

        /* Info texto */
        .info-label {
            color: #6b7280;
            font-size: 0.8rem;
            margin-bottom: 0.2rem;
        }

        .info-value {
            font-weight: 600;
            color: #111827;
        }

        .description-box {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 0.85rem 1rem;
            font-size: 0.9rem;
            color: #111827;
        }

        /* Estados y badges */
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            border-radius: 2rem;
            padding: 0.25rem 0.65rem;
            font-weight: 600;
            font-size: 0.78rem;
        }

        .st-ok {
            background: #ecfdf5;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .st-bad {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .badge-code {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.6rem;
            border-radius: 999px;
            background: #e5e7eb;
            color: #111827;
            font-size: 0.78rem;
            font-weight: 500;
        }

        /* Tabla historial precios */
        .table-responsive {
            border-radius: var(--inventory-radius);
            border: 1px solid #e5e7eb;
            background: #ffffff;
        }

        .table thead th {
            background: #f3f4ff;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #111827;
        }

        .table tbody td {
            font-size: 0.82rem;
            color: #111827;
            border-color: #e5e7eb;
        }

        .price-sell {
            color: #16a34a;
            font-weight: 700;
        }

        .price-date {
            color: #6b7280;
            font-size: 0.8rem;
        }

        .table tbody tr:hover {
            background: #eef2ff;
        }

        /* Botones finales con estilo del módulo */
        .details-actions-bar {
            border-top: 1px solid #e5e7eb !important;
            padding-top: 1rem;
            margin-top: 0.5rem;
        }

        .btn-create-outline {
            border: 1px solid var(--inventory-accent);
            background: transparent;
            color: var(--inventory-secondary);
            border-radius: var(--inventory-radius);
            font-weight: 500;
            padding: 0.6rem 1.4rem;
            font-size: 0.88rem;
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

            .btn-create-outline:hover {
                background: var(--inventory-accent);
                color: #ffffff;
                box-shadow: 0 4px 10px rgba(15, 23, 42, 0.16);
                transform: translateY(-1px);
            }

        .btn-create-primary {
            background: var(--inventory-secondary);
            border: none;
            border-radius: var(--inventory-radius);
            color: #ffffff;
            font-weight: 600;
            padding: 0.6rem 1.4rem;
            font-size: 0.9rem;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            text-decoration: none;
        }

            .btn-create-primary:hover {
                background: var(--inventory-primary);
                box-shadow: 0 4px 12px rgba(15, 23, 42, 0.18);
                transform: translateY(-1px);
                color: #ffffff;
            }

        @@media (max-width: 768px) {
            .create-card-body {
                padding: 1.1rem 1.1rem 1.3rem;
            }

            .section-container {
                padding: 0.9rem 0.85rem;
            }

            .section-title {
                font-size: 0.95rem;
                padding-bottom: 0.4rem;
            }

            .details-actions-bar .d-flex {
                flex-direction: column;
                align-items: stretch !important;
                gap: 0.6rem;
            }

            .btn-create-outline,
            .btn-create-primary {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

<div class="container inventory-theme">
    <div class="details-card create-card">
        <div class="details-head create-card-header">
            <i class="bi bi-eye fs-3 me-2"></i>
            <div>
                <h2 class="mb-0">Detalles del producto</h2>
                <small>Información general y precios históricos</small>
            </div>
        </div>

        <div class="p-3 create-card-body">
            <div class="row g-3">
                <div class="col-lg-6">
                    <!-- Información básica -->
                    <div class="section section-container">
                        <h3 class="title section-title">
                            <i class="bi bi-card-text"></i>
                            <span>Información básica</span>
                        </h3>

                        <div class="mb-3">
                            <div class="info-label">Nombre</div>
                            <div class="info-value fs-5">@Model.Nombre</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="info-label">Código</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrEmpty(Model.CodigoBarras))
                                    {
                                        <span class="badge-code">@Model.CodigoBarras</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No asignado</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-label">Estado</div>
                                <div class="info-value">
                                    @if (Model.Activo)
                                    {
                                        <span class="status-pill st-ok">
                                            <i class="bi bi-check-circle-fill"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill st-bad">
                                            <i class="bi bi-x-circle-fill"></i> Inactivo
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-label">Categoría</div>
                                <div class="info-value">
                                    @(Model.Categoria?.Nombre ?? "Sin categoría")
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-label">Marca</div>
                                <div class="info-value">
                                    @(Model.Marca?.Nombre ?? "Sin marca")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="section section-container">
                        <h3 class="title section-title">
                            <i class="bi bi-file-text"></i>
                            <span>Descripción</span>
                        </h3>
                        <div class="description-box">
                            @if (!string.IsNullOrEmpty(Model.Descripcion))
                            {
                                @Model.Descripcion
                            }
                            else
                            {
                                <span class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>Sin descripción.
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Historial de precios -->
                <div class="col-lg-6">
                    <div class="section section-container h-100">
                        <h3 class="title section-title">
                            <i class="bi bi-graph-up"></i>
                            <span>Historial de precios</span>
                        </h3>

                        @if (precios != null && precios.Any())
                        {
                            <div class="table-responsive" style="max-height: 420px;">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Precio venta</th>
                                            <th>Inicio</th>
                                            <th>Fin</th>
                                            <th class="text-center">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in precios)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="price-sell">Q @p.PrecioVenta.ToString("N2")</span>
                                                </td>
                                                <td>
                                                    <span class="price-date">@p.FechaInicio:dd/MM/yyyy</span>
                                                </td>
                                                <td>
                                                    @if (p.FechaFin.HasValue)
                                                    {
                                                        <span class="price-date">@p.FechaFin.Value:dd/MM/yyyy</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="price-date">Vigente</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (p.Activo)
                                                    {
                                                        <span class="status-pill st-ok">
                                                            <i class="bi bi-check-circle-fill"></i> Activo
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-pill st-bad">
                                                            <i class="bi bi-clock-history"></i> Histórico
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-tags fs-2 d-block mb-2"></i>
                                No hay precios registrados.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Acciones -->
            <div class="d-flex justify-content-between align-items-center pt-3 mt-2 details-actions-bar">
                <a asp-action="Index" class="btn-create-outline">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
                <div>
                    @if (isAuth && isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.IdProducto" class="btn-create-primary">
                            <i class="bi bi-pencil-square me-1"></i> Editar
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
