@model ProyectoLogin.Models.ModelosProducts.ProductoCore
@{
    ViewData["Title"] = "Detalles del Producto";
    var inventario = ViewBag.Inventario as ProyectoLogin.Models.ModelosProducts.Inventario;
    var precios = ViewBag.Precios as IEnumerable<ProyectoLogin.Models.ModelosProducts.ProductoPrecio>;
    var movimientos = ViewBag.Movimientos as IEnumerable<ProyectoLogin.Models.ModelosProducts.MovInventario>;
}

<h2 class="mb-4">Detalles: @Model.Nombre</h2>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Información del Producto</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Código de Producto</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.CodigoBarras) ? "-" : Model.CodigoBarras)</dd>

                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8">@(Model.Categoria?.Nombre ?? "-")</dd>

                    <dt class="col-sm-4">Marca</dt>
                    <dd class="col-sm-8">@(Model.Marca?.Nombre ?? "-")</dd>

                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </dd>
                </dl>

                <div class="d-flex gap-2 mt-4">
                    <!-- Editar -->
                    <a asp-action="Edit" asp-route-id="@Model.IdProducto"
                       class="btn btn-outline-warning rounded-pill" title="Editar producto">
                        <i class="bi bi-pencil-square me-1"></i>Editar
                    </a>

                    <!-- Volver -->
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Volver al listado">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PRECIOS HISTÓRICOS -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-warning text-dark">
        <h5 class="card-title mb-0">
            <i class="bi bi-tags me-2"></i>Precios Históricos
        </h5>
    </div>
    <div class="card-body">
        @if (precios != null && precios.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Precio Compra</th>
                            <th>Precio Venta</th>
                            <th>Fecha Inicio</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in precios)
                        {
                            <tr>
                                <td>Q @p.PrecioCompra.ToString("N2")</td>
                                <td><strong>Q @p.PrecioVenta.ToString("N2")</strong></td>
                                <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (p.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center py-3">
                <i class="bi bi-tags me-2"></i>No hay precios registrados.
            </p>
        }
    </div>
</div>

