@model ProyectoLogin.Models.Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <!-- CARD PRINCIPAL -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-building-gear fs-4 me-2"></i>
                        <h4 class="mb-0">Editar Proveedor</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdProveedor" />

                        <!-- INFORMACIÓN BÁSICA -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-info-circle me-2"></i>Información Básica
                                </h6>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Nombre" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-building me-1"></i>Nombre del Proveedor *
                                </label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre del proveedor" required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- INFORMACIÓN DE CONTACTO -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-telephone me-2"></i>Información de Contacto
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Contacto" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-person me-1"></i>Persona de Contacto
                                </label>
                                <input asp-for="Contacto" class="form-control" placeholder="Nombre del contacto principal" />
                                <span asp-validation-for="Contacto" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-phone me-1"></i>Teléfono
                                </label>
                                <input asp-for="Telefono" class="form-control" placeholder="Número de teléfono" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- INFORMACIÓN ADICIONAL -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-geo-alt me-2"></i>Información Adicional
                                </h6>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-envelope me-1"></i>Correo Electrónico
                                </label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="correo@proveedor.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Direccion" class="form-label fw-semibold text-primary">
                                    <i class="bi bi-geo me-1"></i>Dirección
                                </label>
                                <input asp-for="Direccion" class="form-control" placeholder="Dirección completa" />
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Volver al listado de proveedores">
                                <i class="bi bi-arrow-left me-1"></i>Cancelar
                            </a>

                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@Model.IdProveedor"
                                   class="btn btn-outline-info rounded-pill" title="Ver detalles del proveedor">
                                    <i class="bi bi-eye me-1"></i>Ver Detalles
                                </a>

                                <button type="submit" class="btn btn-primary rounded-pill" title="Guardar cambios del proveedor">
                                    <i class="bi bi-check2-circle me-1"></i>Guardar Cambios
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TARJETA INFORMATIVA -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-primary mb-3">
                        <i class="bi bi-lightbulb me-2"></i>Información Importante
                    </h6>
                    <div class="row text-muted small">
                        <div class="col-12">
                            <p class="mb-2">
                                <i class="bi bi-asterisk text-danger me-1"></i>
                                <strong>Campos obligatorios:</strong> Solo el nombre del proveedor es requerido.
                            </p>
                            <p class="mb-2">
                                <i class="bi bi-info-circle text-primary me-1"></i>
                                <strong>Contacto:</strong> Es recomendable incluir al menos un método de contacto.
                            </p>
                            <p class="mb-0">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <strong>Datos actualizados:</strong> Mantener la información actualizada facilita la comunicación.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Focus en el primer campo al cargar
            const firstInput = document.querySelector('input[type="text"]');
            if (firstInput) firstInput.focus();

            // Validación en tiempo real para campos requeridos
            const nombreInput = document.querySelector('#Nombre');
            if (nombreInput) {
                nombreInput.addEventListener('blur', function() {
                    const errorSpan = this.nextElementSibling;
                    if (!this.value.trim() && errorSpan && errorSpan.classList.contains('text-danger')) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                });
            }
        });
    </script>
}