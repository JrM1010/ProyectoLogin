@model ProyectoLogin.Models.Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
}

<style>
    :root {
        /* Paleta AZUL (igual a Productos) */
        --sup-primary: #1C1973; /* primario */
        --sup-secondary: #514BF2; /* secundario */
        --sup-accent: #8B88F2; /* acento */
        --sup-bg: #f5f6fa; /* fondo */
        --sup-card: #FFFFFF;
        --sup-text: #212529;
        --sup-radius: 0.75rem;
        --sup-border: #e5e7eb; /* borde suave */
        --sup-muted: #6b7280;
        --sup-success: #22C55E;
        --sup-danger: #E54848;
    }

    /* Contenedor general (igual a productos/create) */
    .supplier-theme {
        background: var(--sup-bg);
        padding: 1.5rem 0 2rem;
    }

    /* Card principal */
    .create-card {
        background: var(--sup-card);
        border: 1px solid var(--sup-border);
        border-radius: var(--sup-radius);
        box-shadow: 0 6px 20px rgba(15,23,42,.08);
        overflow: hidden;
        margin-bottom: 1.5rem;
        transition: all .25s ease;
    }

        .create-card:hover {
            box-shadow: 0 10px 28px rgba(15,23,42,.12);
            transform: translateY(-1px);
        }

    .create-card-header {
        background: linear-gradient(90deg,var(--sup-primary),var(--sup-secondary));
        color: #fff;
        padding: 1.25rem 1.75rem;
        border-bottom: 1px solid rgba(255,255,255,.18);
    }

    .create-card-body {
        padding: 1.5rem 1.75rem 1.75rem;
    }

    /* Secciones */
    .section-container {
        background: #fff;
        border: 1px solid var(--sup-border);
        border-radius: var(--sup-radius);
        padding: 1.25rem 1.25rem 1.15rem;
        margin-bottom: 1.25rem;
        transition: all .25s ease;
    }

        .section-container:hover {
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            border-color: var(--sup-accent);
        }

    .section-title {
        color: #111827;
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: .85rem;
        padding-bottom: .6rem;
        border-bottom: 2px solid rgba(139,136,242,.22); /* antes coral, ahora acento azul */
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .section-title i {
            background: var(--sup-secondary);
            color: #fff;
            width: 1.9rem;
            height: 1.9rem;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
        }

    /* Controles y labels */
    .form-label {
        color: #374151;
        font-weight: 600;
        margin-bottom: .35rem;
        display: block;
    }

    .form-control-create {
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: var(--sup-radius);
        color: #111827;
        padding: .6rem .85rem;
        transition: all .25s ease;
        width: 100%;
        font-size: .94rem;
    }

        .form-control-create::placeholder {
            color: #9ca3af;
        }

        .form-control-create:focus {
            background: #fff;
            border-color: var(--sup-secondary);
            box-shadow: 0 0 0 .16rem rgba(81,75,242,.18); /* antes rojo */
            color: #111827;
            outline: none;
        }

        .form-control-create.is-invalid {
            border-color: var(--sup-danger);
        }

        .form-control-create.is-valid {
            border-color: var(--sup-success);
        }

    .required-field::after {
        content: " *";
        color: var(--sup-danger);
    }

    .validation-message, .text-danger.small {
        color: var(--sup-danger);
        font-size: .8rem;
        margin-top: .15rem;
        display: block;
    }

    /* Botones */
    .btn-create-primary {
        background: var(--sup-secondary);
        border: none;
        border-radius: var(--sup-radius);
        color: #fff;
        font-weight: 600;
        padding: .6rem 1.4rem;
        font-size: .92rem;
        transition: all .25s ease;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .btn-create-primary:hover {
            background: var(--sup-primary);
            box-shadow: 0 4px 12px rgba(15,23,42,.18);
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-create-outline {
        border: 1px solid var(--sup-accent);
        background: transparent;
        color: var(--sup-primary); /* antes #B8405A */
        border-radius: var(--sup-radius);
        font-weight: 500;
        padding: .6rem 1.4rem;
        font-size: .9rem;
        transition: all .25s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .btn-create-outline:hover {
            background: var(--sup-accent);
            color: #101232; /* azul oscuro legible */
            box-shadow: 0 4px 10px rgba(15,23,42,.16);
            transform: translateY(-1px);
        }

    .action-buttons {
        border-top: 1px solid var(--sup-border);
        padding-top: 1rem;
        margin-top: .75rem;
    }

    /* Panel informativo claro */
    .info-panel {
        background: #fff;
        border: 1px solid var(--sup-border);
        border-radius: var(--sup-radius);
        box-shadow: 0 6px 18px rgba(15,23,42,.08);
        color: #374151;
        font-size: .9rem;
    }

        .info-panel h6 {
            color: var(--sup-primary); /* antes rojo */
            font-weight: 700;
            font-size: .95rem;
        }

    @@media (max-width:768px) {
        .create-card-body {
            padding: 1.1rem 1.1rem 1.3rem;
        }

        .section-container {
            padding: .9rem .85rem;
        }

        .section-title {
            font-size: .95rem;
            padding-bottom: .4rem;
        }

        .create-card-header {
            padding: 1rem 1.25rem;
        }

        .action-buttons .d-flex {
            flex-direction: column;
            align-items: stretch;
            gap: .6rem;
        }

        .btn-create-outline, .btn-create-primary {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="container supplier-theme">
    <div class="create-card">
        <!-- Header -->
        <div class="create-card-header">
            <div class="d-flex align-items-center">
                <i class="bi bi-building-gear fs-2 me-3"></i>
                <div>
                    <h2 class="mb-1">Editar Proveedor</h2>
                    <p class="mb-0 opacity-75">
                        @(string.IsNullOrWhiteSpace(Model?.Nombre)
                                                ? "Actualiza los datos de contacto y ubicación del proveedor."
                                                : $"Editando: {Model.Nombre}")
                    </p>
                </div>
            </div>
        </div>

        <!-- Body / Form -->
        <div class="create-card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdProveedor" />

                <!-- Información del Proveedor -->
                <div class="section-container">
                    <h4 class="section-title">
                        <i class="bi bi-card-text"></i> Información del Proveedor
                    </h4>
                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label required-field">Nombre del Proveedor</label>
                            <input asp-for="Nombre" class="form-control-create" placeholder="Nombre completo del proveedor" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Información de Contacto -->
                <div class="section-container">
                    <h4 class="section-title">
                        <i class="bi bi-telephone"></i> Información de Contacto
                    </h4>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Contacto" class="form-label">Persona de Contacto</label>
                            <input asp-for="Contacto" class="form-control-create" placeholder="Nombre del contacto principal" />
                            <span asp-validation-for="Contacto" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono" class="form-control-create" placeholder="Número de teléfono" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Información Adicional -->
                <div class="section-container">
                    <h4 class="section-title">
                        <i class="bi bi-geo-alt"></i> Información Adicional
                    </h4>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Correo Electrónico</label>
                            <input asp-for="Email" type="email" class="form-control-create" placeholder="correo@proveedor.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Direccion" class="form-label">Dirección</label>
                            <input asp-for="Direccion" class="form-control-create" placeholder="Dirección completa" />
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Acciones -->
                <div class="action-buttons">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn-create-outline">
                            <i class="bi bi-arrow-left"></i> Volver al listado
                        </a>
                        <button type="submit" class="btn-create-primary">
                            <i class="bi bi-check2-circle"></i> Guardar Cambios
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Info extra -->
    <div class="card info-panel mt-4">
        <div class="card-body">
            <h6><i class="bi bi-lightbulb me-1"></i> Información Importante</h6>
            <p><i class="bi bi-asterisk text-danger me-1"></i><strong>Campos obligatorios:</strong> asegúrate de completar el nombre del proveedor.</p>
            <p><i class="bi bi-info-circle me-1"></i><strong>Contacto actualizado:</strong> mejora la comunicación y la logística.</p>
            <p class="mb-0"><i class="bi bi-shield-check text-success me-1"></i><strong>Precisión de datos:</strong> impacta en pedidos y facturación.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const nombreInput = document.querySelector('#Nombre');
            if (nombreInput) {
                nombreInput.focus();
                nombreInput.addEventListener('blur', function () {
                    const errorSpan = this.nextElementSibling;
                    if (!this.value.trim() && errorSpan && errorSpan.classList.contains('text-danger')) {
                        this.classList.add('is-invalid');
                    } else if (this.value.trim()) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                        setTimeout(() => this.classList.remove('is-valid'), 2000);
                    }
                });
            }
        });
    </script>
}
