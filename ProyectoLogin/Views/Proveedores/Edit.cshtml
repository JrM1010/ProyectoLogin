@model ProyectoLogin.Models.Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
}

<style>
    :root {
        --prov-primary: #1C1973;
        --prov-secondary: #514BF2;
        --prov-accent: #8B88F2;
        --prov-bg: #0D0E26;
        --prov-card: #11133F;
        --prov-card-soft: #15184B;
        --prov-text: #F0F0F7;
        --prov-muted: #A4A5D4;
        --prov-border: #2E2C7A;
        --prov-radius: 0.9rem;
        --prov-danger: #FF6B6B;
        --prov-success: #2ECC71;
    }

    .prov-edit-theme {
        min-height: 100vh;
        padding: 1.8rem 0 2.5rem;
        background: radial-gradient(circle at top left, rgba(81, 75, 242, 0.08), transparent), radial-gradient(circle at bottom right, rgba(28, 25, 115, 0.18), transparent), linear-gradient(135deg, var(--prov-bg) 0%, #080A2E 100%);
        color: var(--prov-text);
    }

    .prov-edit-card-main {
        background: linear-gradient(180deg, rgba(17, 19, 63, 0.98), #0E1035);
        border-radius: var(--prov-radius);
        border: 1px solid var(--prov-border);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.8);
        overflow: hidden;
    }

    .prov-edit-header {
        padding: 1rem 1.6rem;
        background: linear-gradient(135deg, var(--prov-primary), var(--prov-secondary), #080A2E);
        border-bottom: 1px solid rgba(139, 136, 242, 0.4);
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }

    .prov-edit-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(139, 136, 242, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--prov-accent);
        font-size: 1.4rem;
    }

    .prov-edit-header h4 {
        margin: 0;
        font-weight: 700;
        font-size: 1.18rem;
        color: var(--prov-text);
    }

    .prov-edit-header small {
        display: block;
        font-size: 0.7rem;
        color: var(--prov-muted);
    }

    .prov-edit-body {
        padding: 1.8rem 1.6rem 1.4rem;
    }

    .prov-section-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--prov-accent);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .prov-label {
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--prov-text);
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-bottom: 0.25rem;
    }

        .prov-label .required {
            color: var(--prov-danger);
        }

    .prov-input {
        background: #0A0C3A;
        border-radius: 0.6rem;
        border: 1px solid var(--prov-border);
        padding: 0.55rem 0.8rem;
        font-size: 0.86rem;
        color: var(--prov-text);
        width: 100%;
        transition: all 0.2s ease;
    }

        .prov-input::placeholder {
            color: rgba(164, 165, 212, 0.7);
        }

        .prov-input:focus {
            outline: none;
            border-color: var(--prov-accent);
            box-shadow: 0 0 0 0.12rem rgba(139, 136, 242, 0.3);
            background: #10125A;
        }

        .prov-input.is-invalid {
            border-color: var(--prov-danger);
        }

        .prov-input.is-valid {
            border-color: var(--prov-success);
        }

    .text-danger.small {
        font-size: 0.72rem;
    }

    .prov-actions {
        padding-top: 1rem;
        margin-top: 0.8rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
    }

    .prov-btn-back {
        border-radius: 999px;
        padding: 0.45rem 1.1rem;
        font-size: 0.8rem;
        border: 1px solid var(--prov-accent);
        color: var(--prov-accent);
        background: transparent;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .prov-btn-back:hover {
            background: rgba(139, 136, 242, 0.1);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
            color: #fff;
        }

    .prov-btn-save {
        border-radius: 999px;
        padding: 0.48rem 1.4rem;
        font-size: 0.8rem;
        border: none;
        background: linear-gradient(135deg, var(--prov-accent), var(--prov-secondary));
        color: #FFF;
        font-weight: 600;
        box-shadow: 0 10px 24px rgba(81, 75, 242, 0.35);
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .prov-btn-save:hover {
            background: linear-gradient(135deg, #5E59F7, #8B88F2);
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(0, 0, 0, 0.7);
        }

    .prov-info-card {
        margin-top: 1.6rem;
        background: linear-gradient(145deg, #0C0E39, #0D0E26);
        border-radius: var(--prov-radius);
        border: 1px solid var(--prov-border);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8);
        color: var(--prov-muted);
        font-size: 0.78rem;
    }

        .prov-info-card h6 {
            color: var(--prov-accent);
            font-weight: 600;
            font-size: 0.86rem;
            margin-bottom: 0.55rem;
        }

    @@media (max-width: 768px) {
        .prov-edit-body

    {
        padding: 1.4rem 1rem 1rem;
    }

    .prov-actions {
        flex-direction: column;
    }

        .prov-actions > * {
            width: 100%;
            text-align: center;
            justify-content: center;
        }

    }
</style>

<div class="container-fluid prov-edit-theme">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="prov-edit-card-main">
                <!-- ENCABEZADO -->
                <div class="prov-edit-header">
                    <div class="prov-edit-header-icon">
                        <i class="bi bi-building-gear"></i>
                    </div>
                    <div>
                        <h4>Editar Proveedor</h4>
                        <small>
                            @(string.IsNullOrWhiteSpace(Model?.Nombre)
                                                        ? "Actualiza los datos de contacto y ubicación del proveedor."
                                                        : $"Editando: {Model.Nombre}")
                        </small>
                    </div>
                </div>

                <!-- FORMULARIO -->
                <div class="prov-edit-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdProveedor" />

                        <!-- Información del Proveedor -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="prov-section-label">
                                    <i class="bi bi-building"></i> Información del Proveedor
                                </div>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Nombre" class="prov-label">
                                    <i class="bi bi-building"></i> Nombre del Proveedor
                                    <span class="required">*</span>
                                </label>
                                <input asp-for="Nombre"
                                       class="prov-input"
                                       placeholder="Nombre completo del proveedor"
                                       required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Contacto -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="prov-section-label">
                                    <i class="bi bi-telephone"></i> Información de Contacto
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Contacto" class="prov-label">
                                    <i class="bi bi-person"></i> Persona de Contacto
                                </label>
                                <input asp-for="Contacto"
                                       class="prov-input"
                                       placeholder="Nombre del contacto principal" />
                                <span asp-validation-for="Contacto" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="prov-label">
                                    <i class="bi bi-phone"></i> Teléfono
                                </label>
                                <input asp-for="Telefono"
                                       class="prov-input"
                                       placeholder="Número de teléfono" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email y Dirección -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="prov-section-label">
                                    <i class="bi bi-geo-alt"></i> Información Adicional
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="prov-label">
                                    <i class="bi bi-envelope"></i> Correo Electrónico
                                </label>
                                <input asp-for="Email"
                                       class="prov-input"
                                       type="email"
                                       placeholder="correo@proveedor.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Direccion" class="prov-label">
                                    <i class="bi bi-geo"></i> Dirección
                                </label>
                                <input asp-for="Direccion"
                                       class="prov-input"
                                       placeholder="Dirección completa" />
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- ACCIONES -->
                        <div class="prov-actions">
                            <a asp-action="Index" class="prov-btn-back">
                                <i class="bi bi-arrow-left"></i> Volver al listado
                            </a>
                            <button type="submit" class="prov-btn-save">
                                <i class="bi bi-check2-circle"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- INFO EXTRA -->
            <div class="card prov-info-card mt-4">
                <div class="card-body">
                    <h6><i class="bi bi-lightbulb"></i> Información Importante</h6>
                    <p>
                        <i class="bi bi-asterisk text-danger me-1"></i>
                        <strong>Campos obligatorios:</strong> asegúrate de completar el nombre del proveedor.
                    </p>
                    <p>
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Contacto actualizado:</strong> ayuda a mejorar la comunicación y la logística.
                    </p>
                    <p class="mb-0">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        <strong>Precisión de datos:</strong> impacta en pedidos, cuentas por pagar y facturación.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const nombreInput = document.querySelector('#Nombre');
            if (nombreInput) {
                nombreInput.focus();
                nombreInput.addEventListener('blur', function () {
                    const errorSpan = this.nextElementSibling;
                    if (!this.value.trim() && errorSpan && errorSpan.classList.contains('text-danger')) {
                        this.classList.add('is-invalid');
                    } else if (this.value.trim()) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                        setTimeout(() => this.classList.remove('is-valid'), 2000);
                    }
                });
            }
        });
    </script>
}
