@model ProyectoLogin.Models.Proveedor

@{
    ViewData["Title"] = "Agregar Proveedor";
}

<style>
    :root {
        /* Paleta AZUL (igual a Productos) */
        --sup-primary: #1C1973; /* primario */
        --sup-secondary: #514BF2; /* secundario */
        --sup-accent: #8B88F2; /* acento */
        --sup-bg: #f5f6fa; /* fondo */
        --sup-card: #FFFFFF;
        --sup-text: #212529;
        --sup-radius: 0.75rem;
        --sup-border: #e5e7eb; /* borde suave */
        --sup-muted: #6b7280; /* muted como productos */
        /* Colores de estado (se mantienen) */
        --sup-success: #22C55E;
        --sup-danger: #E54848;
        --sup-warning: #F1C40F;
    }

    /* Contenedor general */
    .supplier-theme {
        background: var(--sup-bg);
        padding: 1.5rem 0 2rem;
    }

    /* Tarjeta principal */
    .create-card {
        background: var(--sup-card);
        border: 1px solid var(--sup-border);
        border-radius: var(--sup-radius);
        box-shadow: 0 6px 20px rgba(15,23,42,.08);
        overflow: hidden;
        margin-bottom: 1.5rem;
        transition: all .25s ease;
    }

        .create-card:hover {
            box-shadow: 0 10px 28px rgba(15,23,42,.12);
            transform: translateY(-1px);
        }

    .create-card-header {
        background: linear-gradient(90deg,var(--sup-primary),var(--sup-secondary));
        color: #fff;
        padding: 1.25rem 1.75rem;
        border-bottom: 1px solid rgba(255,255,255,.18);
    }

    .create-card-body {
        padding: 1.5rem 1.75rem 1.75rem;
    }

    /* Secciones */
    .section-container {
        background: #fff;
        border: 1px solid var(--sup-border);
        border-radius: var(--sup-radius);
        padding: 1.25rem 1.25rem 1.15rem;
        margin-bottom: 1.25rem;
        transition: all .25s ease;
    }

        .section-container:hover {
            box-shadow: 0 4px 14px rgba(15,23,42,.06);
            border-color: var(--sup-accent);
        }

    .section-title {
        color: #111827;
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: .85rem;
        padding-bottom: .6rem;
        border-bottom: 2px solid rgba(139,136,242,.22); /* antes rojo, ahora acento azul */
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .section-title i {
            background: var(--sup-secondary);
            color: #fff;
            width: 1.9rem;
            height: 1.9rem;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
        }

    /* Labels y controles */
    .form-label {
        color: #374151;
        font-weight: 600;
        margin-bottom: .35rem;
        display: block;
    }

    .form-control-create,
    textarea.form-control-create {
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: var(--sup-radius);
        color: #111827;
        padding: .6rem .85rem;
        transition: all .25s ease;
        width: 100%;
        font-size: .94rem;
    }

        .form-control-create::placeholder {
            color: #9ca3af;
        }

        .form-control-create:focus,
        textarea.form-control-create:focus {
            background: #fff;
            border-color: var(--sup-secondary);
            box-shadow: 0 0 0 .16rem rgba(81,75,242,.18); /* antes coral */
            color: #111827;
            outline: none;
        }

    .form-text-create {
        color: var(--sup-muted);
        font-size: .8rem;
        margin-top: .15rem;
    }

    .required-field::after {
        content: " *";
        color: var(--sup-danger);
    }

    .validation-message {
        color: var(--sup-danger);
        font-size: .8rem;
        margin-top: .15rem;
        display: block;
    }

    .alert-create {
        border-radius: var(--sup-radius);
        border: 1px solid transparent;
        padding: .7rem .9rem;
        margin-bottom: .85rem;
        font-size: .86rem;
    }

    .alert-danger {
        background: #FEF2F2;
        border-color: #FECACA;
        color: #B91C1C;
    }

    .alert-success {
        background: #ECFDF5;
        border-color: #BBF7D0;
        color: #166534;
    }

    /* Botones */
    .btn-create-primary {
        background: var(--sup-secondary);
        border: none;
        border-radius: var(--sup-radius);
        color: #fff;
        font-weight: 600;
        padding: .6rem 1.4rem;
        font-size: .92rem;
        transition: all .25s ease;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .btn-create-primary:hover {
            background: var(--sup-primary);
            box-shadow: 0 4px 12px rgba(15,23,42,.18);
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-create-outline {
        border: 1px solid var(--sup-accent);
        background: transparent;
        color: var(--sup-primary); /* antes rojo fijo */
        border-radius: var(--sup-radius);
        font-weight: 500;
        padding: .6rem 1.4rem;
        font-size: .9rem;
        transition: all .25s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .btn-create-outline:hover {
            background: var(--sup-accent);
            color: #101232; /* azul oscuro legible */
            box-shadow: 0 4px 10px rgba(15,23,42,.16);
            transform: translateY(-1px);
        }

    .action-buttons {
        border-top: 1px solid var(--sup-border);
        padding-top: 1rem;
        margin-top: .75rem;
    }

    /* Tarjeta informativa */
    .info-panel {
        background: #fff;
        border: 1px solid var(--sup-border);
        border-radius: var(--sup-radius);
        box-shadow: 0 6px 18px rgba(15,23,42,.08);
        color: #374151;
        font-size: .9rem;
    }

        .info-panel h6 {
            color: var(--sup-primary); /* antes rojo */
            font-weight: 700;
            font-size: .95rem;
        }

    /* Scrollbars */
    .table-responsive::-webkit-scrollbar {
        width: 7px;
        height: 7px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f3f4f6;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #c9cbff;
        border-radius: 4px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #a3a6ff;
        }

    @@media (max-width:768px) {
        .create-card-body {
            padding: 1.1rem 1.1rem 1.3rem;
        }

        .section-container {
            padding: .9rem .85rem;
        }

        .section-title {
            font-size: .95rem;
            padding-bottom: .4rem;
        }

        .create-card-header {
            padding: 1rem 1.25rem;
        }

        .action-buttons .d-flex {
            flex-direction: column;
            align-items: stretch;
            gap: .6rem;
        }

        .btn-create-outline, .btn-create-primary {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="container supplier-theme">
    <!-- Card principal -->
    <div class="create-card">
        <div class="create-card-header">
            <div class="d-flex align-items-center">
                <i class="bi bi-building-add fs-2 me-3"></i>
                <div>
                    <h2 class="mb-1">Agregar Nuevo Proveedor</h2>
                    <p class="mb-0 opacity-75">Registra un nuevo aliado comercial con datos claros y actualizados.</p>
                </div>
            </div>
        </div>

        <div class="create-card-body">
            <!-- Resumen de validación MVC -->
            <div asp-validation-summary="ModelOnly" class="alert-create alert-danger" role="alert"></div>

            <form asp-action="Create" method="post" id="proveedorForm">
                @Html.AntiForgeryToken()

                <!-- SECCIÓN: Información del Proveedor -->
                <div class="section-container">
                    <h4 class="section-title">
                        <i class="bi bi-card-text"></i>
                        Información del Proveedor
                    </h4>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label required-field">Nombre del Proveedor</label>
                            <input asp-for="Nombre" class="form-control-create" placeholder="Ingrese el nombre del proveedor" required />
                            <span asp-validation-for="Nombre" class="validation-message"></span>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN: Información de Contacto -->
                <div class="section-container">
                    <h4 class="section-title">
                        <i class="bi bi-telephone"></i>
                        Información de Contacto
                    </h4>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Contacto" class="form-label">Persona de Contacto</label>
                            <input asp-for="Contacto" class="form-control-create" placeholder="Nombre del contacto principal" />
                            <span asp-validation-for="Contacto" class="validation-message"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono" class="form-control-create" placeholder="Número de teléfono" />
                            <span asp-validation-for="Telefono" class="validation-message"></span>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN: Información Adicional -->
                <div class="section-container">
                    <h4 class="section-title">
                        <i class="bi bi-geo-alt"></i>
                        Información Adicional
                    </h4>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Correo Electrónico</label>
                            <input asp-for="Email" type="email" class="form-control-create" placeholder="correo@proveedor.com" />
                            <span asp-validation-for="Email" class="validation-message"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Direccion" class="form-label">Dirección</label>
                            <textarea asp-for="Direccion" rows="2" class="form-control-create" placeholder="Dirección completa"></textarea>
                            <span asp-validation-for="Direccion" class="validation-message"></span>
                        </div>
                    </div>
                </div>

                <!-- BOTONES -->
                <div class="action-buttons">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn-create-outline">
                            <i class="bi bi-arrow-left"></i> Volver al listado
                        </a>

                        <div class="d-flex gap-3">
                            <button type="reset" class="btn-create-outline" id="btnReset">
                                <i class="bi bi-arrow-clockwise"></i> Limpiar
                            </button>
                            <button type="submit" class="btn-create-primary" id="btnSubmit">
                                <i class="bi bi-plus-circle"></i> Agregar Proveedor
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tarjeta informativa -->
    <div class="card info-panel mt-4">
        <div class="card-body">
            <h6><i class="bi bi-lightbulb me-1"></i> Recomendaciones para el registro</h6>
            <p>
                <i class="bi bi-check-circle text-success me-1"></i>
                <strong>Nombre claro:</strong> usa el nombre comercial real del proveedor.
            </p>
            <p>
                <i class="bi bi-telephone me-1"></i>
                <strong>Contacto confiable:</strong> agrega teléfono o correo que realmente respondan.
            </p>
            <p class="mb-0">
                <i class="bi bi-shield-check text-info me-1"></i>
                <strong>Datos correctos:</strong> evitar errores facilita compras, pagos y facturación.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('#proveedorForm');
            const nombreInput = document.querySelector('#Nombre');
            const resetButton = document.querySelector('#btnReset');

            if (nombreInput) nombreInput.focus();

            if (nombreInput) {
                nombreInput.addEventListener('blur', function () {
                    const errorSpan = this.nextElementSibling;
                    if (!this.value.trim() && errorSpan && errorSpan.classList.contains('validation-message')) {
                        this.classList.add('is-invalid');
                    } else if (this.value.trim()) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                        setTimeout(() => this.classList.remove('is-valid'), 2000);
                    }
                });
            }

            if (resetButton && form) {
                resetButton.addEventListener('click', function () {
                    form.querySelectorAll('.is-valid, .is-invalid').forEach(el => {
                        el.classList.remove('is-valid', 'is-invalid');
                    });
                });
            }
        });
    </script>
}
