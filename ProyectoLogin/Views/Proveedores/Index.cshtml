@model IEnumerable<ProyectoLogin.Models.Proveedor>

@{
    var activos = ViewBag.Activos as List<ProyectoLogin.Models.Proveedor>
                  ?? new List<ProyectoLogin.Models.Proveedor>();
    var inactivos = ViewBag.Inactivos as List<ProyectoLogin.Models.Proveedor>
                   ?? new List<ProyectoLogin.Models.Proveedor>();

    var totalActivos = ViewBag.TotalActivos ?? 0;
    var totalInactivos = ViewBag.TotalInactivos ?? 0;
    var pageSize = ViewBag.PageSize ?? 5;
    var pageActivos = ViewBag.PageActivos ?? 1;
    var pageInactivos = ViewBag.PageInactivos ?? 1;
    var totalPagesActivos = ViewBag.TotalPagesActivos ?? 1;
    var totalPagesInactivos = ViewBag.TotalPagesInactivos ?? 1;

    // --- Capturar y eliminar TempData para evitar duplicados en Layout/partials ---
    var msgError = TempData["Error"] as string;
    var msgSuccess = TempData["Success"] as string;
    var msgWarning = TempData["Warning"] as string;
    TempData.Remove("Error");
    TempData.Remove("Success");
    TempData.Remove("Warning");

    ViewData["Title"] = "Gestión de Proveedores";
}

<style>
    :root {
        /* Paleta AZUL (igual a Productos) */
        --sup-primary: #1C1973; /* primario */
        --sup-secondary: #514BF2; /* secundario */
        --sup-accent: #8B88F2; /* acento */
        --sup-bg: #f5f6fa; /* fondo */
        --sup-card: #FFFFFF;
        --sup-text: #212529;
        --sup-radius: 0.75rem;
        --muted: #6b7280;
        --border-soft: #e5e7eb;
        /* Dejo estos igual (estado) */
        --sup-success: #22C55E;
        --sup-danger: #E54848;
        --sup-warning: #F1C40F;
    }

    /* Fondo general */
    .prov-theme {
        background: var(--sup-bg);
        padding: 1.5rem 0 2rem;
        color: var(--sup-text);
        min-height: 100vh;
    }

    /* HEADER */
    .prov-header-card {
        background: linear-gradient(90deg,var(--sup-primary),var(--sup-secondary));
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: var(--sup-radius);
        padding: 1.1rem 1.4rem;
        margin-bottom: 1rem;
        box-shadow: 0 6px 18px rgba(15,23,42,0.18);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        color: #fff;
    }

    .prov-header-title {
        display: flex;
        align-items: center;
        gap: .7rem;
        color: #fff;
    }

    .prov-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: rgba(0,0,0,.18);
        border: 1px solid rgba(255,255,255,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #fff;
    }

    .prov-header-title h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .prov-header-subtitle {
        color: rgba(249,250,251,.9);
        font-size: .85rem;
        margin-top: .15rem;
    }

    /* Botones */
    .prov-btn-outline {
        border: 1px solid var(--sup-accent);
        background: transparent;
        color: #fff;
        border-radius: var(--sup-radius);
        font-weight: 500;
        padding: .5rem 1.4rem;
        font-size: .86rem;
        transition: all .25s ease;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        text-decoration: none;
    }

        .prov-btn-outline:hover {
            background: rgba(139,136,242,.16); /* acento azul suave */
            color: #fff;
            box-shadow: 0 4px 10px rgba(15,23,42,.25);
            transform: translateY(-1px);
        }

    .prov-btn-primary {
        background: #fff;
        color: var(--sup-primary);
        border: none;
        border-radius: var(--sup-radius);
        font-weight: 600;
        padding: .5rem 1.4rem;
        font-size: .86rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: all .25s ease;
        text-decoration: none;
    }

        .prov-btn-primary:hover {
            background: #f9fafb; /* igual productos */
            color: var(--sup-secondary);
            box-shadow: 0 4px 12px rgba(15,23,42,.25);
            transform: translateY(-1px);
        }

    /* Búsqueda */
    .prov-search-card {
        background: var(--sup-card);
        border: 1px solid var(--border-soft);
        border-radius: var(--sup-radius);
        padding: .9rem 1.1rem;
        margin-bottom: 1.1rem;
        box-shadow: 0 2px 8px rgba(15,23,42,.04);
    }

    .prov-search-label {
        font-size: .8rem;
        font-weight: 600;
        color: var(--muted);
        margin-bottom: .25rem;
    }

    .prov-input-icon {
        background: #fff;
        border: 1px solid var(--border-soft);
        border-right: 0;
        border-radius: .6rem 0 0 .6rem;
        width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--sup-primary);
    }

    .prov-input-search {
        background: #fff;
        border: 1px solid var(--border-soft);
        border-left: 0;
        border-radius: 0 .6rem .6rem 0;
        padding: .55rem .85rem;
        font-size: .9rem;
        color: var(--sup-text);
    }

        .prov-input-search::placeholder {
            color: #9ca3af;
        }

        .prov-input-search:focus {
            outline: none;
            border-color: var(--sup-secondary);
            box-shadow: 0 0 0 .16rem rgba(81,75,242,.15); /* azul */
        }

    .prov-btn-search {
        border-radius: var(--sup-radius);
        margin-left: .4rem;
        padding: .5rem 1.3rem;
        font-size: .86rem;
        border: 1px solid var(--sup-accent);
        background: transparent;
        color: var(--sup-primary);
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        transition: all .25s ease;
    }

        .prov-btn-search:hover {
            background: var(--sup-accent);
            color: #101232; /* azul oscuro legible */
            box-shadow: 0 4px 10px rgba(15,23,42,.16);
            transform: translateY(-1px);
        }

    /* Grupo buscador */
    .prov-search-inline {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .prov-input-group {
        display: flex;
        align-items: stretch;
        flex: 1 1 380px;
        min-width: 280px;
    }

    .prov-input-search {
        border-right: 0;
        border-radius: 0;
    }

    .prov-btn-search {
        margin-left: 0;
        border-left: 0;
    }

        .prov-btn-search.prov-join {
            border-radius: 0 .6rem .6rem 0;
        }

    /* Tarjetas */
    .prov-card {
        background: var(--sup-card);
        border: 1px solid var(--border-soft);
        border-radius: var(--sup-radius);
        overflow: hidden;
        margin-bottom: 1.25rem;
        box-shadow: 0 4px 14px rgba(15,23,42,.06);
        transition: all .22s ease;
    }

        .prov-card:hover {
            box-shadow: 0 7px 20px rgba(15,23,42,.10);
            transform: translateY(-1px);
        }

    .prov-card-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .85rem 1.15rem;
        border-bottom: 1px solid rgba(255,255,255,.06);
        background: linear-gradient(90deg,var(--sup-primary),var(--sup-secondary));
        color: #fff;
    }

    .prov-card-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
    }

    .prov-badge-count {
        margin-left: auto;
        background: rgba(15,23,42,.16);
        border: 1px solid rgba(226,232,240,.45);
        border-radius: 999px;
        padding: .25rem .8rem;
        font-size: .78rem;
        color: #f8fafc;
        display: inline-flex;
        align-items: center;
        gap: .25rem;
    }

    .prov-btn-sort {
        border-radius: 999px;
        padding: .25rem .9rem;
        font-size: .72rem;
        border: 1px solid rgba(255,255,255,.6);
        color: #fff;
        background: transparent;
        text-decoration: none;
        transition: all .22s ease;
    }

        .prov-btn-sort:hover {
            background: rgba(255,255,255,.16);
            color: #fff;
        }

    /* Tabla */
    .prov-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        font-size: .85rem;
        color: var(--sup-text);
    }

        .prov-table thead th {
            background: #f3f4ff; /* azul claro como Productos */
            font-weight: 600;
            font-size: .78rem;
            border-bottom: 1px solid var(--border-soft);
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: .03em;
            color: #6b7280;
            padding: .65rem .9rem;
        }

        .prov-table td {
            padding: .6rem .9rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--border-soft);
        }

    .table-hover tbody tr:hover {
        background-color: #f9fafb;
    }
    /* neutro */

    .prov-name {
        font-weight: 600;
        color: var(--sup-text);
        display: flex;
        align-items: center;
        gap: .4rem;
    }

    .prov-contact-muted {
        color: var(--muted);
        font-size: .78rem;
    }

    .prov-link-mail {
        color: var(--sup-primary);
        text-decoration: none;
        font-size: .8rem;
    }

        .prov-link-mail:hover {
            text-decoration: underline;
        }

    .prov-empty {
        text-align: center;
        padding: 2.2rem 1rem;
        color: var(--muted);
        font-size: .86rem;
    }

        .prov-empty i {
            font-size: 2rem;
            margin-bottom: .35rem;
            color: var(--sup-secondary);
            opacity: .9;
        }

    /* Botones de acción */
    .prov-action-btn {
        width: 2.2rem;
        height: 2.2rem;
        border-radius: .7rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 .12rem;
        padding: 0;
        font-size: .9rem;
        transition: all .2s ease;
        border: none;
    }

        .prov-action-btn.edit {
            background: #fff7e6;
            color: #92400e;
            border: 1px solid #fcd77b;
        }

            .prov-action-btn.edit:hover {
                background: #fbbf24;
                color: #111827;
                transform: translateY(-1px);
            }

        .prov-action-btn.off {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

            .prov-action-btn.off:hover {
                background: #dc2626;
                color: #fff;
                transform: translateY(-1px);
            }

        .prov-action-btn.on {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

            .prov-action-btn.on:hover {
                background: #22c55e;
                color: #fff;
                transform: translateY(-1px);
            }

    /* Paginación */
    .prov-paging-bar {
        padding: .9rem 1rem;
        border-top: 1px solid var(--border-soft);
        background: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font-size: .78rem;
        color: var(--muted);
    }

    .prov-pagination .page-link {
        border-radius: 999px !important;
        font-size: .78rem;
        padding: .25rem .6rem;
        border: 1px solid var(--border-soft);
        color: var(--sup-primary);
    }

    .prov-pagination .page-item.active .page-link {
        background-color: var(--sup-secondary);
        border-color: var(--sup-secondary);
        color: #fff;
    }

    .prov-pagination .page-link:hover {
        background: #f3f4ff;
        border-color: var(--sup-secondary);
        color: var(--sup-secondary);
    }

    /* Scroll */
    .table-responsive::-webkit-scrollbar {
        height: 7px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f3f4f6;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #c9cbff;
        border-radius: 4px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #a3a6ff;
        }

    /* Modal */
    .modal-prov .modal-content {
        background: #fff;
        color: var(--sup-text);
        border-radius: var(--sup-radius);
        border: 1px solid var(--border-soft);
        box-shadow: 0 10px 40px rgba(15,23,42,.18);
    }

    .modal-prov .modal-header {
        background: linear-gradient(90deg,var(--sup-primary),var(--sup-secondary));
        border-bottom: 1px solid rgba(255,255,255,.16);
        color: #fff;
        border-radius: var(--sup-radius) var(--sup-radius) 0 0;
    }

    .modal-prov .btn-cancel {
        border-radius: var(--sup-radius);
        font-size: .82rem;
        border: 1px solid var(--border-soft);
        background: #fff;
        color: var(--muted);
        padding: .45rem 1rem;
    }

        .modal-prov .btn-cancel:hover {
            background: #eef2ff;
            color: var(--sup-primary);
            border-color: var(--sup-secondary);
        }

    .modal-prov .btn-confirm {
        background: var(--sup-secondary);
        border-radius: var(--sup-radius);
        font-size: .82rem;
        border: none;
        padding: .45rem 1rem;
        color: #fff;
    }

        .modal-prov .btn-confirm:hover {
            background: var(--sup-primary);
        }

    /* --- Alertas inline --- */
    .prov-alert {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: .6rem;
        padding: .75rem 1rem;
        border-radius: var(--sup-radius);
        border: 1px solid var(--border-soft);
        background: #fff;
        color: var(--sup-text);
        box-shadow: 0 4px 12px rgba(15,23,42,.06);
        transition: opacity .25s ease, transform .25s ease;
        margin-bottom: 1rem;
    }

        .prov-alert::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 6px;
            border-radius: var(--sup-radius) 0 0 var(--sup-radius);
        }

        .prov-alert .prov-alert-icon {
            font-size: 1.1rem;
            margin-top: .1rem;
        }

        .prov-alert .prov-alert-title {
            font-weight: 700;
            margin-right: .25rem;
        }

        .prov-alert .prov-alert-close {
            position: absolute;
            right: .5rem;
            top: .45rem;
            border: 0;
            background: transparent;
            color: inherit;
            opacity: .75;
        }

            .prov-alert .prov-alert-close:hover {
                opacity: 1;
            }

    .prov-alert--error {
        border-color: rgba(229,72,72,.35);
    }

        .prov-alert--error::before {
            background: var(--sup-danger);
        }

    .prov-alert--success {
        border-color: rgba(34,197,94,.35);
    }

        .prov-alert--success::before {
            background: var(--sup-success);
        }

    .prov-alert--warning {
        border-color: rgba(241,196,15,.45);
    }

        .prov-alert--warning::before {
            background: var(--sup-warning);
        }

    .prov-alert-hide {
        opacity: 0;
        transform: translateY(-6px);
    }

    @@media (max-width:768px) {
        .prov-header-card {
            flex-direction: column;
            align-items: flex-start;
            padding: .9rem 1rem;
        }

        .prov-header-title h2 {
            font-size: 1.1rem;
        }

        .prov-header-subtitle {
            font-size: .8rem;
        }

        .prov-header-actions {
            width: 100%;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .prov-paging-bar {
            flex-direction: column;
            align-items: flex-start;
        }

        .prov-action-btn {
            width: 2rem;
            height: 2rem;
            border-radius: .6rem;
        }

        .prov-input-group {
            flex: 1 1 100%;
        }
    }
</style>

<div class="container-fluid prov-theme">
    <!-- HEADER -->
    <div class="prov-header-card">
        <div class="prov-header-title">
            <div class="prov-header-icon">
                <i class="bi bi-truck"></i>
            </div>
            <div>
                <h2>Gestión de Proveedores</h2>
                <div class="prov-header-subtitle">Administra tus aliados comerciales, contactos y fuentes de abastecimiento.</div>
            </div>
        </div>
        <div class="d-flex gap-2 prov-header-actions">
            <a href="@Url.Action("Index", "Home")" class="prov-btn-outline">
                <i class="bi bi-arrow-left"></i> Volver al Inicio
            </a>
            <a asp-action="Create" class="prov-btn-primary" title="Agregar nuevo proveedor">
                <i class="bi bi-plus-circle"></i> Agregar Proveedor
            </a>
        </div>
    </div>

    <!-- MENSAJES (TempData, con eliminación para evitar duplicados) -->
    <div id="prov-message-area">
        @if (!string.IsNullOrWhiteSpace(msgError))
        {
            <div class="prov-alert prov-alert--error" role="alert">
                <i class="bi bi-exclamation-octagon-fill prov-alert-icon"></i>
                <div><span class="prov-alert-title">No se pudo completar la acción.</span>@msgError</div>
                <button type="button" class="prov-alert-close" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(msgSuccess))
        {
            <div class="prov-alert prov-alert--success" role="status">
                <i class="bi bi-check-circle-fill prov-alert-icon"></i>
                <div><span class="prov-alert-title">Operación exitosa.</span>@msgSuccess</div>
                <button type="button" class="prov-alert-close" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(msgWarning))
        {
            <div class="prov-alert prov-alert--warning" role="alert">
                <i class="bi bi-exclamation-triangle-fill prov-alert-icon"></i>
                <div><span class="prov-alert-title">Atención.</span>@msgWarning</div>
                <button type="button" class="prov-alert-close" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
        }
    </div>

    <!-- BÚSQUEDA (BOTÓN JUNTO AL INPUT) -->
    <div class="prov-search-card">
        <form method="get" asp-action="Index" class="prov-search-inline">
            <div class="prov-search-label mb-0">Buscar proveedor</div>

            <div class="prov-input-group">
                <span class="prov-input-icon"><i class="bi bi-search"></i></span>

                <input type="text"
                       name="q"
                       value="@(ViewData["q"] ?? "")"
                       class="prov-input-search"
                       placeholder="Nombre, contacto, teléfono o email del proveedor..." />

                <input type="hidden" name="pageActivos" value="1" />
                <input type="hidden" name="pageInactivos" value="1" />

                <button class="prov-btn-search prov-join" type="submit">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </form>
    </div>

    <!-- ACTIVOS -->
    <div class="prov-card">
        <div class="prov-card-header">
            <i class="bi bi-check2-circle fs-5"></i>
            <h3 class="prov-card-title mb-0">Proveedores activos</h3>
            <span class="prov-badge-count"><i class="bi bi-people"></i> @totalActivos</span>
            <a asp-action="Index" asp-route-ordenar="true" class="prov-btn-sort ms-3" title="Ordenar alfabéticamente">
                <i class="bi bi-sort-alpha-down"></i> A-Z
            </a>
        </div>

        <div class="card-body p-0">
            @if (!activos.Any())
            {
                <div class="prov-empty">
                    <i class="bi bi-truck"></i>
                    <div>No hay proveedores activos registrados</div>
                    @if (!string.IsNullOrEmpty(ViewData["q"] as string))
                    {
                        <div class="small mt-2">Intenta con otros términos de búsqueda.</div>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 prov-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in activos)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="prov-name"><i class="bi bi-building"></i>@p.Nombre</div>
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(p.Contacto)
                                                                        ? Html.Raw("<span class='prov-contact-muted'>Sin contacto</span>")
                                                                        : p.Contacto)
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-telephone text-secondary"></i>
                                    <span>@(string.IsNullOrEmpty(p.Telefono) ? "-" : p.Telefono)</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-envelope text-secondary"></i>
                                                <a href="mailto:@p.Email" class="prov-link-mail">@p.Email</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="prov-contact-muted">-</span>
                                        }
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(p.Direccion)
                                                                    ? Html.Raw("<span class='prov-contact-muted'>Sin dirección registrada</span>")
                                                                    : p.Direccion)
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex">
                                    <a asp-action="Edit" asp-route-id="@p.IdProveedor"
                                       class="prov-action-btn edit" title="Editar proveedor">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.IdProveedor" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button"
                                                class="prov-action-btn off prov-prov-confirm"
                                                data-prov-name="@p.Nombre"
                                                data-action="desactivar"
                                                title="Desactivar proveedor">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesActivos > 1)
                {
                    <div class="prov-paging-bar">
                        <div>
                            Página @pageActivos de @totalPagesActivos • Mostrando @activos.Count() de @totalActivos
                        </div>
                        <nav class="prov-pagination">
                            <ul class="pagination mb-0">
                                @if (pageActivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = pageActivos - 1, pageInactivos = pageInactivos, pageSize = pageSize })">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
                                }

                                @{
                                    int startPage = Math.Max(1, pageActivos - 2);
                                    int endPage = Math.Min(totalPagesActivos, pageActivos + 2);

                                    if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = 1, pageInactivos = pageInactivos, pageSize = pageSize })">1</a>
                                        </li>
                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                    }
                                    for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == pageActivos ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = i, pageInactivos = pageInactivos, pageSize = pageSize })">@i</a>
                                        </li>
                                    }
                                    if (endPage < totalPagesActivos)
                                    {
                                        if (endPage < totalPagesActivos - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = totalPagesActivos, pageInactivos = pageInactivos, pageSize = pageSize })">@totalPagesActivos</a>
                                        </li>
                                    }
                                }

                                @if (pageActivos < totalPagesActivos)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = pageActivos + 1, pageInactivos = pageInactivos, pageSize = pageSize })">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-right"></i></span></li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>

    <!-- INACTIVOS -->
    @if (totalInactivos > 0)
    {
        <div class="prov-card">
            <div class="prov-card-header">
                <i class="bi bi-archive fs-5"></i>
                <h3 class="prov-card-title mb-0">Proveedores inactivos</h3>
                <span class="prov-badge-count"><i class="bi bi-archive"></i> @totalInactivos</span>
                <a asp-action="Index" asp-route-ordenar="true" class="prov-btn-sort ms-3" title="Ordenar alfabéticamente">
                    <i class="bi bi-sort-alpha-down"></i> A-Z
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 prov-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in inactivos)
                            {
                                <tr class="text-muted">
                                    <td class="ps-3">
                                        <div class="prov-name" style="color:#6b7280;">
                                            <i class="bi bi-building"></i>@p.Nombre
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Contacto) ? "-" : p.Contacto)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-telephone"></i>
                                            <span>@(string.IsNullOrEmpty(p.Telefono) ? "-" : p.Telefono)</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-envelope"></i>
                                                <span>@p.Email</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="prov-contact-muted">-</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Direccion) ? "-" : p.Direccion)</td>
                                    <td class="text-center">
                                        <div class="d-inline-flex">
                                            <form asp-action="Activar" asp-route-id="@p.IdProveedor" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="prov-action-btn on prov-prov-confirm"
                                                        data-prov-name="@p.Nombre"
                                                        data-action="activar"
                                                        title="Activar proveedor">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesInactivos > 1)
                {
                    <div class="prov-paging-bar">
                        <div>
                            Página @pageInactivos de @totalPagesInactivos • Mostrando @inactivos.Count() de @totalInactivos
                        </div>
                        <nav class="prov-pagination">
                            <ul class="pagination mb-0">
                                @if (pageInactivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = pageActivos, pageInactivos = pageInactivos - 1 })">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
                                }

                                @{
                                    int startPageI = Math.Max(1, pageInactivos - 2);
                                    int endPageI = Math.Min(totalPagesInactivos, pageInactivos + 2);

                                    if (startPageI > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = pageActivos, pageInactivos = 1 })">1</a>
                                        </li>
                                        if (startPageI > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                    }
                                    for (int i = startPageI; i <= endPageI; i++)
                                    {
                                        <li class="page-item @(i == pageInactivos ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = pageActivos, pageInactivos = i })">@i</a>
                                        </li>
                                    }
                                    if (endPageI < totalPagesInactivos)
                                    {
                                        if (endPageI < totalPagesInactivos - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = pageActivos, pageInactivos = totalPagesInactivos })">@totalPagesInactivos</a>
                                        </li>
                                    }
                                }

                                @if (pageInactivos < totalPagesInactivos)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { q = ViewData["q"], ordenar = ViewBag.Ordenar, pageActivos = pageActivos, pageInactivos = pageInactivos + 1 })">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-right"></i></span></li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL CONFIRMACIÓN -->
<div class="modal fade modal-prov" id="confirmProvModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmProvTitle">Confirmar acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="confirmProvText" class="mb-0">¿Deseas continuar?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-confirm" id="btnConfirmProv">Sí, continuar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.querySelector('input[name="q"]');
            if (input) input.focus();

            const modalEl = document.getElementById('confirmProvModal');
            let confirmModal = null;
            if (modalEl && window.bootstrap) { confirmModal = new bootstrap.Modal(modalEl); }

            const titleEl = document.getElementById('confirmProvTitle');
            const textEl = document.getElementById('confirmProvText');
            const btnConfirm = document.getElementById('btnConfirmProv');
            let formToSubmit = null;

            document.querySelectorAll('.prov-prov-confirm').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const form = btn.closest('form'); if (!form) return;

                    const provName = btn.getAttribute('data-prov-name') || 'este proveedor';
                    const action = (btn.getAttribute('data-action') || '').toLowerCase();

                    let title = 'Confirmar acción', message = '';
                    if (action === 'desactivar') {
                        title = 'Desactivar proveedor';
                        message = `<strong>${provName}</strong><br>Pasará a la lista de inactivos (no se elimina).`;
                    } else if (action === 'activar') {
                        title = 'Activar proveedor';
                        message = `<strong>${provName}</strong><br>Volverá a estar disponible para operaciones.`;
                    } else {
                        message = `¿Deseas continuar con la operación para <strong>${provName}</strong>?`;
                    }

                    if (titleEl) titleEl.textContent = title;
                    if (textEl) textEl.innerHTML = message;

                    formToSubmit = form;

                    if (confirmModal) { confirmModal.show(); }
                    else { if (confirm(`${title} - ${provName}`)) form.submit(); }
                });
            });

            if (btnConfirm) {
                btnConfirm.addEventListener('click', () => {
                    if (formToSubmit) { formToSubmit.submit(); formToSubmit = null; }
                    if (confirmModal) confirmModal.hide();
                });
            }

            /* Alertas: autocierre y botón cerrar */
            const area = document.getElementById('prov-message-area');
            if (area){
                area.querySelectorAll('.prov-alert').forEach(el=>{
                    const kill = ()=>{ el.classList.add('prov-alert-hide'); el.addEventListener('transitionend', ()=> el.remove(), {once:true}); };
                    setTimeout(kill, 4500);
                    el.querySelector('.prov-alert-close')?.addEventListener('click', kill);
                });
            }
        });
    </script>
}
