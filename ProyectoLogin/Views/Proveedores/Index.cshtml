@model IEnumerable<ProyectoLogin.Models.Proveedor>

@{
    var activos = ViewBag.Activos as List<ProyectoLogin.Models.Proveedor>
                  ?? new List<ProyectoLogin.Models.Proveedor>();
    var inactivos = ViewBag.Inactivos as List<ProyectoLogin.Models.Proveedor>
                   ?? new List<ProyectoLogin.Models.Proveedor>();

    var totalActivos = ViewBag.TotalActivos ?? 0;
    var totalInactivos = ViewBag.TotalInactivos ?? 0;
    var pageSize = ViewBag.PageSize ?? 5;
    var pageActivos = ViewBag.PageActivos ?? 1;
    var pageInactivos = ViewBag.PageInactivos ?? 1;
    var totalPagesActivos = ViewBag.TotalPagesActivos ?? 1;
    var totalPagesInactivos = ViewBag.TotalPagesInactivos ?? 1;

    ViewData["Title"] = "Gestión de Proveedores";
}

<style>
    :root {
        --prov-primary: #1C1973;
        --prov-secondary: #514BF2;
        --prov-accent: #8B88F2;
        --prov-bg: #0D0E26;
        --prov-card: #11133F;
        --prov-card-alt: #15184B;
        --prov-text: #F0F0F7;
        --prov-muted: #A4A5D4;
        --prov-border: #2E2C7A;
        --prov-radius: 0.9rem;
        --prov-danger: #FF6B6B;
        --prov-success: #2ECC71;
        --prov-warning: #F1C40F;
    }

    .prov-theme {
        min-height: 100vh;
        padding: 1.5rem 0 2.5rem;
        background:
            radial-gradient(circle at top left, rgba(81, 75, 242, 0.06), transparent),
            radial-gradient(circle at bottom right, rgba(28, 25, 115, 0.14), transparent),
            linear-gradient(135deg, var(--prov-bg) 0%, #080A2E 100%);
        color: var(--prov-text);
    }

    /* HEADER PRINCIPAL */
    .prov-header-card {
        background:
            radial-gradient(circle at top left, rgba(139, 136, 242, 0.16), transparent),
            linear-gradient(135deg, var(--prov-primary), #3230A0, #15184B);
        border-radius: var(--prov-radius);
        padding: 1.4rem 1.6rem;
        margin-bottom: 1.8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid rgba(139, 136, 242, 0.55);
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.85);
    }

    .prov-header-title {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        color: var(--prov-text);
    }

    .prov-header-icon {
        width: 50px;
        height: 50px;
        border-radius: 18px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(139, 136, 242, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: var(--prov-accent);
    }

    .prov-header-title h2 {
        margin: 0;
        font-weight: 700;
        letter-spacing: 0.03em;
        font-size: 1.4rem;
    }

    .prov-header-subtitle {
        margin: 0.2rem 0 0;
        font-size: 0.8rem;
        color: rgba(240, 240, 247, 0.86);
    }

    .prov-header-actions {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
    }

    .prov-btn-outline {
        border-radius: 999px;
        padding: 0.45rem 1.2rem;
        font-size: 0.8rem;
        border: 1px solid rgba(240, 240, 247, 0.45);
        color: var(--prov-text);
        background: transparent;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        text-decoration: none;
        transition: all 0.22s ease;
    }

    .prov-btn-outline:hover {
        background: rgba(8, 10, 40, 0.96);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.9);
        transform: translateY(-1px);
        color: var(--prov-accent);
        border-color: var(--prov-accent);
    }

    .prov-btn-primary {
        border-radius: 999px;
        padding: 0.48rem 1.5rem;
        font-size: 0.82rem;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg, var(--prov-accent), var(--prov-secondary));
        color: #0D0E26;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        box-shadow: 0 14px 30px rgba(81, 75, 242, 0.55);
        transition: all 0.22s ease;
        text-decoration: none;
    }

    .prov-btn-primary:hover {
        background: linear-gradient(135deg, var(--prov-secondary), var(--prov-accent));
        color: #F0F0F7;
        transform: translateY(-1px);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.95);
    }

    /* BARRA DE BÚSQUEDA */
    .prov-search-card {
        background: var(--prov-card);
        border-radius: var(--prov-radius);
        border: 1px solid rgba(139, 136, 242, 0.32);
        margin-bottom: 1.8rem;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.9);
    }

    .prov-search-card .card-body {
        padding: 1.1rem 1.4rem;
    }

    .prov-search-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--prov-accent);
        margin-bottom: 0.2rem;
    }

    .prov-search-input-group {
        display: flex;
        align-items: stretch;
    }

    .prov-input-icon {
        background: #0A0C30;
        border: 1px solid rgba(139, 136, 242, 0.6);
        border-right: none;
        border-radius: 0.7rem 0 0 0.7rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        color: var(--prov-accent);
        font-size: 0.9rem;
    }

    .prov-input-search {
        background: #050821;
        border-radius: 0 0.7rem 0.7rem 0;
        border: 1px solid rgba(139, 136, 242, 0.6);
        padding: 0.55rem 0.85rem;
        min-width: 260px;
        font-size: 0.86rem;
        color: var(--prov-text);
        transition: all 0.2s ease;
    }

    .prov-input-search::placeholder {
        color: rgba(164, 165, 212, 0.75);
    }

    .prov-input-search:focus {
        outline: none;
        border-color: var(--prov-accent);
        box-shadow: 0 0 0 0.12rem rgba(139, 136, 242, 0.28);
        background: #080B30;
    }

    .prov-btn-search {
        border-radius: 0.7rem;
        margin-left: 0.4rem;
        padding: 0.5rem 1.3rem;
        font-size: 0.8rem;
        border: 1px solid var(--prov-accent);
        background: transparent;
        color: var(--prov-accent);
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all 0.2s ease;
    }

    .prov-btn-search:hover {
        background: var(--prov-accent);
        color: #0D0E26;
        box-shadow: 0 8px 22px rgba(81, 75, 242, 0.45);
        transform: translateY(-1px);
    }

    /* TARJETAS LISTAS */
    .prov-card {
        background: var(--prov-card);
        border-radius: var(--prov-radius);
        border: 1px solid rgba(139, 136, 242, 0.4);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.95);
        margin-bottom: 1.6rem;
        overflow: hidden;
    }

    .prov-card-header {
        padding: 0.9rem 1.3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: linear-gradient(90deg, #11133F, #15184B);
    }

    .prov-card-header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .prov-card-title {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--prov-text);
    }

    .prov-badge-count {
        padding: 0.15rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        background: #0D0E26;
        color: var(--prov-accent);
        border: 1px solid rgba(139, 136, 242, 0.85);
    }

    .prov-btn-sort {
        border-radius: 999px;
        padding: 0.25rem 0.9rem;
        font-size: 0.72rem;
        border: 1px solid rgba(164, 165, 212, 0.6);
        background: transparent;
        color: var(--prov-muted);
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .prov-btn-sort:hover {
        background: rgba(8, 10, 40, 0.96);
        color: var(--prov-accent);
        border-color: var(--prov-accent);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.8);
    }

    /* TABLA */
    .prov-table-wrap {
        width: 100%;
    }

    .prov-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        font-size: 0.82rem;
        color: var(--prov-text);
        table-layout: fixed;
    }

    .prov-table thead {
        background: linear-gradient(90deg, #080B30, #11133F);
    }

    .prov-table thead th {
        padding: 0.7rem 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.09em;
        color: var(--prov-muted);
        border-bottom: 1px solid rgba(139, 136, 242, 0.35);
        white-space: nowrap;
    }

    .prov-table tbody tr {
        transition: all 0.22s ease;
        background: transparent;
    }

    .prov-table tbody tr:nth-child(even) {
        background: rgba(8, 10, 40, 0.96);
    }

    .prov-table tbody tr:hover {
        background: rgba(139, 136, 242, 0.08);
        transform: translateX(2px);
    }

    .prov-table td {
        padding: 0.6rem 0.9rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        vertical-align: middle;
        color: var(--prov-text);
    }

    .prov-name {
        font-weight: 600;
        color: var(--prov-text);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .prov-name i {
        color: var(--prov-accent);
    }

    .prov-contact-muted {
        color: var(--prov-muted);
        font-size: 0.78rem;
    }

    .prov-link-mail {
        color: var(--prov-accent);
        text-decoration: none;
        font-size: 0.8rem;
    }

    .prov-link-mail:hover {
        text-decoration: underline;
    }

    .prov-empty {
        text-align: center;
        padding: 2.4rem 1rem;
        color: var(--prov-muted);
        font-size: 0.86rem;
    }

    .prov-empty i {
        font-size: 2rem;
        margin-bottom: 0.4rem;
        color: var(--prov-accent);
        opacity: 0.85;
    }

    /* ACCIONES */
    .prov-action-btn {
        width: 30px;
        height: 30px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        border: 1px solid transparent;
        background: transparent;
        color: var(--prov-muted);
        transition: all 0.2s ease;
        margin: 0 1px;
    }

    .prov-action-btn.edit {
        border-color: rgba(241, 196, 15, 0.65);
        color: var(--prov-warning);
    }

    .prov-action-btn.edit:hover {
        background: rgba(241, 196, 15, 0.14);
        box-shadow: 0 4px 10px rgba(241, 196, 15, 0.3);
        transform: translateY(-1px);
    }

    .prov-action-btn.off {
        border-color: rgba(255, 107, 107, 0.7);
        color: var(--prov-danger);
    }

    .prov-action-btn.off:hover {
        background: rgba(255, 107, 107, 0.16);
        box-shadow: 0 4px 10px rgba(255, 107, 107, 0.3);
        transform: translateY(-1px);
    }

    .prov-action-btn.on {
        border-color: rgba(46, 204, 113, 0.7);
        color: var(--prov-success);
    }

    .prov-action-btn.on:hover {
        background: rgba(46, 204, 113, 0.14);
        box-shadow: 0 4px 10px rgba(46, 204, 113, 0.3);
        transform: translateY(-1px);
    }

    /* PAGINACIÓN */
    .prov-paging-bar {
        padding: 0.7rem 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.04);
        background: #080A24;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font-size: 0.74rem;
        color: var(--prov-muted);
    }

    .prov-pagination .page-link {
        padding: 0.28rem 0.55rem;
        font-size: 0.72rem;
        border-radius: 0.45rem;
        border: 1px solid rgba(164, 165, 212, 0.8);
        background: transparent;
        color: var(--prov-muted);
        transition: all 0.18s ease;
    }

    .prov-pagination .page-item.active .page-link {
        background: linear-gradient(135deg, var(--prov-accent), var(--prov-secondary));
        color: #0D0E26;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(81, 75, 242, 0.5);
    }

    .prov-pagination .page-link:hover {
        background: rgba(139, 136, 242, 0.14);
        color: var(--prov-accent);
        border-color: var(--prov-accent);
    }

    .prov-pagination .page-item.disabled .page-link {
        opacity: 0.35;
        cursor: default;
        background: transparent;
    }

    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #080A24;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: rgba(46, 44, 122, 0.9);
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: var(--prov-accent);
    }

    @@media (max-width: 768px) {
        .prov-header-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.9rem;
        }

        .prov-header-actions {
            width: 100%;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .prov-paging-bar {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="container-fluid prov-theme">
    <!-- HEADER PRINCIPAL -->
    <div class="prov-header-card">
        <div class="prov-header-title">
            <div class="prov-header-icon">
                <i class="bi bi-truck"></i>
            </div>
            <div>
                <h2>Gestión de Proveedores</h2>
                <p class="prov-header-subtitle">
                    Administra tus aliados comerciales, contactos y fuentes de abastecimiento.
                </p>
            </div>
        </div>
        <div class="prov-header-actions">
            <a href="@Url.Action("Index", "Home")" class="prov-btn-outline">
                <i class="bi bi-arrow-left"></i> Volver al Inicio
            </a>
            <a asp-action="Create" class="prov-btn-primary" title="Agregar nuevo proveedor">
                <i class="bi bi-plus-circle"></i> Agregar Proveedor
            </a>
        </div>
    </div>

    <!-- BARRA DE BÚSQUEDA -->
    <div class="card prov-search-card">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="prov-search-label">Buscar proveedor</label>
                    <div class="prov-search-input-group">
                        <span class="prov-input-icon">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               name="q"
                               value="@(ViewData["q"] ?? "")"
                               class="prov-input-search"
                               placeholder="Nombre, contacto, teléfono o email del proveedor..." />
                    </div>
                </div>
                <div class="col-auto d-flex align-items-end">
                    <input type="hidden" name="pageActivos" value="1" />
                    <input type="hidden" name="pageInactivos" value="1" />
                    <button class="prov-btn-search" type="submit">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- PROVEEDORES ACTIVOS -->
    <div class="prov-card">
        <div class="prov-card-header">
            <div class="prov-card-header-left">
                <i class="bi bi-check-circle text-success"></i>
                <h5 class="prov-card-title mb-0">Proveedores Activos</h5>
                <span class="prov-badge-count">@totalActivos</span>
            </div>
            <a asp-action="Index" asp-route-ordenar="true"
               class="prov-btn-sort"
               title="Ordenar alfabéticamente">
                <i class="bi bi-sort-alpha-down"></i> A-Z
            </a>
        </div>
        <div class="card-body p-0 prov-table-wrap">
            @if (!activos.Any())
            {
                <div class="prov-empty">
                    <i class="bi bi-truck"></i>
                    <div>No hay proveedores activos registrados.</div>
                    @if (!string.IsNullOrEmpty(ViewData["q"] as string))
                    {
                        <div class="small mt-2">Intenta con otros términos de búsqueda.</div>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="prov-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in activos)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="prov-name">
                                            <i class="bi bi-building"></i>
                                            @p.Nombre
                                        </div>
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(p.Contacto)
                                            ? Html.Raw("<span class='prov-contact-muted'>Sin contacto</span>")
                                            : p.Contacto)
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-telephone text-secondary"></i>
                                            <span>@(string.IsNullOrEmpty(p.Telefono) ? "-" : p.Telefono)</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-envelope text-secondary"></i>
                                                <a href="mailto:@p.Email" class="prov-link-mail">@p.Email</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="prov-contact-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(p.Direccion)
                                            ? Html.Raw("<span class='prov-contact-muted'>Sin dirección registrada</span>")
                                            : p.Direccion)
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center">
                                            <a asp-action="Edit" asp-route-id="@p.IdProveedor"
                                               class="prov-action-btn edit"
                                               title="Editar proveedor">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@p.IdProveedor" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="prov-action-btn off"
                                                        title="Desactivar proveedor"
                                                        onclick="return confirm('¿Estás seguro de desactivar a @p.Nombre?')">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesActivos > 1)
                {
                    <div class="prov-paging-bar">
                        <div>
                            Página @pageActivos de @totalPagesActivos •
                            Mostrando @activos.Count() de @totalActivos proveedores
                        </div>
                        <nav class="prov-pagination">
                            <ul class="pagination pagination-sm mb-0">
                                @if (pageActivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                               q = ViewData["q"],
                                               ordenar = ViewBag.Ordenar,
                                               pageActivos = pageActivos - 1,
                                               pageInactivos = pageInactivos
                                           })">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                    </li>
                                }

                                @{
                                    int startPage = Math.Max(1, pageActivos - 2);
                                    int endPage = Math.Min(totalPagesActivos, pageActivos + 2);

                                    if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               href="@Url.Action("Index", new {
                                                   q = ViewData["q"],
                                                   ordenar = ViewBag.Ordenar,
                                                   pageActivos = 1,
                                                   pageInactivos = pageInactivos
                                               })">1</a>
                                        </li>
                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                    }

                                    for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == pageActivos ? "active" : "")">
                                            <a class="page-link"
                                               href="@Url.Action("Index", new {
                                                   q = ViewData["q"],
                                                   ordenar = ViewBag.Ordenar,
                                                   pageActivos = i,
                                                   pageInactivos = pageInactivos
                                               })">@i</a>
                                        </li>
                                    }

                                    if (endPage < totalPagesActivos)
                                    {
                                        if (endPage < totalPagesActivos - 1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link"
                                               href="@Url.Action("Index", new {
                                                   q = ViewData["q"],
                                                   ordenar = ViewBag.Ordenar,
                                                   pageActivos = totalPagesActivos,
                                                   pageInactivos = pageInactivos
                                               })">@totalPagesActivos</a>
                                        </li>
                                    }
                                }

                                @if (pageActivos < totalPagesActivos)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                               q = ViewData["q"],
                                               ordenar = ViewBag.Ordenar,
                                               pageActivos = pageActivos + 1,
                                               pageInactivos = pageInactivos
                                           })">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>

    <!-- PROVEEDORES INACTIVOS -->
    @if (totalInactivos > 0)
    {
        <div class="prov-card">
            <div class="prov-card-header">
                <div class="prov-card-header-left">
                    <i class="bi bi-x-circle text-danger"></i>
                    <h5 class="prov-card-title mb-0">Proveedores Inactivos</h5>
                    <span class="prov-badge-count">@totalInactivos</span>
                </div>
                <a asp-action="Index" asp-route-ordenar="true"
                   class="prov-btn-sort"
                   title="Ordenar alfabéticamente">
                    <i class="bi bi-sort-alpha-down"></i> A-Z
                </a>
            </div>
            <div class="card-body p-0 prov-table-wrap">
                <div class="table-responsive">
                    <table class="prov-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in inactivos)
                            {
                                <tr class="text-muted">
                                    <td class="ps-3">
                                        <div class="prov-name" style="color: var(--prov-muted);">
                                            <i class="bi bi-building"></i>
                                            @p.Nombre
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Contacto) ? "-" : p.Contacto)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-telephone"></i>
                                            <span>@(string.IsNullOrEmpty(p.Telefono) ? "-" : p.Telefono)</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-envelope"></i>
                                                <span>@p.Email</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="prov-contact-muted">-</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Direccion) ? "-" : p.Direccion)</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center">
                                            <form asp-action="Activar" asp-route-id="@p.IdProveedor" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="prov-action-btn on"
                                                        title="Activar proveedor"
                                                        onclick="return confirm('¿Estás seguro de activar a @p.Nombre?')">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPagesInactivos > 1)
                {
                    <div class="prov-paging-bar">
                        <div>
                            Página @pageInactivos de @totalPagesInactivos •
                            Mostrando @inactivos.Count() de @totalInactivos proveedores
                        </div>
                        <nav class="prov-pagination">
                            <ul class="pagination pagination-sm mb-0">
                                @if (pageInactivos > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                               q = ViewData["q"],
                                               ordenar = ViewBag.Ordenar,
                                               pageActivos = pageActivos,
                                               pageInactivos = pageInactivos - 1
                                           })">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                                    </li>
                                }

                                @{
                                    int startPageInactivos = Math.Max(1, pageInactivos - 2);
                                    int endPageInactivos = Math.Min(totalPagesInactivos, pageInactivos + 2);

                                    if (startPageInactivos > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               href="@Url.Action("Index", new {
                                                   q = ViewData["q"],
                                                   ordenar = ViewBag.Ordenar,
                                                   pageActivos = pageActivos,
                                                   pageInactivos = 1
                                               })">1</a>
                                        </li>
                                        if (startPageInactivos > 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                    }

                                    for (int i = startPageInactivos; i <= endPageInactivos; i++)
                                    {
                                        <li class="page-item @(i == pageInactivos ? "active" : "")">
                                            <a class="page-link"
                                               href="@Url.Action("Index", new {
                                                   q = ViewData["q"],
                                                   ordenar = ViewBag.Ordenar,
                                                   pageActivos = pageActivos,
                                                   pageInactivos = i
                                               })">@i</a>
                                        </li>
                                    }

                                    if (endPageInactivos < totalPagesInactivos)
                                    {
                                        if (endPageInactivos < totalPagesInactivos - 1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link"
                                               href="@Url.Action("Index", new {
                                                   q = ViewData["q"],
                                                   ordenar = ViewBag.Ordenar,
                                                   pageActivos = pageActivos,
                                                   pageInactivos = totalPagesInactivos
                                               })">@totalPagesInactivos</a>
                                        </li>
                                    }
                                }

                                @if (pageInactivos < totalPagesInactivos)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new {
                                               q = ViewData["q"],
                                               ordenar = ViewBag.Ordenar,
                                               pageActivos = pageActivos,
                                               pageInactivos = pageInactivos + 1
                                           })">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.querySelector('input[name="q"]');
            if (input) input.focus();
        });
    </script>
}
