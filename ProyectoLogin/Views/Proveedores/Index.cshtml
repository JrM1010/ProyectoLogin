@model IEnumerable<ProyectoLogin.Models.Proveedor>

<div class="container-fluid">
    <!-- HEADER PRINCIPAL -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-truck text-primary me-2"></i>Gestión de Proveedores
        </h2>
        <a asp-action="Create" class="btn btn-success rounded-pill" title="Agregar nuevo proveedor">
            <i class="bi bi-plus-circle me-1"></i>Agregar Proveedor
        </a>
    </div>

    <!-- PROVEEDORES ACTIVOS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle fs-5 me-2"></i>
                <h5 class="mb-0 me-2">Proveedores Activos</h5>
                <span class="badge bg-light text-success fs-6">@Model.Count(x => x.Activo)</span>
            </div>
            <a asp-action="Index" asp-route-ordenar="true" class="btn btn-outline-light btn-sm rounded-pill" title="Ordenar alfabéticamente">
                <i class="bi bi-sort-alpha-down me-1"></i>Ordenar A-Z
            </a>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any(x => x.Activo))
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-truck fs-1 mb-2"></i>
                    <p class="mb-0">No hay proveedores activos</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Where(x => x.Activo))
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-building text-primary me-2"></i>
                                            @p.Nombre
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Contacto) ? "-" : p.Contacto)</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-telephone text-muted me-2"></i>
                                            @p.Telefono
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-envelope text-muted me-2"></i>
                                                <a href="mailto:@p.Email" class="text-decoration-none">@p.Email</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Direccion) ? "-" : p.Direccion)</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Editar -->
                                            <a asp-action="Edit" asp-route-id="@p.IdProveedor"
                                               class="btn btn-outline-warning rounded-circle btn-sm" title="Editar proveedor">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Desactivar -->
                                            <form asp-action="Delete" asp-route-id="@p.IdProveedor" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger rounded-circle btn-sm"
                                                        title="Desactivar proveedor"
                                                        onclick="return confirm('¿Estás seguro de desactivar a @p.Nombre?')">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- PROVEEDORES INACTIVOS -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="bi bi-x-circle fs-5 me-2"></i>
                <h5 class="mb-0 me-2">Proveedores Inactivos</h5>
                <span class="badge bg-light text-secondary fs-6">@Model.Count(x => !x.Activo)</span>
            </div>
            <a asp-action="Index" asp-route-ordenar="true" class="btn btn-outline-light btn-sm rounded-pill" title="Ordenar alfabéticamente">
                <i class="bi bi-sort-alpha-down me-1"></i>Ordenar A-Z
            </a>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any(x => !x.Activo))
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-emoji-smile fs-1 mb-2"></i>
                    <p class="mb-0">No hay proveedores inactivos</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Nombre</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Where(x => !x.Activo))
                            {
                                <tr class="text-muted">
                                    <td class="ps-3 fw-semibold">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-building me-2"></i>
                                            @p.Nombre
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Contacto) ? "-" : p.Contacto)</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-telephone me-2"></i>
                                            @p.Telefono
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-envelope me-2"></i>
                                                @p.Email
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.Direccion) ? "-" : p.Direccion)</td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Activar -->
                                            <form asp-action="Activar" asp-route-id="@p.IdProveedor" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-outline-success rounded-circle btn-sm"
                                                        title="Activar proveedor"
                                                        onclick="return confirm('¿Estás seguro de activar a @p.Nombre?')">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table td {
        vertical-align: middle;
    }

    .btn-sm {
        padding: 0.375rem 0.5rem;
    }

    .card-header {
        border-bottom: none;
    }

    a.text-decoration-none:hover {
        text-decoration: underline !important;
    }
</style>